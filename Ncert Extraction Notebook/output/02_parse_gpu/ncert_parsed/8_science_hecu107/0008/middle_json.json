              "content": "z The gas jar should trap the smoke inside."
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.132,
            0.863,
            0.676,
            0.884
          ],
          "content": [
            {
              "type": "text",
              "content": "z Turn it over and cover it with a glass plate (Fig. 7.7b)."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.133,
            0.887,
            0.744,
            0.926
          ],
          "content": [
