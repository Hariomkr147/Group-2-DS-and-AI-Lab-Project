            0.162,
            0.883,
            0.218
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Choose the correct answer with justification. If we could remove all the constituent particles from a chair, what would happen?"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.302,
            0.22,
            0.543,
            0.239
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Nothing will change."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.295,
            0.238,
            0.78,
            0.257
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) The chair will weigh less due to lost particles."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.29,
            0.257,
            0.661,
            0.276
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Nothing of the chair will remain."
