          ],
          "content": [
            {
              "type": "text",
              "content": "z Take a glass vessel, fill it about half with water, and mark the level of water A (Fig. 7.10a)."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.272,
            0.161,
            0.637,
            0.179
          ],
          "content": [
            {
              "type": "text",
              "content": "z Add two teaspoons of sugar into it."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.272,
            0.181,
            0.871,
            0.199
          ],
          "content": [
            {
              "type": "text",
              "content": "z Mark the new water level on the glass vessel B (Fig. 7.10b)."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.272,
            0.2,
            0.88,
            0.219
          ],
          "content": [
            {
              "type": "text",
              "content": "z Stir the water with a glass rod to dissolve the sugar (Fig. 7.10c)."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.272,
            0.22,
            0.882,
            0.256
          ],
          "content": [
            {
              "type": "text",
              "content": "Predict",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " whether the water level will increase or decrease with respect to the mark B."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.272,
            0.257,
            0.726,
            0.277
          ],
          "content": [
            {
              "type": "text",
              "content": "z Mark this water level again as C (Fig. 7.10d)."
            }
          ]
        },
