          ],
          "content": [
            {
              "type": "text",
              "content": "The sky is divided into regions called constellations, which include groups of stars that appear to form patterns."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.292,
            0.78,
            0.883,
            0.843
          ],
          "content": [
            {
              "type": "text",
              "content": "The Pole Star appears nearly stationary in the North direction. This helps in locating the North direction in the Northern hemisphere."
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.256,
            0.847,
            0.809,
            0.87
          ],
          "content": [
            {
              "type": "text",
              "content": "The Sun is a star which produces heat and light."
            }
          ]
        },
