            0.768,
            0.713,
            0.869,
            0.755
          ],
          "content": [
            {
              "type": "text",
              "content": "More to know!",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.115,
            0.772,
            0.555,
            0.791
          ],
          "content": [
            {
              "type": "text",
              "content": "Sometimes we have visitors from the"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.114,
            0.791,
            0.745,
            0.876
          ],
          "content": [
            {
              "type": "text",
              "content": "outer regions of the Solar System! These objects with long tails are called comets (Fig. 12.10). They are made up of dust, gases, rocks and ice. As a comet approaches close to the Sun, the frozen material in it starts evaporating. This evaporating"
            }
          ]
        },
        {
          "type": "aside_text",
