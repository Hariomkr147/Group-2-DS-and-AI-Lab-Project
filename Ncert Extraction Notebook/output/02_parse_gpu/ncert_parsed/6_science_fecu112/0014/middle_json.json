            0.579
          ],
          "content": [
            {
              "type": "text",
              "content": "The Moon is about 3,84,000 km away from the Earth."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.523,
