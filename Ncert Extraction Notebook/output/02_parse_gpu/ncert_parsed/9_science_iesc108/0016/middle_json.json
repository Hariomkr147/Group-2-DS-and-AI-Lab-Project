            0.182,
            0.094,
            0.479,
            0.113
          ],
          "content": [
            {
              "type": "text",
              "content": "Bridging Science and Society"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.135,
            0.131,
            0.622,
            0.163
          ],
          "content": [
            {
              "type": "text",
              "content": "Some isotopes have special properties that are useful in various fields. Some of the applications of isotopes are:"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.138,
            0.166,
            0.572,
            0.216
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "^ { 2 3 5 } _ { 9 2 } \\mathrm { U _ { i } }"
            },
            {
              "type": "text",
              "content": " an isotope of uranium, is used as a fuel in a nuclear reactor to generate electricity in a nuclear power plant (Fig. 8.14)."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.137,
            0.22,
            0.617,
            0.254
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "^ { 6 0 } _ { 2 7 } \\mathsf { C o } ,"
            },
            {
              "type": "text",
              "content": " a radioactive isotope of cobalt, is used in radiation treatment for cancer."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.138,
            0.258,
            0.583,
            0.294
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "^ { 1 3 1 } _ { 5 3 } \\mathrm { I } _ { 3 }"
            },
            {
              "type": "text",
              "content": " an isotope of iodine, is used to treat goitre and thyroid cancer."
            }
          ]
        },
        {
          "type": "image",
          "index": 8,
          "bbox": [
            0.626,
            0.128,
            0.907,
            0.279
          ],
          "content": [
            {
