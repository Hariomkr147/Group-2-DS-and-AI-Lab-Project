          "bbox": [
            0.149,
            0.595,
            0.846,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "We have been using a scale to measure length for a few years. We already know that 1 cm = 10 mm (millimeters)."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.11,
            0.641,
            0.394,
            0.665
          ],
          "content": [
            {
              "type": "text",
              "content": "How many cm is 1 mm?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.174,
            0.674,
            0.641,
            0.711
          ],
          "content": [
            {
              "type": "text",
              "content": "1 mm = 10 1 cm = 0.1 cm (i.e., one-tenth of a cm)."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.111,
            0.721,
            0.54,
            0.746
          ],
          "content": [
            {
              "type": "text",
              "content": "How many cm is (a) 5 mm? (b) 12 mm?"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.174,
            0.753,
            0.41,
            0.791
          ],
          "image_path": "images/page_18_equation_14.jpg",
          "content": "5\\  mm =\\frac{5}{10}\\  cm =0.5\\  cm"
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.175,
            0.793,
