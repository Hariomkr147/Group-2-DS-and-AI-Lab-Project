          ],
          "content": [
            {
              "type": "text",
              "content": "The length of the pencil shown in the figure below is "
            },
            {
              "type": "equation_inline",
              "content": "^ 3 \\frac { 4 } { 1 0 }"
            },
            {
              "type": "text",
              "content": " units, which can also be read as 3 units and four one-tenths, i.e., "
            },
            {
              "type": "equation_inline",
              "content": "( 3 \\times 1 ) + \\left( 4 \\times { \\cfrac { 1 } { 1 0 } } \\right)"
            },
            {
              "type": "text",
              "content": " units."
            }
          ]
        },
