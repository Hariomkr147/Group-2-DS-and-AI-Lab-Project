          "image_source": "images/page_2_image_5.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.857,
            0.847,
            0.895
          ],
          "content": "This length is the same as 34 one-tenths units because 10 one-tenths units make one unit."
