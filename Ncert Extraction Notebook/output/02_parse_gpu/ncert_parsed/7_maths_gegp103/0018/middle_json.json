              ],
              "image_path": "images/page_17_table_17.jpg",
              "content": "<table><tbody><tr><td>Thousands</td><td>Hundreds</td><td>Tens</td><td>Units</td></tr><tr><td></td><td>23</td><td></td><td></td></tr><tr><td>2</td><td>3</td><td>0</td><td>0</td></tr></tbody></table>"
            },
            {
              "type": "table_footnote",
              "index": 18,
              "bbox": [
                0.175,
                0.862,
                0.454,
                0.881
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Similarly, 23 tens would be:"
                }
              ]
            },
            {
              "type": "table_footnote",
              "index": 19,
              "bbox": [
                0.176,
                0.881,
                0.506,
                0.899
              ],
              "content": [
                {
                  "type": "text",
                  "content": "23 tens = 23 × 10 = 200 + 30 = 230."
                }
              ]
            }
