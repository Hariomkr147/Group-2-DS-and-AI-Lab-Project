        },
        {
          "type": "text",
          "bbox": [
            0.111,
            0.384,
            0.738,
            0.407
          ],
          "content": "? Identify and write the decimal numbers against the letters."
        },
        {
          "type": "image",
          "bbox": [
            0.165,
            0.424,
            0.829,
            0.493
          ],
          "content": "",
          "captions": [],
