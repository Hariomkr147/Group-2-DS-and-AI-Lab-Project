        },
        {
          "type": "text",
          "bbox": [
            0.111,
            0.245,
            0.76,
            0.269
          ],
          "content": "? Name all the divisions between 1 and 1.1 on the number line."
        },
        {
          "type": "image",
          "bbox": [
            0.163,
            0.288,
            0.834,
            0.366
          ],
          "content": "",
