            0.182,
            0.086,
            0.811,
            0.401
          ],
          "content": "\\begin{aligned} & (e)  \\quad \\frac{8}{10} \\quad \\frac{2}{100}, \\frac{9}{100}, 1 \\frac{8}{100} \\\\&\\quad \\frac{9}{ \\end{aligned}",
          "image_source": "images/page_10_equation_1.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.111,
            0.427,
            0.639,
            0.463
          ],
          "content": "What will be the sum of $1 5   \\frac { 3 } { 1 0 } \\frac { 4 } { 1 0 0 }$ and $2 \\frac{6}{10} \\frac{8}{100}$"
        },
        {
          "type": "text",
          "bbox": [
            0.174,
            0.465,
            0.777,
            0.486
          ],
          "content": "This can be solved in different ways. Some are shown below."
        },
        {
          "type": "text",
          "bbox": [
            0.183,
            0.49,
            0.327,
            0.509
          ],
          "content": "(a) Method 1"
        },
        {
          "type": "equation",
          "bbox": [
            0.224,
            0.517,
            0.543,
            0.72
          ],
          "content": "\\begin{aligned} &\\left(15+2\\right)+\\left(\\frac{3}{10}+\\frac{6}{10}\\right)+\\left(\\frac{4}{100}+\\frac{8}{100}\\right)\\\\ &=17+\\frac{9}{10}+\\frac{12}{100}\\\\ &=17+\\frac{9}{10}+\\frac{1}{10}+\\frac{2}{100}\\\\ &=17+\\frac{10}{10}+\\frac{2}{100}\\\\ &=18\\frac{2}{100} \\times\\\\ \\end{aligned}",
          "image_source": "images/page_10_equation_5.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.625,
            0.557,
            0.775,
            0.589
          ],
          "content": "10 hundredths is the same as 1 tenth."
        },
        {
          "type": "text",
          "bbox": [
            0.184,
            0.736,
            0.333,
            0.759
          ],
          "content": "(b) Method $2$"
        },
        {
          "type": "equation",
          "bbox": [
            0.342,
            0.728,
            0.546,
            0.927
          ],
          "content": "\\begin{aligned}&\\overline{\\phantom{\\frac{15\\ \\frac{3}{10}\\ \\frac{4}{100}}{}}} \\\\&+\\quad \\begin{array}{c}2\\ \\frac{6}{10}\\ \\frac{8}{100} \\\\\\hline17\\ \\frac{9}{10}\\ \\frac{12}{100} \\\\\\end{array} \\\\&=\\quad \\begin{array}{c}17\\ \\frac{10}{10}\\ \\frac{2}{100} \\\\\\end{array} \\\\&=\\quad \\begin{array}{c}18\\ \\quad \\begin{array}{c}2 \\\\100 \\\\\\end{array} \\\\\\end{array} \\\\\\end{aligned}",
          "image_source": "images/page_10_equation_8.jpg"
