        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.184,
            0.492,
            0.429,
            0.731
          ],
          "image_path": "images/page_5_equation_16.jpg",
          "content": "\\begin{aligned} (a)  \\quad & 12 + \\frac{4}{10} - 6 - \\frac{7}{10} \\\\& = (12 - 6) + \\left( \\frac{4}{10} - \\frac{7}{10} \\right) \\\\& = 6 - \\frac{3}{10} \\\\& = 5 + 1 - \\frac{3}{10} \\\\& = 5 + \\frac{10}{10} - \\frac{3}{10} \\\\& = 5 + \\frac{7}{10} = 5 \\frac{7}{10}\\end{aligned}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.486,
            0.607,
            0.613,
            0.652
          ],
          "content": [
            {
              "type": "text",
              "content": "Discuss what is being done here and why."
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.186,
            0.747,
            0.474,
            0.869
          ],
          "image_path": "images/page_5_equation_18.jpg",
          "content": "\\begin{array}{ccc}( b ) & 12\\dfrac{4}{10} &  \\\\\\underbrace{-6\\dfrac{7}{10}} & \\longrightarrow & 11\\dfrac{14}{10} \\\\&  & -6\\dfrac{7}{10} \\\\&  & =5\\dfrac{7}{10} \\\\\\end{array}"
        },
