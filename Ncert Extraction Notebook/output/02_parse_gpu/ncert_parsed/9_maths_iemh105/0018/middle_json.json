          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.141,
            0.113,
            0.42,
            0.303
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.141,
                0.113,
                0.42,
                0.303
              ],
              "image_path": "images/page_17_image_2.jpg",
