          ],
          "content": [
            {
              "type": "text",
              "content": "5.6 Distance of Chords from the Centre"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.111,
            0.231,
            0.886,
            0.31
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Take a paper circle. Fold the circle from the boundary, inwards. Open the fold. The crease is now a chord (see Fig. 5.13B). Now fold the paper again, so that the end points of the chord meet. Open the fold (see Fig. 5.13C)."
            }
          ]
