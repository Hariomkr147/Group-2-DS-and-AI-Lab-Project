            {
              "type": "text",
              "content": "From Question 1 above, we have the following result."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.133,
            0.886,
            0.174
          ],
          "content": [
            {
              "type": "text",
              "content": "Theorem 5:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The perpendicular from the centre of a circle to a chord of the circle bisects the chord."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
