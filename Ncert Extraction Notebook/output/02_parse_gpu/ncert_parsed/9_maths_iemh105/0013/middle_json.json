          "content": [
            {
              "type": "text",
              "content": "Theorem 7:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Chords of a circle that are equidistant from the centre have equal length."
            }
          ]
        },
        {
