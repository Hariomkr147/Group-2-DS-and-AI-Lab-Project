            0.164,
            0.206,
            0.884,
            0.248
          ],
          "content": [
            {
              "type": "text",
              "content": "For the purpose of construction, let us take the side lengths to be of 5 cm. Consider this figure."
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.398,
            0.244,
            0.651,
            0.402
          ],
          "content": [
            {
              "type": "image_body",
              "index": 4,
              "bbox": [
                0.398,
                0.244,
