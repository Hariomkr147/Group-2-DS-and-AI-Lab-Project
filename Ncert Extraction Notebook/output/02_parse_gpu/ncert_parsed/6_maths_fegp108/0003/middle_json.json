          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.74,
            0.83,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "Having explored the use of a compass, go ahead and recreate the images in Fig. 8.1."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.113,
            0.786,
            0.83,
            0.829
          ],
          "content": [
            {
              "type": "text",
              "content": "Can you make the figures look as good as the figures shown there? Try again if you want to!"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.142,
