          "footnotes": [],
          "image_source": "images/page_32_image_5.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.322,
            0.863,
            0.358
          ],
          "content": "**Q.2. Draw a rectangle of sides 2 cm and 10 cm. After drawing, check if it satisfies both the rectangle properties.**"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.369,
            0.163,
            0.384
          ],
          "content": "**Ans.**"
        },
        {
          "type": "equation",
          "bbox": [
            0.177,
            0.396,
            0.412,
            0.412
          ],
          "content": "\\angle \\mathrm{P} = \\angle \\mathrm{Q} = \\angle \\mathrm{R} = \\angle \\mathrm{S} = 90^{\\circ}",
          "image_source": "images/page_32_equation_8.jpg"
        },
        {
          "type": "equation",
          "bbox": [
            0.176,
            0.414,
            0.486,
            0.431
          ],
          "content": "PQ = SR = 10  cm  \\& PS = QR = 2  cm",
          "image_source": "images/page_32_equation_9.jpg"
