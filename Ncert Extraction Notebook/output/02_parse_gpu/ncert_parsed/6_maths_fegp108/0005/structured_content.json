          "level": 2,
          "content": "2. Wavy Wave"
        },
        {
          "type": "text",
          "bbox": [
            0.155,
            0.206,
            0.315,
            0.226
          ],
          "content": "Construct this."
        },
        {
          "type": "image",
          "bbox": [
            0.278,
            0.235,
            0.666,
            0.385
          ],
          "content": "",
          "captions": [],
