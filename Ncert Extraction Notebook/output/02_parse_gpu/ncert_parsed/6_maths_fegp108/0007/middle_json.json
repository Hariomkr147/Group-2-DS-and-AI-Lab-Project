          ],
          "content": [
            {
              "type": "text",
              "content": "Recall that, in a rectangle:"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.143,
            0.143,
            0.656,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "R1) The opposite sides are equal in length, and"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.144,
            0.168,
            0.433,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "R2) All the angles are "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.114,
            0.19,
            0.834,
            0.234
          ],
          "content": [
            {
              "type": "text",
              "content": "As in the case of rectangles, the corners and sides are defined for a square in the same manner."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.142,
            0.236,
            0.647,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "A square satisfies the following two properties:"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.143,
            0.26,
            0.491,
            0.281
          ],
          "content": [
            {
              "type": "text",
              "content": "S1) All the sides are equal, and"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.143,
            0.284,
            0.431,
            0.305
          ],
          "content": [
            {
              "type": "text",
              "content": "S2) All the angles are 90"
            },
            {
              "type": "text",
              "content": "o",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": "."
