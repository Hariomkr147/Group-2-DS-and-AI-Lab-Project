          "image_source": "images/page_6_image_22.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.113,
            0.791,
            0.524,
            0.835
          ],
          "content": "Let us check if the rotated paper still satisfies the properties of a square."
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.839,
            0.526,
            0.861
          ],
          "content": "• Are all the sides still equal? Yes."
        },
        {
          "type": "text",
          "bbox": [
            0.149,
            0.866,
            0.517,
            0.888
          ],
          "content": "• Are all the angles still $9 0 ^ { \\circ } ?$ Yes."
        },
