          "image_source": "images/page_6_image_17.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.114,
            0.649,
            0.48,
            0.67
          ],
          "level": 2,
          "content": "Rotated Squares and Rectangles"
        },
        {
          "type": "text",
          "bbox": [
            0.112,
            0.677,
            0.51,
            0.789
          ],
          "content": "Here is a square piece of paper having all its sides equal in length and all angles equal to $9 0 ^ { \\circ }$ . It is rotated as shown in the figure. Is it still a square?"
        },
        {
          "type": "footer",
          "bbox": [
            0.449,
            0.97,
            0.55,
            0.985
          ],
          "content": "Reprint 2026-27"
        },
        {
          "type": "image",
          "bbox": [
            0.536,
            0.694,
            0.642,
            0.775
          ],
          "content": "",
          "captions": [],
