          ],
          "content": [
            {
              "type": "text",
              "content": "Now "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { A }"
            },
            {
              "type": "text",
              "content": " is divided into two angles. One measures "
