        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.255,
            0.284,
            0.882,
            0.306
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us explore how salt can be separated from a salt solution."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.254,
            0.317,
            0.672,
            0.339
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 9.2: Let us observe and create"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.1,
            0.37,
            0.285,
            0.542
          ],
          "content": [
            {
              "type": "text",
              "content": "Have you ever observed white patches on the dark coloured clothes you wear during hot summers? How are these patches formed?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.329,
            0.352,
            0.882,
            0.394
          ],
          "content": [
            {
              "type": "text",
              "content": "Take a bowl or any container and fill it half with water."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.33,
            0.397,
            0.883,
            0.44
          ],
          "content": [
            {
              "type": "text",
              "content": "Add 2–3 teaspoons of salt into it and stir till the salt dissolves to form a solution."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.329,
            0.442,
            0.883,
            0.505
          ],
          "content": [
            {
              "type": "text",
              "content": " Take a small piece of black or dark coloured thick paper and spread a few drops of the salt solution on it (Fig. 9.7a)."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.329,
            0.508,
            0.883,
            0.549
          ],
          "content": [
            {
              "type": "text",
              "content": " You can also create any art of your choice with this salt solution."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.329,
            0.551,
            0.883,
            0.595
          ],
          "content": [
            {
              "type": "text",
              "content": " Allow it to dry and then observe it (Fig. 9.7b and Fig. 9.7c)."
            }
          ]
        },
