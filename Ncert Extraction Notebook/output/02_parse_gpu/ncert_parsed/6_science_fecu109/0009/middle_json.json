            0.115,
            0.28,
            0.451,
            0.302
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 9.4: Let us experiment"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.318,
            0.755,
            0.359
          ],
          "content": [
            {
