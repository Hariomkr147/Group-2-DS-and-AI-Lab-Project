        },
        {
          "type": "text",
          "bbox": [
            0.274,
            0.398,
            0.556,
            0.46
          ],
          "content": "Heat and let the water boil away as shown in Fig. 9.8."
        },
        {
          "type": "image",
          "bbox": [
            0.591,
            0.262,
            0.929,
            0.436
          ],
          "content": "",
