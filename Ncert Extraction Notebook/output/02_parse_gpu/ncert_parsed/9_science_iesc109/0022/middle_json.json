          "bbox": [
            0.14,
            0.633,
            0.775,
            0.684
          ],
          "content": [
            {
              "type": "text",
              "content": "Pick cards from the pile or from open cards and match them with cards in your hand to form compounds. You may discard any unwanted cards."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.143,
            0.687,
            0.774,
            0.722
          ],
          "content": [
            {
              "type": "text",
              "content": "Ask other players for cards and form compounds using the cards they already have."
