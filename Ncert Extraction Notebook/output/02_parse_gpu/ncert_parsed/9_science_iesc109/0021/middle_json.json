            0.296,
            0.887,
            0.33
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Ammonium nitrate "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{(NH_{4}NO_{3})}"
            },
            {
              "type": "text",
              "content": " , used as a nitrogen fertiliser, which is essential for plant growth."
