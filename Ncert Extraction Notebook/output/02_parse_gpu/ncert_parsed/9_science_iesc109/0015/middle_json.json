            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.213,
            0.519,
            0.295,
            0.538
          ],
          "content": [
            {
              "type": "text",
              "content": "Formula"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.539,
            0.465,
            0.613,
