            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.213,
            0.356,
            0.295,
            0.375
          ],
          "content": [
            {
              "type": "text",
              "content": "Formula"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.371,
            0.357,
            0.422,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "CaCl"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "subscript"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.211,
            0.378,
            0.857,
            0.431
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, in calcium chloride, there are two chloride ions (Cl–) for each calcium ion "
            },
            {
              "type": "equation_inline",
              "content": "( \\mathbb { C } \\mathbf { a } ^ { 2 + } )"
            },
            {
              "type": "text",
              "content": " The positive and negative charges must balance each "
            },
            {
              "type": "text",
              "content": "other, and the overall structure must be neutral.",
              "styles": [
                "underline"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.213,
            0.441,
            0.51,
            0.46
          ],
          "content": [
            {
              "type": "text",
              "content": "The formula of aluminium oxide —"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.539,
            0.441,
            0.865,
            0.461
          ],
          "content": [
            {
              "type": "text",
              "content": "The formula for magnesium oxide"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.213,
            0.462,
            0.287,
            0.482
          ],
          "content": [
