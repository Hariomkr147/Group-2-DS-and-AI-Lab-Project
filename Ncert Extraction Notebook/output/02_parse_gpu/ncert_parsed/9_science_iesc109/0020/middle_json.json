            },
            {
              "type": "equation_inline",
              "content": "3 \\; \\mathbf { C } \\mathbf { a } ^ { 2 + }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "2 \\; \\mathrm { S O _ { 4 } ^ { 2 - } }"
