              "type": "equation_inline",
              "content": "\\mathrm { M g ^ { 2 + } }"
            },
            {
              "type": "text",
              "content": " and 1 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { P O _ { 4 } ^ { 3 - } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.147,
            0.537,
            0.333,
            0.553
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "2 \\; \\mathrm { F e ^ { 3 + } }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "3 \\; 0 ^ { 2 - }"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.148,
            0.553,
            0.343,
            0.572
          ],
          "content": [
            {
              "type": "text",
