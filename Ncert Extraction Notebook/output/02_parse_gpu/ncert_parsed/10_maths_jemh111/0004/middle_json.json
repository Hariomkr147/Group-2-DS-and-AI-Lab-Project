              "type": "text",
              "content": "AREAS RELATED TO CIRCLES"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.863,
            0.104,
            0.898,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "157"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.096,
            0.154,
            0.594,
            0.2
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2 : Find the area of the segment AYB shown in Fig. 11.6, if radius of the circle is 21 cm and"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.098,
            0.206,
            0.402,
            0.249
          ],
          "image_path": "images/page_3_equation_3.jpg",
          "content": "\\angle  AOB = 120^{\\circ}. (Use \\pi = \\frac{22}{7})"
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.646,
            0.147,
            0.855,
            0.299
          ],
          "content": [
            {
              "type": "image_body",
              "index": 4,
              "bbox": [
                0.646,
                0.147,
                0.855,
                0.299
              ],
              "image_path": "images/page_3_image_4.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 5,
              "bbox": [
                0.696,
                0.305,
                0.795,
                0.324
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 11.6"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.337,
            0.462,
            0.356
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : Area of the segment AYB"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.42,
            0.363,
            0.899,
            0.382
          ],
          "content": [
            {
              "type": "text",
              "content": "= Area of sector OAYB – Area of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { ~ O A B }"
            },
            {
              "type": "text",
              "content": " (1)"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.097,
            0.387,
            0.788,
            0.431
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, area of the sector "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{OAVB} = \\frac{120}{360} \\times \\frac{22}{7} \\times 21 \\times 21\\mathrm{cm}^{2} = 462\\mathrm{cm}^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.868,
            0.401,
            0.898,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "(2)"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.096,
            0.438,
            0.773,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "For finding the area of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { O A B }"
            },
            {
              "type": "text",
              "content": " , draw "
            },
            {
              "type": "equation_inline",
              "content": "OM \\perp AB"
            },
            {
              "type": "text",
              "content": " as shown in Fig. 11.7."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.096,
            0.464,
            0.799,
            0.484
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { O A } = \\mathrm { O B }"
            },
            {
              "type": "text",
              "content": " . Therefore, by RHS congruence, "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta  AMO  \\cong \\Delta  BMO"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.096,
            0.497,
            0.785,
            0.538
          ],
          "content": [
            {
              "type": "text",
              "content": "So, M is the mid-point of AB and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle AOM = \\angle BOM = \\frac{1}{2} \\times 120^{\\circ} = 60^{\\circ}"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.098,
            0.548,
            0.138,
            0.564
          ],
          "content": [
            {
              "type": "text",
              "content": "Let"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.354,
            0.547,
            0.476,
            0.567
          ],
          "image_path": "images/page_3_equation_14.jpg",
          "content": "\\mathrm{OM} = x^{\\circ}\\mathrm{cm}"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.592,
            0.272,
            0.611
          ],
          "content": [
            {
              "type": "text",
              "content": "So, from ∆ OMA,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.345,
            0.579,
            0.498,
            0.62
          ],
          "image_path": "images/page_3_equation_16.jpg",
          "content": "\\frac{OM}{OA} = \\cos 60^{\\circ}"
        },
        {
          "type": "image",
          "index": 17,
          "bbox": [
            0.596,
            0.551,
            0.9,
            0.635
          ],
          "content": [
            {
              "type": "image_body",
              "index": 17,
              "bbox": [
                0.596,
                0.551,
                0.9,
                0.635
              ],
              "image_path": "images/page_3_image_17.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.098,
            0.649,
            0.128,
            0.665
          ],
          "content": [
            {
              "type": "text",
              "content": "or,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.362,
            0.631,
            0.612,
            0.675
          ],
          "image_path": "images/page_3_equation_19.jpg",
          "content": "\\frac{x}{21} = \\frac{1}{2} \\quad \\left( \\cos 60^{\\circ} = \\frac{1}{2} \\right)"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.695,
            0.645,
            0.793,
            0.665
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 11.7"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.098,
            0.693,
            0.128,
            0.707
          ],
          "content": [
            {
              "type": "text",
              "content": "or,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.379,
            0.677,
            0.458,
            0.719
          ],
          "image_path": "images/page_3_equation_22.jpg",
          "content": "x = { \\frac { 2 1 } { 2 } }"
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.098,
            0.736,
            0.134,
            0.753
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 24,
          "bbox": [
            0.353,
            0.723,
            0.498,
            0.763
          ],
          "image_path": "images/page_3_equation_24.jpg",
          "content": "\\mathrm { O M } = { \\frac { 2 1 } { 2 } } ~ \\mathrm { c m }"
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.098,
            0.784,
            0.154,
            0.801
          ],
          "content": [
            {
              "type": "text",
              "content": "Also,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 26,
          "bbox": [
            0.348,
            0.767,
            0.553,
            0.811
          ],
          "image_path": "images/page_3_equation_26.jpg",
          "content": "\\frac{ AM }{ OA } = \\sin 60^{\\circ} = \\frac{\\sqrt{3}}{2}"
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.098,
            0.827,
            0.134,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 28,
          "bbox": [
            0.355,
            0.812,
            0.527,
            0.854
          ],
          "image_path": "images/page_3_equation_28.jpg",
          "content": "\\mathrm { A M } = { \\frac { 2 1 { \\sqrt { 3 } } } { 2 } } { \\mathrm { ~ c m } }"
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.098,
            0.869,
            0.205,
            0.887
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "footer",
          "index": 30,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "equation",
          "index": 31,
          "bbox": [
            0.358,
            0.854,
            0.748,
            0.898
          ],
          "image_path": "images/page_3_equation_31.jpg",
          "content": "AB = 2   AM  = \\frac{2 \\times 21\\sqrt{3}}{2}   cm  = 21\\sqrt{3}   cm"
        }
      ]
    }
