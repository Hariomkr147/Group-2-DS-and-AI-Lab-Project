          "content": [
            {
              "type": "text",
              "content": "？ Example 5: Construct a triangle with angles in the ratio 1 : 3 : 5."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.15,
            0.113,
            0.846,
            0.15
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that the sum of the angles in a triangle is 180°. So the angles are C"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.153,
            0.151,
            0.517,
            0.18
          ],
          "image_path": "images/page_5_equation_3.jpg",
          "content": "\\angle \\mathrm{A}=180^{\\circ} \\times \\frac{1}{(1+3+5)}=180^{\\circ} \\times \\frac{1}{9}=20^{\\circ}."
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.152,
            0.181,
            0.517,
            0.209
          ],
          "image_path": "images/page_5_equation_4.jpg",
          "content": "\\angle \\mathrm{B}=180^{\\circ} \\times \\frac{3}{(1+3+5)}=180^{\\circ} \\times \\frac{3}{9}=60^{\\circ}."
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.153,
            0.209,
            0.524,
            0.238
          ],
          "image_path": "images/page_5_equation_5.jpg",
          "content": "\\angle C = 180^{\\circ} \\times \\frac{5}{(1 + 3 + 5)} = 180^{\\circ} \\times \\frac{5}{9} = 100^{\\circ}."
        },
        {
