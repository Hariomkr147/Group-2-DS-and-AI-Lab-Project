              "content": "<table><tbody><tr><td>Subject</td><td>Language</td><td>Arts Education</td><td>Vocational Education</td><td>Social Science</td><td>Physical Education</td><td>Maths</td><td>Science</td></tr><tr><td>Number of Students</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
