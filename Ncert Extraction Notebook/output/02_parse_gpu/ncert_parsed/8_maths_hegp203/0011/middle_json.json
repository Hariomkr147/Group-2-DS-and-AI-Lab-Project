          ],
          "content": [
            {
              "type": "text",
              "content": "2. Fill in the empty cells if x and y are in inverse proportion."
            }
          ]
        },
        {
          "type": "table",
          "index": 10,
          "bbox": [
            0.252,
            0.473,
            0.746,
