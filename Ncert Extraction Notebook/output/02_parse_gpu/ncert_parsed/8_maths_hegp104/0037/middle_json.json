        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.152,
            0.325,
            0.724,
            0.345
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". In (a) Given CASE is a square. Let side of square be "
            },
            {
              "type": "equation_inline",
              "content": "x"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.202,
            0.356,
            0.413,
            0.389
          ],
          "content": [
            {
              "type": "text",
              "content": "Then half of sid "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { e } = { \\frac { x } { 2 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.201,
            0.385,
            0.622,
            0.488
          ],
          "content": [
            {
              "type": "text",
              "content": "In right ∆CUV, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{UV}^{2}=\\mathrm{CU}^{2}+\\mathrm{CV}^{2}=\\frac{x^{2}}{4}+\\frac{x^{2}}{4}=\\frac{x^{2}}{2}"
            },
            {
              "type": "text",
              "content": " So "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { U V = } { \\frac { 1 } { \\sqrt { 2 } } } x"
            },
            {
              "type": "text",
              "content": " Similarly, "
            },
            {
              "type": "equation_inline",
              "content": "\\left[ \\mathrm{UX} = \\mathrm{XW} = \\mathrm{VW} = \\frac{1}{\\sqrt{2}} x \\right]"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.202,
            0.493,
            0.56,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, In ∆CUV, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle C = 90^{\\circ}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{CU} = \\mathrm{CV}"
            },
            {
              "type": "text",
              "content": " So, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 1 = \\angle 2 = 45^{\\circ}"
            },
            {
              "type": "text",
              "content": " or "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 3 = \\angle 4 = 45^{\\circ}"
            },
            {
              "type": "text",
              "content": " So, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 1 + \\angle 3 + \\angle 5 = 180^{\\circ}"
            },
            {
              "type": "text",
              "content": " (Linear Pair) "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 5 = 90^{\\circ}"
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.644,
            0.369,
            0.844,
            0.526
          ],
          "content": [
