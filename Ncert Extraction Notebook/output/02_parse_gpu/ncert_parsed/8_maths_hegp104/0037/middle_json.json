                0.728,
                0.533,
                0.751,
                0.547
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(a)"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.203,
            0.573,
            0.486,
            0.592
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 6 = \\angle 7 = \\angle 8 = 90^{\\circ}"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.201,
            0.593,
            0.845,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "In quadrilateral UXWV, all sides and angles are equal (90°) so UXWN is square."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.151,
            0.642,
            0.847,
            0.699
          ],
          "content": [
            {
              "type": "text",
              "content": "8. If a quadrilateral has four equal sides and one angle of "
            },
            {
              "type": "equation_inline",
              "content": "[ 9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , will it be a square? Find the answer using geometric reasoning as well as by construction and measurement."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.152,
            0.706,
            0.426,
            0.726
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". Yes it will be a square."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.199,
            0.732,
            0.846,
            0.813
          ],
          "content": [
            {
              "type": "text",
              "content": "A quadrilateral with four equal sides is a rhombus. In a rhombus opposite angles are equal and adjacent angles are supplementary . One angle is "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " then adjacent angle and opposite angle will be "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " All four angles are equal to "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . So it is a square."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.151,
            0.821,
            0.846,
            0.88
          ],
          "content": [
            {
              "type": "text",
              "content": "9. What type of a quadrilateral is one in which the opposite sides are equal? Justify your answer. "
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Draw a diagonal and check for congruent triangles."
            }
          ]
        },
