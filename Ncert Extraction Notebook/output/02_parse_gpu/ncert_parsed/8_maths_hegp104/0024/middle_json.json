            0.407
          ],
          "content": [
            {
              "type": "text",
              "content": "Kite"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.417,
            0.848,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "One of the ways the two triangles of sides 6 cm, 9 cm and 12 cm can be joined together is as follows —"
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.313,
            0.456,
            0.604,
            0.686
          ],
          "content": [
            {
