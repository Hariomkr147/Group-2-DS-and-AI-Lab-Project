              "bbox": [
                0.313,
                0.456,
                0.604,
                0.686
              ],
              "image_path": "images/page_23_image_10.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 11,
          "bbox": [
            0.897,
            0.354,
            0.995,
            0.491
          ],
          "content": [
            {
              "type": "image_body",
              "index": 11,
              "bbox": [
                0.897,
                0.354,
                0.995,
                0.491
              ],
              "image_path": "images/page_23_image_11.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.15,
            0.711,
            0.659,
            0.751
          ],
          "content": [
            {
              "type": "text",
              "content": "This quadrilateral looks like a kite. Observe that the adjacent sides are of the same length."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.149,
            0.753,
            0.659,
            0.792
          ],
          "content": [
            {
              "type": "text",
              "content": "Kite:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A kite is a quadrilateral that can be labelled ABCD such that "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { A } \\bar { \\mathbf { B } } = \\mathbf { B } \\mathbf { C } ,"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { C D } = \\mathrm { D A }"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.273,
            0.825,
            0.557,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) bisects "
            },
            {
              "type": "equation_inline",
              "content": "\\angle  ABC"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle  ADC ,"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.267,
            0.848,
            0.659,
            0.906
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) bisects the diagonal AC, that is, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A O } = \\mathrm { O C } ,"
            },
            {
              "type": "text",
              "content": " and is perpendicular to it. "
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Is "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta  AOB  \\cong \\Delta  COB?"
            }
          ]
        },
