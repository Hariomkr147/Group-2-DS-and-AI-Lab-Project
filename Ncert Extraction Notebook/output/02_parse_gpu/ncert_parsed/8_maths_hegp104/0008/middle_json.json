            0.202,
            0.889,
            0.344,
            0.907
          ],
          "image_path": "images/page_7_equation_15.jpg",
          "content": "\\mathrm{Since} \\angle \\mathrm{B} = 90^{\\circ},"
        },
        {
          "type": "equation",
