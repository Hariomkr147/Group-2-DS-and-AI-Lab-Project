            0.272,
            0.161
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus "
            },
            {
              "type": "equation_inline",
              "content": "a = 6 0 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.151,
            0.172,
            0.689,
            0.193
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, we can find the values of all the other angles."
            }
          ]
        },
        {
