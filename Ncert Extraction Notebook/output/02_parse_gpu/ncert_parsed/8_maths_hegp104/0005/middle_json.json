            0.437
          ],
          "content": [
            {
              "type": "text",
              "content": "Can we now identify what type of quadrilateral ABCD is? Notice that its angles all add up to "
            },
            {
              "type": "equation_inline",
              "content": "90^{\\circ} \\left( 30^{\\circ} + 60^{\\circ} \\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.438,
            0.475,
            0.461
          ],
          "content": [
            {
              "type": "text",
              "content": "What can we say about its sides?"
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.259,
            0.465,
