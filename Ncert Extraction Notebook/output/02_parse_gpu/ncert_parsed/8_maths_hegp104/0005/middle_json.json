            0.143
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore "
            },
            {
              "type": "equation_inline",
              "content": "2 a = 1 2 0 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
