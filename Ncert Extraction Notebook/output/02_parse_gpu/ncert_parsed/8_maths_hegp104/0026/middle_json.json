            0.217,
            0.589,
            0.847,
            0.628
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) What is the quadrilateral that is both a kite and a parallelogram?"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.21,
            0.632,
            0.847,
            0.652
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Can there be a quadrilateral that is both a kite and a rectangle?"
