          ],
          "content": [
            {
              "type": "text",
              "content": "Properties of a rhombus —"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.236,
            0.13,
            0.823,
            0.152
          ],
          "content": [
            {
              "type": "text",
              "content": "y The opposite sides of a rhombus are parallel to each other."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.237,
            0.154,
            0.823,
            0.193
          ],
          "content": [
            {
              "type": "text",
              "content": "In a rhombus, the adjacent angles add up to 180°, and the opposite angles are equal."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.237,
            0.196,
            0.823,
            0.236
          ],
          "content": [
            {
              "type": "text",
              "content": "The diagonals of a rhombus bisect each other at right angles."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.237,
            0.239,
            0.694,
            0.26
          ],
          "content": [
            {
              "type": "text",
              "content": "y The diagonals of a rhombus bisect its angles."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.175,
            0.263,
            0.823,
            0.304
          ],
          "content": [
            {
              "type": "text",
              "content": "A "
            },
            {
              "type": "text",
              "content": "kite",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " is a quadrilateral with two non-overlapping adjacent pairs of sides having the same length."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.176,
            0.311,
            0.825,
            0.351
          ],
          "content": [
            {
              "type": "text",
              "content": "A "
            },
            {
              "type": "text",
              "content": "trapezium",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " is a quadrilateral having at least one pair of parallel opposite sides."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.175,
            0.359,
            0.766,
            0.381
          ],
          "content": [
            {
              "type": "text",
              "content": " The sum of the angle measures in a quadrilateral is 360°."
            }
          ]
