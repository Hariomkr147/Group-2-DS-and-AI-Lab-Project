            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.343,
            0.656,
            0.847,
            0.715
          ],
          "content": [
            {
              "type": "text",
              "content": "We can find the remaining angles between the diagonals using our understanding of vertically opposite angles and linear pairs."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.151,
            0.821,
            0.661,
            0.859
          ],
          "content": [
            {
              "type": "text",
              "content": "In "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A O B } _ { 3 }"
            },
            {
              "type": "text",
              "content": " since "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { O A = O B } ,"
            },
            {
              "type": "text",
              "content": " the angles opposite them are equal, say a."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.112,
            0.861,
            0.428,
            0.885
          ],
          "content": [
            {
              "type": "text",
              "content": "Can you find the value of a?"
            }
          ]
        },
