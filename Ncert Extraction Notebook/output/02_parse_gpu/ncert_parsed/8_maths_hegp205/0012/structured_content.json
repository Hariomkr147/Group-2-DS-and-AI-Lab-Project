        {
          "type": "text",
          "bbox": [
            0.152,
            0.717,
            0.801,
            0.756
          ],
          "content": "5. Find the median of 8, 10, 19, 23, 26, 34, 40, 41, 41, 48, 51, 55, 70, 84, 91, 92."
        },
        {
          "type": "image",
          "bbox": [
            0.818,
            0.704,
            0.903,
            0.755
          ],
          "content": "",
          "captions": [],
