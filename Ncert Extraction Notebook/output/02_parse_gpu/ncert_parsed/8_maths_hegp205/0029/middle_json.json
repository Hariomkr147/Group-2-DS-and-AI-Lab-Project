                0.154,
                0.892,
                0.309
              ],
              "image_path": "images/page_28_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.198,
            0.338,
            0.847,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Calculate the average time spent per activity. Represent this average day using a strip."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.192,
            0.379,
            0.81,
            0.419
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Similarly, track the activities of any adult at home. Compare your data with theirs."
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.825,
            0.374,
            0.925,
            0.428
          ],
          "content": [
            {
              "type": "image_body",
              "index": 9,
              "bbox": [
                0.825,
                0.374,
                0.925,
                0.428
              ],
              "image_path": "images/page_28_image_9.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.153,
            0.427,
            0.81,
            0.466
          ],
          "content": [
            {
              "type": "text",
              "content": "13. Small group project: Make a group of 3 – 4 members. Do at least one of the following:"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.204,
            0.47,
            0.846,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Track daily sleep time of all your family members for a week. Daily sleep time includes night sleep, naps, and any sleep during the day."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.235,
            0.531,
            0.51,
            0.551
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Represent this on strips."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.235,
            0.555,
            0.846,
            0.612
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Put together the data of all your group members. Calculate the average and median sleep time of children, adults, elderly."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.235,
            0.616,
            0.645,
            0.636
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) Share your findings and observations."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.198,
            0.645,
            0.847,
            0.776
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) When do schools start and end? On a weekday, Manoj’s school starts at 9:30 am and ends at 4:30 pm, i.e., 7 hours which include class time and breaks. Collect information on the daily timings of different schools for Grade 8, including class time and break time (the schools can be anywhere in the country. You can ask your neighbours, relatives, parents and friends to find out). Analyse and present the data collected."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.153,
            0.784,
            0.847,
            0.86
          ],
          "content": [
            {
              "type": "text",
              "content": "14. The following graphs show the sunrise and sunset times across the year at 4 locations in India. Observe how the graphs are organised. Are you able to identify which lines indicate the sunrise and which indicate the sunset?"
            }
          ]
        },
