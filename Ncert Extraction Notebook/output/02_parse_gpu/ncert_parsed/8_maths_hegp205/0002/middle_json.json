              "content": "<table><tr><td></td><td></td><td>●</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td>0</td><td>2</td><td colspan=\"2\">4</td><td>6</td><td colspan=\"2\">8</td><td>10</td><td>12</td></tr></table>"
