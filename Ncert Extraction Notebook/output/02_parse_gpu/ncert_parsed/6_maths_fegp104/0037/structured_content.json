          "type": "text",
          "bbox": [
            0.117,
            0.455,
            0.297,
            0.471
          ],
          "content": "Ans. a. 3 symbols"
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.473,
            0.319,
            0.488
          ],
          "content": "b. Poonam Ben"
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.491,
            0.281,
            0.506
          ],
          "content": "c. Jasmeet"
        },
