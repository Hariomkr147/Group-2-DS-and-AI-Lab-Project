        {
          "type": "text",
          "bbox": [
            0.248,
            0.736,
            0.653,
            0.757
          ],
          "content": "b. Which village has the most tractors?"
        },
        {
          "type": "text",
          "bbox": [
            0.248,
            0.765,
            0.873,
            0.787
          ],
          "content": "How many more tractors does Village C have than Village B?"
