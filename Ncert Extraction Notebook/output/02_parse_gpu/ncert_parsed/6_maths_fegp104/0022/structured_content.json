          "type": "text",
          "bbox": [
            0.196,
            0.329,
            0.561,
            0.348
          ],
          "content": "b. The maximum number of times."
        },
        {
          "type": "text",
          "bbox": [
            0.197,
            0.357,
            0.786,
            0.378
          ],
          "content": "c. Find numbers that appeared an equal number of times."
