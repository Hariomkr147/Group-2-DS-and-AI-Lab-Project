        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.143,
            0.229,
            0.666,
            0.251
          ],
          "content": [
            {
              "type": "text",
              "content": "c. Who purchased more kites, Jasmeet or Chaman?"
