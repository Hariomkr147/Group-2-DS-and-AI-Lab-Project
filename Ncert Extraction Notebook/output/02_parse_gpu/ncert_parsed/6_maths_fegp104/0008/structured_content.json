            0.425,
            0.72,
            0.451
          ],
          "content": "**= 1 student**"
        },
        {
          "type": "text",
          "bbox": [
            0.319,
            0.674,
            0.519,
            0.691
          ],
          "content": "No. of students absent"
        },
        {
          "type": "text",
          "bbox": [
            0.114,
