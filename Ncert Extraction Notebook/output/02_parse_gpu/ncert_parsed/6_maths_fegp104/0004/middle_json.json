              ],
              "image_path": "images/page_3_table_5.jpg",
              "content": "<table><tr><td>4</td><td>5</td><td>3</td><td>4 3 4</td><td>5 5</td><td>4</td></tr><tr><td>5</td><td>5</td><td>4</td><td>6 5</td><td>3 5</td><td>6</td></tr><tr><td>4</td><td>6</td><td>4</td><td>5</td><td>6 4</td><td>5</td></tr></table>"
