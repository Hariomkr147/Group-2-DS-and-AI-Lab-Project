          "image_source": "images/page_19_table_9.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.155,
            0.521,
            0.674,
            0.542
          ],
          "content": "Help her prepare a bar graph representing this data."
        },
        {
          "type": "text",
          "bbox": [
            0.144,
            0.55,
            0.833,
            0.617
          ],
          "content": "2. Pooja collected data on the number of tickets sold at the Bhopal railway station for a few different cities of Madhya Pradesh over a two-hour period."
