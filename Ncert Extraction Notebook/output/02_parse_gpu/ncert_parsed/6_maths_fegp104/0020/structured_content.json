            0.497
          ],
          "content": "<table><tr><td><img src=\"images/page_19_table_image_9_1.jpg\"/></td><td><img src=\"images/page_19_table_image_9_2.jpg\"/></td><td><img src=\"images/page_19_table_image_9_3.jpg\"/></td><td><img src=\"images/page_19_table_image_9_4.jpg\"/></td><td><img src=\"images/page_19_table_image_9_5.jpg\"/></td></tr><tr><td>Mites</td><td>Caterpillars</td><td>Beetles</td><td>Butterflies</td><td>Grasshoppers</td></tr><tr><td>6</td><td>10</td><td>5</td><td>3</td><td>2</td></tr></table>",
          "captions": [],
