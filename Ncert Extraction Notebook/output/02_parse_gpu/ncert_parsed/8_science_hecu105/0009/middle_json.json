          ],
          "content": [
            {
              "type": "text",
              "content": "— Textbook of Science for Grade 8"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 1,
          "bbox": [
            0.256,
            0.084,
            0.47,
