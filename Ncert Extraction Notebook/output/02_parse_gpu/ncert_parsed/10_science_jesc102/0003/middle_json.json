            0.551,
            0.984
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.124,
            0.093,
            0.686,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Rinse both cloth strips with water and again check their odour.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.125,
            0.108,
            0.354,
            0.122
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Note your observations.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.124,
            0.122,
            0.698,
            0.15
          ],
          "content": [
            {
              "type": "text",
              "content": "Now take some dilute vanilla essence and clove oil and check their odour.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.124,
            0.151,
            0.698,
            0.209
          ],
          "content": [
            {
              "type": "text",
              "content": "Take some dilute HCl solution in one test tube and dilute NaOH solution in another. Add a few drops of dilute vanilla essence to both test tubes and shake well. Check the odour once again and record changes in odour, if any.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.124,
            0.209,
            0.698,
            0.239
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, test the change in the odour of clove oil with dilute HCl and dilute NaOH solutions and record your observations.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.099,
            0.25,
            0.721,
            0.283
          ],
          "content": [
            {
              "type": "text",
              "content": "Which of these – vanilla, onion and clove, can be used as olfactory indicators on the basis of your observations?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.098,
            0.283,
            0.721,
            0.315
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us do some more activities to understand the chemical properties of acids and bases.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.099,
            0.331,
            0.632,
            0.35
          ],
          "content": [
            {
              "type": "text",
              "content": "2.1.2 How do Acids and Bases React with Metals?"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.143,
            0.367,
            0.297,
            0.39
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 2.3"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.131,
            0.402,
            0.6,
            0.417
          ],
          "content": [
            {
              "type": "text",
              "content": "CAUTION: This activity needs the teacher’s assistance.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.131,
            0.418,
            0.487,
            0.433
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Set the apparatus as shown in Fig. 2.1.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.131,
            0.434,
            0.692,
            0.464
          ],
          "content": [
            {
              "type": "text",
              "content": "Take about 5 mL of dilute sulphuric acid in a test tube and add a few pieces of zinc granules to it.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.131,
            0.465,
            0.605,
            0.479
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "What do you observe on the surface of zinc granules?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.131,
            0.48,
            0.606,
            0.495
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Pass the gas being evolved through the soap solution.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.131,
            0.495,
            0.547,
            0.51
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Why are bubbles formed in the soap solution?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.131,
            0.51,
            0.551,
            0.525
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Take a burning candle near a gas filled bubble.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.131,
            0.526,
            0.34,
            0.539
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "What do you observe?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.131,
            0.54,
            0.69,
            0.571
          ],
          "content": [
            {
              "type": "text",
              "content": "Repeat this Activity with some more acids like HCl, HNO "
            },
            {
              "type": "text",
              "content": "and",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " CH COOH."
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.131,
            0.571,
            0.652,
            0.586
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Are the observations in all the cases the same or different?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
