              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": "ffected when a "
            },
            {
              "type": "text",
              "content": "solution of an acid is diluted?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
