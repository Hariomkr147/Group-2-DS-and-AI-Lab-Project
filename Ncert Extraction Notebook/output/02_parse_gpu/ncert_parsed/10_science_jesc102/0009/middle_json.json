              "content": "5.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " How is the concentration of hydronium ions "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { ( H _ { 3 } O ^ { + } ) }"
            },
            {
              "type": "text",
              "content": " "
            },
