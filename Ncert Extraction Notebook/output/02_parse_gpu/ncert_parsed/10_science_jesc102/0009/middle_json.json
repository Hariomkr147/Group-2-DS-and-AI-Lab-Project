        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.122,
            0.181,
            0.703,
            0.198
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Why does an aqueous solution of an acid conduct electricity?",
              "styles": [
