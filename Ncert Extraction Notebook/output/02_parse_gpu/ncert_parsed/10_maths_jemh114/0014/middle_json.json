            0.114,
            0.316,
            0.608,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "12.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A game of chance consists of spinning an arrow which comes to rest pointing at one of the numbers 1, 2, 3, 4, 5, 6, 7, 8 (see Fig. 14.5 ), and these are equally likely outcomes. What is the probability that it will point at (i) 8 ? (ii) an odd number? (iii) a number greater than 2? (iv) a number less than 9?"
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.681,
            0.362,
            0.826,
            0.468
          ],
          "content": [
