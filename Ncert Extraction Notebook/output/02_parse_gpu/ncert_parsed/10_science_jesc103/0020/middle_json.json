            0.87,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Which of the following methods is suitable for preventing an iron frying pan from rusting?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.151,
            0.42,
            0.355,
            0.44
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Applying grease",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.44,
            0.347,
            0.46
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Applying paint",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.152,
            0.46,
            0.439,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) Applying a coating of zinc",
              "styles": [
                "bold"
              ]
            }
          ]
