                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.12,
            0.5,
            0.871,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "3. An element reacts with oxygen to give a compound with a high melting point. This compound is also soluble in water. The element is likely to be",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.152,
            0.538,
            0.284,
            0.557
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) calcium",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.151,
            0.557,
            0.278,
            0.577
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) carbon",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.152,
            0.577,
            0.273,
            0.596
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) silicon",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.152,
            0.598,
            0.254,
            0.616
          ],
          "content": [
            {
              "type": "text",
              "content": "(d) iron.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.121,
            0.618,
            0.655,
            0.636
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Food cans are coated with tin and not with zinc because",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.151,
            0.638,
            0.414,
            0.656
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) zinc is costlier than tin.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.151,
            0.657,
            0.559,
            0.677
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) zinc has a higher melting point than tin.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.152,
            0.678,
            0.467,
            0.696
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) zinc is more reactive than tin.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.151,
            0.698,
            0.456,
            0.716
          ],
          "content": [
            {
              "type": "text",
              "content": "(d) zinc is less reactive than tin.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.121,
            0.717,
            0.707,
            0.735
          ],
          "content": [
            {
              "type": "text",
              "content": "5. You are given a hammer, a battery, a bulb, wires and a switch.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.151,
            0.737,
            0.87,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) How could you use them to distinguish between samples of metals and non-metals?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.149,
            0.772,
            0.869,
            0.807
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Assess the usefulness of these tests in distinguishing between metals and non-metals.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.12,
            0.808,
            0.777,
            0.828
          ],
          "content": [
            {
              "type": "text",
              "content": "6. What are amphoteric oxides? Give two examples of amphoteric oxides.",
