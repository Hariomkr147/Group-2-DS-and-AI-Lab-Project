          ],
          "content": [
            {
              "type": "text",
              "content": "Non-metals form negatively charged ions by gaining electrons when reacting with "
            },
            {
              "type": "text",
              "content": "metals.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.114,
            0.131,
            0.674,
            0.15
          ],
          "content": [
            {
              "type": "text",
              "content": "Non-metals form oxides which are either acidic or neutral."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.114,
            0.151,
            0.868,
            0.186
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Non-metals do not displace hydrogen from dilute acids. They react with hydrogen to form hydrides.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
