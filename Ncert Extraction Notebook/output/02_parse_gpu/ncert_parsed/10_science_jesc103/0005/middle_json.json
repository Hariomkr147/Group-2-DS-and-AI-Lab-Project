  "pages": [
    {
      "page_idx": 4,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.099,
            0.085,
            0.634,
            0.106
          ],
          "content": [
            {
              "type": "text",
              "content": "3.2.1 What happens when Metals are burnt in Air?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.098,
            0.114,
            0.723,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "You have seen in Activity 3.8 that magnesium burns in air with a dazzling white flame. Do all metals react in the same manner? Let us check by performing the following Activity.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.144,
            0.179,
            0.296,
            0.201
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 3.9"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.147,
            0.215,
            0.696,
            0.245
          ],
          "content": [
            {
              "type": "text",
              "content": "CAUTION: The following activity needs the teacher’s assistance. It would be better if students wear eye protection.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.124,
            0.246,
            0.697,
            0.277
          ],
          "content": [
            {
              "type": "text",
              "content": "Hold any of the samples taken above with a pair of tongs and try burning over a flame. Repeat with the other metal samples.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.126,
            0.276,
            0.399,
            0.29
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Collect the product if formed.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.125,
            0.291,
            0.576,
            0.306
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Let the products and the metal surface cool down.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.126,
            0.306,
            0.381,
            0.32
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Which metals burn easily?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.125,
            0.321,
            0.642,
            0.336
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "What flame colour did you observe when the metal burnt?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.125,
            0.336,
            0.578,
            0.351
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "How does the metal surface appear after burning?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "footer",
          "index": 10,
          "bbox": [
            0.448,
            0.971,
            0.552,
            0.985
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.125,
            0.352,
            0.697,
            0.381
          ],
          "content": [
            {
              "type": "text",
              "content": "Arrange the metals in the decreasing order of their reactivity towards oxygen.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.125,
            0.382,
            0.446,
            0.398
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Are the products soluble in water?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.129,
            0.42,
            0.664,
            0.437
          ],
          "content": [
            {
              "type": "text",
              "content": "Almost all metals combine with oxygen to form metal oxides.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.131,
            0.443,
            0.414,
            0.46
          ],
          "image_path": "images/page_4_equation_14.jpg",
          "content": "\\mathrm { M e t a l ~ + ~ O x y g e n \\rightarrow M e t a l ~ o x i d e }"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.099,
            0.467,
            0.721,
            0.5
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, when copper is heated in air, it combines with oxygen to form copper(II) oxide, a black oxide.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.129,
            0.506,
            0.401,
            0.54
          ],
          "image_path": "images/page_4_equation_16.jpg",
          "content": "\\begin{aligned} &2\\mathrm{Cu~+~O_{_2}~\\rightarrow~2CuO}\\\\ &\\mathrm{(Copper)} \\quad \\mathrm{(Copper(II)~oxi)}\\\\ \\end{aligned}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.099,
            0.546,
            0.506,
            0.563
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, aluminium forms aluminium oxide.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.13,
            0.57,
            0.36,
            0.587
          ],
          "image_path": "images/page_4_equation_18.jpg",
          "content": "4 \\mathrm { A l } \\qquad \\mathrm { ~ + ~ } \\; 3 \\mathrm { O } _ { 2 } \\rightarrow 2 \\mathrm { A l } _ { 2 } \\mathrm { O } _ { 3 }"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.131,
            0.588,
            0.234,
            0.603
          ],
          "content": [
            {
              "type": "text",
              "content": "(Aluminium)",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.098,
            0.61,
            0.723,
            0.707
          ],
          "content": [
            {
              "type": "text",
              "content": "Recall from Chapter 2, how copper oxide reacts with hydrochloric acid. We have learnt that metal oxides are basic in nature. But some metal oxides, such as aluminium oxide, zinc oxide show both acidic as well as basic behaviour. Such metal oxides which react with both acids as well as bases to produce salts and water are known as amphoteric oxides. Aluminium oxide reacts in the following manner with acids and bases –",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.13,
            0.71,
            0.25,
            0.729
          ],
          "image_path": "images/page_4_equation_21.jpg",
          "content": "\\mathrm{Al}_{2}\\mathrm{O}_{3}+6\\mathrm{HCl}"
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.309,
            0.708,
            0.471,
            0.729
          ],
          "image_path": "images/page_4_equation_22.jpg",
          "content": "\\mathrm{2AlCl_{3}^{-}~\\eta~+~3H_{2}O}"
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.131,
            0.733,
            0.27,
            0.753
          ],
          "image_path": "images/page_4_equation_23.jpg",
          "content": "\\mathrm{Al}_{2}\\mathrm{O}_{3}+2\\mathrm{NaOH}"
        },
        {
          "type": "equation",
          "index": 24,
          "bbox": [
            0.31,
            0.733,
            0.459,
            0.751
          ],
          "image_path": "images/page_4_equation_24.jpg",
          "content": "2NaAlO_{2}+H_{2}O"
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.311,
            0.751,
            0.384,
            0.766
          ],
          "content": [
            {
              "type": "text",
              "content": "(Sodium",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.311,
            0.767,
            0.401,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "aluminate)",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.098,
            0.789,
            0.723,
            0.839
          ],
          "content": [
            {
              "type": "text",
              "content": "Most metal oxides are insoluble in water but some of these dissolve in water to form alkalis. Sodium oxide and potassium oxide dissolve in water to produce alkalis as follows –",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 28,
          "bbox": [
            0.13,
            0.845,
            0.411,
            0.864
          ],
          "image_path": "images/page_4_equation_28.jpg",
          "content": "\\mathrm{Na_{2}O(s)~+~H_{2}O(l) \\rightarrow 2NaOH(aq)}"
        },
        {
          "type": "equation",
          "index": 29,
          "bbox": [
            0.131,
            0.868,
            0.399,
            0.888
          ],
          "image_path": "images/page_4_equation_29.jpg",
          "content": "\\mathrm{K_2O(s)} \\quad + \\mathrm{H_2O(l)} \\rightarrow \\mathrm{2KOH(aq)}"
        },
        {
          "type": "footer",
          "index": 30,
          "bbox": [
            0.1,
            0.916,
            0.27,
            0.93
          ],
          "content": [
            {
              "type": "text",
              "content": "Metals and Non-metals"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 31,
