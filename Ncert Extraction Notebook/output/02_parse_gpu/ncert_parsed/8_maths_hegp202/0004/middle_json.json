        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.111,
            0.367,
            0.805,
            0.414
          ],
          "content": [
            {
              "type": "text",
              "content": "Why is the smaller inside square half the area of the larger square? Again, adding some east-west and north-south lines can explain it:"
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.434,
            0.416,
            0.564,
            0.514
          ],
          "content": [
            {
              "type": "image_body",
              "index": 7,
              "bbox": [
                0.434,
                0.416,
                0.564,
                0.514
              ],
              "image_path": "images/page_3_image_7.jpg",
