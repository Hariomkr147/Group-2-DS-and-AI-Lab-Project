                0.841,
                0.288
              ],
              "image_path": "images/page_19_image_6.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 7,
              "bbox": [
                0.705,
                0.281,
                0.761,
                0.297
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 4.3"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.113,
            0.299,
            0.801,
            0.34
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What do you think are the different possible projections of a square that we get based on its orientation?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.353,
            0.802,
            0.392
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What do you think is the projection of a parallelogram under different orientations?"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.15,
            0.396,
            0.803,
            0.454
          ],
          "content": [
            {
              "type": "text",
              "content": "Can this ever be a quadrilateral that is not a parallelogram? As a starting point, you could think about the projection of a pair of parallel lines."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.114,
            0.463,
            0.812,
            0.526
          ],
          "content": [
            {
              "type": "text",
              "content": "? What can you say about the projection of an n-sided regular polygon? ["
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Projection of a polygon is composed of the projections of its sides.]"
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.818,
            0.456,
            0.904,
            0.518
          ],
          "content": [
