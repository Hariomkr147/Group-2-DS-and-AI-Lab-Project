          ],
          "content": "EXPLORING SOME GEOMETRIC THEMES"
        },
        {
          "type": "header",
          "bbox": [
            0.796,
            0.262,
            1.0,
            0.279
          ],
          "content": ""
        },
        {
          "type": "header",
