        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.164,
            0.861,
            0.847,
            0.918
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Picture your name, then read off the letters backwards. Make sure to do this by sight, not by sound — really see your name! Now try with your friend’s name."
            }
          ]
