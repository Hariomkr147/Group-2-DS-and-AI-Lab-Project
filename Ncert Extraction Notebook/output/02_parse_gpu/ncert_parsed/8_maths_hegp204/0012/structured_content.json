        {
          "type": "text",
          "bbox": [
            0.196,
            0.429,
            0.436,
            0.448
          ],
          "content": "(i) 5 cm, 3 cm, and 1 cm"
        },
        {
          "type": "text",
          "bbox": [
            0.192,
            0.453,
            0.436,
            0.473
          ],
          "content": "(ii) 6 cm, 3 cm, and 2 cm"
