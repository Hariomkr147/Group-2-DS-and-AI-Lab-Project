        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.15,
            0.823,
            0.848,
            0.9
          ],
          "content": [
            {
              "type": "text",
              "content": "Faces",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " are the plane/flat surfaces of a solid that form its boundary. "
            },
            {
              "type": "text",
              "content": "Edges",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " are the line segments that form the sides of the faces, and "
            },
            {
              "type": "text",
              "content": "vertices",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " are the points at which the edges meet. For example, a cuboid or cube has 6 faces, 12 edges and 8 vertices."
            }
          ]
        },
