          ],
          "content": [
            {
              "type": "text",
              "content": "？ Show that by joining the midpoints of an equilateral triangle, we divide it into 4 identical equilateral triangles."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.152,
            0.595,
            0.647,
            0.616
          ],
          "content": [
            {
              "type": "text",
              "content": "["
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Note that the corner triangles are isosceles.]"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.152,
            0.618,
            0.669,
            0.64
          ],
          "content": [
            {
              "type": "text",
              "content": "This fractal is called the "
            },
            {
              "type": "text",
              "content": "Sierpinski Triangle/Gasket",
              "styles": [
                "bold"
              ]
            },
            {
