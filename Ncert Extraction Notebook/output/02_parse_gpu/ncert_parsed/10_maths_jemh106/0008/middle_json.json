              "content": "80"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.782,
            0.104,
            0.899,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.095,
            0.147,
            0.902,
            0.204
          ],
          "content": [
            {
              "type": "text",
              "content": "Theorem 6.1 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If a line is drawn parallel to one side of a triangle to intersect the other two sides in distinct points, the other two sides are divided in the same ratio."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.096,
            0.211,
            0.593,
            0.269
          ],
          "content": [
            {
              "type": "text",
              "content": "Proof :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " We are given a triangle ABC in which a line parallel to side BC intersects other two sides AB and AC at D and E respectively (see Fig. 6.10)."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.097,
            0.282,
            0.432,
            0.323
          ],
          "content": [
            {
              "type": "text",
              "content": "We need to prove that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { \\mathrm { A D } } { \\mathrm { D B } }   =   \\frac { \\mathrm { A E } } { \\mathrm { E C } }"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.588,
            0.203,
            0.898,
            0.342
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.588,
                0.203,
                0.898,
                0.342
              ],
              "image_path": "images/page_7_image_5.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.332,
            0.592,
            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us join BE and CD and then draw "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { D M } \\bot \\mathrm { A C }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { E N } \\perp \\mathrm { A B }"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.693,
            0.349,
            0.792,
            0.367
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 6.10"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.384,
            0.658,
            0.426
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, area of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A D E } ( = { \\frac { 1 } { 2 } } \\mathrm { b a s e } \\times \\mathrm { h e i g h t } ) = { \\frac { 1 } { 2 } } \\mathrm { A D } \\times \\mathrm { E N } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.096,
            0.434,
            0.732,
            0.453
          ],
          "content": [
            {
              "type": "text",
              "content": "Recall from Class IX, that area of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { A D E }"
            },
            {
              "type": "text",
              "content": " is denoted as ar(ADE)."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.097,
            0.479,
            0.135,
            0.497
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "footer",
          "index": 11,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.276,
            0.466,
            0.523,
            0.507
          ],
          "image_path": "images/page_7_equation_12.jpg",
          "content": "\\mathrm{ar}(\\mathrm{ADE}) = \\frac{1}{2} \\mathrm{AD} \\times \\mathrm{EN}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.097,
            0.536,
            0.188,
            0.556
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.278,
            0.522,
            0.527,
            0.567
          ],
          "image_path": "images/page_7_equation_14.jpg",
          "content": "\\mathrm{ar}(\\mathrm{BDE}) = \\frac{1}{2} \\mathrm{DB} \\times \\mathrm{EN},"
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.275,
            0.578,
            0.826,
            0.622
          ],
          "image_path": "images/page_7_equation_15.jpg",
          "content": "\\mathrm{ar}(\\mathrm{ADE})=\\frac{1}{2}\\mathrm{AE}\\times\\mathrm{DM}\\ \\mathrm{and}\\ \\mathrm{ar}(\\mathrm{ DEC})=\\frac{1}{2}\\mathrm{EC}\\times\\mathrm{DM}."
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.098,
            0.671,
            0.205,
            0.69
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.265,
            0.643,
            0.897,
            0.719
          ],
          "image_path": "images/page_7_equation_17.jpg",
          "content": "\\frac{\\frac{1}{2}\\mathrm{AD} \\times \\mathrm{EN}}{\\frac{1}{2}\\mathrm{DB} \\times \\mathrm{EN}} = \\frac{\\frac{1}{2}\\mathrm{AD} \\times \\mathrm{EN}}{\\frac{1}{2}\\mathrm{DB} \\times \\mathrm{EN}} = \\frac{\\mathrm{AD}}{\\mathrm{DB}}\\tag{1}"
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.098,
            0.775,
            0.141,
            0.791
          ],
          "content": [
            {
              "type": "text",
              "content": "and"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.263,
            0.743,
            0.896,
            0.821
          ],
          "image_path": "images/page_7_equation_19.jpg",
          "content": "\\frac{\\mathrm{ar}(\\mathrm{ADE})}{\\mathrm{ar}(\\mathrm{DEC})}=\\frac{\\frac{1}{2}\\mathrm{AE}\\times\\mathrm{DM}}{\\frac{1}{2}\\mathrm{EC}\\times\\mathrm{DM}}=\\frac{\\mathrm{AE}}{\\mathrm{EC}}\\tag{2}"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.096,
            0.835,
            0.9,
            0.873
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta"
            },
            {
              "type": "text",
              "content": " BDE and DEC are on the same base DE and between the same parallels BC and DE."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.098,
            0.881,
            0.135,
            0.898
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.278,
            0.879,
            0.897,
            0.899
          ],
          "image_path": "images/page_7_equation_22.jpg",
          "content": "\\mathrm{ar}(\\mathrm{BDE}) = \\mathrm{ar}(\\mathrm{DEC})\\tag{3}"
        }
      ]
    }
  ],
