          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.139,
            0.595,
            0.197
          ],
          "content": [
            {
              "type": "text",
              "content": "Theorem 6.2 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If a line divides any two sides of a triangle in the same ratio, then the line is parallel to the third side."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.203,
            0.594,
            0.293
          ],
          "content": [
            {
              "type": "text",
              "content": "This theorem can be proved by taking a line DE such that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { \\mathrm { A D } } { \\mathrm { D B } }   =   \\frac { \\mathrm { A E } } { \\mathrm { E C } }"
            },
            {
              "type": "text",
              "content": " and assuming that DE is not parallel to BC (see Fig. 6.12)."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.095,
            0.298,
            0.594,
            0.338
          ],
          "content": [
            {
              "type": "text",
              "content": "If DE is not parallel to BC, draw a line DE parallel to BC."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.608,
            0.138,
            0.898,
            0.304
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.608,
                0.138,
                0.898,
                0.304
              ],
              "image_path": "images/page_9_image_6.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 7,
              "bbox": [
                0.703,
                0.313,
                0.802,
                0.333
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.12"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.096,
            0.363,
            0.135,
            0.382
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.323,
            0.346,
            0.572,
            0.392
          ],
          "image_path": "images/page_9_equation_9.jpg",
          "content": "\\left[ \\frac{ AD }{ DB } = \\frac{ AE '}{ E ' C } \\right.\\tag{Why ?}"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.098,
            0.42,
            0.205,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.326,
            0.405,
            0.45,
            0.45
          ],
          "image_path": "images/page_9_equation_11.jpg",
          "content": "\\left[ \\frac{ AE }{ EC } = \\frac{ AE '}{ EC } \\right."
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.096,
            0.457,
