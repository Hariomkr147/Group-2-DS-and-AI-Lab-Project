          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm { E ^ { \\prime } }"
            },
            {
              "type": "text",
              "content": " must coincide. (Why ?)"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.096,
            0.502,
            0.772,
            0.522
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us take some examples to illustrate the use of the above theorems."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.096,
            0.534,
            0.898,
            0.601
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 1 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If a line intersects sides AB and AC of a "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { A B C }"
            },
            {
              "type": "text",
              "content": " at D and E respectively and is parallel to BC, prove that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{ AD }{ AB } = \\frac{ AE }{ AC }"
            },
            {
              "type": "text",
              "content": " (see Fig. 6.13)."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.611,
            0.205,
            0.63
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.336,
            0.611,
            0.896,
            0.631
          ],
          "image_path": "images/page_9_equation_16.jpg",
          "content": "DE  \\parallel  BC\\tag{Given}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.098,
            0.657,
            0.134,
            0.675
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.099,
            0.643,
            0.446,
            0.727
          ],
          "image_path": "images/page_9_equation_18.jpg",
          "content": "\\frac{ AD }{ DB } = \\frac{ AE }{ EC }\\tag{or,}"
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.1,
            0.695,
            0.445,
            0.777
          ],
          "image_path": "images/page_9_equation_19.jpg",
          "content": "{ \\frac { \\mathrm { D B } } { \\mathrm { A D } } } = { \\frac { \\mathrm { E C } } { \\mathrm { A E } } }\\tag{or,}"
        },
        {
          "type": "equation",
