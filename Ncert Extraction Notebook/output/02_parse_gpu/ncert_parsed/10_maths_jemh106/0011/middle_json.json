            {
              "type": "text",
              "content": "Example 2 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " ABCD is a trapezium with AB || DC. E and F are points on non-parallel sides AD and BC respectively such that EF is parallel to AB"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.096,
            0.213,
            0.465,
            0.254
          ],
          "content": [
            {
              "type": "text",
              "content": "(see Fig. 6.14). Show that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { \\mathrm { A E } } { \\mathrm { E D } }   =   \\frac { \\mathrm { B F } } { \\mathrm { F C } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.263,
            0.593,
            0.302
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us join AC to intersect EF at G (see Fig. 6.15)."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.143,
            0.307,
            0.472,
            0.327
          ],
          "content": [
            {
              "type": "text",
              "content": "AB || DC and EF || AB (Given)"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.096,
            0.333,
            0.594,
            0.372
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { E F } \\parallel \\mathrm { D C }"
            },
            {
              "type": "text",
              "content": " (Lines parallel to the same line are parallel to each other)"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.097,
            0.377,
            0.26,
            0.396
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, in "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { A D C }"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.149,
            0.402,
            0.409,
            0.423
          ],
          "image_path": "images/page_10_equation_8.jpg",
          "content": "EG  \\parallel  DC  \\quad ( As EF  \\parallel  DC )"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.096,
            0.434,
            0.426,
            0.477
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { \\mathrm { A E } } { \\mathrm { E D } } }   =   { \\frac { \\mathrm { A G } } { \\mathrm { G C } } }"
            },
            {
              "type": "text",
              "content": " (Theorem 6.1)"
