            0.758,
            0.435
          ],
          "image_path": "images/page_16_equation_6.jpg",
          "content": "\\left[ \\frac{\\mathrm{DP}}{\\mathrm{PE}} = \\frac{\\mathrm{DQ}}{\\mathrm{QF}} \\quad  and   \\mathrm{PQ} \\parallel \\mathrm{EF} \\quad (\\mathrm{flow}?) \\right]"
        },
