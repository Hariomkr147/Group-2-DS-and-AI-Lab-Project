            0.609,
            0.521
          ],
          "image_path": "images/page_16_equation_10.jpg",
          "content": "\\left( \\frac{\\mathrm{DP}}{\\mathrm{DE}} = \\frac{\\mathrm{DQ}}{\\mathrm{DF}} = \\frac{\\mathrm{PQ}}{\\mathrm{EE}} \\right)"
        },
        {
          "type": "text",
