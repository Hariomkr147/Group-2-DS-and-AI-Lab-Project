            0.443,
            0.702,
            0.464
          ],
          "image_path": "images/page_16_equation_8.jpg",
          "content": "\\angle \\mathrm{P} = \\angle \\mathrm{E} \\quad  and  \\quad \\angle \\mathrm{Q} = \\angle \\mathrm{F}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
