              ],
              "image_path": "images/page_18_image_8.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 9,
              "bbox": [
                0.448,
                0.434,
                0.55,
                0.453
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.29"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.095,
            0.464,
            0.467,
            0.485
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { P Q } \\parallel \\mathrm { R S }"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.096,
            0.489,
            0.474,
            0.51
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{P} = \\angle \\mathrm{S}"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.718,
            0.49,
            0.898,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "(Alternate angles)"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.096,
            0.514,
            0.478,
            0.535
          ],
          "content": [
            {
              "type": "text",
              "content": "and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle Q = \\angle R"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.095,
            0.539,
            0.9,
            0.561
          ],
          "content": [
            {
              "type": "text",
              "content": "Also, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle POQ = \\angle SOR"
            },
            {
              "type": "text",
              "content": " (Vertically opposite angles)"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.096,
            0.564,
            0.504,
            0.585
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta  POQ  \\sim \\Delta  SOR"
            }
          ]
        },
        {
