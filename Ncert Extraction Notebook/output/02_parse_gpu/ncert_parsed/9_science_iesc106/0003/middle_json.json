          ],
          "content": [
            {
              "type": "text",
              "content": "Answer:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.224,
            0.687,
            0.784,
            0.705
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Net force "
            },
            {
              "type": "equation_inline",
              "content": "e = 10    N  + 6    N  = 16    N ,"
            },
            {
              "type": "text",
              "content": " acting towards the right side."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.224,
            0.706,
            0.775,
            0.723
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Net "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{force}=10\\mathrm{~N}-6\\mathrm{~N}=4\\mathrm{~N}"
            },
            {
              "type": "text",
              "content": " , acting towards the right side."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.224,
            0.724,
            0.76,
            0.741
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) Net force = 10 N – 6 N = 4 N, acting towards the left side."
            }
          ]
        },
