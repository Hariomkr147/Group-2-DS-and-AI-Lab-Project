          ],
          "content": [
            {
              "type": "text",
              "content": "If another friend, Sangmu, joins them and orders the same items, what will be the expression for the total amount to be paid?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.146,
