          "content": [
            {
              "type": "text",
              "content": "？ "
            },
            {
              "type": "text",
              "content": "Does adding the terms of an expression in any order give the same value? Take some more expressions and check. Consider expressions with more than 3 terms also.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.616,
            0.882,
            0.654
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Yes, adding the terms of an expression in any order gives the same value Consider an expression with 3 terms"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.163,
            0.683,
            0.492,
            0.72
          ],
          "content": [
            {
              "type": "text",
              "content": "Order 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " 9 + 4 + 6 = (9 + 4) + 6 = 13 + 6 = 19"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.163,
            0.732,
            0.491,
            0.769
          ],
          "content": [
            {
              "type": "text",
              "content": "Order 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " 9 + 4 + 6 = 9 + (4 + 6) = 9 + 10 = 19"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.163,
            0.78,
            0.732,
            0.818
          ],
          "content": [
            {
              "type": "text",
              "content": "An expression with 4 terms (including a negative number) Consider the expression: 15 + (– 8) + 5 + 12"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.163,
            0.828,
            0.696,
            0.847
          ],
          "content": [
            {
              "type": "text",
              "content": "Order 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (15 + (– 8)) + 5 + 12 = (7 + 5) + 12 = 12 + 12 = 24"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.164,
            0.858,
            0.423,
            0.895
          ],
          "content": [
            {
              "type": "text",
              "content": "Order 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " 15 + 5 + 12 + (– 8) = (15 + 5 + 12) + (– 8)"
            }
