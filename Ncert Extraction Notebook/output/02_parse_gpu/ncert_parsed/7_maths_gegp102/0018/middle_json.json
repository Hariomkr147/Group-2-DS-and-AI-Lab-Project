            {
              "type": "text",
              "content": "Arithmetic Expressions"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.109,
            0.085,
            0.652,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 17:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Given "
            },
            {
              "type": "equation_inline",
              "content": "53 \\times 18 = 954."
            },
            {
              "type": "text",
              "content": " Find out "
            },
            {
              "type": "equation_inline",
              "content": "6 3 \\times 1 8 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.148,
            0.112,
            0.45,
            0.131
          ],
          "content": [
            {
              "type": "text",
              "content": "As 63 × 18 means 63 times 18,"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.149,
            0.131,
            0.406,
            0.204
          ],
          "content": [
            {
              "type": "text",
              "content": "63 × 18 = (53 + 10) × 18 = 53 ×18 + 10×18 = 954 + 180 = 1134."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.109,
            0.213,
            0.715,
            0.236
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 18:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find an effective way of evaluating "
            },
            {
              "type": "equation_inline",
              "content": "9 7 \\times 2 5"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.149,
            0.239,
            0.42,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "97 × 25 means 97 times 25."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.173,
            0.258,
            0.493,
            0.276
          ],
          "content": [
            {
              "type": "text",
              "content": "We can write it as "
            },
            {
              "type": "equation_inline",
              "content": "( 1 0 0 - 3 ) \\times 2 5"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.149,
            0.276,
            0.849,
            0.313
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that this is the same as the difference of 100 times 25 and 3 times 25:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.369,
            0.318,
            0.629,
            0.338
          ],
          "image_path": "images/page_17_equation_8.jpg",
          "content": "9 7 \\times 2 5 = 1 0 0 \\times 2 5 - 3 \\times 2 5"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.174,
            0.343,
            0.335,
            0.362
          ],
          "content": [
            {
              "type": "text",
              "content": "Find this value."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.109,
            0.37,
            0.621,
            0.394
          ],
          "content": [
            {
              "type": "text",
              "content": "Use this method to find the following products:"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.182,
            0.408,
            0.296,
            0.427
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) "
            },
            {
              "type": "equation_inline",
              "content": "9 5 \\times 8"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.182,
            0.431,
            0.318,
            0.452
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) "
            },
            {
              "type": "equation_inline",
              "content": "1 0 4 \\times 1 5"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.182,
            0.456,
            0.307,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) "
            },
            {
              "type": "equation_inline",
              "content": "4 9 \\times 5 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.173,
            0.486,
            0.848,
            0.507
          ],
          "content": [
            {
              "type": "text",
              "content": "Is this quicker than the multiplication procedure you use generally?"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.109,
            0.514,
            0.783,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "? Which other products might be quicker to find like the ones above?"
            }
          ]
        },
