          "bbox": [
            0.175,
            0.332,
            0.35,
            0.365
          ],
          "content": "Is –15 one more or one less than –16?"
        },
        {
          "type": "image",
          "bbox": [
            0.397,
            0.286,
            0.598,
            0.329
          ],
          "content": "",
          "captions": [],
