          ],
          "content": [
            {
              "type": "text",
              "content": "1. Fill in the blanks with numbers, and boxes with operation signs such that the expressions on both sides are equal."
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.206,
            0.459,
