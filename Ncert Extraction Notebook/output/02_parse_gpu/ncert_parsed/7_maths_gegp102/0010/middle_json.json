            },
            {
              "type": "text",
              "content": "Example 10:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Kannan has to pay ₹432 to a shopkeeper using coins of ₹1 and ₹5, and notes of ₹10, ₹20, ₹50 and ₹100. How can he do it?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.174,
            0.456,
            0.658,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "There is more than one possibility. For example,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.318,
            0.48,
            0.679,
            0.499
          ],
          "image_path": "images/page_9_equation_8.jpg",
          "content": "432=4\\times100+1\\times20+1\\times10+2\\times1"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.503,
            0.845,
            0.548
          ],
          "content": [
            {
              "type": "text",
              "content": "Meaning: 4 notes of ₹100, 1 note of ₹20, 1 note of ₹10 and 2 notes of ₹1 432 = 8 × 50 + 1 × 10 + 4 × 5 + 2 × 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.15,
            0.552,
            0.832,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "Meaning: 8 notes of ₹50, 1 note of ₹10, 4 notes of ₹5 and 2 notes of ₹1"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.109,
            0.58,
            0.633,
            0.604
          ],
          "content": [
            {
              "type": "text",
              "content": "Identify the terms in the two expressions above."
            }
          ]
        },
        {
