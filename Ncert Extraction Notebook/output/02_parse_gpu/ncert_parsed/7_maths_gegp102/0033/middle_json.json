              "content": "(b) Yes"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.157,
            0.086,
            0.883,
            0.144
          ],
          "content": [
            {
              "type": "text",
              "content": "6. Using only reasoning of how terms change their values, fill the blanks to make the expressions on either side of the equality (=) equal.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.187,
            0.154,
            0.51,
            0.173
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) 423 + = 419 +"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.189,
            0.177,
            0.458,
            0.196
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) 207 – 68 = 210 –"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.164,
            0.215,
            0.216,
            0.23
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.188,
            0.233,
            0.666,
            0.251
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) 423 + 419 = 419 + 423 (Commutative Property)"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.188,
            0.252,
            0.865,
            0.291
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) 207 – 68 = 207 + 3 – 3 – 68 = 207 + 3 – (3 + 68) = 210 – 71 (Associative Property)"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.157,
            0.305,
            0.883,
            0.363
          ],
          "content": [
            {
              "type": "text",
              "content": "7. Using the numbers 2, 3, and 5, and the operators ‘+’ and ‘ – ‘, and brackets, as necessary, generate expressions to give as many different values as possible.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.187,
            0.373,
            0.619,
            0.392
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, 2 – 3 + 5 = 4 and 3 – (5 – 2) = 0",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.164,
            0.407,
            0.49,
            0.426
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Some of the expressions are"
            }
          ]
        },
        {
          "type": "code",
          "index": 10,
          "bbox": [
            0.198,
            0.428,
            0.44,
            0.543
          ],
          "content": [
            {
              "type": "code_body",
              "index": 10,
              "bbox": [
                0.198,
                0.428,
                0.44,
                0.543
              ],
              "content": "1. 3 – 2 – 5 = – 4\n2. 5 + 2 + 3 = 10\n3. 5 + 2 – 3 = 4\n4. 2 – (3 + 5) = – 6\nForm more expressions."
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.157,
            0.558,
            0.882,
            0.596
          ],
          "content": [
            {
              "type": "text",
              "content": "8. Whenever Jasoda has to subtract 9 from a number, she subtracts 10 and adds 1 to it.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.187,
            0.598,
            0.469,
            0.617
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, 36 – 9 = 26 + 1",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.187,
            0.627,
            0.794,
            0.646
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Do you think she always gets the correct answer? Why?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.187,
            0.649,
            0.873,
            0.669
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Can you think of other similar strategies? Give some examples.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.166,
            0.673,
            0.216,
            0.688
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.201,
            0.694,
            0.271,
            0.711
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Yes"
            }
          ]
        },
        {
          "type": "code",
          "index": 17,
          "bbox": [
            0.236,
            0.716,
            0.628,
            0.734
          ],
          "content": [
            {
              "type": "code_body",
              "index": 17,
              "bbox": [
                0.236,
                0.716,
                0.628,
                0.734
              ],
              "content": "36 – 9 = 36 – (10 – 1) = 36 – 10 + 1 = 26 + 1"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.235,
            0.761,
            0.785,
            0.779
          ],
          "content": [
            {
              "type": "text",
              "content": "To subtract 8: Subtract 10 and add 2 (since – 8 = – 10 + 2)."
            }
          ]
        },
        {
          "type": "code",
          "index": 19,
          "bbox": [
            0.236,
            0.783,
            0.589,
            0.801
          ],
          "content": [
            {
              "type": "code_body",
              "index": 19,
              "bbox": [
                0.236,
                0.783,
                0.589,
                0.801
              ],
              "content": "Ex: 55 – 8 = 55 – (10 – 2) = 55 – 10 + 2"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.235,
            0.805,
            0.619,
            0.825
          ],
          "content": [
            {
              "type": "text",
              "content": "More such strategies can be thought of."
            }
          ]
        },
