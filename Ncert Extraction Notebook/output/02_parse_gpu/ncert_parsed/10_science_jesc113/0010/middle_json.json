          ],
          "content": [
            {
              "type": "text",
              "content": "(d) Grass, fish and goat",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.144,
