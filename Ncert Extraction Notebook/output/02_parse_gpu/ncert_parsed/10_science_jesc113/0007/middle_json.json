        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.098,
            0.691,
            0.753,
            0.722
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Give any two ways in which non-biodegradable substances would affect the environment.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.275,
            0.758,
            0.901,
            0.837
          ],
          "content": [
            {
              "type": "text",
              "content": "Visit any town or city, and we are sure to find heaps of garbage all over the place. Visit any place of tourist interest and we are sure to find the place littered with empty food wrappers. In the earlier classes we have talked about this problem of dealing with the garbage that we generate. Let us now look at the problem a bit more deeply.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
