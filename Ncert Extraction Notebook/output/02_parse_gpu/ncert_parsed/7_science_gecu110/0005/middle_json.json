            0.127,
            0.079,
            0.547,
            0.1
          ],
          "content": [
            {
              "type": "text",
              "content": "Take out the leaf and place it on a plate."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.127,
            0.104,
            0.744,
            0.16
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, put a few drops of diluted iodine solution with the help of a dropper on the decolourised leaf (Fig. 10.2b). Wait for a few minutes and observe."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.127,
            0.16,
            0.743,
            0.199
          ],
          "content": [
            {
              "type": "text",
              "content": "If the colour of the leaf changes to blue-black, it indicates the presence of starch."
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.073,
            0.199,
            0.113,
            0.226
          ],
