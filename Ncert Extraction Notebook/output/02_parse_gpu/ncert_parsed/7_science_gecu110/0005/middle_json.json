              "content": "EEPER",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.684,
            0.246,
            0.892,
            0.385
          ],
          "content": [
            {
              "type": "image_body",
              "index": 9,
              "bbox": [
                0.684,
