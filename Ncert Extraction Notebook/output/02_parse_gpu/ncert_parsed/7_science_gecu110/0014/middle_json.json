              "content": "<table><tbody><tr><td>S.No.</td><td>Feature Photosynthesis Respiration</td></tr><tr><td>1.</td><td>Raw materials</td></tr><tr><td>2.</td><td>Products</td></tr><tr><td>3.</td><td>Word equation</td></tr><tr><td>4.</td><td>Importance</td></tr></tbody></table>"
