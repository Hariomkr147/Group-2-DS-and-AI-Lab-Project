            0.103
          ],
          "content": [
            {
              "type": "text",
              "content": "Place the set-up in sunlight for a few hours."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.267,
            0.107,
            0.882,
            0.146
          ],
          "content": [
            {
              "type": "text",
              "content": "Observe and record the availability of water, sunlight, chlorophyll, and carbon dioxide in Table 10.3."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.267,
            0.15,
            0.883,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "Remove the leaf and test it for starch using the iodine test, as was done in Activity 10.2."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.267,
            0.192,
            0.685,
            0.212
          ],
          "content": [
            {
              "type": "text",
              "content": "Record your observations in Table 10.3."
            }
          ]
        },
        {
          "type": "table",
          "index": 6,
          "bbox": [
            0.12,
            0.248,
            0.879,
            0.466
          ],
          "content": [
            {
              "type": "table_caption",
