        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.115,
            0.85,
            0.744,
            0.891
          ],
          "content": [
            {
              "type": "text",
              "content": "Based on Barkha didi’s experiment, we can conclude that oxygen is released during photosynthesis."
            }
          ]
