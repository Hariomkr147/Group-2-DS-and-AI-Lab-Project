                {
                  "type": "text",
                  "content": "Fig. 5.14: Linear motion"
                }
              ]
            }
          ]
        },
        {
          "type": "page_number",
          "index": 2,
          "bbox": [
            0.088,
            0.899,
            0.115,
            0.915
          ],
          "content": [
            {
              "type": "text",
              "content": "92"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.254,
            0.084,
            0.883,
            0.146
          ],
          "content": [
            {
              "type": "text",
              "content": "When an object moves along a straight line, its motion is called "
            },
            {
              "type": "text",
              "content": "linear motion",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". "
            },
            {
              "type": "text",
              "content": "Identify",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " such linear motion in your surroundings."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.254,
            0.559,
            0.883,
            0.623
          ],
          "content": [
            {
              "type": "text",
              "content": "But do things always move along a straight line? You might have enjoyed playing on swings and merry-go-rounds. Are these types of motion also linear motion?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.255,
            0.637,
            0.586,
            0.659
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 5.4: Let us investigate"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.257,
            0.67,
            0.821,
            0.691
          ],
          "content": [
            {
              "type": "text",
              "content": " Tie an eraser (or a potato) to one end of a thread."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.257,
            0.695,
            0.883,
            0.737
          ],
          "content": [
            {
              "type": "text",
              "content": " Hold the other end of the thread with your hand and whirl it (Fig. 5.15)."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.257,
            0.743,
            0.509,
            0.763
          ],
          "content": [
            {
              "type": "text",
              "content": "Observe its motion."
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.208,
            0.768,
            0.251,
            0.81
          ],
          "content": [
            {
              "type": "image_body",
              "index": 10,
              "bbox": [
                0.208,
                0.768,
                0.251,
                0.81
              ],
              "image_path": "images/page_13_image_10.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.254,
            0.768,
            0.882,
            0.809
          ],
          "content": [
            {
              "type": "text",
              "content": "Is the motion of the eraser the same as that of a merry-goround?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.255,
            0.815,
            0.883,
            0.857
          ],
          "content": [
            {
              "type": "text",
              "content": "When an object moves along a circular path, its motion is called "
            },
            {
              "type": "text",
              "content": "circular motion.",
              "styles": [
                "bold"
              ]
            }
          ]
