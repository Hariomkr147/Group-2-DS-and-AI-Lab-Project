            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "Padma: “We will need a longer measuring tape. Let us take it from the sports room.” (Fig. 5.10)"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
