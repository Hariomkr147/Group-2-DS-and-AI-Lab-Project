          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.257,
            0.756,
            0.882,
            0.799
          ],
          "content": [
            {
              "type": "text",
              "content": "Look at the picture of a children’s park (Fig. 5.18) or visit a children’s park."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.257,
            0.803,
            0.883,
            0.845
          ],
          "content": [
            {
              "type": "text",
              "content": " Observe different kinds of motions. "
            },
            {
              "type": "text",
              "content": "Classify",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " them as linear, circular or oscillatory motion."
            }
          ]
        },
        {
          "type": "text",
