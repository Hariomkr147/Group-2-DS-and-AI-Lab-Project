            0.064
          ],
          "content": [
            {
              "type": "text",
              "content": "Working with Fractions"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.151,
            0.088,
            0.847,
            0.127
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us look at this red square. The area of the triangle inside it (coloured yellow) is half the area of the red square. So,"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.151,
            0.137,
            0.689,
            0.173
          ],
          "content": [
            {
              "type": "text",
              "content": "the area of the yellow triangle "
            },
            {
              "type": "equation_inline",
              "content": "= { \\frac { 1 } { 2 } } \\times { \\frac { 1 } { 4 } } = { \\frac { 1 } { 8 } }"
            },
            {
              "type": "text",
              "content": " square units."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.151,
            0.176,
            0.625,
            0.196
          ],
          "content": [
            {
              "type": "text",
              "content": "What fraction of this yellow triangle is shaded?"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.15,
            0.2,
            0.691,
            0.254
          ],
          "content": [
            {
              "type": "text",
              "content": "The shaded region occupies "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " of the area of the yellow triangle. Are you able to see why?"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.693,
            0.167,
            0.848,
            0.284
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.693,
                0.167,
                0.848,
                0.284
              ],
              "image_path": "images/page_20_image_5.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.151,
            0.263,
            0.639,
            0.3
          ],
          "content": [
            {
              "type": "text",
              "content": "The area of shaded part "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{4} \\times \\frac{1}{8} = \\frac{3}{32}"
            },
            {
              "type": "text",
              "content": " square units."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.15,
            0.305,
            0.828,
            0.342
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, the shaded region occupies "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 3 2 }"
            },
            {
              "type": "text",
              "content": " of the area of the whole square."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.11,
            0.352,
            0.846,
            0.393
          ],
          "content": [
            {
              "type": "text",
              "content": "？ In each of the figures given below, find the fraction of the big square that the shaded region occupies."
            }
          ]
        },
        {
