          ],
          "content": [
            {
              "type": "text",
              "content": "Working with Fractions"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.15,
            0.088,
            0.846,
            0.126
          ],
          "content": [
            {
              "type": "text",
              "content": "We can use this technique of converting division into multiplication problems to divide fractions."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.175,
            0.129,
            0.322,
            0.162
          ],
          "content": [
            {
              "type": "text",
              "content": "What is "
            },
            {
              "type": "equation_inline",
              "content": "1 \\div \\frac { 2 } { 3 } ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.175,
            0.164,
            0.64,
            0.184
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us rewrite this as a multiplication problem"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.455,
            0.197,
            0.542,
            0.232
          ],
          "image_path": "images/page_14_equation_4.jpg",
          "content": "\\frac { 2 } { 3 } \\times ? = 1"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.175,
            0.238,
            0.698,
            0.27
          ],
          "content": [
            {
              "type": "text",
              "content": "What should be multiplied by "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{3}"
            },
            {
              "type": "text",
              "content": " to get the product 1?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.175,
            0.272,
            0.775,
            0.293
          ],
          "content": [
            {
              "type": "text",
              "content": "If we somehow cancel out the 2 and the 3, we are left with 1."
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.445,
            0.311,
            0.534,
            0.383
          ],
          "content": [
            {
              "type": "image_body",
              "index": 7,
              "bbox": [
                0.445,
                0.311,
                0.534,
                0.383
              ],
              "image_path": "images/page_14_image_7.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.175,
            0.402,
            0.211,
            0.421
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.466,
            0.422,
            0.557,
            0.458
          ],
          "image_path": "images/page_14_equation_9.jpg",
          "content": "1 \\div \\frac{2}{3} = \\frac{3}{2}."
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.175,
            0.46,
            0.455,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us try another problem:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.483,
            0.481,
            0.539,
            0.516
          ],
          "image_path": "images/page_14_equation_11.jpg",
          "content": "3 \\div \\frac{2}{3}."
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.175,
            0.518,
            0.367,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "This is the same as"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.454,
            0.549,
            0.543,
            0.584
          ],
          "image_path": "images/page_14_equation_13.jpg",
          "content": "\\frac{2}{3} \\times 2 = 3."
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.175,
            0.58,
            0.433,
            0.6
          ],
          "content": [
            {
              "type": "text",
              "content": "Can you find the answer?"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.151,
            0.606,
            0.847,
            0.656
          ],
          "content": [
            {
              "type": "text",
              "content": "We know what to multiply "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{3}"
            },
            {
              "type": "text",
              "content": " by to get 1. We just need to multiply that by 3 to get 3. So,"
            }
          ]
        },
        {
          "type": "image",
          "index": 16,
          "bbox": [
            0.433,
            0.654,
            0.562,
            0.724
          ],
          "content": [
            {
              "type": "image_body",
              "index": 16,
              "bbox": [
                0.433,
                0.654,
                0.562,
                0.724
              ],
              "image_path": "images/page_14_image_16.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.176,
            0.74,
            0.211,
            0.759
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "footer",
          "index": 18,
          "bbox": [
            0.449,
            0.97,
            0.551,
            0.985
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.419,
            0.77,
            0.579,
            0.807
          ],
          "image_path": "images/page_14_equation_19.jpg",
          "content": "3 \\div \\frac{2}{3} = \\frac{3}{2} \\times 3 = \\frac{9}{2}."
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.422,
            0.815,
            0.577,
            0.85
          ],
          "content": [
            {
              "type": "text",
              "content": "What is 1 1 ? 5 2"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.175,
            0.852,
            0.669,
            0.873
          ],
          "content": [
            {
              "type": "text",
              "content": "Rewriting it as a multiplication problem, we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.453,
            0.884,
            0.545,
            0.919
          ],
          "image_path": "images/page_14_equation_22.jpg",
          "content": "{ \\frac { 1 } { 2 } } \\times ? = { \\frac { 1 } { 5 } } ."
        },
        {
          "type": "page_number",
          "index": 23,
          "bbox": [
