            0.596,
            0.489
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, what is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{4} \\times \\frac{1}{2} ;"
            },
            {
              "type": "text",
              "content": " That is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{8}"
            },
            {
              "type": "text",
              "content": " too."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.15,
            0.545,
            0.848,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "In general, note that the area of a rectangle remains the same even if the length and breadth are interchanged."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.174,
            0.582,
            0.672,
            0.603
          ],
          "content": [
            {
              "type": "text",
              "content": "The order of multiplication does not matter. Thus,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.432,
            0.616,
            0.563,
            0.652
          ],
          "image_path": "images/page_13_equation_8.jpg",
          "content": "\\frac{a}{b} \\times \\frac{c}{d} = \\frac{c}{d} \\times \\frac{a}{b}."
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.663,
            0.848,
            0.701
          ],
          "content": [
            {
              "type": "text",
              "content": "This can also be seen from Brahmagupta’s formula for multiplying fractions."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.151,
            0.725,
            0.495,
            0.749
          ],
          "content": [
            {
              "type": "text",
              "content": "8.2 Division of Fractions"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.15,
            0.758,
            0.537,
            0.815
          ],
          "content": [
            {
              "type": "text",
              "content": "What is "
            },
            {
              "type": "equation_inline",
              "content": "12 \\div 4?"
            },
            {
              "type": "text",
              "content": " You know this already. But can this problem be restated as a multiplication problem?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.814,
            0.536,
            0.853
          ],
          "content": [
            {
              "type": "text",
              "content": "What should be multiplied by 4 to get 12? That is,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.294,
            0.862,
            0.393,
            0.881
          ],
          "image_path": "images/page_13_equation_13.jpg",
          "content": "4 \\times ? = 1 2"
