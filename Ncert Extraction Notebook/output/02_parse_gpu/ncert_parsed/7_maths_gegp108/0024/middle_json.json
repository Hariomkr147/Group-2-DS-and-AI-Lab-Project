            0.847,
            0.634
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Maria bought 8 m of lace to decorate the bags she made for school. She used "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{4}"
            },
            {
              "type": "text",
              "content": " m for each bag and finished the lace. How many bags did she decorate? (i) "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{array}{c}8 \\times \\frac{1}{4} \\\\8 \\div \\frac{1}{4}\\end{array}"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 8 } \\times \\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " (iii) (iv) "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 1 } { 4 } } \\div 8"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.208,
            0.637,
            0.847,
            0.764
          ],
          "content": [
            {
              "type": "text",
