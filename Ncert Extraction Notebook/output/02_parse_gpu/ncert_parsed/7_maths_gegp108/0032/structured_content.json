            0.136
          ],
          "content": "**5. Multiply and then convert it into a mixed fraction:**"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.148,
            0.262,
            0.18
          ],
          "content": "(a) $7 \\times \\frac { 3 } { 5 }$"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.187,
            0.37,
            0.223
          ],
          "content": "**Ans:** $7 \\times \\frac{3}{5} = \\frac{21}{5} = 4\\frac{1}{5}$"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.239,
            0.252,
            0.27
          ],
          "content": "(b) $4 \\times { \\frac { 1 } { 3 } }$"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.27,
            0.351,
            0.303
          ],
          "content": "**Ans:** 4 $\\times \\frac{1}{3} = \\frac{4}{3} = 1\\frac{1}{3}$"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.318,
            0.245,
            0.349
          ],
          "content": "(c) $\\frac { 9 } { 7 } \\times 6$"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.349,
            0.358,
            0.381
          ],
          "content": "9 54 5 Ans: × 6 = = 7 7 7 7"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.397,
            0.261,
            0.428
          ],
          "content": "**(d)** $\\frac { \\mathbf { 1 3 } } { \\mathbf { 1 1 } } \\times \\mathbf { 6 }$"
        },
        {
          "type": "equation",
          "bbox": [
