            0.063
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Prakash | Grade 7"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.175,
            0.089,
            0.74,
            0.145
          ],
          "content": [
            {
              "type": "text",
              "content": "Now we divide this "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " into 2 equal parts. What do we get? What fraction of the whole is shaded?"
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.101,
            0.147,
            0.325,
            0.276
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.101,
                0.147,
                0.325,
                0.276
              ],
              "image_path": "images/page_5_image_2.jpg",
              "content": ""
            },
            {
              "type": "image_footnote",
              "index": 4,
              "bbox": [
                0.12,
                0.28,
                0.331,
                0.306
              ],
              "content": [
                {
                  "type": "equation_inline",
                  "content": "\\frac { 1 } { 4 }"
                },
                {
                  "type": "text",
                  "content": " divided into 2 equal parts"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.375,
            0.152,
            0.848,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "Since the whole is divided into 8 equal parts and one of the parts is shaded, we can say that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 8 }"
            },
            {
              "type": "text",
              "content": " of the whole is shaded. So, the distance covered by the tortoise in half an hour is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 8 }"
            },
            {
              "type": "text",
              "content": " km."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.4,
            0.27,
            0.661,
            0.306
          ],
          "content": [
            {
              "type": "text",
              "content": "This tells us that "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 1 } { 2 } } \\times { \\frac { 1 } { 4 } } = { \\frac { 1 } { 8 } } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.111,
            0.312,
            0.848,
            0.373
          ],
          "content": [
            {
              "type": "text",
              "content": "? If the tortoise walks faster and it can cover "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{5}"
            },
            {
              "type": "text",
              "content": " km in 1 hour, how far will it walk in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.388,
            0.4,
            0.424
          ],
          "content": [
            {
              "type": "text",
              "content": "Distance covered "
            },
            {
              "type": "equation_inline",
              "content": "= { \\frac { 3 } { 4 } } \\times { \\frac { 2 } { 5 } } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.151,
            0.436,
            0.373,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "Finding the product:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.471,
            0.667,
            0.504
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) First find the distance covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.506,
            0.847,
            0.558
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Multiply the result by 3, to get the distance covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.151,
            0.567,
            0.602,
            0.645
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Distance in km covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour = The quantity we get by dividing "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{5}"
            },
            {
              "type": "text",
              "content": " into 4 equal parts."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.652,
            0.604,
            0.735
          ],
          "content": [
            {
              "type": "text",
              "content": "Taking the unit square as the whole, the shaded part (in Fig. 8.1) is a region we get when we divide "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{5}"
            },
            {
              "type": "text",
              "content": " into 4 equal parts."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.644,
            0.589,
            0.851,
            0.75
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
              "bbox": [
                0.644,
                0.589,
                0.851,
                0.75
              ],
              "image_path": "images/page_5_image_13.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.174,
            0.739,
            0.481,
            0.82
          ],
          "content": [
            {
              "type": "text",
              "content": "How much of the whole is it? The whole is divided into 5 rows and 4 columns, creating "
            },
            {
              "type": "equation_inline",
              "content": "5 \\times 4 = 2 0"
            },
            {
              "type": "text",
              "content": " equal parts."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.695,
            0.757,
            0.756,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 8.1"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.175,
            0.823,
            0.515,
            0.843
          ],
          "content": [
            {
              "type": "text",
              "content": "Number of these parts shaded = 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.175,
            0.845,
            0.624,
            0.881
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the distance covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour "
            },
            {
              "type": "equation_inline",
              "content": "c = { \\frac { 2 } { 2 0 } }"
            }
          ]
        },
