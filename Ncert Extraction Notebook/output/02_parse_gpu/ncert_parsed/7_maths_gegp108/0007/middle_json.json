            0.064
          ],
          "content": [
            {
              "type": "text",
              "content": "Working with Fractions"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.151,
            0.089,
            0.584,
            0.233
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Now, we need to multiply "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " by 3. Distance covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " of an hour "
            },
            {
              "type": "equation_inline",
              "content": "= 3 \\times { \\frac { 2 } { 2 0 } }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "= { \\frac { 6 } { 2 0 } }"
            },
            {
              "type": "text",
              "content": " So, "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{4} \\times \\frac{2}{5} = \\frac{6}{20} = \\frac{3}{10}."
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.647,
            0.084,
            0.824,
            0.215
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.647,
                0.084,
                0.824,
                0.215
              ],
              "image_path": "images/page_6_image_2.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
            0.151,
            0.252,
            0.288,
            0.272
          ],
          "content": [
            {
              "type": "text",
              "content": "Discussion"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.15,
            0.283,
            0.542,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "In the case of a fraction multiplied by another fraction, we follow a method similar to the one we used, when we multiplied a fraction by a whole number. We multiplied as follows:"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.568,
            0.299,
            0.648,
            0.316
          ],
          "content": [
            {
              "type": "text",
              "content": "Multiplier"
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.551,
            0.284,
            0.848,
            0.356
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.551,
                0.284,
                0.848,
                0.356
              ],
              "image_path": "images/page_6_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.729,
            0.298,
            0.828,
            0.316
          ],
          "content": [
            {
              "type": "text",
              "content": "Multiplicand"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.241,
            0.388,
            0.755,
            0.481
          ],
          "content": [
            {
              "type": "text",
              "content": "4 "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 } { 5 } \\div 4 = \\frac { 2 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " Divide the multiplicand by 4. 34 "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{3} \\times \\frac{2}{20} = \\frac{6}{20} ="
            },
            {
              "type": "text",
              "content": " Divide the multiplicand by 3."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.11,
            0.507,
            0.556,
            0.541
          ],
          "content": [
            {
              "type": "text",
              "content": "Using this understanding, multiply "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 5 } { 4 } } \\times { \\frac { 3 } { 2 } } ."
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.817,
            0.494,
            0.903,
            0.547
          ],
          "content": [
            {
              "type": "image_body",
              "index": 10,
              "bbox": [
                0.817,
                0.494,
                0.903,
                0.547
              ],
              "image_path": "images/page_6_image_10.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.15,
            0.547,
            0.655,
            0.63
          ],
          "content": [
            {
              "type": "text",
              "content": "First, let us represent "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{2},"
            },
            {
              "type": "text",
              "content": " taking the unit square as the whole. Since, the fraction "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 2 }"
            },
            {
              "type": "text",
              "content": " is one whole and a half, it can be seen as follows:"
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.666,
            0.571,
            0.846,
            0.732
          ],
          "content": [
            {
              "type": "image_body",
              "index": 12,
              "bbox": [
                0.666,
                0.571,
                0.846,
                0.732
              ],
              "image_path": "images/page_6_image_12.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.15,
            0.648,
            0.655,
            0.789
          ],
          "content": [
            {
              "type": "text",
              "content": "Following the steps of multiplication, we need to first divide this fraction "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{2}"
            },
            {
              "type": "text",
              "content": " into 4 equal parts. It can be done as shown in the Fig. 8.2 with the yellow shaded region representing the fraction obtained by dividing "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 2 }"
            },
            {
              "type": "text",
              "content": " into 4 equal parts. What is its value?"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.718,
            0.739,
            0.781,
            0.753
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 8.2"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.174,
            0.79,
            0.569,
            0.902
          ],
          "content": [
            {
              "type": "text",
              "content": "We see that the whole is divided into — 2 rows and 4 columns, creating "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 4 = 8"
            },
            {
              "type": "text",
              "content": " equal parts. Number of parts shaded = 3. So the yellow shaded part "
            },
            {
              "type": "equation_inline",
              "content": "= { \\frac { 3 } { 8 } } ."
            }
          ]
        },
        {
          "type": "footer",
          "index": 16,
          "bbox": [
