          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, distance covered in 3 hours = "
            },
            {
              "type": "equation_inline",
              "content": "3 \\times { \\frac { 1 } { 4 } }"
            },
            {
              "type": "text",
              "content": " km"
            }
          ]
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.175,
            0.125,
            0.319,
            0.161
          ],
          "image_path": "images/page_1_equation_2.jpg",
          "content": "= { \\frac { 1 } { 4 } } + { \\frac { 1 } { 4 } } + { \\frac { 1 } { 4 } }   \\mathrm { k m }"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.176,
            0.166,
            0.254,
            0.201
          ],
          "content": [
            {
              "type": "text",
              "content": "= 3 km. 4"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.174,
            0.205,
            0.559,
            0.24
          ],
          "content": [
            {
              "type": "text",
              "content": "The tortoise can walk "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " km in 3 hours."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.241,
            0.848,
            0.28
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us consider a case where the time spent walking is a fraction of an hour."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.111,
            0.288,
            0.848,
            0.342
          ],
          "content": [
            {
              "type": "text",
              "content": "？ We saw that Aaron can walk 3 kilometres in 1 hour. How far can he walk in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 5 }"
            },
            {
              "type": "text",
              "content": " hours?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.15,
            0.346,
            0.848,
            0.386
          ],
          "content": [
            {
              "type": "text",
              "content": "We continue to calculate the total distance covered through multiplication."
            }
          ]
        },
        {
          "type": "table",
          "index": 8,
          "bbox": [
            0.173,
            0.416,
            0.794,
            0.525
          ],
          "content": [
            {
              "type": "table_body",
              "index": 8,
              "bbox": [
                0.173,
                0.416,
                0.794,
                0.525
              ],
              "image_path": "images/page_1_table_8.jpg",
              "content": "<table><tr><td>K</td><td>Distance in 1 hour</td></tr><tr><td><eq>\\frac { 1 } { 5 }</eq> Distance in</td><td></td></tr></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.175,
            0.554,
            0.573,
            0.591
          ],
          "content": [
            {
              "type": "text",
              "content": "Distance covered in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{5}"
            },
            {
              "type": "text",
              "content": " hours "
            },
            {
              "type": "equation_inline",
              "content": "= { \\frac { 1 } { 5 } } \\times 3"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.603,
            0.375,
            0.624
          ],
          "content": [
            {
              "type": "text",
              "content": "Finding the product:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.15,
            0.627,
            0.498,
            0.647
          ],
          "content": [
            {
              "type": "text",
              "content": "Distance covered in 1 hour = 3 km."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.15,
            0.65,
            0.848,
            0.71
          ],
          "content": [
            {
              "type": "text",
              "content": "In "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 5 }"
            },
            {
              "type": "text",
              "content": " hours, distance covered is equal to the length we get by dividing 3 km into 5 equal parts, which is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 5 }   \\mathrm { k m }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.174,
            0.715,
            0.438,
            0.75
          ],
          "content": [
            {
              "type": "text",
              "content": "This tells us that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 5 } \\times 3 = \\frac { 3 } { 5 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.11,
            0.759,
            0.517,
            0.794
          ],
          "content": [
