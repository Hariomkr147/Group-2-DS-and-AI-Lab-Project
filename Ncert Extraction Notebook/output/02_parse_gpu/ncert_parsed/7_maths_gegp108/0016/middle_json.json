          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.418,
            0.228,
            0.578,
            0.266
          ],
          "image_path": "images/page_15_equation_4.jpg",
          "content": "\\frac{1}{5} \\div \\frac{1}{2} = 2 \\times \\frac{1}{5} = \\frac{2}{5}."
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.175,
            0.263,
            0.33,
            0.298
          ],
          "content": [
            {
              "type": "text",
              "content": "What is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 } { 3 } \\div \\frac { 3 } { 5 } ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.175,
            0.3,
            0.585,
            0.32
          ],
          "content": [
            {
              "type": "text",
              "content": "Rewriting this as multiplication, we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.454,
            0.331,
            0.544,
            0.367
          ],
          "image_path": "images/page_15_equation_7.jpg",
          "content": "{ \\frac { 3 } { 5 } } \\times ? = { \\frac { 2 } { 3 } } ."
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.175,
            0.362,
            0.414,
            0.383
          ],
          "content": [
            {
              "type": "text",
              "content": "How will we solve this?"
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.434,
            0.398,
            0.569,
            0.47
          ],
          "content": [
            {
              "type": "image_body",
              "index": 9,
              "bbox": [
                0.434,
                0.398,
                0.569,
                0.47
              ],
