  "pages": [
    {
      "page_idx": 23,
      "blocks": [
        {
          "type": "header",
          "index": 0,
          "bbox": [
            0.161,
            0.066,
            0.373,
            0.084
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Prakash | Grade 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.166,
            0.119,
            0.332,
            0.149
          ],
          "content": [
            {
              "type": "text",
              "content": "Clearly, "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 6 } { 4 5 } > \\frac { 3 5 } { 4 5 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.165,
            0.163,
            0.269,
            0.193
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 4 } { 5 } } >   { \\frac { 7 } { 9 } }   !"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.193,
            0.209,
            0.627,
            0.239
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us try this for another pair: "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 9 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 7 } { 2 1 }"
            },
            {
              "type": "text",
              "content": " ."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.164,
            0.245,
            0.762,
            0.266
          ],
          "content": [
            {
              "type": "text",
              "content": "63 is a common multiple of 9 and 21. We can then write:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.17,
            0.271,
            0.466,
            0.304
          ],
          "image_path": "images/page_23_equation_5.jpg",
          "content": "\\frac{7}{9} = \\frac{7 \\times 7}{9 \\times 7} = \\frac{49}{63} , \\frac{17}{21} = \\frac{17 \\times 3}{21 \\times 3} = \\frac{51}{63} ."
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.166,
            0.321,
            0.454,
            0.352
          ],
          "content": [
            {
              "type": "text",
              "content": "Clearly, "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{49}{63} < \\frac{51}{63} . \\mathrm{SO}, \\frac{7}{9} < \\frac{17}{21} \\mathrm{I}"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.165,
            0.365,
            0.366,
            0.385
          ],
          "content": [
            {
              "type": "text",
              "content": "Let’s Summarise!"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.164,
            0.398,
            0.781,
            0.42
          ],
          "content": [
            {
              "type": "text",
              "content": "Steps to compare the sizes of two or more given fractions:"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.164,
            0.426,
            0.885,
            0.492
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Change the given fractions to equivalent fractions so that they all are expressed with the same denominator or same fractional unit."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.164,
            0.502,
            0.885,
            0.547
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Now, compare the equivalent fractions by simply comparing the numerators, i.e., the number of fractional units each has."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.166,
            0.559,
            0.353,
            0.582
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.207,
            0.593,
            0.851,
            0.696
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Compare the following fractions and justify your answers: a. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{8}{3}, \\frac{5}{2}"
            },
            {
              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 4 } { 9 } } , ~ { \\frac { 3 } { 7 } }"
            },
            {
              "type": "text",
              "content": " c. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 1 0 }   ,   \\frac { 9 } { 1 4 }"
            },
            {
              "type": "text",
              "content": " d. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{12}{5}, \\quad \\frac{8}{5}"
            },
            {
              "type": "text",
              "content": " e. "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 9 } { 4 } } , { \\frac { 5 } { 2 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.206,
            0.703,
            0.758,
            0.761
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Write the following fractions in ascending order. 1 "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{7}{10}, \\frac{11}{15}, \\frac{2}{5}"
            },
            {
              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{19}{24} , \\frac{5}{6} , \\frac{7}{12}"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.206,
            0.776,
            0.77,
            0.833
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Write the following fractions in descending order. a. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{25}{16}, \\frac{7}{8}, \\frac{13}{4}, \\frac{17}{32}"
            },
            {
              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{4}, \\frac{12}{5}, \\frac{7}{12}, \\frac{5}{4}"
            }
          ]
        },
