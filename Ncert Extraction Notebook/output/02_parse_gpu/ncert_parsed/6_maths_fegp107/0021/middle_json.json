  "pages": [
    {
      "page_idx": 20,
      "blocks": [
        {
          "type": "header",
          "index": 0,
          "bbox": [
            0.751,
            0.063,
            0.834,
            0.08
          ],
          "content": [
            {
              "type": "text",
              "content": "Fractions"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.113,
            0.12,
            0.834,
            0.247
          ],
          "content": [
            {
              "type": "text",
              "content": "Shabnam: There is a condition. The fractional unit used for the two fractions have to be the same! Like "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{6}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{6}"
            },
            {
              "type": "text",
              "content": " both use the same fractional unit "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{array} { r } { \\frac { 1 } { 6 } \\left( \\mathbf { i . e . } \\right. } \\end{array}"
            },
            {
              "type": "text",
              "content": " , the denominators are the same). But "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{6}{8}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 1 } { 3 0 }"
            },
            {
              "type": "text",
              "content": " do not use the same fractional units (they have different denominators)."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.114,
            0.251,
            0.767,
            0.274
          ],
          "content": [
            {
              "type": "text",
              "content": "Mukta: Okay, so let us start making equivalent fractions then:"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.202,
            0.275,
            0.688,
            0.305
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "{ \\frac { 3 } { 4 } } ~ = ~ { \\frac { 6 } { 8 } } ~ = ~ { \\frac { 9 } { 1 2 } } ~ = ~ { \\frac { 1 2 } { 1 6 } } ~ = ~ { \\frac { 1 5 } { 2 0 } } ~ ."
            },
            {
              "type": "text",
              "content": " … But when do I stop?"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.114,
            0.317,
            0.673,
            0.339
          ],
          "content": [
            {
              "type": "text",
              "content": "Shabnam: \u0007Got it! How about we go on till "
            },
            {
              "type": "equation_inline",
              "content": "4 \\times 10 = 40"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.114,
            0.344,
            0.711,
            0.365
          ],
          "content": [
            {
              "type": "text",
              "content": "Mukta: You mean the product of the two denominators?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.194,
            0.367,
            0.343,
            0.388
          ],
          "content": [
            {
              "type": "text",
              "content": "Sounds good!"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.194,
            0.393,
            0.832,
            0.443
          ],
          "content": [
            {
              "type": "text",
              "content": "We have "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 1 0 }"
            },
            {
              "type": "text",
              "content": " . The product of the two denominators (4 and 10) is 40."
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.197,
            0.447,
            0.584,
            0.48
          ],
          "image_path": "images/page_20_equation_8.jpg",
          "content": "\\frac{3}{4} = \\frac{6}{8} = \\frac{9}{12} = \\frac{12}{16} = \\frac{15}{20} = \\frac{18}{24} = \\ldots = \\frac{27}{36} = \\frac{30}{40}."
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.199,
            0.484,
            0.373,
            0.517
          ],
          "image_path": "images/page_20_equation_9.jpg",
          "content": "{ \\frac { 7 } { 1 0 } }   =   { \\frac { 1 4 } { 2 0 } }   =   { \\frac { 2 1 } { 3 0 } }   =   { \\frac { 2 8 } { 4 0 } } ."
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.63,
            0.463,
            0.795,
            0.503
          ],
          "content": [
            {
              "type": "text",
              "content": "Go till we reach the denominator 40."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.164,
            0.557,
            0.455,
            0.61
          ],
          "content": [
            {
              "type": "text",
              "content": "But notice that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 5 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 4 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " also had the same denominator!"
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.319,
            0.617,
            0.439,
            0.721
          ],
          "content": [
            {
              "type": "image_body",
              "index": 12,
              "bbox": [
                0.319,
                0.617,
                0.439,
                0.721
              ],
              "image_path": "images/page_20_image_12.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.522,
            0.565,
            0.774,
            0.625
          ],
          "content": [
            {
              "type": "text",
              "content": "Yes! We just needed to get the same fractional units for each fraction."
            }
          ]
        },
        {
          "type": "image",
          "index": 14,
          "bbox": [
            0.509,
            0.643,
            0.62,
            0.71
          ],
          "content": [
            {
              "type": "image_body",
              "index": 14,
              "bbox": [
                0.509,
                0.643,
                0.62,
                0.71
              ],
              "image_path": "images/page_20_image_14.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.114,
            0.735,
            0.833,
            0.845
          ],
          "content": [
            {
              "type": "text",
              "content": "Shabnam: So, fractions equivalent to "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 1 0 }"
            },
            {
              "type": "text",
              "content": " with the same fractional unit (same denominators) are "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 0 } { 4 0 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 8 } { 4 0 } ,"
            },
            {
              "type": "text",
              "content": " , or "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 5 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 4 } { 2 0 }"
            },
            {
              "type": "text",
              "content": " Since clearly "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 0 } { 4 0 } > \\frac { 2 8 } { 4 0 }"
            },
            {
              "type": "text",
              "content": " , we conclude that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 } > \\frac { 7 } { 1 0 }"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 16,
          "bbox": [
            0.885,
