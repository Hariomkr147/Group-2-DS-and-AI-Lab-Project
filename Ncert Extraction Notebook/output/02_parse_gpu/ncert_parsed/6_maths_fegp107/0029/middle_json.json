            0.122,
            0.249,
            0.253,
            0.279
          ],
          "image_path": "images/page_28_equation_5.jpg",
          "content": "{ \\frac { 1 } { 3 } } = { \\frac { 1 \\times 2 } { 3 \\times 2 } }   =   { \\frac { 2 } { 6 } }"
        },
        {
          "type": "text",
          "index": 6,
