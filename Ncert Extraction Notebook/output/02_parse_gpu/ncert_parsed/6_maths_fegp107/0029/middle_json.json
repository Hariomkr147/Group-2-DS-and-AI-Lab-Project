              "content": "{ \\frac { 2 } { 3 } } \\quad + \\quad { \\frac { 1 } { 5 } } \\quad = \\quad { \\frac { 1 0 } { 1 5 } } \\quad + \\quad { \\frac { 3 } { 1 5 } } \\quad = \\quad { \\frac { 1 3 } { 1 5 } }"
