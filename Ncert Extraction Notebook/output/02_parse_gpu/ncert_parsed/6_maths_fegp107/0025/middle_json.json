            0.468,
            0.834,
            0.539
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us now divide the remaining half into two further halves as shown. Each of these pieces is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " of the whole chikki."
