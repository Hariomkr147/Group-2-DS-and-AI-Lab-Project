            0.419
          ],
          "image_path": "images/page_34_equation_4.jpg",
          "content": "{ \\frac { 1 } { 2 } }   +   { \\frac { 1 } { 3 } }   +   { \\frac { 1 } { 6 } }   =   1"
        },
        {
          "type": "text",
