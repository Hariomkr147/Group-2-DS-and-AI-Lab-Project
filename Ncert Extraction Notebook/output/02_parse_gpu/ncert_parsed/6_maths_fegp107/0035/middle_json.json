          ],
          "content": [
            {
              "type": "text",
              "content": "another fractional unit, that is different from "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 1 } { 2 } } ,"
            },
            {
              "type": "text",
              "content": " is to replace it by "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 1 } { 3 } } ."
            },
            {
              "type": "text",
              "content": " So two of the fractions must be "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 3 } !"
            },
            {
              "type": "text",
              "content": " What must be third fraction then, so that the three fractions add up to 1?"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.143,
            0.202,
            0.834,
            0.225
          ],
          "content": [
            {
              "type": "text",
              "content": "This explains why there is only one solution to the above problem."
            }
          ]
        },
        {
          "type": "chart",
          "index": 3,
          "bbox": [
            0.369,
            0.224,
