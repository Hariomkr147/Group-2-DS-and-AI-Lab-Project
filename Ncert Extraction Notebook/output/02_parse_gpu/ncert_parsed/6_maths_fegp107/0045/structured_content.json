{
  "pages": [
    {
      "page_idx": 44,
      "blocks": [
        {
          "type": "text",
          "bbox": [
            0.117,
            0.085,
            0.515,
            0.103
          ],
          "content": "**Which groups were easier to compare? Why?**"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.112,
            0.452,
            0.142
          ],
          "content": "**Ans.** Each child’s share in group $1 = { \\frac { 4 } { 7 } }$"
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.142,
            0.452,
            0.172
          ],
          "content": "Each child’s share in group $2 = { \\frac { 5 } { 7 } }$"
        },
        {
          "type": "text",
          "bbox": [
            0.178,
            0.171,
            0.276,
            0.202
          ],
          "content": "And ${ \\frac { 5 } { 7 } } { > } { \\frac { 4 } { 7 } }$"
        },
        {
          "type": "text",
          "bbox": [
            0.176,
            0.202,
            0.881,
            0.237
          ],
          "content": "The groups in second part were easier to compare because the number of children is same."
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.265,
            0.232,
            0.282
          ],
          "content": "**Page no. 172**"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.29,
            0.247,
            0.311
          ],
          "content": "**Section 7.6**"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.321,
            0.881,
            0.355
          ],
          "content": "**Q. Find equivalent fractions for the given pairs of fractions such that the fractional units are the same.**"
        },
        {
          "type": "text",
          "bbox": [
            0.175,
            0.363,
            0.641,
            0.43
          ],
          "content": "**a.** $\\frac { 7 } { 2 }   \\mathbf { a n d }   \\frac { 3 } { 5 }$ b. $\\frac { 8 } { 3 } \\mathbf { a n d } \\frac { 5 } { 6 }$ c. $\\frac { 3 } { 4 }   \\mathbf { a n d }   \\frac { 3 } { 5 }$ d. $\\frac { 6 } { 7 } \\mathbf { a n d } \\frac { 8 } { 5 }$ e. $\\frac { 9 } { 4 } \\mathbf { a n d } \\frac { 5 } { 2 }$ f. $\\frac { 1 } { 1 0 }   \\mathrm { a n d }   \\frac { 2 } { 9 }$ g. $\\frac{8}{3}$ **and** $\\frac { \\mathbf { 1 1 } } { 4 }$ **h.** $\\frac { 1 3 } { 6 }   \\mathbf { a n d }   \\frac { 1 } { 9 }$"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.437,
            0.162,
            0.453
          ],
          "content": "**Ans.**"
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.462,
            0.269,
            0.496
          ],
          "content": "a. $\\frac{35}{10}  and  \\frac{6}{10}$"
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.501,
            0.259,
            0.534
          ],
          "content": "b. ${ \\frac { 1 6 } { 6 } } \\operatorname { a n d } { \\frac { 5 } { 6 } }$"
        },
        {
          "type": "text",
          "bbox": [
            0.149,
            0.54,
            0.259,
            0.574
          ],
          "content": "𝑐. $\\frac{15}{20}  and  \\frac{12}{20}$"
        },
        {
          "type": "text",
          "bbox": [
            0.149,
            0.58,
            0.262,
            0.614
          ],
          "content": "𝑑.33 $\\frac{30}{35}  and  \\frac{56}{35}$"
        },
        {
          "type": "text",
          "bbox": [
            0.149,
            0.619,
            0.252,
            0.652
          ],
          "content": "𝑒. $\\frac { 9 } { 4 } \\bmod \\frac { 1 0 } { 4 }$"
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.659,
            0.261,
            0.692
          ],
          "content": "𝑓.9 $\\frac{9}{90}  and  \\frac{20}{90}$"
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.698,
            0.262,
            0.731
          ],
          "content": "𝑔. $\\frac{32}{12}  and  \\frac{33}{12}$"
        },
        {
          "type": "text",
          "bbox": [
            0.149,
            0.737,
            0.261,
            0.77
          ],
          "content": "ℎ. $\\frac{39}{18}  and  \\frac{2}{18}$"
        }
      ]
    }
