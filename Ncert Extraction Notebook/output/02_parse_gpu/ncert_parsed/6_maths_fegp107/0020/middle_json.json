            0.166,
            0.718,
            0.636,
            0.741
          ],
          "content": [
            {
              "type": "text",
              "content": "Which groups were easier to compare? Why?"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.647,
            0.725,
            0.882,
            0.784
          ],
          "content": [
            {
              "type": "text",
              "content": "When the number of children is same, it is easier to compare, isn’t it?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.165,
            0.758,
            0.626,
            0.85
          ],
          "content": [
            {
              "type": "text",
              "content": "Shabnam: \u0007To compare the first two groups, we have to find fractions equivalent to the fractions "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 1 0 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.166,
            0.859,
            0.573,
            0.89
          ],
          "content": [
            {
              "type": "text",
              "content": "Mukta: How about "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{6}{8}   =   \\frac{3}{4}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 2 1 } { 3 0 } }   =   { \\frac { 7 } { 1 0 } }   ?"
            }
          ]
        },
