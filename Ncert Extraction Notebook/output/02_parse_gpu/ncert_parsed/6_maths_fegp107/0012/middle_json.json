            0.141
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.205,
            0.145,
            0.617,
            0.172
          ],
          "content": [
            {
              "type": "text",
              "content": "1. How many whole units are there in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 2 } ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.205,
            0.191,
            0.708,
            0.22
          ],
          "content": [
            {
              "type": "text",
              "content": "2. How many whole units are there in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{4}{3}"
            },
            {
              "type": "text",
              "content": " and in "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 7 } { 3 } ?"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.833,
            0.143,
            0.919,
            0.226
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.833,
                0.143,
                0.919,
                0.226
              ],
              "image_path": "images/page_11_image_5.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.165,
            0.234,
            0.816,
            0.256
          ],
          "content": [
            {
              "type": "text",
              "content": "Writing fractions greater than one as mixed numbers"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.254,
            0.265,
            0.501,
            0.294
          ],
          "content": [
            {
              "type": "text",
              "content": "We saw that: "
            },
            {
              "type": "equation_inline",
              "content": "{ \\textstyle { \\frac { 3 } { 2 } }   =   1   +   { \\frac { 1 } { 2 } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.249,
            0.302,
            0.878,
            0.323
          ],
          "content": [
            {
              "type": "text",
              "content": "We can write other fractions in a similar way. For example,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.293,
            0.324,
            0.565,
            0.366
          ],
          "image_path": "images/page_11_equation_9.jpg",
          "content": "{ \\frac { 4 } { 3 } }   =   { \\underbrace { { \\frac { 1 } { 3 } }   +   { \\frac { 1 } { 3 } }   +   { \\frac { 1 } { 3 } } } _ { } }   +   { \\frac { 1 } { 3 } }   =   1   +   { \\frac { 1 } { 3 } }   ."
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.338,
            0.374,
            0.436,
            0.402
          ],
          "image_path": "images/page_11_equation_10.jpg",
          "content": "3 \\times { \\textstyle { \\frac { 1 } { 3 } } } = 1"
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.166,
            0.412,
            0.352,
            0.434
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.206,
            0.441,
            0.884,
            0.517
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Figure out the number of whole units in each of the following fractions: a. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{8}{3}"
            },
            {
              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 1 } { 5 }"
            },
            {
              "type": "text",
              "content": " . "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 9 } { 4 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.232,
            0.531,
            0.349,
            0.548
          ],
          "content": [
            {
              "type": "text",
              "content": "We saw that"
            }
          ]
        },
        {
          "type": "image",
          "index": 14,
          "bbox": [
            0.232,
            0.554,
            0.483,
            0.619
          ],
          "content": [
            {
              "type": "image_body",
              "index": 14,
              "bbox": [
                0.232,
                0.554,
                0.483,
                0.619
              ],
              "image_path": "images/page_11_image_14.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.536,
            0.552,
            0.881,
            0.599
          ],
          "content": [
            {
              "type": "text",
              "content": "This number is thus also called ‘two and two thirds’. We also write it as "
            },
            {
              "type": "equation_inline",
              "content": "2   \\frac { 2 } { 3 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.233,
            0.6,
            0.482,
            0.618
          ],
          "content": [
            {
              "type": "text",
              "content": "Fraction Mixed number"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.205,
            0.634,
            0.883,
            0.654
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Can all fractions greater than 1 be written as such mixed numbers?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 18,
          "bbox": [
            0.188,
            0.68,
            0.861,
            0.742
          ],
          "content": [
            {
              "type": "text",
              "content": "A mixed number or mixed fraction contains a whole number (called the whole part) and a fraction that is less than 1 (called the fractional part)."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.205,
            0.771,
            0.841,
            0.853
          ],
          "content": [
            {
              "type": "text",
              "content": "Write the following fractions as mixed fractions (e.g., "
            },
            {
              "type": "equation_inline",
              "content": "\\textstyle { \\frac { 9 } { 2 } }   = 4   { \\frac { 1 } { 2 } } )"
            },
            {
              "type": "text",
              "content": " a. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 9 } { 2 }"
            },
            {
              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{9}{5}"
            },
            {
              "type": "text",
              "content": " c. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 1 } { 1 9 }"
            },
            {
              "type": "text",
              "content": " d. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 4 7 } { 9 }"
            },
            {
              "type": "text",
              "content": " e. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 2 } { 1 1 }"
            },
            {
              "type": "text",
              "content": " f. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 9 } { 6 }"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 20,
