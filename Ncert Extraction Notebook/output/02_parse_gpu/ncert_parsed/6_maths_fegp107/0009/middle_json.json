              ],
              "image_path": "images/page_8_image_4.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.113,
            0.338,
            0.834,
            0.41
          ],
          "content": [
            {
              "type": "text",
              "content": "The distance between 0 and 1 is one unit long. It is divided into two equal parts. So, the length of each part is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 }"
            },
            {
              "type": "text",
              "content": " unit. So, this blue line is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 }"
            },
            {
              "type": "text",
              "content": " unit long."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.113,
            0.423,
            0.833,
            0.467
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, can you find the lengths of the various blue lines shown below? Fill in the boxes as well."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
