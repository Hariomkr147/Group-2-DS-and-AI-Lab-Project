          "bbox": [
            0.164,
            0.162,
            0.528,
            0.185
          ],
          "content": "The picture shows a whole chikki."
        },
        {
          "type": "image",
          "bbox": [
            0.624,
            0.169,
            0.864,
            0.292
          ],
