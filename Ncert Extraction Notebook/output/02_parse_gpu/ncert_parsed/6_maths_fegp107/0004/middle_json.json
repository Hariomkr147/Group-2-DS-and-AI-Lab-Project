          "bbox": [
            0.163,
            0.511,
            0.885,
            0.592
          ],
          "content": [
            {
              "type": "text",
              "content": "We can see that the bigger piece has 3 pieces of "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 }"
            },
            {
              "type": "text",
              "content": " chikki in it. So, we can measure the bigger piece using the fractional unit "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 4 } ,"
            },
            {
              "type": "text",
              "content": " . We see that the bigger piece is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{3}{4}"
            },
            {
              "type": "text",
              "content": " chikki."
            }
          ]
