          ],
          "content": [
            {
              "type": "text",
              "content": "A picture of the chikki broken into 2 pieces is shown below. How much of the original chikki is each piece?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.66,
            0.3,
            0.824,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "A whole chikki"
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.356,
            0.346,
            0.765,
            0.503
          ],
          "content": [
            {
              "type": "image_body",
