            0.36
          ],
          "content": [
            {
              "type": "text",
              "content": "So, 25 = 10 4 !"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.113,
            0.416,
            0.822,
            0.437
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us examine the shares of each child in the following situations."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.137,
            0.439,
            0.634,
            0.46
          ],
          "content": [
            {
              "type": "text",
              "content": "• 1 roti is divided equally between 2 children."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.137,
            0.462,
            0.641,
            0.482
          ],
          "content": [
            {
              "type": "text",
              "content": "• 2 rotis are divided equally among 4 children."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.137,
            0.485,
            0.642,
            0.506
          ],
          "content": [
            {
              "type": "text",
              "content": "• 3 rotis are divided equally among 6 children."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.114,
            0.517,
            0.365,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us draw and share!"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.113,
            0.537,
            0.834,
            0.584
          ],
          "content": [
            {
              "type": "text",
              "content": "Did you notice that in each situation the share of every child is the same? So, we can say that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{2} = \\frac{2}{4} \\leq \\frac{3}{6}"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.121,
            0.613,
            0.278,
            0.653
          ],
          "content": [
            {
              "type": "text",
              "content": "1 roti is divided equally between 2"
