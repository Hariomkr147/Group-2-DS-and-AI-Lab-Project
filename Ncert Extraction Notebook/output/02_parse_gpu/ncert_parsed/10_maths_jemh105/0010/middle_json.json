          "bbox": [
            0.295,
            0.771,
            0.896,
            0.791
          ],
          "image_path": "images/page_9_equation_29.jpg",
          "content": "a_{3}=a+(3-1)d=a+2d=5\\tag{1}"
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.097,
            0.796,
            0.142,
            0.813
          ],
