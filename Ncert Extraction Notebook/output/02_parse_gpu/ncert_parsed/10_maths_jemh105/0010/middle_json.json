          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "a _ { n }"
            },
            {
              "type": "text",
              "content": " is also called the "
            },
            {
              "type": "text",
              "content": "general term of the AP",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". If there are m terms in the AP, then "
            },
            {
              "type": "equation_inline",
              "content": "a _ { m }"
            },
            {
              "type": "text",
              "content": " represents the "
            },
            {
              "type": "text",
              "content": "last term which is sometimes also denoted by l",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
