          "bbox": [
            0.096,
            0.745,
            0.297,
            0.763
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " We have"
            }
          ]
        },
        {
          "type": "equation",
