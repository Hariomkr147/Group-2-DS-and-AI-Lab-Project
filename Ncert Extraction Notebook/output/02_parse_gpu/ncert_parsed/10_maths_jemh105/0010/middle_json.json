            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.146,
            0.184,
            0.46,
            0.202
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us consider some examples."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.215,
            0.643,
            0.235
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 3 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find the 10th term of the AP : 2, 7, 12, . . ."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.095,
            0.242,
            0.631,
            0.261
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, "
            },
            {
              "type": "equation_inline",
              "content": "a = 2, \\quad d = 7 - 2 = 5 \\quad  and  \\quad n = 10."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.097,
            0.269,
            0.191,
            0.287
          ],
          "content": [
            {
              "type": "text",
              "content": "We have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.25,
            0.27,
            0.433,
            0.289
          ],
          "image_path": "images/page_9_equation_7.jpg",
          "content": "a_{_n} = a + (n - 1) d"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.097,
            0.296,
            0.135,
            0.314
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.249,
            0.295,
            0.599,
            0.316
          ],
          "image_path": "images/page_9_equation_9.jpg",
          "content": "a_{10} = 2 + (10 - 1) \\times 5 = 2 + 45 = 47"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.096,
            0.322,
            0.548,
            0.341
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the 10th term of the given AP is 47."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.095,
            0.354,
            0.901,
            0.393
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 4 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Which term of the AP : 21, 18, 15, . . . is – 81? Also, is any term 0? Give reason for your answer."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.095,
            0.4,
            0.887,
            0.42
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, a = 21, d = 18 – 21 = – 3 and "
            },
            {
              "type": "equation_inline",
              "content": "a _ { _ n } = - \\; 8 1"
            },
            {
              "type": "text",
              "content": " , and we have to find n."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.098,
            0.428,
            0.135,
            0.445
          ],
          "content": [
            {
              "type": "text",
              "content": "As"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.24,
            0.428,
            0.435,
            0.448
          ],
          "image_path": "images/page_9_equation_14.jpg",
          "content": "a_{n}=a+(n-1)d,"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.454,
            0.187,
            0.472
          ],
          "content": [
            {
              "type": "text",
              "content": "we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.207,
            0.453,
            0.46,
            0.525
          ],
          "image_path": "images/page_9_equation_16.jpg",
          "content": "\\begin{aligned}- 81 &= 21 + (n - 1)(- 3) \\\\- 81 &= 24 - 3n \\\\- 105 &= - 3n \\quad  食食 \\end{aligned}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.097,
            0.534,
            0.135,
            0.552
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.244,
            0.534,
            0.322,
            0.552
          ],
          "image_path": "images/page_9_equation_18.jpg",
          "content": "n = 3 5"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.095,
            0.557,
            0.567,
            0.576
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the 35th term of the given AP is – 81."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.095,
            0.584,
            0.899,
            0.604
          ],
          "content": [
            {
              "type": "text",
              "content": "Next, we want to know if there is any n for which "
            },
            {
              "type": "equation_inline",
              "content": "a _ { _ n } = 0"
            },
            {
              "type": "text",
              "content": " . If such an n is there, then"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.303,
            0.608,
            0.521,
            0.63
          ],
          "image_path": "images/page_9_equation_21.jpg",
          "content": "2\\Gamma+(n-1)(-3)=0,"
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.098,
            0.638,
            0.139,
            0.656
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.388,
            0.636,
            0.525,
            0.656
          ],
          "image_path": "images/page_9_equation_23.jpg",
          "content": "3(n - 1) = 21"
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.098,
            0.664,
            0.139,
            0.682
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.452,
            0.664,
            0.517,
            0.682
          ],
          "image_path": "images/page_9_equation_25.jpg",
          "content": "n = \\; 8"
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.097,
            0.687,
            0.328,
            0.706
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the eighth term is 0."
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.096,
            0.719,
            0.808,
            0.738
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Determine the AP whose 3rd term is 5 and the 7th term is 9."
            }
          ]
        },
        {
          "type": "text",
