            0.098,
            0.189,
            0.205,
            0.208
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.355,
            0.189,
            0.857,
            0.21
          ],
          "image_path": "images/page_17_equation_7.jpg",
          "content": "a_{20}=10+(20-1)\\times10=200, i.e. 20th term is 200."
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.222,
            0.901,
            0.259
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 13 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " How many terms of the AP : 24, 21, 18, . . . must be taken so that their sum is 78?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.096,
            0.266,
            0.783,
            0.286
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, a = 24, "
            },
            {
              "type": "equation_inline",
              "content": "d = 21 - 24 = -3."
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { S } _ { _ n } = 7 8"
            },
            {
              "type": "text",
              "content": " . We need to find n."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.098,
            0.299,
            0.239,
            0.318
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.363,
            0.292,
            0.582,
            0.327
          ],
          "image_path": "images/page_17_equation_11.jpg",
          "content": "S_{n} = \\frac{n}{2} \\left[ 2a + (n - 1)d \\right]"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.098,
            0.347,
            0.135,
            0.365
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.362,
            0.337,
            0.738,
            0.373
          ],
          "image_path": "images/page_17_equation_13.jpg",
          "content": "7 8 = { \\frac { n } { 2 } } { \\bigl [ } 4 8 + ( n - 1 ) ( - 3 ) { \\bigr ] } = { \\frac { n } { 2 } } { \\bigl [ } 5 1 - 3 n { \\bigr ] }"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.098,
            0.389,
            0.126,
            0.404
          ],
          "content": [
            {
              "type": "text",
              "content": "or"
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.234,
            0.386,
            0.438,
            0.405
          ],
          "image_path": "images/page_17_equation_15.jpg",
          "content": "3n^{2}-51n+156=0"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.098,
            0.415,
            0.126,
            0.429
          ],
          "content": [
            {
              "type": "text",
              "content": "or"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.254,
            0.411,
            0.438,
            0.43
          ],
          "image_path": "images/page_17_equation_17.jpg",
          "content": "n^{2}-17n+52=0"
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.098,
            0.44,
            0.126,
            0.454
          ],
          "content": [
            {
              "type": "text",
              "content": "or"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.243,
            0.437,
            0.438,
            0.456
          ],
          "image_path": "images/page_17_equation_19.jpg",
          "content": "(n - 4)(n - 13) = 0"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.098,
            0.465,
            0.126,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "or"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.372,
            0.462,
            0.506,
            0.481
          ],
          "image_path": "images/page_17_equation_21.jpg",
          "content": "n = 4  or  13"
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.096,
            0.487,
            0.798,
            0.507
          ],
          "content": [
            {
              "type": "text",
              "content": "Both values of n are admissible. So, the number of terms is either 4 or 13."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 23,
          "bbox": [
            0.098,
            0.513,
            0.212,
            0.53
          ],
          "content": [
            {
              "type": "text",
              "content": "Remarks:"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.108,
            0.537,
            0.865,
            0.557
          ],
          "content": [
            {
              "type": "text",
              "content": "1. In this case, the sum of the first 4 terms = the sum of the first 13 terms = 78."
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.107,
            0.563,
            0.902,
            0.622
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Two answers are possible because the sum of the terms from 5th to 13th will be zero. This is because "
            },
            {
              "type": "equation_inline",
              "content": "a"
            },
            {
              "type": "text",
              "content": " is positive and d is negative, so that some terms will be positive and some others negative, and will cancel out each other."
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.097,
            0.635,
            0.408,
            0.654
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 14 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find the sum of :"
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.248,
            0.663,
            0.886,
            0.683
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) the first 1000 positive integers (ii) the first n positive integers"
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.096,
            0.684,
            0.205,
            0.702
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.119,
            0.712,
            0.451,
            0.73
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Let "
            },
            {
              "type": "equation_inline",
              "content": "S = 1 + 2 + 3 + \\cdots + 1000"
            }
          ]
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.148,
            0.735,
            0.901,
            0.777
          ],
          "content": [
            {
              "type": "text",
              "content": "Using the formula "
            },
            {
              "type": "equation_inline",
              "content": "S _ { _ n } = \\frac { n } { 2 } ( a + l ) ."
            },
            {
              "type": "text",
              "content": " for the sum of the first n terms of an AP, we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 31,
          "bbox": [
            0.295,
            0.776,
            0.752,
            0.816
          ],
          "image_path": "images/page_17_equation_31.jpg",
          "content": "S_{1000} = \\frac{1000}{2} \\left( 1 + 1000 \\right) = 500 \\times 1001 = 500500"
        },
        {
          "type": "text",
          "index": 32,
          "bbox": [
            0.148,
            0.823,
            0.681,
            0.842
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the sum of the first 1000 positive integers is 500500."
            }
          ]
        },
        {
          "type": "footer",
          "index": 33,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 34,
          "bbox": [
            0.115,
            0.85,
            0.427,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Let "
            },
            {
              "type": "equation_inline",
              "content": "S_{n}=1+2+3+\\cdots+n"
            }
          ]
        },
        {
          "type": "text",
          "index": 35,
          "bbox": [
            0.149,
            0.878,
            0.485,
            0.896
          ],
          "content": [
            {
              "type": "text",
              "content": "Here a = 1 and the last term l is n."
            }
          ]
        }
      ]
