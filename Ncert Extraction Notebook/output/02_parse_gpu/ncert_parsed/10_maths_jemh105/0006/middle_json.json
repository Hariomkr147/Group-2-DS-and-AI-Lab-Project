  "pages": [
    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "page_number",
          "index": 0,
          "bbox": [
            0.099,
            0.105,
            0.127,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "54"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.782,
            0.104,
            0.9,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.095,
            0.139,
            0.902,
            0.197
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that to find d in the AP : 6, 3, 0, – 3, . . ., we have subtracted 6 from 3 and not 3 from 6, i.e., we should subtract the kth term from the (k + 1) th term even if the (k + 1) th term is smaller."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.146,
            0.204,
            0.736,
            0.224
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us make the concept more clear through some examples."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.239,
            0.901,
            0.297
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 1 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " For the "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AP}:\\frac{3}{2},\\frac{1}{2},-\\frac{1}{2},-\\frac{3}{2}"
            },
            {
              "type": "text",
              "content": " , write the first term a and the common difference d."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.095,
            0.309,
            0.545,
            0.35
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, "
            },
            {
              "type": "equation_inline",
              "content": "a = \\frac{3}{2}, d = \\frac{1}{2} - \\frac{3}{2} = - 1."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.36,
            0.901,
            0.398
          ],
          "content": [
            {
              "type": "text",
              "content": "the numbers are in AP."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.096,
            0.411,
            0.901,
            0.451
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Which of the following list of numbers form an AP? If they form an AP, write the next two terms :"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.118,
            0.455,
            0.677,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) 4, 10, 16, 22, . . . (ii) "
            },
            {
              "type": "equation_inline",
              "content": "1,-1,-3,-5,"
            },
            {
              "type": "text",
              "content": " . ."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.108,
            0.481,
            0.73,
            0.501
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) – 2, 2, – 2, 2, – 2, . . . (iv) 1, 1, 1, 2, 2, 2, 3, 3, 3, . . ."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.095,
            0.506,
            0.573,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) We have "
            },
            {
              "type": "equation_inline",
              "content": "a_{2}-a_{1}=10-4=6"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.345,
            0.532,
            0.575,
            0.552
          ],
          "image_path": "images/page_5_equation_11.jpg",
          "content": "a_{3}-a_{2}=16-10=6"
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.345,
            0.557,
            0.577,
            0.578
          ],
          "image_path": "images/page_5_equation_12.jpg",
          "content": "a_{4}-a_{3}=22-16=6"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.095,
            0.583,
            0.482,
            0.604
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., "
            },
            {
              "type": "equation_inline",
              "content": "a _ { { } _ { k \\; + \\; 1 } } - a _ { { } _ { k } }"
            },
            {
              "type": "text",
              "content": " is the same every time."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.096,
            0.607,
            0.834,
            0.626
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the given list of numbers forms an AP with the common difference "
            },
            {
              "type": "equation_inline",
              "content": "d = 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.096,
            0.632,
            0.609,
            0.651
          ],
          "content": [
            {
              "type": "text",
              "content": "The next two terms are: "
            },
            {
              "type": "equation_inline",
              "content": "22 + 6 = 28"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "28+6=34."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.115,
            0.657,
            0.398,
            0.676
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "a_{2}-a_{1}=-1-1=-2"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.158,
            0.679,
            0.532,
            0.7
          ],
          "image_path": "images/page_5_equation_17.jpg",
          "content": "a_{3}-a_{2}=-3-(-1)=-3+1=-2"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.16,
            0.704,
            0.527,
            0.725
          ],
          "image_path": "images/page_5_equation_18.jpg",
          "content": "a_{4}-a_{3}=-5-(-3)=-5+3=-2"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.096,
            0.73,
            0.48,
            0.751
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., "
            },
            {
              "type": "equation_inline",
              "content": "a _ { { } _ { k \\; + \\; 1 } } - a _ { { } _ { k } }"
            },
            {
              "type": "text",
              "content": " is the same every time."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.096,
            0.754,
            0.885,
            0.797
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the given list of numbers forms an AP with the common difference "
            },
            {
              "type": "equation_inline",
              "content": "d = - 2"
            },
            {
              "type": "text",
              "content": " The next two terms are:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.245,
            0.802,
            0.719,
            0.821
          ],
          "image_path": "images/page_5_equation_21.jpg",
          "content": "-5+(-2)=-7\\qquad and \\qquad-7+(-2)=-9"
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.109,
            0.826,
            0.445,
            0.846
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "a_{2}-a_{1}=2-(-2)=2+2=4"
            }
          ]
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.15,
            0.851,
            0.375,
            0.871
          ],
          "image_path": "images/page_5_equation_23.jpg",
          "content": "a_{3}-a_{2}=-2-2=-4"
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.096,
            0.873,
            0.764,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "As "
            },
            {
              "type": "equation_inline",
              "content": "a_{_2}-a_{_1}\\ne a_{_3}-a_{_2}"
            },
            {
              "type": "text",
              "content": " , the given list of numbers does not form an AP."
            }
          ]
        },
        {
          "type": "footer",
          "index": 25,
          "bbox": [
            0.435,
            0.966,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        }
      ]
    }
