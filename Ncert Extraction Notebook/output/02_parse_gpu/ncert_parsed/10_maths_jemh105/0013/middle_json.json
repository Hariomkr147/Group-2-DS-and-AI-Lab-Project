          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm { S o } ,"
            },
            {
              "type": "text",
              "content": " to find the interest at the end of 30 years, we shall find "
            },
            {
              "type": "equation_inline",
              "content": "a _ { 3 0 ^ { \\circ } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.098,
            0.215,
            0.155,
            0.233
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
