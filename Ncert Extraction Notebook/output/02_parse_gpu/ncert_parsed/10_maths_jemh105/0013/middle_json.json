            },
            {
              "type": "text",
              "content": " the interest at the end of 30 years will be ` 2400."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.095,
            0.275,
            0.902,
            0.336
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 10 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In a flower bed, there are 23 rose plants in the first row, 21 in the second, 19 in the third, and so on. There are 5 rose plants in the last row. How many rows are there in the flower bed?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.343,
            0.791,
            0.362
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The number of rose plants in the 1st, 2nd, 3rd, . . ., rows are :"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.415,
            0.369,
            0.584,
            0.388
          ],
          "image_path": "images/page_12_equation_9.jpg",
          "content": "2 3 , 2 1 , 1 9 , \\ldots , 5"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.096,
            0.395,
            0.783,
            0.415
          ],
          "content": [
            {
              "type": "text",
              "content": "It forms an AP (Why?). Let the number of rows in the flower bed be n."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.098,
            0.422,
            0.155,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Then"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.215,
            0.422,
            0.575,
            0.441
          ],
          "image_path": "images/page_12_equation_12.jpg",
          "content": "a = 23, \\quad d = 21 - 23 = -2, \\quad a_{n} = 5"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.098,
            0.449,
            0.138,
            0.466
          ],
          "content": [
            {
              "type": "text",
              "content": "As,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.308,
            0.449,
            0.498,
            0.468
          ],
          "image_path": "images/page_12_equation_14.jpg",
          "content": "a_{n} = a + (n - 1)   d"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.098,
            0.474,
            0.194,
            0.493
          ],
          "content": [
            {
              "type": "text",
              "content": "We have,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.318,
            0.475,
            0.531,
            0.493
          ],
          "image_path": "images/page_12_equation_16.jpg",
          "content": "5 = 23 + (n - 1)( - 2)"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.098,
            0.502,
            0.139,
            0.519
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.288,
            0.501,
            0.481,
            0.519
          ],
          "image_path": "images/page_12_equation_18.jpg",
          "content": "-18 = (n - 1)(-2)"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.098,
            0.528,
            0.139,
            0.545
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.318,
            0.528,
            0.394,
            0.545
          ],
          "image_path": "images/page_12_equation_20.jpg",
          "content": "n = \\: 1 0"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.096,
            0.553,
            0.481,
            0.572
          ],
          "content": [
            {
