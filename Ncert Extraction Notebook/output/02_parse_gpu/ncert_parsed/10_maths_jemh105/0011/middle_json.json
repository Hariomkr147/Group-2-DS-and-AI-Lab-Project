          ],
          "content": [
            {
              "type": "text",
              "content": "Example 6 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Check whether 301 is a term of the list of numbers 5, 11, 17, 23, . . . "
            },
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " We have :"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.21,
            0.189,
            0.9,
            0.21
          ],
          "image_path": "images/page_10_equation_3.jpg",
          "content": "a_{2}-a_{1}=11-5=6, \\quad a_{3}-a_{2}=17-11=6, \\quad a_{4}-a_{3}=23-17=6"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.097,
            0.215,
            0.855,
            0.235
          ],
          "content": [
            {
              "type": "text",
              "content": "As "
            },
            {
              "type": "equation_inline",
              "content": "a _ { { } _ { k \\; + \\; 1 } } - a _ { { } _ { k } }"
            },
            {
              "type": "text",
              "content": " is the same for k = 1, 2, 3, etc., the given list of numbers is an AP."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.098,
            0.241,
            0.155,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.249,
            0.24,
            0.47,
            0.258
          ],
          "image_path": "images/page_10_equation_6.jpg",
          "content": "a = 5 \\quad { \\mathrm { a n d } } \\quad d = 6 ."
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.096,
            0.265,
            0.548,
            0.283
          ],
          "content": [
            {
              "type": "text",
              "content": "Let 301 be a term, say, the nth term of this AP."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.097,
            0.29,
            0.239,
            0.308
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.442,
            0.316,
            0.63,
            0.336
          ],
          "image_path": "images/page_10_equation_9.jpg",
          "content": "a_{_n} = a + (n - 1)   d"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.097,
            0.341,
            0.136,
            0.358
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.431,
            0.339,
            0.645,
            0.359
          ],
          "image_path": "images/page_10_equation_11.jpg",
          "content": "3 0 1   =   5 + ( n - 1 ) \\times 6"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.096,
            0.366,
            0.14,
            0.384
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.432,
            0.365,
            0.565,
            0.384
          ],
          "image_path": "images/page_10_equation_13.jpg",
          "content": "3 0 1 = 6 n - 1"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.097,
            0.411,
            0.135,
            0.428
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.447,
            0.396,
            0.605,
            0.441
          ],
          "image_path": "images/page_10_equation_15.jpg",
          "content": "n = \\frac{302}{6} = \\frac{151}{3}"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.096,
            0.448,
            0.901,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "But n should be a positive integer (Why?). So, 301 is not a term of the given list of numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.096,
            0.499,
            0.696,
            0.519
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 7 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " How many two-digit numbers are divisible by 3?"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.095,
            0.525,
            0.644,
            0.544
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The list of two-digit numbers divisible by 3 is :"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.405,
            0.551,
            0.593,
            0.57
          ],
          "image_path": "images/page_10_equation_19.jpg",
          "content": "12,15,18;\\therefore ,99"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.096,
            0.578,
            0.63,
            0.597
          ],
          "content": [
            {
              "type": "text",
              "content": "Is this an AP? Yes it is. Here, "
            },
            {
              "type": "equation_inline",
              "content": "a = 12, \\quad d = 3, \\quad a_{n} = 99."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.098,
            0.606,
            0.135,
            0.623
          ],
          "content": [
            {
              "type": "text",
              "content": "As"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.442,
            0.605,
            0.632,
            0.627
          ],
          "image_path": "images/page_10_equation_22.jpg",
          "content": "a_{n}^{-} = a + (n - 1)   d,"
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.097,
            0.632,
            0.187,
            0.65
          ],
          "content": [
            {
              "type": "text",
              "content": "we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 24,
          "bbox": [
            0.442,
            0.631,
            0.654,
            0.651
          ],
          "image_path": "images/page_10_equation_24.jpg",
          "content": "99 = 12 + (n - 1) \\times 3"
        },
        {
          "type": "footer",
          "index": 25,
          "bbox": [
            0.435,
            0.967,
            0.564,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.097,
            0.658,
            0.14,
            0.676
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
