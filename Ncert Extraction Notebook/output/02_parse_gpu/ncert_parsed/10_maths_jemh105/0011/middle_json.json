          ],
          "content": [
            {
              "type": "text",
              "content": "Example 8 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find the 11th term from the last term (towards the first term) of the AP : 10, 7, 4, . . ., – 62."
