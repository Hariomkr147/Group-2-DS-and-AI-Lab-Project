          "bbox": [
            0.442,
            0.657,
            0.608,
            0.676
          ],
          "image_path": "images/page_10_equation_27.jpg",
          "content": "8 7   =   ( n - 1 ) \\times 3"
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.098,
            0.705,
            0.139,
            0.723
          ],
          "content": [
            {
