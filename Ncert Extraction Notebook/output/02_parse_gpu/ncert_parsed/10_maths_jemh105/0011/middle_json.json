          "bbox": [
            0.415,
            0.692,
            0.587,
            0.733
          ],
          "image_path": "images/page_10_equation_29.jpg",
          "content": "n - 1 = { \\frac { 8 7 } { 3 } } = 2 9"
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.098,
            0.744,
            0.139,
