                0.284,
                0.925,
                0.301
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 13.5: Earth — The blue planet"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.146,
            0.339,
            0.314,
            0.359
          ],
          "content": [
            {
              "type": "text",
              "content": "A step further"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.146,
            0.375,
            0.394,
            0.394
          ],
          "content": [
            {
              "type": "text",
              "content": "Did Mars ever support life?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.145,
            0.398,
            0.746,
            0.451
          ],
          "content": [
            {
              "type": "text",
              "content": "Mars lies at the edge of the Sun’s habitable zone. Several spacecrafts have been sent to Mars, rovers have landed and explored its surface, but no proof of life has been found yet. However, scientists think"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.145,
            0.45,
            0.477,
            0.52
          ],
          "content": [
            {
              "type": "text",
              "content": "that in the past, Mars may have had liquid water—maybe even some lakes—and conditions that could support simple life forms (Fig. 13.6)."
            }
          ],
          "continues_prev": true
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.144,
            0.523,
            0.478,
            0.644
          ],
          "content": [
            {
              "type": "text",
              "content": "This is one reason Mars continues to interest scientists. It also reminds us that science doesn’t always have final answers. As we explore more, we may find new clues—or even new kinds of life. Science stays open to change when we learn more."
            }
          ]
        },
        {
