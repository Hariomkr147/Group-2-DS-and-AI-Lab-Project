          ],
          "content": [
            {
              "type": "text",
              "content": "Opposite angles, like ∠b and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d ,"
            },
            {
              "type": "text",
              "content": " formed by two lines intersecting each other, are called "
            },
            {
              "type": "text",
              "content": "vertically opposite angles",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". Vertically opposite angles are always equal to each other."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.149,
            0.143,
            0.848,
            0.2
          ],
          "content": [
            {
              "type": "text",
              "content": "From the above reasoning, we conclude that whenever two lines intersect, vertically opposite angles are equal. Such a justification is called a "
            },
            {
              "type": "text",
              "content": "proof",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " in mathematics."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
            0.112,
            0.208,
            0.293,
            0.23
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
