              "content": ""
            },
            {
              "type": "image_caption",
              "index": 7,
              "bbox": [
                0.463,
                0.57,
                0.537,
                0.584
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 5.19"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.173,
            0.611,
            0.824,
            0.651
          ],
          "content": [
            {
              "type": "text",
              "content": "Corresponding angles formed by a transversal intersecting a pair of parallel lines are always equal to each other."
            }
          ]
        },
        {
