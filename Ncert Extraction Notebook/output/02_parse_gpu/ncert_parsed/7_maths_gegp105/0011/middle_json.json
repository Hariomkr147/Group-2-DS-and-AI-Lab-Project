          ],
          "content": [
            {
              "type": "text",
              "content": "If one angle is "
            },
            {
              "type": "equation_inline",
              "content": "6 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , the other angle of the linear pair should be "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " So, we already have two distinct angles."
            }
          ]
        },
        {
          "type": "text",
