          "content": [
            {
              "type": "text",
              "content": "？ "
            },
            {
              "type": "text",
              "content": "Is it possible for all the eight angles to have different measurements? Why, why not?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.115,
            0.34,
            0.881,
            0.38
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " No, because "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 1 = \\angle 3 , \\angle 2 = \\angle 4 , \\angle 5 = \\angle 7 ,"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 6 = \\angle 8"
            },
            {
              "type": "text",
              "content": " (vertically opposite angles are equal)."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.162,
            0.393,
            0.683,
            0.414
          ],
          "content": [
            {
              "type": "text",
              "content": "What about five different angles — 6, 5, 4, 3 and 2?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.115,
            0.428,
            0.385,
            0.447
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " No, because "
            },
            {
              "type": "equation_inline",
              "content": "\\angle 2 = \\angle 4."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
