          ],
          "content": [
            {
              "type": "text",
              "content": "Tools required: Ruler, Set-squares (right-angled triangle), Pencil, eraser "
            },
            {
              "type": "text",
              "content": "Steps:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
