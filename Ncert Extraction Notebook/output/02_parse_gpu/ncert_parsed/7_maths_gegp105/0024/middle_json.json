          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.207,
            0.33,
            0.881,
            0.371
          ],
          "content": [
            {
              "type": "text",
              "content": "Make one more horizontal fold in the folded sheet. How many parallel lines do you see now?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.207,
            0.374,
            0.881,
            0.437
          ],
          "content": [
            {
              "type": "text",
              "content": "What will happen if you do it once more? How many parallel lines will you get? Is there a pattern? Check if the pattern extends further, if you make another horizontal fold.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.207,
            0.441,
            0.881,
            0.482
          ],
          "content": [
            {
              "type": "text",
              "content": "Make a vertical fold in the square sheet. This new vertical line",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " is to the previous horizontal lines."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.207,
            0.486,
            0.882,
            0.528
          ],
          "content": [
            {
              "type": "text",
              "content": "Fold the sheet along a diagonal. Can you find a fold that creates a line parallel to the diagonal line?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.14,
            0.553,
            0.193,
            0.57
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.14,
            0.581,
            0.321,
            0.599
          ],
          "content": [
            {
              "type": "text",
              "content": "Fill in the Blanks"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.146,
            0.604,
            0.741,
            0.623
          ],
          "content": [
            {
              "type": "text",
              "content": "● The opposite edges of the sheet are "
            },
            {
              "type": "text",
              "content": "parallel",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " to each other."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.146,
            0.626,
            0.807,
            0.646
          ],
          "content": [
            {
              "type": "text",
              "content": "● The adjacent edges of the sheet are "
            },
            {
              "type": "text",
              "content": "perpendicular",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " to each other."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.14,
            0.67,
            0.362,
            0.687
          ],
          "content": [
            {
              "type": "text",
              "content": "First Horizontal Fold"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.146,
            0.689,
            0.881,
            0.73
          ],
          "content": [
            {
              "type": "text",
              "content": "● We will see "
            },
            {
              "type": "text",
              "content": "three",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " parallel lines. The new line segment is "
            },
            {
              "type": "text",
              "content": "perpendicular",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " to the vertical sides."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.14,
            0.748,
            0.443,
            0.766
          ],
          "content": [
            {
              "type": "text",
              "content": "Subsequent Horizontal Folds"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.146,
            0.768,
            0.881,
            0.831
          ],
          "content": [
            {
              "type": "text",
              "content": "After one more horizontal fold, we will see a total of "
            },
            {
              "type": "text",
              "content": "five",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " parallel lines. The two original horizontal edges, the first fold line, and the second fold line are all parallel to each other."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.147,
            0.835,
            0.881,
            0.876
          ],
          "content": [
            {
              "type": "text",
              "content": "● If we fold it horizontally one more time, we will get "
            },
            {
              "type": "text",
              "content": "nine",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " parallel lines. Yes, the pattern is "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { \\mathrm { n } } + 1"
            },
            {
              "type": "text",
              "content": " , where n is the number of folds."
            }
          ]
        }
      ]
    }
