                0.197
              ],
              "image_path": "images/page_1_image_1.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 2,
              "bbox": [
                0.467,
                0.205,
                0.534,
                0.22
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 5.2"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.11,
            0.236,
            0.704,
            0.26
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Can two straight lines intersect at more than one point?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.151,
            0.278,
            0.258,
            0.297
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 1"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.149,
            0.297,
            0.851,
            0.372
          ],
          "content": [
            {
              "type": "text",
              "content": "Draw two lines on a plain sheet of paper so that they intersect. Measure the four angles formed with a protractor. Draw four such pairs of intersecting lines and measure the angles formed at the points of intersection."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.11,
            0.38,
            0.663,
            0.403
          ],
          "content": [
            {
              "type": "text",
              "content": "? What patterns do you observe among these angles?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.11,
            0.421,
            0.847,
            0.462
          ],
          "content": [
            {
              "type": "text",
              "content": "？ In Fig. 5.2, if "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " is "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , can you figure out the measurements of "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b , \\angle c"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d ,"
            },
            {
              "type": "text",
              "content": " without drawing and measuring them?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.15,
            0.471,
            0.848,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " together measure "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ } ,"
            },
            {
              "type": "text",
              "content": " because when they are combined, they form a straight angle which measures "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . So, if "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " is "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , then "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " must be "
            },
            {
              "type": "equation_inline",
              "content": "6 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.526,
            0.846,
            0.582
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " together measure "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . So, if "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " is "
            },
            {
              "type": "equation_inline",
              "content": "6 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , then "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " must be "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . And "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d"
            },
            {
              "type": "text",
              "content": " together measure "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . So, if "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " is "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " then "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d"
            },
            {
              "type": "text",
              "content": " must be "
            },
            {
              "type": "equation_inline",
              "content": "6 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.15,
            0.581,
            0.847,
            0.618
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, in "
            },
            {
              "type": "equation_inline",
              "content": "{ \\mathrm { F i g } } ."
            },
            {
              "type": "text",
              "content": " 5.2, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " measure "
            },
            {
              "type": "equation_inline",
              "content": "1 2 0 ^ { \\circ } ]"
            },
            {
              "type": "text",
              "content": " , and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d"
            },
            {
              "type": "text",
              "content": " measure "
            },
            {
              "type": "equation_inline",
              "content": "6 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.149,
            0.618,
            0.848,
            0.675
          ],
          "content": [
            {
              "type": "text",
              "content": "When two lines intersect each other and form four angles, labelled a, b, c and "
            },
            {
              "type": "equation_inline",
              "content": "{ \\mathsf { d } } ,"
            },
            {
              "type": "text",
              "content": " as in Fig. 5.2, then "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " are equal, and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d"
            },
            {
              "type": "text",
              "content": " are equal!"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.111,
            0.684,
            0.67,
            0.706
          ],
          "content": [
            {
              "type": "text",
              "content": "Is this always true for any pair of intersecting lines?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.15,
            0.715,
            0.847,
            0.753
          ],
          "content": [
            {
              "type": "text",
              "content": "Check this for different measures of "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a ."
            },
            {
              "type": "text",
              "content": " . Using these measurements, can you reason whether this property holds true for any measure of "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a?"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.15,
            0.752,
            0.846,
            0.788
          ],
          "content": [
            {
              "type": "text",
              "content": "We can generalise our reasoning for Fig. 5.2, without assuming the values "
            },
            {
              "type": "equation_inline",
              "content": "{ \\tt o f } \\angle \\bar { a } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.174,
            0.788,
            0.846,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "Since straight angles measure "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " , we must have "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a + \\angle b = \\angle a + \\angle d"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "= 1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . Hence, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle d"
            },
            {
              "type": "text",
              "content": " are always equal. Similarl "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b + \\angle a = \\angle b +"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c = 180^{\\circ}"
            },
            {
              "type": "text",
              "content": " , so "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle c"
            },
            {
              "type": "text",
              "content": " must be equal."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.151,
            0.843,
            0.846,
            0.883
          ],
          "content": [
            {
              "type": "text",
              "content": "Adjacent angles, like "
            },
            {
              "type": "equation_inline",
              "content": "\\angle a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle b ,"
            },
            {
              "type": "text",
              "content": " formed by two lines intersecting each other, are called "
            },
            {
              "type": "text",
              "content": "linear pairs",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". Linear pairs always add up to "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "page_number",
