          ],
          "content": [
            {
              "type": "text",
              "content": "Parallel and Intersecting Lines"
            }
          ]
        },
        {
          "type": "image",
          "index": 1,
          "bbox": [
            0.375,
            0.083,
            0.623,
            0.197
          ],
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "bbox": [
                0.375,
                0.083,
