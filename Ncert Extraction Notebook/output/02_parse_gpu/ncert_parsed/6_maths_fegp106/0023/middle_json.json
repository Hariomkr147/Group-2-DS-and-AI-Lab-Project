            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "a. Perimeter of a rectangle = 14 cm; breadth = 2 cm; length = ?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.163,
            0.309,
            0.626,
            0.327
          ],
          "content": [
            {
              "type": "text",
              "content": "b. Perimeter of a square = 20 cm; side of a length = ?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.163,
            0.336,
            0.693,
            0.354
          ],
          "content": [
            {
              "type": "text",
              "content": "c. Perimeter of a rectangle = 12 m; length = 3 m; breadth = ?",
