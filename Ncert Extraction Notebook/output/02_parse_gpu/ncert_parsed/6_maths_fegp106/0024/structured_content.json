        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.296,
            0.66,
            0.314
          ],
          "content": "**Q.1. Find out the total distance Akshi has covered in 5 rounds.**"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.324,
            0.635,
            0.369
          ],
          "content": "Ans. Perimeter of the outer track = 220 m Total distance Akshi has covered in 5 rounds = 1100 m"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.378,
            0.881,
            0.396
          ],
          "content": "**Q.2. Find out the total distance Toshi has covered in 7 rounds. Who ran a longer distance?**"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.405,
            0.63,
            0.478
          ],
          "content": "Ans. Perimeter of the inner track = 180 m Total distance Toshi has covered in 7 rounds = 1260 m Toshi ran longer distance"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.487,
            0.213,
            0.505
          ],
          "content": "**Deep Dive**"
        },
