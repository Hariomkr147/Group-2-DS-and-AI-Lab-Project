            0.366
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it out",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.116,
            0.374,
            0.881,
            0.41
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.1. The area of a rectangular garden 25 m long is 300 sq m. What is the width of the garden?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.117,
            0.42,
            0.507,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. Width of the garden = 300   25 = 12 m."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.115,
            0.447,
            0.882,
            0.484
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.2. What is the cost of tiling a rectangular plot of land 500 m long and 200 m wide at the rate of Rs.8 per hundred sq. m?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.116,
            0.492,
            0.386,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. Cost of tiling = Rs. 8000"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.115,
            0.519,
            0.883,
            0.574
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.3. A rectangular coconut grove is 100 m long and 50 m wide. If each coconut tree requires 25 sq m, what is the maximum number of trees that can be planted in this grove?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.117,
            0.582,
            0.22,
            0.6
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. 200."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.116,
            0.609,
            0.883,
            0.646
          ],
          "content": [
