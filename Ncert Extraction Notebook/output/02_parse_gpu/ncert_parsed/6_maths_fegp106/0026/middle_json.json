          ],
          "content": [
            {
              "type": "text",
              "content": "Q. Using 9 unit squares, solve the following.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.14,
            0.346,
            0.515,
            0.365
          ],
          "content": [
            {
              "type": "text",
              "content": "1. What is the smallest perimeter possible?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.14,
            0.374,
            0.504,
            0.392
          ],
          "content": [
            {
              "type": "text",
              "content": "2. What is the largest perimeter possible?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.139,
            0.401,
            0.537,
            0.419
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Make a figure with a perimeter of 18 units.",
              "styles": [
                "bold"
              ]
            }
