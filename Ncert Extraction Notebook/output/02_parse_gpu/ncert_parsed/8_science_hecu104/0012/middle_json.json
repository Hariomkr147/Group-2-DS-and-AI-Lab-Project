              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 4.9: (a) Dry cell; (b) Its internal structure"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
