        },
        {
          "type": "text",
          "bbox": [
            0.162,
            0.571,
            0.495,
            0.688
          ],
          "content": "3. Shyamala bought 3 kg bananas at ₹30/- per kg. She counted 35 bananas in all. She sells each banana for ₹5/-. How much profit does she make selling all the bananas?"
        },
        {
          "type": "image",
          "bbox": [
            0.518,
            0.515,
            0.801,
            0.724
          ],
          "content": "",
          "captions": [],
