            {
              "type": "text",
              "content": "Example 11:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " What is the value of "
            },
            {
              "type": "equation_inline",
              "content": "0 . 0 6 \\div 5 ?"
            },
            {
              "type": "text",
              "content": " 0.06 0 Ones + 0 Tenths + 6 Hundredths "
            },
            {
              "type": "equation_inline",
              "content": "0 { \\mathrm { ~ O n e s } } \\div 5 \\rightarrow 0 { \\mathrm { ~ O n e s } } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.15,
            0.153,
            0.611,
            0.209
          ],
          "content": [
            {
              "type": "text",
              "content": "When we move from Ones to Tenths we need to place the decimal point in the quotient. 0 Tenths "
            },
            {
              "type": "equation_inline",
              "content": "\\div 5 \\rightarrow 0"
            },
            {
              "type": "text",
              "content": " Tenths."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.151,
            0.211,
            0.611,
            0.267
          ],
          "content": [
            {
              "type": "text",
              "content": "6 Hundredths "
            },
            {
              "type": "equation_inline",
              "content": "\\div 5 \\rightarrow 1"
            },
            {
              "type": "text",
              "content": " Hundredths, and 1 Hundredth remains. We need to regroup 1 Hundredth into 10 Thousandths."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.151,
            0.271,
            0.531,
            0.316
          ],
          "content": [
            {
              "type": "text",
              "content": "10 Thousandths "
            },
            {
              "type": "equation_inline",
              "content": "\\div 5 \\rightarrow 2"
            },
            {
              "type": "text",
              "content": " Thousandths. So, the quotient is 0.012."
            }
          ]
