          "content": [
            {
              "type": "text",
              "content": "Example 10:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A shopkeeper has 9.5 kg of sugar and he wants to pack it equally in 4 bags. What is the weight of each bag of sugar?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.558,
            0.707,
            0.58
          ],
          "content": [
            {
              "type": "text",
              "content": "To find the weight of each bag we need to divide 9.5 by 4."
            }
          ]
        },
