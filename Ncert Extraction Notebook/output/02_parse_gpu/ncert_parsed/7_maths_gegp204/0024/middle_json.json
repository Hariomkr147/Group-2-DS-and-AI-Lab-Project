          ],
          "content": [
            {
              "type": "text",
              "content": "Making Another Adjustment"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.207,
            0.2,
            0.792,
            0.392
          ],
          "content": [
            {
              "type": "image_body",
              "index": 4,
              "bbox": [
