                0.554
              ],
              "image_path": "images/page_1_table_3.jpg",
              "content": "<table><tbody><tr><td>Fraction</td><td>Expanding the Numerator</td><td>Sum of one-tenths, one-hundredths, one-thousands,...</td><td>Decimals</td></tr><tr><td>2541000</td><td>1200000 +10 5000 +10 400=1 20 +10 50 +10 400</td><td>0.2 + 0.05 + 0.004</td><td>0.254</td></tr><tr><td>84710000</td><td></td><td></td><td></td></tr><tr><td>173100</td><td></td><td></td><td></td></tr><tr><td>231000</td><td></td><td></td><td></td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.111,
            0.574,
            0.815,
            0.662
          ],
          "content": [
            {
              "type": "text",
              "content": "? Can you give a simple rule to divide any number by a number of the form 1 followed by zeroes — 10, 100, 1000, etc.? For example, "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 1 2 3 } { 1 0 } } ,"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 4 } { 1 0 0 }   \\mathrm { o r }   \\frac { 6 7 8 } { 1 0 0 0 }   ?"
            },
            {
              "type": "text",
              "content": " Look for a pattern in the previous problems."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.151,
            0.671,
            0.73,
            0.692
          ],
          "content": [
            {
              "type": "text",
              "content": "Here is one such rule. Let us consider the example "
            },
            {
              "type": "equation_inline",
              "content": "1 2 3 \\div 1 0 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.151,
            0.695,
            0.837,
            0.739
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Write the dividend as it is and place a decimal point at the end. 123."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.744,
            0.636,
            0.765
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Count the number of zeroes in the divisor."
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.224,
            0.768,
            0.356,
            0.789
          ],
          "image_path": "images/page_1_equation_8.jpg",
          "content": "10 \\to 1    zero"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.15,
            0.792,
            0.848,
            0.833
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Move the decimal point from Step 1 left by the same number of places as the count from Step 2. Add zeroes in front if needed."
            }
          ]
