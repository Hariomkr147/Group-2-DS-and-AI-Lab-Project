              "content": "<table><tbody><tr><td></td><td>× 10</td><td>× 100</td><td>× 1000</td></tr><tr><td>5.7</td><td></td><td></td><td></td></tr><tr><td>23.02</td><td></td><td></td><td></td></tr><tr><td>0.92</td><td></td><td></td><td></td></tr><tr><td>0.306</td><td></td><td></td><td></td></tr><tr><td>24.67</td><td></td><td></td><td></td></tr></tbody></table>"
            }
