          "content": "|  | × 10 | × 100 | × 1000 |\n| --- | --- | --- | --- |\n| 5.7 |  |  |  |\n| 23.02 |  |  |  |\n| 0.92 |  |  |  |\n| 0.306 |  |  |  |\n| 24.67 |  |  |  |",
          "captions": [],
