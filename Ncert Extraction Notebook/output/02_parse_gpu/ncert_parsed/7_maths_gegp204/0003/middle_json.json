              ],
              "image_path": "images/page_2_table_2.jpg",
              "content": "<table><tbody><tr><td>24 ÷ 100 = 0.24</td><td>678 ÷ 1000 = 0.678</td></tr><tr><td>12÷1000 = 0.012</td><td>12345÷1000 = 12.345</td></tr></tbody></table>"
