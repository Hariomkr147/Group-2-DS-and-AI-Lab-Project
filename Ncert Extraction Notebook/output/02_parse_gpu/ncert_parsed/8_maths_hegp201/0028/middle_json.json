          "bbox": [
            0.198,
            0.688,
            0.825,
            0.709
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) The population after three months was "
            },
            {
              "type": "equation_inline",
              "content": "p + 0 . 0 5 - 0 . 0 2 - 0 . 0 3 ."
