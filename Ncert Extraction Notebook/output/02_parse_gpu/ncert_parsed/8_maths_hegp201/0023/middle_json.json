          ],
          "image_path": "images/page_22_equation_13.jpg",
          "content": "p \\times r \\times t"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.506,
            0.454,
            0.871,
            0.487
          ],
          "content": [
            {
              "type": "text",
              "content": "The total amount at the end of an FD of t years is"
            }
          ]
        },
        {
          "type": "equation",
