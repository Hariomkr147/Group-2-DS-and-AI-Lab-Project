                0.65,
                0.494,
                0.873
              ],
              "content": [
                {
                  "type": "text",
                  "content": "The total amount in the FD after Year 1 is\n"
                },
                {
                  "type": "equation_inline",
                  "content": "\\widehat{(6000) \\times 1.1}"
                },
                {
                  "type": "text",
                  "content": "\n(principal for Year 1)\nThe total amount in the FD after Year 2 is\n"
                },
                {
                  "type": "equation_inline",
                  "content": "\\hat{(6000 \\times 1.1) \\times 1.1}"
                },
                {
                  "type": "text",
                  "content": "\n(principal for Year 2)\nThe total amount in the FD after Year 3 is\n"
                },
                {
                  "type": "equation_inline",
                  "content": "\\angle (6000 \\times 1.1 \\times 1.1) \\times 1.1"
                },
                {
                  "type": "text",
                  "content": "\n(principal for Year 3)\nThe total amount in the FD after t years is\n6000 × (1.1 × 1.1 × 1.1…..× 1.1)\nt times\n6000 × (1.1)t."
                }
              ]
            }
          ],
          "sub_type": "algorithm"
