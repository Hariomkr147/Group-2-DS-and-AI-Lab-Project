          "bbox": [
            0.152,
            0.555,
            0.364,
            0.575
          ],
          "content": [
            {
              "type": "text",
              "content": "With Compounding"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.15,
            0.578,
            0.847,
            0.637
          ],
          "content": [
            {
              "type": "text",
              "content": "Here, the interest gained every term/year is added back to the FD. Therefore, the principal amount increases after every term, and as a result, the interest gained every term also increases proportionately."
            }
          ]
        },
        {
          "type": "code",
          "index": 18,
          "bbox": [
            0.118,
            0.65,
            0.494,
            0.873
          ],
          "content": [
