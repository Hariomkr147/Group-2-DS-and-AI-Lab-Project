                0.908
              ],
              "content": "(ii)"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_11_table_5.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.151,
            0.421,
            0.848,
            0.553
          ],
          "content": "",
          "captions": [],
