          ],
          "image_path": "images/page_26_equation_18.jpg",
          "content": "d = { \\frac { 1 } { 3 } } = 0 . 3 3 ."
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.197,
            0.702,
            0.657,
            0.722
          ],
          "content": [
            {
              "type": "text",
              "content": "The discount offered should have been 33.33%."
            }
          ]
        },
        {
          "type": "text",
