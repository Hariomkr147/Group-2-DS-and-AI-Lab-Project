          "image_source": "images/page_4_image_7.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.431,
            0.54,
            0.575,
            0.585
          ],
          "content": "Ice cream is about 30 – 50% air by volume."
        },
        {
          "type": "image",
          "bbox": [
            0.647,
            0.402,
            0.857,
            0.519
          ],
          "content": "",
          "captions": [],
