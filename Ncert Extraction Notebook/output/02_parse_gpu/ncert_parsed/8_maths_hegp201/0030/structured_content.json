        },
        {
          "type": "text",
          "bbox": [
            0.162,
            0.156,
            0.477,
            0.176
          ],
          "content": "15. Look at the following graph."
        },
        {
          "type": "chart",
          "bbox": [
            0.109,
            0.179,
            0.928,
            0.549
          ],
          "content": "",
          "captions": [],
