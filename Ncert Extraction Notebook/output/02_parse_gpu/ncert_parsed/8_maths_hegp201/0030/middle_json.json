          "bbox": [
            0.203,
            0.662,
            0.847,
            0.702
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) People in their twenties are the most computer-literate among all age groups."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.198,
            0.704,
            0.846,
            0.744
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Women lag behind in the ability to use computers across age groups."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.192,
            0.747,
            0.779,
            0.768
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) There are more people in their twenties than teenagers."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.192,
            0.771,
            0.845,
            0.792
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) More than a quarter of people in their thirties can use computers."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.197,
            0.795,
            0.776,
            0.816
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) Less than 1 in 10 aged 60 and above can use computers."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.192,
            0.819,
            0.768,
            0.841
          ],
          "content": [
            {
              "type": "text",
              "content": "(vi) Half of the people in their twenties can use computers."
            }
          ]
