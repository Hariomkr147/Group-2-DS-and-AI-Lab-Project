            },
            {
              "type": "text",
              "content": "Example 7:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If one deposits ₹6000 in the bank, what is the amount after 3 years?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.152,
            0.524,
            0.748,
            0.544
          ],
          "content": [
            {
              "type": "text",
              "content": "That depends on the choice of FD. There are two possibilities:"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.152,
            0.548,
            0.845,
            0.587
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Option 1: The interest is paid out regularly (for example, every year). The principal amount is returned after the maturity period."
            }
          ]
        },
