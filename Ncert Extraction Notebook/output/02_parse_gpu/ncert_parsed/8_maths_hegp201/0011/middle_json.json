                0.251
              ],
              "content": [
                {
                  "type": "text",
                  "content": "3500 5000 × 100 = 70%"
                }
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.279,
            0.249,
            0.425,
            0.276
          ],
          "image_path": "images/page_10_equation_6.jpg",
          "content": "40\\% = \\frac{40}{100} = \\frac{2}{5} = 0.4"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.577,
            0.249,
            0.731,
            0.276
          ],
          "image_path": "images/page_10_equation_8.jpg",
          "content": "70\\% = \\frac{70}{100} = \\frac{7}{10} = 0.7"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.282,
            0.511,
            0.302
          ],
          "content": [
            {
              "type": "text",
              "content": "It is 40% on Day 1 and 70% on Day 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.152,
            0.301,
            0.845,
            0.34
          ],
          "content": [
            {
              "type": "text",
              "content": "Another way of saying it is — he was 60% short of his target on Day 1 and 30% short of his target on Day 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.111,
            0.341,
            0.846,
            0.382
          ],
          "content": [
            {
              "type": "text",
              "content": "? In the next two days, he made ₹5000 and ₹6000 respectively. What percentage of his target are these values?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.384,
            0.846,
            0.423
          ],
          "content": [
            {
              "type": "text",
              "content": "His target is ₹5000, and he made ₹5000 on Day 3 — this is 100%. On Day 4, he made ₹6000, which is 1000 more than his target."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.111,
            0.423,
            0.683,
            0.449
          ],
          "content": [
            {
              "type": "text",
              "content": "? What percentage of the target was achieved on Day 4?"
            }
          ]
        },
        {
          "type": "chart",
          "index": 14,
          "bbox": [
            0.208,
            0.459,
            0.489,
            0.556
          ],
          "content": [
            {
              "type": "chart_body",
              "index": 14,
              "bbox": [
                0.208,
                0.459,
                0.489,
                0.556
              ],
              "image_path": "images/page_10_chart_14.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.25,
            0.555,
            0.395,
            0.58
          ],
          "image_path": "images/page_10_equation_15.jpg",
          "content": "\\frac{5000}{5000} \\times 100 = 100\\%"
        },
        {
          "type": "image",
          "index": 16,
          "bbox": [
            0.523,
            0.459,
            0.793,
            0.556
          ],
          "content": [
            {
              "type": "image_body",
              "index": 16,
              "bbox": [
                0.523,
                0.459,
                0.793,
                0.556
              ],
              "image_path": "images/page_10_image_16.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.57,
            0.555,
            0.715,
            0.58
          ],
          "image_path": "images/page_10_equation_17.jpg",
          "content": "\\frac{6000}{5000} \\times 100 = 120\\%"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.247,
            0.578,
            0.4,
            0.604
          ],
          "image_path": "images/page_10_equation_18.jpg",
          "content": "100\\% = \\frac{100}{100} = \\frac{1}{1} = 1.0"
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.566,
            0.578,
            0.719,
            0.604
          ],
          "image_path": "images/page_10_equation_19.jpg",
          "content": "120\\% = \\frac{120}{100} = \\frac{6}{5} = 1.2"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.152,
            0.61,
            0.846,
            0.675
          ],
          "content": [
            {
              "type": "text",
              "content": "1000 is 20% of 5000. Therefore, 6000, (5000 + 1000) is "
            },
            {
              "type": "equation_inline",
              "content": "100\\% + 20\\%"
            },
            {
              "type": "text",
              "content": " = 120% of 5000. It can also be computed as "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{6000}{5000} \\times 100 = \\frac{6}{5} \\times 100 = 120\\%."
            },
            {
              "type": "text",
              "content": " This means he achieved 120% of his target, i.e., 20% more than his target."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.111,
            0.676,
            0.846,
            0.718
          ],
          "content": [
            {
              "type": "text",
              "content": "？ On Days 5 and 6 his sales were ₹7800 and ₹9550 respectively. Calculate the percentage of the target achieved on these days."
