          ],
          "image_path": "images/page_10_equation_4.jpg",
          "content": "\\frac{2000}{5000} \\times 100 = 40\\%"
        },
        {
          "type": "chart",
          "index": 5,
          "bbox": [
            0.527,
            0.123,
            0.77,
            0.227
          ],
          "content": [
            {
              "type": "chart_body",
