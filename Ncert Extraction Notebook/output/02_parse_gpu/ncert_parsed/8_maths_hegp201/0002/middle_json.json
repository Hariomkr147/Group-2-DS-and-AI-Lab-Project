        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.151,
            0.093,
            0.847,
            0.159
          ],
          "content": [
            {
              "type": "text",
              "content": "Explaining this in a different way: To express "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " as a percentage, we need to find its equivalent fraction with 100 as the denominator. Two ways of going ahead are shown below."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.245,
            0.175,
            0.344,
            0.196
          ],
          "content": [
            {
              "type": "text",
              "content": "Method 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.585,
            0.175,
            0.688,
            0.197
          ],
          "content": [
            {
              "type": "text",
              "content": "Method 2"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.25,
            0.205,
            0.385,
            0.27
          ],
          "image_path": "images/page_1_equation_4.jpg",
          "content": "\\begin{aligned}\\frac{3}{4} &= \\frac{3 \\times 25}{4 \\times 25} \\\\&= \\frac{75}{100} = 75\\%\\end{aligned}"
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.52,
            0.206,
            0.753,
            0.33
          ],
          "image_path": "images/page_1_equation_5.jpg",
          "content": "\\begin{aligned}\\frac{3}{4} &= \\frac{x}{100} \\cdot \\\\\\frac{3}{4} \\times 100 &= \\frac{x}{100} \\times 100 \\\\\\left[  multiply both sides by   100 \\right] \\\\x &= \\frac{3}{4} \\times 100 \\\\&= 75.\\end{aligned}"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.152,
            0.342,
            0.45,
            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " can be expressed as 75%."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.371,
            0.845,
            0.417
          ],
          "content": [
            {
              "type": "text",
              "content": "Observe the following bar model diagram showing the equivalence between "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 4 }"
            },
            {
              "type": "text",
              "content": " and 75%."
            }
          ]
        },
        {
          "type": "chart",
          "index": 8,
          "bbox": [
            0.223,
            0.431,
            0.776,
            0.638
          ],
          "content": [
            {
              "type": "chart_body",
