          ],
          "content": [
            {
              "type": "text",
              "content": "？ "
            },
            {
              "type": "text",
              "content": "Example 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Surya won some prize money in a contest. He wants to save "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 } { 5 }"
            },
            {
              "type": "text",
              "content": " of the money to purchase a new canvas. Express this quantity as a percentage."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.151,
            0.774,
            0.846,
            0.813
          ],
          "content": [
            {
              "type": "text",
              "content": "Try to understand the different methods for solving this problem, as shown below."
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.307,
            0.828,
            0.407,
            0.851
          ],
          "image_path": "images/page_1_equation_12.jpg",
          "content": "\\operatorname { M e t h o d 1 }"
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.299,
            0.859,
            0.415,
            0.911
          ],
          "image_path": "images/page_1_equation_13.jpg",
          "content": "\\begin{aligned}\\frac{2}{5} &= \\frac{20}{50} = \\frac{40}{100} \\\\&= 40\\%.\\end{aligned}"
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.56,
            0.827,
            0.719,
            0.919
          ],
          "image_path": "images/page_1_equation_14.jpg",
          "content": "\\begin{aligned} & 故  \\; \\begin{aligned}\\\\ &\\bmod 2 \\\\&\\frac{2}{5} = \\frac{x}{100}.\\\\ &\\end{aligned}\\\\ &\\quad x = \\frac{2}{5} \\times 100 = 40.\\\\ \\end{aligned}"
        },
