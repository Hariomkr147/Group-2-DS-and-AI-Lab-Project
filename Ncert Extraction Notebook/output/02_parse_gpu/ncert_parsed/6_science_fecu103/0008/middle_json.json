        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.13,
            0.225,
            0.231,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "More to know!",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.27,
            0.184,
            0.725,
            0.246
          ],
          "content": [
            {
              "type": "text",
              "content": "Have you ever seen mushrooms? They grow mostly in dark and moist places. Edible mushrooms are good sources of protein."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.739,
            0.16,
            0.884,
            0.256
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.739,
