            0.144,
            0.121,
            0.437,
            0.141
          ],
          "content": [
            {
              "type": "text",
              "content": "Here is how it can be done:"
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.353,
            0.154,
            0.594,
            0.336
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.353,
                0.154,
