            0.354
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Can you think of other examples where mathematics helps us in our everyday lives?"
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.835,
