                0.758,
                0.503
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Quadrilateral"
                }
              ]
            },
            {
              "type": "image_footnote",
              "index": 10,
              "bbox": [
                0.19,
                0.533,
                0.296,
                0.549
              ],
              "content": [
                {
                  "type": "text",
                  "content": "6-sided figure"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.151,
            0.556,
            0.846,
            0.631
          ],
          "content": [
            {
              "type": "text",
              "content": "We can rule out the first possibility by looking at the sum of angles x and y. Since AB ‖ CD, we have "
            },
            {
              "type": "equation_inline",
              "content": "x + y = 180"
            },
            {
              "type": "text",
              "content": " , since they are internal angles along the same side of the transversal (BC). So ABD́ and A ́CD are straight lines. Therefore, the resulting figure is a quadrilateral."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.111,
            0.632,
            0.506,
            0.655
          ],
          "content": [
            {
              "type": "text",
              "content": "What type of a quadrilateral is this?"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.151,
            0.657,
            0.659,
            0.677
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us look at the other two angles of the trapezium."
            }
          ]
        },
        {
          "type": "image",
          "index": 14,
          "bbox": [
            0.312,
            0.681,
            0.679,
            0.779
          ],
          "content": [
            {
              "type": "image_body",
              "index": 14,
              "bbox": [
                0.312,
                0.681,
                0.679,
                0.779
              ],
              "image_path": "images/page_20_image_14.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.152,
            0.787,
            0.846,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "We have "
            },
            {
              "type": "equation_inline",
              "content": "u + v = 180"
            },
            {
              "type": "text",
              "content": " . Therefore, AD‖D́ A ́, since the sum of the internal angles along the same side of the transversal A ́D is 180°. Since we already have AD́  ‖ A ́D, the quadrilateral AD́ A ́D is actually a parallelogram."
            }
          ]
        },
