            0.114,
            0.275,
            0.847,
            0.338
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What figure will we get when the two trapeziums are joined along BC? The possibilities are either a 6-sided figure or a 4-sided figure (quadrilateral)."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.152,
            0.348,
            0.287,
            0.368
          ],
          "content": [
            {
              "type": "text",
              "content": "Possibilities",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.131,
            0.367,
            0.469,
            0.534
          ],
          "content": [
            {
              "type": "image_body",
              "index": 7,
              "bbox": [
                0.131,
