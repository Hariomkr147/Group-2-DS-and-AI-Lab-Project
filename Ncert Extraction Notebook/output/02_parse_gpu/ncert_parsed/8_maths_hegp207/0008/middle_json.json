            0.815,
            0.049,
            0.861,
            0.064
          ],
          "content": [
            {
              "type": "text",
              "content": "Area"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 1,
          "bbox": [
            0.152,
            0.089,
            0.569,
            0.109
          ],
          "content": [
            {
              "type": "text",
              "content": "Some Applications of the Area Formula"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.114,
            0.124,
            0.238,
            0.146
          ],
          "content": [
            {
              "type": "text",
              "content": "Find BY."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.151,
            0.156,
            0.613,
            0.194
          ],
          "content": [
            {
              "type": "text",
              "content": "BY can be found using the formula for the area of a triangle."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.152,
            0.199,
            0.367,
            0.217
          ],
          "content": [
            {
              "type": "text",
              "content": "What is Area (∆ABC)?"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.189,
            0.226,
            0.576,
            0.254
          ],
          "content": [
            {
              "type": "text",
              "content": "Area "
            },
            {
              "type": "equation_inline",
              "content": "( \\Delta  ABC  ) = \\frac{1}{2} \\times  AX  \\times  BC  = \\frac{15}{2}"
            },
            {
              "type": "text",
              "content": " sq. units."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.616,
            0.097,
            0.883,
            0.247
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.616,
                0.097,
                0.883,
                0.247
              ],
              "image_path": "images/page_7_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.176,
            0.26,
            0.625,
            0.279
          ],
          "content": [
            {
              "type": "text",
              "content": "The area of the triangle can also be written as"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.281,
            0.282,
            0.716,
            0.31
          ],
          "image_path": "images/page_7_equation_8.jpg",
          "content": "\\mathrm{Area}\\left(\\Delta \\mathrm{ABC}\\right)=\\frac{1}{2} \\times \\mathrm{BY} \\times \\mathrm{AC}=\\frac{1}{2} \\times 4 \\times \\mathrm{BY}=2 \\mathrm{BY}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.311,
            0.213,
            0.329
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.45,
            0.338,
            0.547,
            0.366
          ],
          "image_path": "images/page_7_equation_10.jpg",
          "content": "2 \\; \\mathrm { B Y } = { \\frac { 1 5 } { 2 } } ."
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.382,
            0.374,
            0.614,
            0.402
          ],
          "image_path": "images/page_7_equation_11.jpg",
          "content": "\\mathrm{SO}, \\mathrm{BY} = \\frac{15}{4} = 3.75 \\mathrm{units}."
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.117,
            0.415,
            0.846,
            0.436
          ],
          "content": [
            {
              "type": "text",
              "content": "Are the 4 triangles obtained by drawing the diagonals of a rectangle"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.152,
            0.435,
            0.567,
            0.455
          ],
          "content": [
            {
              "type": "text",
              "content": "(regions 1 – 4 in the figure) of equal areas?"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.152,
            0.465,
            0.603,
            0.503
          ],
          "content": [
            {
              "type": "text",
              "content": "Clearly, the triangles 1 – 4 are not four congruent triangles."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.152,
            0.503,
            0.604,
            0.541
          ],
          "content": [
            {
              "type": "text",
              "content": "To compare their areas, let us consider any two adjacent triangles, say 1 and 2."
            }
          ]
        },
        {
          "type": "image",
          "index": 16,
          "bbox": [
            0.61,
            0.436,
            0.875,
            0.557
          ],
          "content": [
            {
              "type": "image_body",
              "index": 16,
              "bbox": [
                0.61,
                0.436,
                0.875,
                0.557
              ],
              "image_path": "images/page_7_image_16.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.151,
            0.581,
            0.605,
            0.676
          ],
          "content": [
            {
              "type": "text",
              "content": "Since the area of a triangle depends on its height and the base, let us consider suitable height-base pairs in each of the triangles. If OD and OB are taken as the bases, then we see that both triangles have the same altitude!"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.175,
            0.692,
            0.605,
            0.711
          ],
          "content": [
            {
              "type": "text",
              "content": "We also have "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{OB} = \\mathrm{OD},"
            },
            {
              "type": "text",
              "content": " since the diagonals of"
            }
          ]
        },
        {
          "type": "image",
          "index": 19,
          "bbox": [
            0.613,
            0.572,
            0.88,
            0.694
          ],
          "content": [
            {
              "type": "image_body",
              "index": 19,
              "bbox": [
                0.613,
                0.572,
                0.88,
                0.694
              ],
              "image_path": "images/page_7_image_19.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.153,
            0.711,
            0.844,
            0.73
          ],
          "content": [
            {
              "type": "text",
              "content": "a rectangle bisect each other. So, the triangles 1 and 2 have equal areas."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.176,
            0.73,
            0.845,
            0.749
          ],
          "content": [
            {
              "type": "text",
              "content": "Arguing this way, we can show that all four triangles have equal areas."
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.152,
            0.761,
            0.553,
            0.798
          ],
          "content": [
            {
              "type": "text",
              "content": "From this problem, we can make the following general statement."
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.152,
            0.798,
            0.554,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "In a triangle, the line joining a vertex to the midpoint of its opposite side divides the triangle into two triangles of equal areas."
            }
          ]
        },
        {
          "type": "image",
          "index": 24,
          "bbox": [
            0.562,
            0.753,
            0.883,
            0.84
          ],
          "content": [
            {
              "type": "image_body",
              "index": 24,
              "bbox": [
                0.562,
                0.753,
                0.883,
                0.84
              ],
              "image_path": "images/page_7_image_24.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.561,
            0.842,
            0.88,
            0.872
          ],
          "content": [
            {
              "type": "text",
              "content": "Triangles 1 and 2 have equal areas as they have the same measures for height and base"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 26,
          "bbox": [
            0.871,
            0.914,
            0.918,
            0.934
          ],
          "content": [
            {
              "type": "text",
              "content": "155"
            }
          ]
        }
      ]
    }
  ],
