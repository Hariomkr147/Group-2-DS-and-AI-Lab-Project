          ],
          "content": [
            {
              "type": "text",
              "content": "Area"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.151,
            0.089,
            0.847,
            0.127
          ],
          "content": [
            {
              "type": "text",
              "content": "We have taken the length of one of the parallel sides as a. Let b be the length of the other parallel side."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.151,
            0.126,
            0.847,
            0.183
          ],
          "content": [
            {
              "type": "text",
              "content": "Can the area of the trapezium be expressed in terms of a, b and h? To replace "
            },
            {
              "type": "equation_inline",
              "content": "x + y"
            },
            {
              "type": "text",
              "content": " in the area expression with a and b, observe that "
            },
            {
              "type": "equation_inline",
              "content": "b = x + y + a."
            },
            {
              "type": "text",
              "content": " . Subtracting a from both sides, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.436,
            0.188,
            0.561,
            0.207
          ],
          "image_path": "images/page_19_equation_3.jpg",
          "content": "x + y = b - a ."
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.152,
            0.205,
            0.329,
            0.226
          ],
          "content": [
            {
              "type": "text",
              "content": "Using this, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.364,
            0.227,
            0.634,
            0.286
          ],
          "image_path": "images/page_19_equation_5.jpg",
          "content": "{ \\mathrm { A r e a ~ W X Y Z } } = { \\frac { 1 } { 2 } }   h ( b - a + 2 a ) , \\qquad { \\mathrm { A r e a ~ W X Y Z } } = { \\frac { 1 } { 2 } }   h ( b - a + 2 a ) ."
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.152,
            0.279,
            0.262,
            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.215,
            0.312,
            0.777,
            0.34
          ],
          "content": [
            {
              "type": "text",
              "content": "Area of a trapezium "
            },
            {
              "type": "equation_inline",
              "content": "\\scriptstyle { \\frac { 1 } { 2 } } \\times h e i g h t \\times s u m"
            },
            {
              "type": "text",
              "content": " of the parallel sides."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.114,
            0.359,
            0.718,
            0.383
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Will this formula hold for a trapezium that looks like this?"
            }
          ]
        },
        {
          "type": "image",
