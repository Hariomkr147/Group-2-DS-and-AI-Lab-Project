                0.526
              ],
              "content": "Fig.7.5: Room thermometer"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_11_image_7.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.254,
            0.531,
            0.54,
            0.553
          ],
          "level": 2,
          "content": "Activity 7.7: Let us analyse"
        },
        {
          "type": "text",
          "bbox": [
            0.256,
            0.563,
            0.883,
            0.605
          ],
          "content": "Read or listen to the weather reports for a place for 10 successive days."
        },
        {
          "type": "text",
          "bbox": [
            0.257,
            0.61,
            0.882,
            0.651
          ],
          "content": " Record the maximum and minimum air temperature for each day in Table 7.3."
