            0.884,
            0.915
          ],
          "content": [
            {
              "type": "text",
              "content": " Laboratory thermometers typically have a temperature range from "
            },
            {
              "type": "equation_inline",
              "content": "- 1 0 \\; ^ { \\circ } \\mathrm { C }"
            },
            {
              "type": "text",
