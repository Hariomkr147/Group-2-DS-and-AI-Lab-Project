          ],
          "content": [
            {
              "type": "text",
              "content": "All three temperature scales, Celsius, Fahrenheit and Kelvin are named in honour of the scientists who developed these scales."
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.443,
            0.1,
            0.78,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "We can easily convert the temperature from Celsius scale to Kelvin scale by using:"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.443,
            0.167,
            0.676,
            0.23
          ],
          "content": [
            {
              "type": "text",
              "content": "Temperature in Kelvin scale = Temperature in Celsius scale + 273.15"
            }
          ]
        },
        {
          "type": "image",
          "index": 3,
          "bbox": [
            0.747,
            0.178,
            0.82,
