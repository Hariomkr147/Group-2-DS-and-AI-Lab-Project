            0.115
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 7.2: Let us measure"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.114,
            0.126,
            0.573,
            0.271
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us now use a digital clinical thermometer to measure body temperature. You may measure your own temperature as well as the temperature of some of your friends. Talk to your friends to find out who would be willing to get their body temperatures measured by you."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.117,
            0.274,
            0.572,
            0.336
          ],
          "content": [
            {
              "type": "text",
              "content": " Wash your hands and the tip of the digital thermometer with soap and water."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.117,
            0.342,
            0.573,
            0.383
          ],
          "content": [
            {
              "type": "text",
              "content": " Reset the thermometer by pressing the reset button."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.117,
            0.388,
            0.574,
            0.431
          ],
          "content": [
            {
              "type": "text",
              "content": "Place the thermometer under the tongue and close your mouth."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.117,
            0.435,
            0.576,
            0.477
          ],
          "content": [
            {
              "type": "text",
              "content": "Wait till the thermometer makes a beeping sound or flashes a light."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.481,
            0.574,
            0.524
          ],
          "content": [
            {
              "type": "text",
              "content": "Take it out from the mouth and read the temperature on the digital display."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.116,
            0.528,
            0.553,
            0.55
          ],
          "content": [
            {
              "type": "text",
              "content": "Record",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the temperature in Table 7.1."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.722,
            0.124,
            0.781,
            0.167
          ],
          "content": [
            {
              "type": "text",
              "content": "A"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.685,
            0.174,
            0.818,
            0.192
          ],
          "content": [
            {
              "type": "text",
              "content": "Precautions"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.65,
            0.194,
            0.854,
            0.251
          ],
          "content": [
            {
              "type": "text",
              "content": "to be taken while using a digital clinical thermometer"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.606,
            0.256,
            0.897,
            0.315
          ],
          "content": [
            {
              "type": "text",
              "content": "To be used after reading the instruction manual of the thermometer."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.606,
            0.32,
            0.897,
            0.378
          ],
          "content": [
            {
              "type": "text",
              "content": "Tip of the thermometer to be washed with soap and water before and after use."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.605,
            0.384,
            0.897,
            0.461
          ],
          "content": [
            {
              "type": "text",
              "content": "While washing, care to be taken to keep the digital portion such as the display out of water."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.606,
            0.465,
            0.897,
            0.506
          ],
          "content": [
            {
              "type": "text",
              "content": "Do not hold the thermometer by the tip."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.117,
            0.554,
            0.743,
            0.596
          ],
          "content": [
            {
              "type": "text",
              "content": " Clean the tip of the thermometer with soap and water, and dry it."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.117,
            0.601,
            0.743,
            0.643
          ],
          "content": [
            {
              "type": "text",
              "content": " Repeat the above steps for measuring the temperatures of your friends."
            }
          ]
        },
        {
          "type": "table",
          "index": 18,
