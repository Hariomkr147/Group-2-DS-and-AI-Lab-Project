              ],
              "image_path": "images/page_21_table_5.jpg",
              "content": "<table><tbody><tr><td></td><td>Lying down</td><td>Sitting</td><td>Standing or Moving around etc.</td></tr><tr><td>Pavani (Patient)</td><td>20</td><td>3</td><td>1</td></tr><tr><td>Raghu (Nurse)</td><td>7</td><td>4</td><td>13</td></tr><tr><td>Zakir (Teacher)</td><td>8</td><td>6</td><td>10</td></tr><tr><td>Sahana (Student)</td><td></td><td></td><td></td></tr><tr><td>Julie (___________)</td><td>8</td><td>10</td><td>6</td></tr></tbody></table>"
