          ],
          "content": [
            {
              "type": "text",
              "content": "Do you remember the ‘What Can A Strip Say?’ activity from last year? In each strip, if we club the tiny strips belonging to each activity together, will we get a 100% stacked bar chart like the one in Fig. 10.6?"
            }
          ]
