        {
          "type": "text",
          "bbox": [
            0.172,
            0.216,
            0.336,
            0.235
          ],
          "content": "**(d) Leishmania.**"
        },
        {
          "type": "text",
          "bbox": [
            0.14,
            0.235,
            0.894,
            0.271
          ],
          "content": "**2. Which of the following is not a part of the female reproductive system in human beings?**"
        },
        {
          "type": "text",
          "bbox": [
            0.172,
            0.272,
            0.294,
            0.292
          ],
          "content": "**(a) Ovary**"
        },
        {
          "type": "text",
          "bbox": [
            0.172,
            0.292,
            0.299,
            0.311
          ],
          "content": "**(b) Uterus**"
        },
        {
          "type": "text",
          "bbox": [
            0.173,
            0.311,
            0.347,
            0.331
          ],
          "content": "**(c) Vas deferens**"
        },
        {
          "type": "text",
          "bbox": [
            0.172,
            0.331,
            0.364,
            0.351
          ],
          "content": "**(d) Fallopian tube**"
        },
        {
          "type": "text",
          "bbox": [
            0.142,
            0.351,
            0.364,
            0.371
          ],
          "content": "**3. The anther contains**"
