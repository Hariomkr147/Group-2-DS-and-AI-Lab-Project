        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.088,
            0.489,
            0.109
          ],
          "content": "6. Construct the following figure."
        },
        {
          "type": "image",
          "bbox": [
            0.407,
            0.112,
            0.59,
            0.246
          ],
          "content": "",
          "captions": [],
