            0.764,
            0.801,
            0.804
          ],
          "content": [
            {
              "type": "text",
              "content": "4. What are the other angles that can be constructed using angle bisection? Can you construct "
            },
            {
              "type": "equation_inline",
              "content": "6 5 . 5 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " angle?"
            }
          ]
        },
        {
