      "page_idx": 27,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.408,
            0.102,
            0.59,
            0.126
          ],
          "level": 2,
          "content": "SUMMARY"
        },
        {
          "type": "text",
          "bbox": [
            0.176,
            0.143,
            0.821,
            0.18
          ],
          "content": "A division of a line segment, or any geometrical quantity, into two identical parts is called **bisection**."
        },
        {
          "type": "text",
          "bbox": [
            0.176,
            0.181,
            0.822,
            0.238
          ],
          "content": "Any point that is of equal distance from the two endpoints of a given line segment lies on its **perpendicular bisector.** This property can be used to construct the perpendicular bisector using a ruler and compass."
        },
        {
          "type": "text",
          "bbox": [
            0.176,
            0.238,
            0.823,
            0.294
          ],
          "content": "The method of constructing the perpendicular bisector can be modified to draw a 90° angle at any point on a line using only a ruler and compass."
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.296,
            0.822,
            0.332
          ],
          "content": "An angle can be bisected and copied using the congruence properties of triangles."
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.334,
            0.823,
            0.371
          ],
          "content": "A 60° angle can be constructed using a ruler and compass by constructing an equilateral triangle."
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.372,
            0.822,
            0.409
          ],
          "content": "Covering a region using a set of shapes, without gaps or overlaps, is called **tiling**."
        }
      ]
    }
  ],
