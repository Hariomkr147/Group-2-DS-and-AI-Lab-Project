        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.111,
            0.752,
            0.546,
            0.776
          ],
          "content": [
            {
              "type": "text",
              "content": "Can a "
            },
            {
              "type": "equation_inline",
              "content": "4 \\times 7"
            },
            {
              "type": "text",
              "content": " grid be tiled using "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 1"
            },
            {
              "type": "text",
              "content": " tiles?"
