            0.151,
            0.815,
            0.847,
            0.855
          ],
          "content": [
            {
              "type": "text",
              "content": "To see that there is no way to tile a "
            },
            {
              "type": "equation_inline",
              "content": "5 \\times 7"
            },
            {
              "type": "text",
              "content": " grid using "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 1"
            },
            {
              "type": "text",
              "content": " tiles, observe that this grid has 35 unit squares. Each tile covers exactly 2 unit squares."
