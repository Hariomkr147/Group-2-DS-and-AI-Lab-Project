          ],
          "content": [
            {
              "type": "text",
              "content": "Covering a region using a set of shapes, without gaps or overlaps, is called "
            },
            {
              "type": "text",
              "content": "tiling",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": "."
            }
