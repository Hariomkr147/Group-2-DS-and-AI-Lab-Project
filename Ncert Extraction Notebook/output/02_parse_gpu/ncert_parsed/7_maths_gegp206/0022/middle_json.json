          "bbox": [
            0.175,
            0.127,
            0.681,
            0.146
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider a rectangu"
            },
            {
              "type": "text",
              "content": "lar grid made of unit square",
              "styles": [
                "underline"
              ]
            },
            {
              "type": "text",
              "content": "s —"
            }
          ]
        },
        {
          "type": "image",
