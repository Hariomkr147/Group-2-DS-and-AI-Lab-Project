            0.151,
            0.314,
            0.718,
            0.334
          ],
          "content": [
            {
              "type": "text",
              "content": "We call this a "
            },
            {
              "type": "equation_inline",
              "content": "4 \\times 6"
            },
            {
              "type": "text",
              "content": " grid, since it has 4 rows and 6 columns."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.111,
            0.343,
            0.722,
            0.389
          ],
          "content": [
            {
              "type": "text",
              "content": "? Can a "
            },
            {
              "type": "equation_inline",
              "content": "4 \\times 6"
            },
            {
              "type": "text",
              "content": " grid be tiled using multiple copies of "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 1"
            },
            {
              "type": "text",
              "content": " tiles? We are allowed to rotate a "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 1"
            },
            {
              "type": "text",
              "content": " tile and use it."
