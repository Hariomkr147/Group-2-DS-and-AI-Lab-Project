            0.158,
            0.398,
            0.496,
            0.438
          ],
          "content": [
            {
              "type": "text",
              "content": "The supporting lines for this figure will look like this."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.557,
            0.325,
            0.785,
            0.495
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.557,
                0.325,
                0.785,
                0.495
              ],
              "image_path": "images/page_7_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.111,
            0.517,
            0.606,
            0.54
          ],
          "content": [
            {
              "type": "text",
              "content": "What is the angle between two adjacent lines?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.15,
            0.542,
            0.846,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "We need the angle between every pair of adjacent lines to be equal. Since "
            },
            {
              "type": "equation_inline",
              "content": "3 6 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " is equally divided into 8 parts, every angle is "
            },
            {
              "type": "equation_inline",
              "content": "4 5 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.591,
            0.846,
            0.657
          ],
          "content": [
            {
              "type": "text",
              "content": "? How do we construct a "
            },
            {
              "type": "equation_inline",
              "content": "4 5 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " angle using only a ruler and a compass? We know how to construct a "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " angle. If we can divide it into two equal parts, or bisect it, then we get a "
            },
            {
              "type": "equation_inline",
              "content": "4 5 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " angle."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.705,
            0.629,
            0.745
          ],
          "content": [
            {
              "type": "text",
              "content": "We will now develop a general method to bisect any angle. Consider an angle ∠XOY."
            }
          ]
        },
        {
          "type": "image",
          "index": 11,
          "bbox": [
            0.651,
            0.661,
            0.836,
            0.771
          ],
          "content": [
            {
              "type": "image_body",
              "index": 11,
              "bbox": [
                0.651,
                0.661,
                0.836,
                0.771
              ],
              "image_path": "images/page_7_image_11.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.813,
            0.63,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "We can bisect it if we can draw two congruent triangles ΔOBC and ΔOAC as shown in the figure. Then "
            },
            {
              "type": "equation_inline",
              "content": "\\angle BOC = \\angle AOC"
            }
          ]
        },
