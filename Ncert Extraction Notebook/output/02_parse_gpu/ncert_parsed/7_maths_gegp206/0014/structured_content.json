            0.116,
            0.286,
            0.134
          ],
          "content": "**Trefoil Arch**"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.14,
            0.565,
            0.16
          ],
          "content": "Have you seen this kind of beautiful arch?"
        },
        {
