          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.111,
            0.456,
            0.595,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "Construct this arch shape on a piece of paper."
