        {
          "type": "text",
          "bbox": [
            0.115,
            0.811,
            0.907,
            0.831
          ],
          "content": "**(a) Give expressions to generate all the numbers in a given column (1, 2, 3, 4).**"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.845,
            0.401,
            0.862
          ],
          "content": "Let r be the row number."
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.865,
            0.259,
            0.882
          ],
          "content": "Column 1:"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.884,
            0.67,
            0.902
          ],
          "content": "So, number in the rth row of column 1 = 4 × (r – 1) + 1"
        },
