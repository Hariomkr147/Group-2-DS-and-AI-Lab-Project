        },
        {
          "type": "text",
          "bbox": [
            0.123,
            0.469,
            0.882,
            0.509
          ],
          "content": "**15.Numbers are written in a particular sequence in this endless 4 – column grid.**"
        },
        {
          "type": "table",
          "bbox": [
