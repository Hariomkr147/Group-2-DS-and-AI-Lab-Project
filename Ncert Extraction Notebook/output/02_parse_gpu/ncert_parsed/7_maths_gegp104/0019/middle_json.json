            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.15,
            0.817,
            0.846,
            0.872
          ],
          "content": [
            {
              "type": "text",
              "content": "["
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Consider a general set of numbers that forms this shape. Take the number at the centre to be ‘a’. Express the other numbers in terms of ‘a’.] 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.15,
            0.872,
            0.802,
            0.912
          ],
          "content": [
            {
              "type": "text",
              "content": "Find other shapes for which the sum of the numbers within the figure is always a multiple of one of the numbers."
            }
          ]
        },
        {
