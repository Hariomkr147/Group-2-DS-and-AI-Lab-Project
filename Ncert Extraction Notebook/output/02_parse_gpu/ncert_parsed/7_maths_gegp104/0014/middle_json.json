          ],
          "content": [
            {
              "type": "text",
              "content": "2. Simplify each of the following expressions:"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.206,
            0.301,
            0.763,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) "
            },
            {
              "type": "equation_inline",
              "content": "p + p + p + p , p + p + p + q ,"
            },
            {
              "type": "text",
              "content": " (b) p + q + p – q,"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.206,
            0.325,
            0.764,
            0.345
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) p – q + p – q, (d) p + q – p + q,"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.206,
            0.349,
            0.76,
            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "(e) p + q – (p + q), (f) p – q – p – q"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.207,
            0.372,
            0.773,
            0.392
          ],
          "content": [
            {
              "type": "text",
              "content": "(g) 2d – d – d – d, (h) 2d – d – d – c,"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.207,
            0.396,
            0.786,
            0.417
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) 2d – d – (d – c), (j) "
            },
            {
              "type": "equation_inline",
              "content": "2d - (d - d) = c,"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.208,
            0.42,
            0.382,
            0.44
          ],
          "content": [
            {
              "type": "text",
              "content": "(k) "
            },
            {
              "type": "equation_inline",
              "content": "2 d - d - c - c"
            }
          ]
        },
        {
          "type": "paragraph_title",
