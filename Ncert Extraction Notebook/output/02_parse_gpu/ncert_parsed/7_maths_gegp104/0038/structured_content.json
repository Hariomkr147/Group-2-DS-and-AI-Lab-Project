            0.322
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_37_image_4.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.574,
            0.252,
            0.846,
            0.322
          ],
          "content": "",
