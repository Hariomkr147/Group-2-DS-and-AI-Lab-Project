          "bbox": [
            0.177,
            0.659,
            0.523,
            0.678
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Design A appears at position 148."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 29,
          "bbox": [
            0.117,
            0.704,
