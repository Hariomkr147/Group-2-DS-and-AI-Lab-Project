          "bbox": [
            0.177,
            0.614,
            0.51,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Design C appears at position 99."
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.177,
            0.637,
            0.522,
            0.655
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Design B appears at position 122."
