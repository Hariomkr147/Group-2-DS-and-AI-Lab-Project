          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.146,
            0.736,
            0.678,
            0.755
          ],
          "content": [
            {
              "type": "text",
              "content": "? "
            },
            {
              "type": "text",
              "content": "Will this always happen? How do you show this?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.175,
            0.759,
            0.745,
            0.778
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let’s build a similar 3×3 grid with a Centre number a."
            }
          ]
        },
        {
          "type": "table",
          "index": 32,
          "bbox": [
            0.383,
            0.789,
            0.615,
            0.857
          ],
          "content": [
            {
              "type": "table_body",
              "index": 32,
              "bbox": [
                0.383,
                0.789,
                0.615,
                0.857
              ],
              "image_path": "images/page_32_table_32.jpg",
              "content": "<table><tbody><tr><td></td><td>a -7</td><td></td></tr><tr><td>a -1</td><td>a</td><td>a + 1</td></tr><tr><td></td><td>a + 7</td><td></td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 33,
          "bbox": [
            0.177,
            0.873,
            0.34,
            0.89
          ],
          "content": [
            {
              "type": "text",
              "content": "Here, the sum is"
            }
          ]
        },
        {
          "type": "text",
          "index": 34,
          "bbox": [
            0.175,
            0.895,
            0.834,
            0.912
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "a-7+a-1+a+a+1+a+7=5a"
            },
            {
              "type": "text",
              "content": " (5times the number in the Centre.)"
            }
          ]
        },
