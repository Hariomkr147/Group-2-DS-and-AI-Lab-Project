            0.845,
            0.196
          ],
          "content": [
            {
              "type": "text",
              "content": "A page from a calendar is given below. Your friend picks a 2 × 2 grid from t"
            },
            {
              "type": "text",
              "content": "his calendar, adds the 4 numbers in th",
              "styles": [
                "underline"
              ]
            },
            {
              "type": "text",
              "content": "is grid and tells you the sum."
            }
          ]
        },
        {
          "type": "table",
          "index": 4,
          "bbox": [
            0.163,
            0.2,
            0.531,
            0.412
          ],
          "content": [
            {
              "type": "table_body",
              "index": 4,
              "bbox": [
                0.163,
                0.2,
                0.531,
                0.412
              ],
              "image_path": "images/page_6_table_4.jpg",
              "content": "<table><tbody><tr><td colspan=\"7\">AUGUST 2025</td></tr><tr><td>SUN</td><td>MON</td><td>TUE</td><td>WED</td><td>THU</td><td>FRI</td><td>SAT</td></tr><tr><td></td><td></td><td></td><td></td><td></td><td>1</td><td>2</td></tr><tr><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td></tr><tr><td>10</td><td>11</td><td>12</td><td>13</td><td>14</td><td>15</td><td>16</td></tr><tr><td>17</td><td>18</td><td>19</td><td>20</td><td>21</td><td>22</td><td>23</td></tr><tr><td>24</td><td>25</td><td>26</td><td>27</td><td>28</td><td>29</td><td>30</td></tr><tr><td>31</td><td></td><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.57,
            0.274,
            0.837,
            0.337
          ],
          "image_path": "images/page_6_equation_5.jpg",
          "content": "\\begin{array}{c|c|c}6 & 7 \\\\\\hline13 & 14 \\\\\\hline\\end{array}6+7+13+14=40"
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.115,
            0.427,
            0.803,
            0.449
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Can we find the 4 numbers in the grid from just knowing this sum?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.152,
            0.452,
            0.846,
            0.49
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us use algebra. Consider a "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 2"
            },
            {
              "type": "text",
              "content": " grid. Let a represent the top left number. What are the other numbers in terms of a?"
            }
          ]
        },
        {
          "type": "table",
          "index": 8,
          "bbox": [
            0.439,
            0.503,
            0.56,
            0.575
          ],
          "content": [
            {
              "type": "table_body",
              "index": 8,
              "bbox": [
                0.439,
                0.503,
                0.56,
                0.575
              ],
              "image_path": "images/page_6_table_8.jpg",
              "content": "<table><tbody><tr><td>a</td><td>a + 1</td></tr><tr><td>a + 7</td><td>a + 8</td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.589,
            0.843,
            0.609
          ],
          "content": [
            {
              "type": "text",
              "content": "Adding all four numbers, the sum is "
            },
            {
              "type": "equation_inline",
              "content": "a+(a+1)+(a+7)+(a+8)=4a+16."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.111,
            0.611,
            0.845,
            0.651
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Suppose you are told that the sum is 36. Can you find the 4 numbers in the grid?"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.177,
            0.661,
            0.323,
            0.678
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "4a + 16 = 36"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.176,
            0.685,
            0.589,
            0.704
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "4 a = 2 0"
            },
            {
              "type": "text",
              "content": " (subtracting 16 from both sides)"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.176,
            0.708,
            0.502,
            0.728
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "a = 5"
            },
            {
              "type": "text",
              "content": " (dividing both sides by 4)"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.152,
            0.733,
            0.845,
            0.772
          ],
          "content": [
            {
              "type": "text",
              "content": "Now that we have found a, we know that the other three numbers are "
            },
            {
              "type": "equation_inline",
              "content": "a+1,a+7   and   a+8"
            },
            {
              "type": "text",
              "content": " . Therefore, the grid must be the following:"
            }
          ]
        },
