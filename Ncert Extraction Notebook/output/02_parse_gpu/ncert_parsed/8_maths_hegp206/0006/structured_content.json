            0.261,
            0.294,
            0.281
          ],
          "level": 2,
          "content": "Figure it Out"
        },
        {
          "type": "text",
          "bbox": [
            0.154,
            0.285,
            0.847,
            0.323
          ],
          "content": "1. Without building the entire pyramid, find the number in the topmost row given the bottom row in each of these cases."
