          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Prakash | Grade 8 | Part-II"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.152,
            0.09,
            0.846,
            0.129
          ],
          "content": [
            {
              "type": "text",
              "content": "Since "
            },
            {
              "type": "equation_inline",
              "content": "q \\geq p ,"
            },
            {
              "type": "text",
              "content": " we can see that "
            },
            {
              "type": "equation_inline",
              "content": "r p \\times q"
            },
            {
              "type": "text",
              "content": " is bigger than "
            },
            {
              "type": "equation_inline",
              "content": "r q \\times p ."
            },
            {
              "type": "text",
              "content": " . This leaves us with a comparison between "
            },
            {
              "type": "equation_inline",
              "content": "q p \\times r"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "r p \\times q ."
            },
            {
              "type": "text",
              "content": " If we expand these, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.176,
            0.133,
            0.469,
            0.152
          ],
          "image_path": "images/page_9_equation_2.jpg",
          "content": "\\cdot \\quad q p \\times r = ( 1 0 \\times q \\times r ) + ( p \\times r )"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.177,
            0.156,
            0.47,
            0.176
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "r p \\times q = ( 1 0 \\times r \\times q ) + ( p \\times q )"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.152,
            0.18,
            0.847,
            0.274
          ],
          "content": [
            {
              "type": "text",
              "content": "Once again, the first term is the same in both expressions. Since "
            },
            {
              "type": "equation_inline",
              "content": "r \\geq q"
            },
            {
              "type": "text",
              "content": " the second term of the first expression is larger, so the largest product is "
            },
            {
              "type": "equation_inline",
              "content": "q p   \\times   r ."
            },
            {
              "type": "text",
              "content": " . This matches our earlier observation that the largest digit should be the multiplier and the other two digits should be arranged in decreasing order to form the multiplicand."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.115,
            0.282,
            0.295,
            0.304
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.153,
            0.305,
            0.847,
            0.345
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Fill the digits 1, 3, and 7 in "
            },
            {
              "type": "equation_inline",
              "content": "\\bigsqcup \\bigsqcup \\times \\bigsqcup"
            },
            {
              "type": "text",
              "content": " to make the largest product possible."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.153,
            0.353,
            0.847,
            0.393
          ],
          "content": [
