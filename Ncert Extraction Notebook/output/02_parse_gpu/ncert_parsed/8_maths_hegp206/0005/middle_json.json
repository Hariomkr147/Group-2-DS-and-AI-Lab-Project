            0.262
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "a + b = 60"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.177,
            0.27,
            0.3,
            0.286
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "12 + c = a"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.177,
            0.293,
            0.288,
            0.31
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "c + 8 = b"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.153,
            0.317,
            0.375,
            0.335
          ],
          "content": [
            {
              "type": "text",
              "content": "From this, we see that,"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.176,
            0.341,
            0.468,
            0.359
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "(12 + c) + (c + 8) = a + b = 60"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.153,
            0.366,
            0.225,
            0.383
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence,"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.177,
            0.389,
            0.321,
            0.406
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "20 + 2c = 60"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.177,
            0.413,
            0.364,
            0.431
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "2c = 60 - 20 = 40"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.177,
            0.438,
            0.269,
