          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.032,
            0.868,
            0.839,
            0.902
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 11.5: (a) The Moon at different positions in its orbit around the Earth; (b) The corresponding phases of the Moon as seen from the Earth. (The sizes and the distances are not to scale in this figure.)"
            }
          ]
        },
