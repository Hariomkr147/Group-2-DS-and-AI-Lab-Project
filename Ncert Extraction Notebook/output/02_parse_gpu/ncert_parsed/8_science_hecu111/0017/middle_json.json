                0.466,
                0.863,
                0.57
              ],
              "image_path": "images/page_16_image_9.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.117,
            0.609,
            0.25,
            0.748
          ],
          "content": [
            {
              "type": "image_body",
              "index": 10,
              "bbox": [
                0.117,
                0.609,
