            0.123,
            0.167,
            0.569,
            0.245
          ],
          "content": [
            {
              "type": "text",
              "content": "Can we find the number of tennis balls that can fit in the classroom by dividing the volume of the classroom by the volume of a tennis ball?"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.65,
