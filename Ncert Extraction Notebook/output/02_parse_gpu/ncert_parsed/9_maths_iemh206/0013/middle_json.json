              "content": ""
            },
            {
              "type": "image_footnote",
              "index": 5,
              "bbox": [
                0.176,
                0.424,
                0.43,
                0.441
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Shivling Peak (Uttarakhand)"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.552,
            0.233,
            0.877,
            0.421
          ],
          "content": [
            {
              "type": "image_body",
