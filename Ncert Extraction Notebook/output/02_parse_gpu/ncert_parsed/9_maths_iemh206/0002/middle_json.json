                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.154,
            0.788,
            0.456,
            0.808
          ],
          "content": [
            {
              "type": "text",
              "content": "• Volume of the cube is "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 3 }"
            },
            {
              "type": "text",
              "content": " ."
            }
          ]
        },
        {
          "type": "text",
