              ],
              "content": "(a)"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_8_image_3.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.362,
            0.184,
            0.522,
            0.302
          ],
          "content": "",
          "captions": [
            {
              "bbox": [
                0.432,
                0.31,
                0.46,
                0.327
              ],
              "content": "(b)"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_8_image_5.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.546,
            0.15,
            0.763,
            0.302
          ],
          "content": "",
          "captions": [
            {
              "bbox": [
                0.639,
                0.311,
                0.666,
                0.327
              ],
              "content": "(c)"
            },
            {
              "bbox": [
                0.456,
                0.334,
                0.543,
                0.353
              ],
              "content": "Fig. 14.9"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_8_image_7.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.362,
            0.881,
            0.401
          ],
          "content": "From Fig. 14.9, it follows that the curved surface area (CSA) of the cone is equal to"
        },
        {
          "type": "equation",
          "bbox": [
            0.152,
            0.402,
            0.69,
            0.496
          ],
          "content": "\\begin{aligned}\\mathrm{CSA} = \\frac{1}{2}b_{_1}l + \\frac{1}{2}b_{_2}l + \\cdots + \\frac{1}{2}b_{_n}l = \\frac{1}{2}(b_{_1} + b_{_2} + \\cdots + b_{_n})l \\\\= \\frac{1}{2} \\times \\mathrm{circm} & \\mathrm{reference} \\mathrm{of the base} \\times l \\\\= \\frac{1}{2}(2\\pi r)l = \\pi r l\\end{aligned}",
          "image_source": "images/page_8_equation_11.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.496,
            0.881,
            0.536
          ],
          "content": "Here is another way of working out the formula for the curved surface area. We have, from the formula for area of a sector of a circle,"
        },
        {
          "type": "equation",
          "bbox": [
            0.334,
            0.543,
            0.663,
            0.581
          ],
          "content": "\\mathrm{CSA} = \\pi l^{2} \\times \\frac{\\theta^{\\circ}}{360^{\\circ}} = \\pi l \\times l \\times \\frac{\\theta^{\\circ}}{360^{\\circ}}",
          "image_source": "images/page_8_equation_13.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.581,
            0.881,
            0.62
          ],
          "content": "Let us try to express this formula in terms of r and l. For this, note that from the cone, we have,"
        },
        {
          "type": "equation",
          "bbox": [
            0.386,
            0.624,
            0.609,
            0.645
          ],
          "content": "\\mathrm{arc}   length =s=2\\pi r,",
          "image_source": "images/page_8_equation_15.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.153,
            0.653,
            0.47,
            0.671
          ],
          "content": "and from the sector, we have"
        },
        {
          "type": "equation",
          "bbox": [
            0.353,
            0.673,
            0.641,
            0.709
          ],
          "content": "\\mathrm{arc}\\ \\mathrm{length}=s=\\frac{\\theta^{\\circ}}{360^{\\circ}}\\times2\\pi l.",
          "image_source": "images/page_8_equation_17.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.153,
            0.711,
            0.448,
            0.732
          ],
          "content": "Equating these two, we get"
        },
        {
          "type": "equation",
          "bbox": [
            0.448,
            0.743,
            0.55,
            0.78
          ],
          "content": "\\frac { \\theta ^ { \\circ } } { 3 6 0 ^ { \\circ } } = \\frac { r } { l } .",
          "image_source": "images/page_8_equation_19.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.153,
            0.788,
            0.677,
            0.807
          ],
          "content": "From this, we see that the curved surface area is"
        },
        {
          "type": "equation",
          "bbox": [
            0.443,
            0.812,
            0.555,
            0.832
          ],
          "content": "\\begin{array} { r } { \\mathrm { C S A } = \\pi r l , } \\end{array}",
          "image_source": "images/page_8_equation_21.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.84,
            0.881,
            0.881
          ],
          "content": "the same formula as earlier. The formula for the total surface area (TSA) (curved portion plus the flat base) is $\\mathrm{TSA} = \\pi r l + \\pi r^{2}$"
        }
      ]
    }
  ],
