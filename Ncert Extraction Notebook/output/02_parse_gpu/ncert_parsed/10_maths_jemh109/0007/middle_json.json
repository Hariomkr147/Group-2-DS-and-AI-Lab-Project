            0.383
          ],
          "image_path": "images/page_6_equation_12.jpg",
          "content": "\\left[ { \\frac { 1 } { \\sqrt { 3 } } } \\; = \\; { \\frac { h } { x   +   4 0 } } \\right]\\tag{2}"
        },
        {
          "type": "text",
          "index": 13,
