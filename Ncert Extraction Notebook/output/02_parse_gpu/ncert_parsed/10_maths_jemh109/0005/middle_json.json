            0.418,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "SOME APPLICATIONS OF TRIGONOMETRY"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.863,
            0.104,
            0.898,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "137"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.096,
            0.141,
            0.576,
            0.227
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 3 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " An observer 1.5 m tall is 28.5 m away from a chimney. The angle of elevation of the top of the chimney from her eyes is "
            },
            {
              "type": "equation_inline",
              "content": "4 5 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . What is the height of the chimney?"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.234,
            0.575,
            0.342
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, AB is the chimney, CD the observer and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { A D E }"
            },
            {
              "type": "text",
              "content": " the angle of elevation (see Fig. 9.6). In this case, ADE is a triangle, right-angled at E and we are required to find the height of the chimney."
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.586,
            0.142,
            0.896,
            0.355
          ],
          "content": [
            {
              "type": "image_body",
              "index": 4,
              "bbox": [
                0.586,
                0.142,
                0.896,
                0.355
              ],
              "image_path": "images/page_4_image_4.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.097,
            0.349,
            0.19,
            0.368
          ],
          "content": [
            {
              "type": "text",
              "content": "We have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.279,
            0.349,
            0.553,
            0.369
          ],
          "image_path": "images/page_4_equation_6.jpg",
          "content": "\\mathrm{AB} = \\mathrm{AE} + \\mathrm{BE} = \\mathrm{AE} + 1.5"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.691,
            0.359,
            0.778,
            0.378
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 9.6"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.097,
            0.378,
            0.142,
            0.396
          ],
          "content": [
            {
              "type": "text",
              "content": "and"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.28,
            0.377,
            0.475,
            0.396
          ],
          "image_path": "images/page_4_equation_9.jpg",
          "content": "DE = CB = 28.5   m"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.095,
            0.405,
            0.902,
            0.447
          ],
          "content": [
            {
              "type": "text",
              "content": "To determine AE, we choose a trigonometric ratio, which involves both AE and DE. Let us choose the tangent of the angle of elevation."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.097,
            0.474,
            0.155,
            0.493
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.294,
            0.459,
            0.442,
            0.502
          ],
          "image_path": "images/page_4_equation_12.jpg",
          "content": "\\tan 45^{\\circ} = \\frac{ AE }{ DE }"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.097,
            0.531,
            0.14,
            0.55
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.352,
            0.518,
            0.451,
            0.561
          ],
          "image_path": "images/page_4_equation_14.jpg",
          "content": "1 \\equiv \\frac{AE}{28.5}"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.568,
            0.205,
            0.587
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.33,
            0.567,
            0.442,
            0.587
          ],
          "image_path": "images/page_4_equation_16.jpg",
          "content": "\\mathrm { A E } = 2 8 . 5"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.096,
            0.593,
            0.673,
            0.614
          ],
          "content": [
            {
              "type": "text",
              "content": "So the height of the chimney "
            },
            {
              "type": "equation_inline",
              "content": "(AB) = (28.5 + 1.5)    m  = 30    m"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.095,
            0.627,
            0.902,
            0.715
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 4 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " From a point P on the ground the angle of elevation of the top of a 10 m tall building is "
            },
            {
              "type": "equation_inline",
              "content": "3 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . A flag is hoisted at the top of the building and the angle of elevation of the top of the flagstaff from P is "
            },
            {
              "type": "equation_inline",
              "content": "4 5 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . Find the length of the flagstaff and the distance of the building from the point P. (You may take "
            },
            {
              "type": "equation_inline",
              "content": "{ \\sqrt { 3 } }   = 1 . 7 3 2 )"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.095,
            0.721,
            0.902,
            0.808
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In Fig. 9.7, AB denotes the height of the building, BD the flagstaff and P the given point. Note that there are two right triangles PAB and PAD. We are required to find the length of the flagstaff, i.e., DB and the distance of the building from the point P, i.e., PA."
            }
          ]
        },
        {
          "type": "footer",
          "index": 20,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.983
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        }
      ]
    }
