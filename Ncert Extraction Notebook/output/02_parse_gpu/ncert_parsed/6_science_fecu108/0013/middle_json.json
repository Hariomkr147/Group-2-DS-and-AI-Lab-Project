            {
              "type": "text",
              "content": "Activity 8.8: Let us explore"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.116,
            0.117,
            0.517,
            0.137
          ],
          "content": [
            {
              "type": "text",
              "content": " Take identical caps of two bottles."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.116,
            0.143,
            0.655,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": " Pour equal amount of water in each of the cap."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.117,
            0.169,
            0.743,
            0.211
          ],
          "content": [
            {
              "type": "text",
              "content": " Place one of the cap in sunlight and keep the other in shade as shown in Fig. 8.6."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.117,
            0.216,
            0.738,
            0.237
          ],
          "content": [
            {
              "type": "text",
              "content": " Observe the two caps of bottles after every 15 minutes."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.117,
            0.242,
            0.743,
            0.284
          ],
          "content": [
            {
              "type": "text",
              "content": " Record the time taken for the water to completely evaporate in each case."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.288,
            0.743,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": " You can also repeat this activity on a windy or a rainy day, and record your observations."
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.116,
