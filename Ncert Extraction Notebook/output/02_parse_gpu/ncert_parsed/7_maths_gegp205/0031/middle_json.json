            0.526,
            0.579,
            0.546
          ],
          "content": [
            {
              "type": "text",
              "content": "These are some prompts for you to probe —"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.153,
            0.55,
            0.846,
            0.587
          ],
          "content": [
            {
              "type": "text",
              "content": "Changes in the heights of boys or girls of a certain age from 1989 to 2019."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.153,
            0.592,
            0.815,
            0.613
          ],
          "content": [
            {
              "type": "text",
              "content": "• The heights of boys vs. girls at different ages in a particular year."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.153,
            0.616,
            0.846,
            0.637
          ],
          "content": [
            {
              "type": "text",
              "content": "• Changes in height between successive ages in boys and girls in 2019."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.645,
            0.793,
            0.667
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Which of the following statements can be justified using the data?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.675,
            0.846,
            0.713
          ],
          "content": [
            {
              "type": "text",
              "content": "1. The average heights of both boys and girls at every age increased from 1989 to 2019."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.717,
            0.846,
            0.757
          ],
          "content": [
            {
              "type": "text",
              "content": "2. The average height of 13-year-old girls in 1989 is more than the average height of 14-year-old girls in 2009."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.151,
            0.759,
            0.846,
            0.798
          ],
          "content": [
            {
              "type": "text",
              "content": "3. The average height of 15-year-old boys in 2019 is more than the average height of 16-year-old boys in 1989."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.801,
            0.652,
            0.822
          ],
          "content": [
            {
              "type": "text",
              "content": "4. All girls aged 13 are taller than all girls aged 11."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.151,
            0.825,
            0.847,
            0.864
          ],
          "content": [
            {
              "type": "text",
              "content": "5. Throughout the age period 5 to 19, the average boy's height is more than the average girl's height."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.151,
            0.867,
            0.577,
            0.888
          ],
          "content": [
            {
              "type": "text",
              "content": "6. Boys keep growing even beyond age 19."
            }
          ]
        },
