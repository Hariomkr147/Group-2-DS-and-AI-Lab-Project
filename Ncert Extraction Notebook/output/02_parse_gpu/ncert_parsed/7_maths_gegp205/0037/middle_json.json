          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.229,
            0.744,
            0.793,
            0.764
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Look at everyone’s data and share your observations."
            }
          ]
        },
        {
