              "bbox": [
                0.236,
                0.17,
                0.827,
                0.263
              ],
              "image_path": "images/page_28_table_2.jpg",
              "content": "<table><tbody><tr><td></td><td>2022</td><td>2023</td><td>2024</td></tr><tr><td>Gujarat</td><td>69000</td><td>89000</td><td>78000</td></tr><tr><td>Delhi</td><td>62000</td><td>74000</td><td>81000</td></tr></tbody></table>"
            }
