              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.151,
            0.589,
            0.482,
            0.609
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2: Infer from what is given"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.112,
            0.612,
            0.629,
            0.635
          ],
          "content": [
            {
              "type": "text",
              "content": "Analyse and interpret each of your observations."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.152,
            0.637,
            0.846,
            0.677
          ],
          "content": [
            {
              "type": "text",
              "content": "We can say that the USA, China, and Russia are the leading rocket launching countries in the given time period."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.153,
            0.68,
            0.847,
            0.738
          ],
          "content": [
            {
              "type": "text",
              "content": "SpaceX launched about twice the number of rockets in 2022 compared to 2021. And it launched about 35 more rockets in 2023 compared to 2022."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.153,
            0.742,
            0.846,
            0.762
          ],
          "content": [
            {
              "type": "text",
              "content": "The number of rockets launched by Arianespace decreased every year."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.153,
            0.766,
            0.847,
            0.823
          ],
          "content": [
            {
              "type": "text",
              "content": "United Launch Alliance launched more rockets in 2022 than in 2021. They launched fewer rockets in 2023 than in both the years 2022 and 2021."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.152,
            0.828,
            0.726,
            0.847
          ],
          "content": [
            {
              "type": "text",
              "content": "Other organisations launched about 25 rockets in 2023."
            }
          ]
        },
