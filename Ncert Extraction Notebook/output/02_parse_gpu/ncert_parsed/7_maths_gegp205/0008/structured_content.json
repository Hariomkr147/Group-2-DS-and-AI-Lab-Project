          "image_source": "images/page_7_image_13.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.669,
            0.801,
            0.709
          ],
          "content": "You can discuss questions that you are curious about with your peers, teachers, or family members to find answers."
        },
        {
          "type": "image",
          "bbox": [
            0.159,
            0.723,
            0.225,
            0.766
          ],
          "content": "",
