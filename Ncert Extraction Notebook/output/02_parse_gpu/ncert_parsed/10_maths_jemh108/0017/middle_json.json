            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.097,
            0.172,
            0.139,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.293,
            0.151,
            0.573,
            0.199
          ],
          "image_path": "images/page_16_equation_3.jpg",
          "content": "\\left( \\frac{AB}{BC} \\right)^{2} + \\left( \\frac{BC}{BC} \\right)^{2} = \\left( \\frac{AC}{BC} \\right)^{2}"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.097,
            0.216,
            0.139,
            0.233
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.362,
            0.215,
            0.897,
            0.233
          ],
          "image_path": "images/page_16_equation_5.jpg",
          "content": "\\cot ^{2}\\mathbf{A} + 1 = \\csc \\mathbf{c}^{2}\\mathbf{A}\\tag{4}"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.096,
            0.243,
            0.899,
            0.281
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that cosec A and cot A are not defined for "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { A }   =   0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . Therefore (4) is true for all A such that "
            },
            {
              "type": "equation_inline",
              "content": "0 ^ { \\circ }   <   \\mathrm { A }   \\le   9 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.095,
            0.288,
            0.9,
            0.345
          ],
          "content": [
            {
              "type": "text",
              "content": "Using these identities, we can express each trigonometric ratio in terms of other trigonometric ratios, i.e., if any one of the ratios is known, we can also determine the values of other trigonometric ratios."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.352,
            0.899,
            0.421
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us see how we can do this using these identities. Suppose we know that tan "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A } = { \\frac { 1 } { \\sqrt { 3 } } } \\cdotp"
            },
            {
              "type": "text",
              "content": " Then, cot "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { A } = { \\dot { \\sqrt { 3 } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.095,
            0.438,
            0.776,
            0.483
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "A = \\frac{\\sqrt{3}}{2}"
            },
            {
              "type": "text",
              "content": " Since, sec "
            },
            {
              "type": "equation_inline",
              "content": "^{2}\\mathrm{A}=1+\\tan^{2}\\mathrm{A}=1+\\frac{1}{3}=\\frac{4}{3},"
            },
            {
              "type": "text",
              "content": " sec "
            },
            {
              "type": "equation_inline",
              "content": "A = \\frac { 2 } { \\sqrt { 3 } }"
            },
            {
              "type": "text",
              "content": " and"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.097,
            0.497,
            0.722,
            0.539
          ],
          "content": [
            {
              "type": "text",
              "content": "Again, sin "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{A} = \\sqrt{1 - \\cos^{2}\\mathrm{A}} = \\sqrt{1 - \\frac{3}{4}} = \\frac{1}{2}"
            },
            {
              "type": "text",
              "content": " Therefore, cosec "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A } = 2"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.095,
            0.557,
            0.798,
            0.576
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 9 : Express the ratios cos A, tan A and sec A in terms of sin A."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.096,
            0.59,
            0.264,
            0.608
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : Since"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.318,
            0.59,
            0.615,
            0.609
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\cos ^{2}A+\\sin ^{2}A=1"
            },
            {
              "type": "text",
              "content": " , therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.402,
            0.627,
            0.858,
            0.655
          ],
          "image_path": "images/page_16_equation_14.jpg",
          "content": "\\cos ^{2}A=1-\\sin ^{2}A,\\therefore \\cos A=\\pm \\sqrt{1-\\sin ^{2}A}"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.682,
            0.201,
            0.701
          ],
          "content": [
            {
              "type": "text",
              "content": "This gives"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.408,
            0.677,
            0.741,
            0.703
          ],
          "image_path": "images/page_16_equation_16.jpg",
          "content": "\\cos A = \\sqrt{1 - \\sin^{2} A} \\quad (\\mathrm{Why?})"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.097,
            0.736,
            0.172,
            0.754
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence,"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.236,
            0.723,
            0.864,
            0.77
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\tan A = \\frac{\\sin A}{\\cos A} = \\frac{\\sin A}{\\sqrt{1 - \\sin^2 A}}"
            },
            {
              "type": "text",
              "content": " and sec "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{A} = \\frac{1}{\\cos \\mathrm{A}} = \\frac{1}{\\sqrt{1 - \\sin^2 \\mathrm{A}}}"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.097,
            0.786,
            0.708,
            0.804
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 10 : Prove that sec "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{A}(1-\\sin \\mathrm{A})(\\sec \\mathrm{A}+\\tan \\mathrm{A})=1"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.096,
            0.813,
            0.205,
            0.83
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.095,
            0.845,
            0.895,
            0.892
          ],
          "image_path": "images/page_16_equation_21.jpg",
          "content": "\\mathrm{LHS} = \\mathrm{secA}(1 - \\sin \\mathrm{A})(\\mathrm{secA} + \\tan \\mathrm{A}) = \\left(\\frac{1}{\\cos \\mathrm{A}}\\right)(1 - \\sin \\mathrm{A})\\left(\\frac{1}{\\cos \\mathrm{A}} + \\frac{\\sin \\mathrm{A}}{\\cos \\mathrm{A}}\\right)"
        },
