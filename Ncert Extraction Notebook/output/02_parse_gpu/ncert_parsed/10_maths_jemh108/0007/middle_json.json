          "bbox": [
            0.235,
            0.679,
            0.612,
            0.708
          ],
          "image_path": "images/page_6_equation_20.jpg",
          "content": "\\mathrm{AC} = \\sqrt[3]{\\mathrm{AB}^{2} - \\mathrm{BC}^{2}} = \\sqrt{(29)^{2} - (21)^{2}}"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.722,
            0.694,
            0.82,
            0.712
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 8.10"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.284,
            0.722,
            0.804,
            0.746
          ],
          "image_path": "images/page_6_equation_22.jpg",
          "content": "\\ln { \\sqrt { ( 2 9 - 2 1 ) ( 2 9 + 2 1 ) } } = { \\sqrt { ( 8 ) ( 5 0 ) } } = { \\sqrt { 4 0 0 } }   = 2 0   { \\mathrm { u n i t s } }"
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.098,
            0.771,
            0.136,
            0.788
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
