          "bbox": [
            0.421,
            0.199,
            0.898,
            0.242
          ],
          "image_path": "images/page_6_equation_5.jpg",
          "content": "\\frac{AC}{PR} = \\frac{AB}{PQ} = k,\\  say\\tag{1}"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.097,
            0.247,
            0.412,
            0.266
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, using Pythagoras theorem,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.428,
            0.271,
            0.628,
            0.299
          ],
          "image_path": "images/page_6_equation_7.jpg",
          "content": "\\mathrm{BC} = \\sqrt{\\mathrm{AB}^2 - \\mathrm{AC}^2}"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.097,
            0.314,
            0.142,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": "and"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.428,
            0.309,
            0.629,
            0.336
          ],
          "image_path": "images/page_6_equation_9.jpg",
          "content": "\\mathrm{QR} = \\sqrt{\\mathrm{PQ}^2 - \\mathrm{PR}^2}"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.096,
            0.349,
            0.77,
            0.403
          ],
          "content": [
            {
              "type": "text",
              "content": "BC √AB2 -AC² √k2PQ2−k2PR2 k√PQ2-PR2 So, QR √PQ2- PR2 √PQ2-PR2 √PQ2-PR2 = k"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.868,
            0.373,
            0.898,
            0.39
          ],
          "content": [
            {
              "type": "text",
              "content": "(2)"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.097,
            0.41,
            0.357,
            0.428
          ],
          "content": [
            {
              "type": "text",
              "content": "From (1) and (2), we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.422,
            0.436,
            0.604,
            0.479
          ],
          "image_path": "images/page_6_equation_13.jpg",
          "content": "\\frac{\\mathrm{AC}}{\\mathrm{PR}} = \\frac{\\overline{\\mathrm{AB}}}{\\mathrm{PQ}} = \\frac{\\overline{\\mathrm{BC}}}{\\overline{\\mathrm{QR}}}"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.097,
            0.488,
            0.802,
            0.508
          ],
          "content": [
            {
              "type": "text",
              "content": "Then, by using Theorem 6.4, "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm{ACB} \\sim \\Delta \\mathrm{PRQ}"
            },
            {
              "type": "text",
              "content": " and therefore, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathbf { B } = \\angle \\mathbf { Q }"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.523,
            0.595,
            0.586
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 3 : Consider "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { A C B }"
            },
            {
              "type": "text",
              "content": " right-angled at C, in which "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A B } = 2 9"
            },
            {
              "type": "text",
              "content": " units, BC = 21 units and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle ABC = \\theta"
            },
            {
              "type": "text",
              "content": " (see Fig. 8.10). Determine the values of"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.12,
            0.594,
            0.3,
            0.613
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "\\cos ^ { 2 } \\theta + \\sin ^ { 2 } \\theta ,"
            }
          ]
        },
        {
          "type": "text",
