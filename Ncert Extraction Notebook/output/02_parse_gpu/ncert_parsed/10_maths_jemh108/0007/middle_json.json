          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.096,
            0.857,
            0.769,
            0.904
          ],
          "content": [
            {
              "type": "text",
              "content": "and (ii) "
            },
            {
              "type": "equation_inline",
              "content": "\\cos ^{2}\\theta -\\sin ^{2}\\theta =\\left ( \\frac{21}{29} \\right ) ^{2} -\\left ( \\frac{20}{29} \\right ) ^{2} =\\frac{(21+20)(21-20)}{29^{2}} =\\frac{41}{841}"
            }
          ]
        }
