        },
        {
          "type": "equation",
          "index": 24,
          "bbox": [
            0.181,
            0.757,
            0.538,
            0.798
          ],
          "image_path": "images/page_6_equation_24.jpg",
          "content": "\\sin \\theta = \\frac{AC}{AB} = \\frac{20}{29}, \\cos \\theta = \\frac{BC}{AB} = \\frac{21}{29}."
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.096,
            0.805,
            0.774,
            0.851
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, (i) "
            },
            {
              "type": "equation_inline",
              "content": "\\cos ^{2}\\theta +\\sin ^{2}\\theta =\\left ( \\frac{20}{29} \\right ) ^{2} +\\left ( \\frac{21}{29} \\right ) ^{2} =\\frac{20^{2} +21^{2}}{29^{2}} =\\frac{400+441}{841} =1,"
            }
          ]
        },
        {
          "type": "footer",
          "index": 26,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
