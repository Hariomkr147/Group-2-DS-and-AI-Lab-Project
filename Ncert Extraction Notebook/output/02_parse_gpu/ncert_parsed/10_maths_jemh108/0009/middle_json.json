          ],
          "content": [
            {
              "type": "text",
              "content": "1. In   ABC, right-angled at B, AB = 24 cm, BC = 7 cm. Determine : (i) sin A, cos A (ii) sin C, cos C"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.123,
            0.238,
            0.421,
            0.256
          ],
          "content": [
            {
              "type": "text",
              "content": "2.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In Fig. 8.13, find tan P – cot R."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.123,
            0.263,
            0.522,
            0.301
          ],
          "content": [
            {
              "type": "text",
              "content": "3. If "
            },
            {
              "type": "equation_inline",
              "content": "\\sin \\mathrm { A } = { \\frac { 3 } { 4 } }"
            },
            {
              "type": "text",
              "content": " , calculate cos A and tan A."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.124,
            0.306,
            0.515,
            0.323
          ],
          "content": [
            {
              "type": "text",
              "content": "4.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Given 15 cot A = 8, find sin A and sec A."
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.707,
            0.183,
            0.871,
            0.338
          ],
          "content": [
