                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In triangle ABC, right-angled at B, if tan "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A } = { \\frac { 1 } { \\sqrt { 3 } } } ,"
            },
            {
              "type": "text",
              "content": " find the value of: (i) sin A cos C + cos A sin C (ii) cos A cos C – sin A sin C"
            }
