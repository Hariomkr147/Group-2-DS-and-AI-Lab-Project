          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.164,
            0.763,
            0.447,
            0.8
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) sin "
            },
            {
              "type": "equation_inline",
              "content": "\\Theta   =   \\frac { 4 } { 3 }"
            },
            {
              "type": "text",
              "content": " for some angle  ."
