        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.124,
            0.332,
            0.658,
            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "5. "
            },
            {
              "type": "equation_inline",
              "content": "{ \\mathrm { G i v e n } } \\; { \\mathrm { s e c } } \\; \\Theta = { \\frac { 1 3 } { 1 2 } } ,"
            },
            {
              "type": "text",
              "content": " calculate all other trigonometric ratios."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.758,
            0.345,
            0.858,
            0.364
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 8.13"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.124,
            0.373,
            0.887,
            0.391
          ],
          "content": [
            {
              "type": "text",
              "content": "6. "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { I f } \\angle \\mathrm { A a n d } \\angle \\mathrm { B }"
            },
            {
              "type": "text",
              "content": " are acute angles such that cos A = cos B, then show that "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{A} \\cong \\angle \\mathrm{B}"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.124,
            0.402,
            0.742,
            0.442
          ],
          "content": [
            {
              "type": "text",
              "content": "7.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If "
            },
            {
              "type": "equation_inline",
              "content": "\\cot \\theta = { \\frac { 7 } { 8 } } ,"
            },
            {
              "type": "text",
              "content": " , evaluate : (i) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{(1+\\sin\\ \\theta)(1-\\sin\\ \\theta)}{(1+\\cos\\ \\theta)(1-\\cos\\ \\theta)}"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "\\cot^{2}\\theta"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.123,
            0.452,
            0.728,
            0.493
          ],
          "content": [
            {
              "type": "text",
              "content": "8.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If 3 cot A = 4, check whether "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1 - \\tan^{2}\\mathrm{A}}{1 + \\tan^{2}\\mathrm{A}} = \\cos^{2}\\mathrm{A} - \\sin^{2}\\mathrm{A}"
            },
            {
              "type": "text",
              "content": " or not."
            }
          ]
        },
        {
