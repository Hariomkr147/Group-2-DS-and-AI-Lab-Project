            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.097,
            0.138,
            0.408,
            0.158
          ],
          "content": [
            {
              "type": "text",
              "content": "8.4 Trigonometric Identities"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.165,
            0.595,
            0.263
          ],
          "content": [
            {
              "type": "text",
              "content": "You may recall that an equation is called an identity when it is true for all values of the variables involved. Similarly, an equation involving trigonometric ratios of an angle is called a trigonometric identity, if it is true for all values of the angle(s) involved."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.096,
            0.268,
            0.594,
            0.326
          ],
          "content": [
            {
              "type": "text",
              "content": "In this section, we will prove one trigonometric identity, and use it further to prove other useful trigonometric identities."
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.698,
            0.138,
            0.884,
            0.299
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.698,
                0.138,
                0.884,
                0.299
              ],
              "image_path": "images/page_15_image_5.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 6,
              "bbox": [
                0.742,
                0.302,
                0.84,
                0.321
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 8.21"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.147,
            0.332,
            0.665,
            0.352
          ],
          "content": [
            {
              "type": "text",
              "content": "In "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta   \\mathrm { A B C } ,"
            },
            {
              "type": "text",
              "content": " , right-angled at B (see Fig. 8.21), we have:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.355,
            0.356,
            0.897,
            0.376
          ],
          "image_path": "images/page_15_equation_8.jpg",
          "content": "\\mathrm{AB^{2}+BC^{2}=AC^{2}}\\tag{1}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.148,
            0.382,
            0.549,
            0.402
          ],
          "content": [
            {
              "type": "text",
              "content": "Dividing each term of (1) by "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { A } \\mathbf { C } ^ { 2 } ,"
            },
            {
              "type": "text",
              "content": " , we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.342,
            0.414,
            0.55,
            0.458
          ],
          "image_path": "images/page_15_equation_10.jpg",
          "content": "\\frac{\\mathrm{AB}^{2}}{\\mathrm{AC}^{2}}+\\frac{\\mathrm{BC}^{2}}{\\mathrm{AC}^{2}}=\\frac{\\mathrm{AC}^{2}}{\\mathrm{AC}^{2}}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.097,
            0.485,
            0.139,
            0.503
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.305,
            0.467,
            0.569,
            0.513
          ],
          "image_path": "images/page_15_equation_12.jpg",
          "content": "\\left( \\frac{AB}{AC} \\right)^{2} + \\left( \\frac{BC}{AC} \\right)^{2} = \\left( \\frac{AC}{AC} \\right)^{2}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.098,
            0.525,
            0.138,
            0.543
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.285,
            0.524,
            0.512,
            0.544
          ],
          "image_path": "images/page_15_equation_14.jpg",
          "content": "\\left( \\cos A \\right)^{2} + \\left( \\sin A \\right)^{2} = 1"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.097,
            0.552,
            0.139,
            0.57
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.303,
            0.551,
            0.897,
            0.57
          ],
          "image_path": "images/page_15_equation_16.jpg",
          "content": "\\cos ^{2}\\mathbf{A}+\\sin ^{2}\\mathbf{A}=\\mathbf{1}\\tag{2}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.146,
            0.586,
            0.898,
            0.631
          ],
          "content": [
            {
              "type": "text",
              "content": "This is true for all A such that "
            },
            {
              "type": "equation_inline",
              "content": "0 ^ { \\circ } \\leq \\mathrm { A } \\leq 9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . So, this is a trigonometric identity. Let us now divide (1) by "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { A B } ^ { 2 } ,"
            },
            {
              "type": "text",
              "content": " We get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.34,
            0.643,
            0.549,
            0.688
          ],
          "image_path": "images/page_15_equation_18.jpg",
          "content": "\\frac{\\mathrm{AB}^{2}}{\\mathrm{AB}^{2}}+\\frac{\\mathrm{BC}^{2}}{\\mathrm{AB}^{2}}=\\frac{\\mathrm{AC}^{2}}{\\mathrm{AB}^{2}}"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.098,
            0.716,
            0.128,
            0.731
          ],
          "content": [
            {
              "type": "text",
              "content": "or,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.306,
            0.696,
            0.57,
            0.742
          ],
          "image_path": "images/page_15_equation_20.jpg",
          "content": "\\left( \\frac{\\mathrm{AB}}{\\mathrm{AB}} \\right)^{2} + \\left( \\frac{\\mathrm{BC}}{\\mathrm{AB}} \\right)^{2} = \\left( \\frac{\\mathrm{AC}}{\\mathrm{AB}} \\right)^{2}"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.097,
            0.754,
            0.139,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.36,
            0.752,
            0.897,
            0.771
          ],
          "image_path": "images/page_15_equation_22.jpg",
          "content": "\\mathbf{1} + \\tan^{2} \\mathbf{A} = \\sec^{2} \\mathbf{A}\\tag{3}"
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.096,
            0.777,
            0.899,
            0.816
          ],
          "content": [
            {
              "type": "text",
              "content": "Is this equation true for "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A   =   0 ^ { \\circ } ? }"
            },
            {
              "type": "text",
              "content": " Yes, it is. What about "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A }   =   9 0 ^ { \\circ } ?"
            },
            {
              "type": "text",
              "content": " Well, tan A and sec A are not defined for "
            },
            {
              "type": "equation_inline",
              "content": "A = 90^{\\circ}.\\  SO ,(3)"
            },
            {
              "type": "text",
              "content": " is true for all A such that "
            },
            {
              "type": "equation_inline",
              "content": "0 ^ { \\circ } \\leq \\mathrm { A } < 9 0 ^ { \\circ }"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.147,
            0.822,
            0.679,
            0.842
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us see what we get on dividing (1) by BC². We get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.342,
            0.851,
            0.551,
            0.897
          ],
          "image_path": "images/page_15_equation_25.jpg",
          "content": "\\frac{AB^{2}}{BC^{2}}+\\frac{BC^{2}}{BC^{2}}=\\frac{AC^{2}}{BC^{2}}"
        },
        {
          "type": "footer",
          "index": 26,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        }
      ]
    }
