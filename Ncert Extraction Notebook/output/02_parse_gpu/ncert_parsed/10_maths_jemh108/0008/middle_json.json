          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.095,
            0.15,
            0.624,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 4 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In a right triangle ABC, right-angled at B, if tan A = 1, then verify that"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.097,
            0.195,
            0.285,
            0.212
          ],
          "content": [
            {
              "type": "text",
              "content": "2 sin A cos A = 1."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.225,
            0.632,
            0.268
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In   ABC, tan "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A }   =   { \\frac { \\mathrm { B C } } { \\mathrm { A B } } } = 1"
            },
            {
              "type": "text",
              "content": " (see Fig 8.11)"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.096,
            0.286,
            0.139,
            0.303
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.43,
            0.284,
            0.535,
            0.303
          ],
          "image_path": "images/page_7_equation_6.jpg",
          "content": "\\mathrm { B C } = \\mathrm { A B }"
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.655,
            0.148,
            0.872,
            0.289
          ],
          "content": [
            {
              "type": "image_body",
              "index": 7,
              "bbox": [
                0.655,
                0.148,
                0.872,
                0.289
              ],
              "image_path": "images/page_7_image_7.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 8,
              "bbox": [
                0.718,
                0.299,
                0.813,
                0.318
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 8.11"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.095,
            0.317,
            0.564,
            0.336
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AB} = \\mathrm{BC} = k"
            },
            {
              "type": "text",
              "content": " , where k is a positive number."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.096,
            0.361,
            0.156,
            0.378
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.428,
            0.355,
            0.702,
            0.433
          ],
          "image_path": "images/page_7_equation_11.jpg",
          "content": "\\begin{aligned} AC  &= \\sqrt{ AB ^2 +  BC ^2} \\\\&= \\sqrt{\\left(k\\right)^2 + \\left(k\\right)^2} = k\\sqrt{2}.\\end{aligned}"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.098,
            0.471,
            0.205,
            0.49
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.411,
            0.456,
            0.868,
            0.499
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\sin A = \\frac{BC}{AC} = \\frac{1}{\\sqrt{2}}"
            },
            {
              "type": "text",
              "content": " and cos "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{A} = \\frac{\\mathrm{AB}}{\\mathrm{AC}} = \\frac{1}{\\sqrt{2}}"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.095,
            0.515,
            0.851,
            0.564
          ],
          "content": [
            {
              "type": "text",
              "content": "So, 2 sin A cos "
            },
            {
              "type": "equation_inline",
              "content": "2\\left(\\frac{1}{\\sqrt{2}}\\right)\\left(\\frac{1}{\\sqrt{2}}\\right)=1,"
            },
            {
              "type": "text",
              "content": " which is the required value."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.095,
            0.575,
            0.595,
            0.639
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { { \\it { K } } } \\mathrm { { \\it { O P Q } } }"
            },
            {
              "type": "text",
              "content": " , right-angled at P, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { O P } = 7"
            },
            {
              "type": "text",
              "content": " cm and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{OQ} \\sim \\mathrm{PQ} = 1"
            },
            {
              "type": "text",
              "content": " cm (see Fig. 8.12). Determine the values of sin Q and cos Q."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.096,
            0.651,
            0.403,
            0.67
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\; \\mathrm { O P Q } ,"
            },
            {
              "type": "text",
              "content": " , we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.309,
            0.682,
            0.502,
            0.704
          ],
          "image_path": "images/page_7_equation_17.jpg",
          "content": "\\mathrm{OQ^{2}} = \\mathrm{OP^{2}} + \\mathrm{PQ^{2}}"
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.098,
            0.717,
            0.139,
            0.736
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.26,
            0.715,
            0.611,
            0.737
          ],
          "image_path": "images/page_7_equation_19.jpg",
          "content": "(1 + \\mathrm{PQ})^2 = \\mathrm{OP}^2 + \\mathrm{PQ}^2 \\quad (\\mathrm{Why?})"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.098,
            0.75,
            0.139,
            0.768
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.212,
            0.748,
            0.502,
            0.769
          ],
          "image_path": "images/page_7_equation_21.jpg",
          "content": "1 + \\mathrm{PQ}^{2} + 2\\mathrm{PQ} = \\mathrm{OP}^{2} + \\mathrm{PQ}^{2}"
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.098,
            0.783,
            0.138,
            0.802
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.278,
            0.782,
            0.416,
            0.802
          ],
          "image_path": "images/page_7_equation_23.jpg",
          "content": "1 + 2\\mathrm{PQ} = 7^{2}"
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.532,
            0.783,
            0.61,
            0.803
          ],
          "content": [
            {
              "type": "text",
              "content": "(Why?)"
            }
          ]
        },
        {
          "type": "image",
          "index": 25,
          "bbox": [
            0.741,
            0.583,
            0.873,
            0.824
          ],
          "content": [
            {
              "type": "image_body",
              "index": 25,
              "bbox": [
                0.741,
                0.583,
                0.873,
                0.824
              ],
              "image_path": "images/page_7_image_25.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.096,
            0.814,
            0.714,
            0.835
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., PQ = 24 cm and OQ = 1 + PQ = 25 cm"
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.096,
            0.852,
            0.597,
            0.896
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "\\sin Q = { \\frac { 7 } { 2 5 } }"
            },
            {
              "type": "text",
              "content": " and cos "
            },
            {
              "type": "equation_inline",
              "content": "\\mathsf { Q } = { \\frac { 2 4 } { 2 5 } } \\cdotp"
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.758,
            0.836,
            0.858,
            0.855
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 8.12"
            }
          ]
        },
        {
