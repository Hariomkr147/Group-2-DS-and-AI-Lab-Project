              "content": ""
            },
            {
              "type": "image_caption",
              "index": 23,
              "bbox": [
                0.641,
                0.825,
                0.727,
                0.844
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 8.9"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.097,
            0.842,
            0.191,
            0.86
          ],
          "content": [
            {
              "type": "text",
              "content": "We have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.413,
            0.832,
            0.537,
            0.871
          ],
          "image_path": "images/page_5_equation_22.jpg",
          "content": "\\sin \\mathbf { B } = { \\frac { \\mathrm { A C } } { \\mathrm { A B } } }"
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.097,
            0.887,
            0.142,
            0.904
          ],
          "content": [
            {
              "type": "text",
              "content": "and"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.412,
            0.875,
            0.536,
            0.915
          ],
          "image_path": "images/page_5_equation_25.jpg",
          "content": "\\sin Q = \\frac{PR}{PQ}"
        },
