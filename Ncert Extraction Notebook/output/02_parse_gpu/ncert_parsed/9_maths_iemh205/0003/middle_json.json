              "image_path": "images/page_2_table_5.jpg",
              "content": "<table><tbody><tr><td>Linear equation in two variables</td><td>Standard Form</td><td>Coefficient of x</td><td>Coefficient of y</td><td>Constant term</td></tr><tr><td>y - 15 = 2x</td><td></td><td></td><td></td><td></td></tr><tr><td>3y - 2x = 0</td><td></td><td></td><td></td><td></td></tr><tr><td>5x = 3y</td><td></td><td></td><td></td><td></td></tr><tr><td>x = 8</td><td></td><td></td><td></td><td></td></tr><tr><td>3y = 1</td><td></td><td></td><td></td><td></td></tr></tbody></table>"
