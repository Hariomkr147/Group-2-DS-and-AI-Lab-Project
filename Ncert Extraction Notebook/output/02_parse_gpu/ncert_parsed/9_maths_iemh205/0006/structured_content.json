          "bbox": [
            0.113,
            0.11,
            0.885,
            0.149
          ],
          "content": "We can represent these solutions or ordered pairs in the form of a table."
        },
        {
          "type": "table",
          "bbox": [
            0.388,
            0.148,
            0.612,
            0.238
          ],
          "content": "<table><tbody><tr><td rowspan=\"2\">x</td><td rowspan=\"2\">0</td><td rowspan=\"2\">72</td></tr><tr></tr><tr><td>y</td><td>7</td><td>0</td></tr></tbody></table>",
          "captions": [],
