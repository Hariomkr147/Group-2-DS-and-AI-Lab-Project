                0.522,
                0.654,
                0.542
              ],
              "content": "Fig. 2.5: The straight line y = 2x + 1"
            }
          ],
          "footnotes": [],
          "image_source": "images/page_12_image_3.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
