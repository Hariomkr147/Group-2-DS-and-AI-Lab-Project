          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.148,
            0.693,
            0.289,
            0.713
          ],
          "content": [
            {
              "type": "text",
              "content": "We see that,"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.72,
            0.532,
            0.74
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "y = 2x + 5"
            },
            {
              "type": "text",
              "content": " cuts the y-axis at A (0, 5),"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.149,
            0.746,
            0.566,
            0.767
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "y = x + 3"
            },
            {
              "type": "text",
              "content": " cuts the y-axis at B (0, 3), and"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.15,
            0.773,
            0.54,
            0.794
