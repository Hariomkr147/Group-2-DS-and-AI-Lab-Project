            0.191
          ],
          "content": [
            {
              "type": "text",
              "content": "Does this help you to conclude anything about the linear equation "
            },
            {
              "type": "equation_inline",
              "content": "y = a x + b"
            },
            {
              "type": "text",
              "content": " when a is fixed but b varies?"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.111,
            0.218,
            0.884,
            0.257
          ],
          "content": [
            {
              "type": "text",
              "content": "("
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In these equations a = 2, and b takes the values –1, 1 and 5, respectively.)"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.108,
            0.257,
            0.886,
            0.298
          ],
          "content": [
            {
              "type": "text",
              "content": "Now let us draw the graphs of the equations "
            },
            {
              "type": "equation_inline",
              "content": "y = x + 3, \\\\ y = 2x + 5"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "y = 3 x - 2"
            },
            {
              "type": "text",
              "content": " . See Fig. 2.14 and observe where these lines cut the y-axis."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.269,
