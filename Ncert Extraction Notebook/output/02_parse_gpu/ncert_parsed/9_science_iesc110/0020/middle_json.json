                0.583
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 10.29: A drone"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.202,
            0.615,
            0.392,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "Pause and Ponder"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.139,
            0.646,
            0.813,
            0.711
          ],
          "content": [
            {
              "type": "text",
              "content": "13. Sound travels much farther in water than light, and thus, is used for various underwater applications. A sonar signal sent to find the depth of ocean takes 4 s to return. What is the depth of the ocean at that location if the speed of sound in seawater is 1500 m s"
            },
            {
              "type": "text",
              "content": "–1",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": "?"
            }
          ]
        },
        {
          "type": "image",
          "index": 15,
          "bbox": [
            0.114,
            0.736,
            0.15,
            0.77
          ],
          "content": [
