                0.631,
                0.49,
                0.89,
                0.52
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 10.19: Graphical representation of a sound wave"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.133,
            0.497,
            0.579,
            0.531
          ],
          "content": [
            {
              "type": "text",
              "content": "9. For the sound wave represented by the graph shown in Fig. 10.19, what is half of its wavelength?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.11,
            0.561,
            0.671,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "10.6.2 Amplitude and intensity of the sound waves"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.108,
            0.583,
            0.401,
            0.753
          ],
          "content": [
            {
              "type": "text",
              "content": "Sound propagates as density oscillations of the medium via compressions and rarefactions. The "
            },
            {
              "type": "text",
              "content": "amplitude",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " of a sound wave is the maximum change in the density of air in a compression (or a rarefaction) compared to the average density. A larger change in density corresponds to a larger amplitude (Fig. 10.20)."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.11,
            0.755,
            0.4,
            0.789
          ],
          "content": [
            {
              "type": "text",
              "content": "The amplitude and the amount of energy a wave carries"
            }
          ]
        },
        {
          "type": "chart",
          "index": 15,
          "bbox": [
            0.406,
            0.587,
            0.656,
            0.754
          ],
          "content": [
            {
              "type": "chart_body",
              "index": 15,
              "bbox": [
                0.406,
                0.587,
                0.656,
                0.754
              ],
              "image_path": "images/page_11_chart_15.jpg",
              "content": ""
            },
            {
              "type": "chart_caption",
              "index": 16,
              "bbox": [
                0.479,
                0.757,
                0.614,
                0.772
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(a) Low amplitude"
                }
              ]
            }
          ]
        },
        {
          "type": "chart",
          "index": 17,
          "bbox": [
            0.703,
            0.583,
            0.955,
            0.754
          ],
          "content": [
            {
