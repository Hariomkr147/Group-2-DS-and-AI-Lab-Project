            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.117,
            0.477,
            0.233,
            0.493
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.116,
            0.494,
            0.883,
            0.563
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.1. Pratibha uses the digits ‘4’, ‘7’, ‘3’ and ‘2’, and makes the smallest and largest 4- digit numbers with them: 2347 and 7432. The difference between these two numbers is 7432 – 2347 = 5085. The sum of these two numbers is 9779. Choose 4– digits to make:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.176,
            0.564,
            0.848,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "a. the difference between the largest and smallest numbers greater than 5085.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.176,
            0.583,
            0.818,
            0.599
          ],
          "content": [
            {
              "type": "text",
              "content": "b. the difference between the largest and smallest numbers less than 5085.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.176,
            0.6,
            0.744,
            0.617
          ],
          "content": [
            {
              "type": "text",
              "content": "c. the sum of the largest and smallest numbers greater than 9779.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.176,
            0.618,
            0.713,
            0.635
          ],
          "content": [
            {
              "type": "text",
              "content": "d. the sum of the largest and smallest numbers less than 9779.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.117,
            0.636,
            0.424,
            0.652
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Some of the possibilities are–"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.212,
            0.654,
            0.402,
            0.67
          ],
          "content": [
            {
              "type": "text",
              "content": "a. 7431 – 1347 = 6084"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.212,
            0.671,
            0.404,
            0.687
          ],
          "content": [
            {
              "type": "text",
              "content": "b. 7433 – 3347 = 4086"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.212,
            0.689,
            0.413,
            0.705
          ],
          "content": [
            {
              "type": "text",
              "content": "c. 7433 + 3347 = 10780"
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.212,
            0.706,
            0.405,
            0.723
          ],
          "content": [
            {
              "type": "text",
              "content": "d. "
            },
            {
              "type": "equation_inline",
              "content": "7 4 3 1 + 1 3 4 7 = 8 7 7 8"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.115,
            0.741,
            0.881,
            0.775
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.2. What is the sum of the smallest and largest 5-digit palindrome? What is their difference?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.116,
            0.777,
            0.49,
            0.848
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Smallest 5 digit palindrome = 10001 largest 5 digit palindrome = 99999 Sum = 10001 + 99999 = 110,000 Difference = 99999 – 10001 = 89,998"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 26,
          "bbox": [
            0.488,
            0.926,
            0.512,
            0.942
          ],
          "content": [
            {
              "type": "text",
              "content": "[8]"
            }
          ]
        }
      ]
