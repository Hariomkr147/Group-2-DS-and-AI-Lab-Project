            0.806,
            0.659
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, look at these additions. Try to figure out what is happening."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.113,
            0.66,
