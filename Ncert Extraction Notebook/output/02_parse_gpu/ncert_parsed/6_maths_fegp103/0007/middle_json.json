            0.796
          ],
          "content": [
            {
              "type": "text",
              "content": "Steps to follow:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Start with a 2-digit number. Add this number to its reverse. Stop if you get a palindrome or else repeat the steps of reversing the digits and adding."
