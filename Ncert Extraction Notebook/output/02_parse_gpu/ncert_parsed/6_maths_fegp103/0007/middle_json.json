            0.371
          ],
          "content": [
            {
              "type": "text",
              "content": "3.5 Pretty Palindromic Patterns"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.112,
            0.386,
            0.835,
            0.477
          ],
          "content": [
            {
              "type": "text",
              "content": "What pattern do you see in these numbers: 66, 848, 575, 797, 1111? These numbers read the same from left to right and from right to left. Try and see. Such numbers are called "
            },
            {
              "type": "text",
              "content": "palindromes",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " or "
            },
            {
              "type": "text",
              "content": "palindromic numbers",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": "."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.155,
            0.489,
            0.48,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "All palindromes using 1, 2, 3"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.113,
            0.518,
            0.833,
            0.563
          ],
          "content": [
            {
              "type": "text",
              "content": "The numbers 121, 313, 222 are some examples of palindromes using the digits ‘1’, ‘2’, 3’."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.574,
            0.746,
            0.597
          ],
          "content": [
            {
              "type": "text",
              "content": "嶽 Write all possible 3-digit palindromes using these digits."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.114,
            0.609,
            0.458,
            0.629
          ],
          "content": [
            {
              "type": "text",
              "content": "Reverse-and-add palindromes"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
