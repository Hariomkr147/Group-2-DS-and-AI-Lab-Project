            0.353,
            0.746
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.197,
            0.759,
            0.885,
            0.849
          ],
          "content": [
            {
              "type": "text",
              "content": "Pratibha uses the digits ‘4’, ‘7’, ‘3’ and ‘2’, and makes the smallest and largest 4-digit numbers with them: 2347 and 7432. The difference between these two numbers is 7432 – 2347 = 5085. The sum of these two numbers is 9779. Choose 4 - digits to make:"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.23,
            0.856,
            0.884,
            0.9
          ],
          "content": [
            {
              "type": "text",
              "content": "a. the difference between the largest and smallest numbers greater than 5085."
            }
          ]
        },
