        {
          "type": "text",
          "bbox": [
            0.113,
            0.12,
            0.834,
            0.166
          ],
          "content": "Follow these steps and experience the magic for yourselves! Pick any 4-digit number having at least two different digits, say 6382."
        },
        {
          "type": "text",
          "bbox": [
            0.338,
            0.181,
            0.532,
            0.202
          ],
          "content": "Take a 4-digit number."
        },
        {
          "type": "text",
          "bbox": [
            0.278,
            0.238,
            0.584,
            0.28
          ],
          "content": "Make the largest number from these digits. Call it A."
        },
        {
          "type": "image",
          "bbox": [
            0.245,
            0.175,
            0.71,
            0.45
          ],
