        {
          "type": "text",
          "bbox": [
            0.272,
            0.317,
            0.59,
            0.36
          ],
          "content": "Make the smallest number from these digits. Call it B."
        },
        {
          "type": "text",
          "bbox": [
            0.336,
            0.482,
            0.632,
            0.528
          ],
          "content": "What happens if we continue doing this?"
        },
        {
          "type": "text",
          "bbox": [
            0.113,
            0.554,
            0.211,
            0.575
          ],
          "content": "A = 8632"
