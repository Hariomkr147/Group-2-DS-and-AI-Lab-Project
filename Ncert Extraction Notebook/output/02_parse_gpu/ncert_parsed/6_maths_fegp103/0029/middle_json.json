        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.161,
            0.705,
            0.36,
            0.721
          ],
          "content": [
            {
              "type": "text",
              "content": "b. Only sometimes true"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.181,
            0.722,
            0.528,
            0.739
          ],
          "content": [
            {
              "type": "text",
              "content": "9,999 + 99 = 10,098 not a 4 digit number"
