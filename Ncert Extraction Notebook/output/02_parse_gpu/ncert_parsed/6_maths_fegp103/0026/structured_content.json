          "content": "<table><tr><td colspan=\"2\">Some of these are-</td></tr><tr><td>12</td><td>47</td></tr><tr><td>+21 33</td><td>+74 121</td></tr></table>",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_25_table_10.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
