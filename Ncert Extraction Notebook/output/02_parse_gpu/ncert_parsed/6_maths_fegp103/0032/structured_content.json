          "bbox": [
            0.115,
            0.15,
            0.633,
            0.43
          ],
          "content": "<table><tr><td colspan=\"4\">25</td><td colspan=\"4\">25</td></tr><tr><td>50</td><td></td><td>50</td><td></td><td>50</td><td></td><td></td><td></td></tr><tr><td></td><td>25</td><td></td><td></td><td>25</td><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td><td>Or</td><td></td><td></td><td></td><td></td></tr><tr><td>10</td><td></td><td>10</td><td></td><td>10</td><td>10</td><td></td><td>10</td></tr><tr><td>10</td><td></td><td>10</td><td></td><td>10</td><td></td><td>10</td><td>10</td></tr><tr><td>10</td><td></td><td>10</td><td></td><td>10</td><td></td><td>10</td><td>10</td></tr><tr><td>10</td><td></td><td>10</td><td></td><td>10</td><td>10</td><td></td><td>10</td></tr><tr><td>10</td><td></td><td>10</td><td></td><td>10</td><td></td><td>10</td><td>10</td></tr></table>",
          "captions": [],
