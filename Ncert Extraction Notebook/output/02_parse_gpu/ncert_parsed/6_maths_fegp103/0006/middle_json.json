            0.512
          ],
          "content": [
            {
              "type": "text",
              "content": "Komal observes that when she adds up digits of certain numbers the sum is the same."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.164,
            0.513,
            0.595,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, adding the digits of the number 68 will be same as adding the digits of 176 or 545."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.166,
            0.593,
            0.353,
            0.615
          ],
          "content": [
