          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.164,
            0.5,
            0.507,
            0.66
          ],
          "content": [
            {
              "type": "text",
              "content": "The rule remains the same: a cell becomes a supercell if the number in it is greater than all the numbers in its neighbouring cells. In Table 1, 8632 is greater than all its neighbours 4580, 8280, 4795 and 1944."
            }
          ]
        },
