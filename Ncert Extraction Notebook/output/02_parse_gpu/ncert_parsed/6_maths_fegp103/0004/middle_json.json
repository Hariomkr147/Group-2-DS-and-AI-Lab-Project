          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.164,
            0.448,
            0.884,
            0.494
          ],
          "content": [
            {
              "type": "text",
              "content": "Here the neighbouring cells are those that are immediately to the left, right, top and bottom. Table 1 Table 1"
