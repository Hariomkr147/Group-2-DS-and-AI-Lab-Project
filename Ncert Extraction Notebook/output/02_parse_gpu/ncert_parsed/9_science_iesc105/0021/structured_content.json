          ],
          "content": "<table><tbody><tr><td rowspan=\"2\">Salts</td><td colspan=\"6\">Temperature (°C)</td></tr><tr><td>10 °C</td><td>20 °C</td><td>30 °C</td><td>40 °C</td><td>60 °C</td><td>80 °C</td></tr><tr><td>Potassium nitrate</td><td>21</td><td>32</td><td>45</td><td>62</td><td>106</td><td>167</td></tr><tr><td>Sodium chloride</td><td>36</td><td>36</td><td>36.3</td><td>36.5</td><td>37</td><td>37</td></tr><tr><td>Potassium chloride</td><td>35</td><td>35</td><td>37.4</td><td>40</td><td>46</td><td>54</td></tr><tr><td>Ammonium chloride</td><td>24</td><td>37</td><td>41</td><td>41</td><td>55</td><td>66</td></tr></tbody></table>",
          "captions": [
