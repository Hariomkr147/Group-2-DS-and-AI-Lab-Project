            0.214
          ],
          "content": "(a) water — acetone"
        },
        {
          "type": "text",
          "bbox": [
            0.426,
            0.196,
            0.57,
            0.214
          ],
          "content": "(b) water — salt"
        },
        {
          "type": "text",
          "bbox": [
            0.188,
            0.217,
            0.38,
            0.234
          ],
          "content": "(c) acetone — alcohol"
