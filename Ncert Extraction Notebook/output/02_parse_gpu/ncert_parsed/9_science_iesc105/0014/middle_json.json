            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.761,
            0.435,
            0.877,
            0.472
          ],
          "content": [
            {
              "type": "text",
              "content": "Threads of Curiosity"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.687,
            0.483,
            0.933,
            0.561
          ],
          "content": [
            {
              "type": "text",
              "content": "The spinning game is a folk dance called phugadi in Marathi and kikli in Punjabi. What is this called in your local language?"
            }
          ]
        },
