            },
            {
              "type": "equation_inline",
              "content": "b ^ { 2 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "is divisible by 3, and so",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " b "
            },
            {
              "type": "text",
