            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "REAL NUMBERS"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.884,
            0.105,
            0.899,
            0.118
          ],
          "content": [
            {
              "type": "text",
              "content": "9"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.097,
            0.143,
            0.571,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "But this contradicts the fact that "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt { 2 }"
            },
            {
              "type": "text",
              "content": " is irrational."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.097,
            0.171,
            0.476,
            0.192
          ],
          "content": [
            {
              "type": "text",
              "content": "So, we conclude that "
            },
            {
              "type": "equation_inline",
              "content": "3 \\sqrt { 2 }"
            },
            {
              "type": "text",
              "content": " is irrational."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.409,
            0.214,
            0.59,
            0.234
          ],
          "content": [
            {
              "type": "text",
              "content": "EXERCISE 1.2"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.124,
            0.249,
            0.407,
            0.271
          ],
          "content": [
            {
              "type": "text",
              "content": "1.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Prove that "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt { 5 }"
            },
            {
              "type": "text",
              "content": " is irrational."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.124,
            0.28,
            0.445,
            0.301
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Prove that "
            },
            {
              "type": "equation_inline",
              "content": "3 + 2 { \\sqrt { 5 } }"
            },
            {
              "type": "text",
              "content": " is irrational."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.123,
            0.312,
            0.503,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": "3.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Prove that the following are irrationals :"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.169,
            0.339,
            0.655,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { \\sqrt { 2 } }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "\\left[ 7 \\sqrt { 5 } \\right]"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "6 + { \\sqrt { 2 } }"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.098,
            0.401,
            0.252,
            0.421
          ],
          "content": [
            {
              "type": "text",
              "content": "1.4 Summary"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.097,
            0.429,
            0.575,
            0.448
          ],
          "content": [
            {
              "type": "text",
              "content": "In this chapter, you have studied the following points:"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.125,
            0.454,
            0.516,
            0.472
          ],
          "content": [
            {
              "type": "text",
              "content": "1.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The Fundamental Theorem of Arithmetic :"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.146,
            0.48,
            0.9,
            0.518
          ],
          "content": [
            {
              "type": "text",
              "content": "Every composite number can be expressed (factorised) as a product of primes, and this factorisation is unique, apart from the order in which the prime factors occur."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.123,
            0.525,
            0.827,
            0.545
          ],
          "content": [
            {
              "type": "text",
              "content": "2.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If p is a prime and p divides "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 } ;"
            },
            {
              "type": "text",
              "content": " then p divides a, where a is a positive integer."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.124,
            0.554,
            0.485,
            0.576
          ],
          "content": [
            {
              "type": "text",
              "content": "3.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " To prove that "
            },
            {
              "type": "equation_inline",
              "content": "{ \\sqrt { 2 } } , { \\sqrt { 3 } }"
            },
            {
              "type": "text",
              "content": " are irrationals."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 15,
          "bbox": [
            0.362,
            0.627,
            0.637,
            0.649
          ],
          "content": [
            {
              "type": "text",
              "content": "A NOTE TO THE READER"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.143,
            0.665,
            0.342,
            0.683
          ],
          "content": [
            {
              "type": "text",
              "content": "You have seen that :"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.14,
            0.692,
            0.856,
            0.752
          ],
          "content": [
            {
              "type": "text",
              "content": "HCF "
            },
            {
              "type": "equation_inline",
              "content": "(p,q,r) \\times \\mathrm{LCM} (p,q,r) \\neq p \\times q \\times r,"
            },
            {
              "type": "text",
              "content": " , where "
            },
            {
              "type": "equation_inline",
              "content": "p , q , r"
            },
            {
              "type": "text",
              "content": " are positive integers (see Example 8). However, the following results hold good for three numbers p, q and "
            },
            {
              "type": "equation_inline",
              "content": "r ;"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.228,
            0.767,
            0.742,
            0.811
          ],
          "image_path": "images/page_8_equation_18.jpg",
          "content": "\\mathrm{LCM}(p, q, r) = \\frac{p \\cdot q \\cdot r \\cdot \\mathrm{HCF}(p, q, r)}{\\mathrm{HCF}(p, q) \\cdot \\mathrm{HCF}(q, r) \\cdot \\mathrm{HCF}(p, r)}"
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.235,
            0.824,
            0.758,
            0.868
          ],
          "image_path": "images/page_8_equation_19.jpg",
          "content": "\\mathrm{HCF}\\left(p, q, r\\right)=\\frac{p \\cdot q \\cdot r \\cdot \\mathrm{LCM}(p, q, r)}{\\mathrm{LCM}(p, q) \\cdot \\mathrm{LCM}(q, r) \\cdot \\mathrm{LCM}(p, r)}"
        },
        {
          "type": "footer",
          "index": 20,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
