              "type": "text",
              "content": "Work, Energy, and Simple Machines"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.857,
            0.017,
            0.952,
            0.086
          ],
          "content": [
            {
              "type": "text",
              "content": "N 129"
            }
          ]
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.14,
            0.088,
            0.441,
            0.106
          ],
          "image_path": "images/page_13_equation_2.jpg",
          "content": "2000000\\mathrm{J}=(50000+50000)\\mathrm{N} \\times d"
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.142,
            0.114,
            0.468,
            0.15
          ],
          "image_path": "images/page_13_equation_3.jpg",
          "content": "d=\\frac{2000000\\mathrm{~J}}{100000\\mathrm{~N}}=\\frac{2000000\\mathrm{~N}\\mathrm{~m}}{100000\\mathrm{~N}}=20\\mathrm{~m}"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.109,
            0.158,
            0.77,
            0.177
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, the minimum length of the ramp to be able to stop such a truck is 20 m."
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.127,
            0.184,
            0.189,
            0.214
          ],
          "content": [
            {
