          "image_source": "images/page_5_image_26.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.7,
            0.368,
            0.794,
            0.423
          ],
          "content": "**Light energy** Energy that allows us to see"
        },
        {
          "type": "image",
          "bbox": [
            0.724,
