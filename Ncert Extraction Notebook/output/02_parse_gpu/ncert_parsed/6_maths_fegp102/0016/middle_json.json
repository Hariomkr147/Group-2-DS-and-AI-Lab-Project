          ],
          "content": [
            {
              "type": "text",
              "content": "Is it possible to draw "
            },
            {
              "type": "equation_inline",
              "content": "\\overrightarrow { \\mathrm { O C } }"
            },
            {
              "type": "text",
              "content": " such that the two angles are equal to each other in size?"
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.803,
            0.313,
            0.891,
            0.38
          ],
