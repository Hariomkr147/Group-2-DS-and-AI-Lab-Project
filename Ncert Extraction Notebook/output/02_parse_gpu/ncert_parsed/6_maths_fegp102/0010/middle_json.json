          ],
          "content": [
            {
              "type": "text",
              "content": "The picture shows the two angles superimposed. It is now clear that ∠PQR is larger than "
            },
            {
              "type": "equation_inline",
              "content": "\\angle  ABC"
            }
          ]
        },
        {
          "type": "text",
