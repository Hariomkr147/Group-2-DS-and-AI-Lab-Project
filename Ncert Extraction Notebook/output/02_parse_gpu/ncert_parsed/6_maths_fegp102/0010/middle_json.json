          "bbox": [
            0.164,
            0.44,
            0.885,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "Equal angles.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Now consider "
