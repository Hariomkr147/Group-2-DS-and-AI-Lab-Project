            0.834,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "360 equal angles or parts. The angle measure of each of these unit parts is 1 degree, which is written as 1°."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.166,
            0.834,
            0.234
          ],
          "content": [
            {
              "type": "text",
              "content": "This unit part is used to assign measure to any angle: the measure of an angle is the number of "
            },
            {
              "type": "equation_inline",
              "content": "1 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " unit parts it contains inside it. For example, see this figure:"
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.324,
            0.231,
            0.653,
            0.359
          ],
          "content": [
            {
              "type": "image_body",
