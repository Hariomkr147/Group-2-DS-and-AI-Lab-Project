          ],
          "content": [
            {
              "type": "text",
              "content": "The measure of half a circle is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 }"
            },
            {
              "type": "text",
              "content": " of a full turn. (Fig. 2.14) So, the measure of half a turn "
            },
            {
              "type": "equation_inline",
              "content": "= \\frac { 1 } { 2 }"
            },
            {
              "type": "text",
              "content": " of "
            },
            {
              "type": "equation_inline",
              "content": "= 1 8 0 ^ { \\circ } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.427,
            0.445,
            0.645,
            0.514
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, write "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " in the left bottom corner of the semicircle."
            }
          ]
