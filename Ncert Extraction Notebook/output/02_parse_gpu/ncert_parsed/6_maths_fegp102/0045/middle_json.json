          "content": [
            {
              "type": "text",
              "content": "Ans. "
            },
            {
              "type": "equation_inline",
              "content": "\\angle  RTQ , \\angle  RTP"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.115,
            0.568,
            0.883,
            0.639
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.5. Mark any three points on your paper that are not on one line. Label them A, B, C. Draw all possible lines going through pairs of these points. How many lines do you get? Name them. How many angles can you name using A, B, C? Write them down, and mark each of them with a curve as in Fig. 2.9.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.327,
            0.637,
            0.44,
            0.651
          ],
          "image_path": "images/page_44_equation_11.jpg",
          "content": "\\Longleftrightarrow \\Longleftrightarrow \\Longleftrightarrow"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.117,
            0.648,
            0.443,
            0.666
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. We get three lines AB, BC, CA."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.224,
            0.678,
            0.466,
            0.845
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
