            0.881,
            0.203
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.1. Can you find the angles in the given pictures? Draw the rays forming any one of the angles and name the vertex of the angle.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.115,
            0.21,
            0.874,
            0.248
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. Yes, one of the angles is ∠BDC. It’s vertex is D. One ray is "
            },
            {
              "type": "equation_inline",
              "content": "\\overrightarrow { \\operatorname { D C } \\mathrm { a } }"
            },
            {
              "type": "text",
              "content": " nd the other rays DB. Try for other pictures."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.115,
            0.257,
            0.568,
            0.275
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.2. Draw and label an angle with arms ST and SR.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.293,
            0.161,
            0.309
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.115,
            0.31,
            0.545,
            0.329
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.4. Name the angles marked in the given figure.",
              "styles": [
