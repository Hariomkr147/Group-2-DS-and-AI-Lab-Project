          "bbox": [
            0.175,
            0.874,
            0.883,
            0.908
          ],
          "content": [
            {
              "type": "text",
              "content": "Using A, B & C we can name three angles: ∠ABC or "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathbf { C B A } ,"
            },
            {
              "type": "text",
              "content": " ∠BCA or "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathbf { A C B }"
            },
            {
              "type": "text",
              "content": " & ∠CAB or ∠BAC."
            }
          ]
