          ],
          "content": [
            {
              "type": "text",
              "content": "Hint: Observe that "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { R E B }"
            },
            {
              "type": "text",
              "content": " is a straight angle. Hence, the degree measure of "
            },
            {
              "type": "equation_inline",
              "content": "\\angle  REB  = 180^{\\circ}"
            },
            {
              "type": "text",
              "content": " of which "
            },
            {
              "type": "equation_inline",
              "content": "8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " is covered by "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { T E R } ."
            },
            {
              "type": "text",
              "content": " A similar argument can be applied to find the measure of "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { S E T } ."
