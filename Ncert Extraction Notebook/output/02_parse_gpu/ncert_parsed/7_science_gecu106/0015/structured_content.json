        {
          "type": "text",
          "bbox": [
            0.155,
            0.362,
            0.434,
            0.384
          ],
          "content": "(ii) Development of breasts"
        },
        {
          "type": "text",
          "bbox": [
            0.15,
            0.387,
            0.415,
            0.408
          ],
          "content": "(iii) Growth of moustache"
