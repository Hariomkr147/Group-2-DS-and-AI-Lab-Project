              "image_path": "images/page_3_table_4.jpg",
              "content": "<table><tbody><tr><td>x</td><td>0</td><td>3</td></tr><tr><td>2x - 12 y =3</td><td>- 4</td><td>-2</td></tr></tbody></table>"
            }
