              "content": "<table><tbody><tr><td>Name of the organism</td><td>Performs photosynthesis</td><td>Feeds on plants and plant products</td><td>Feeds on animals</td><td>Feeds on both plants and animals</td></tr><tr><td>Deer</td><td>No</td><td>Yes - Grass and leaves of plants</td><td>No</td><td>No - Only on plants</td></tr><tr><td>Hare</td><td></td><td></td><td></td><td></td></tr><tr><td>Vulture</td><td></td><td></td><td></td><td></td></tr><tr><td>Bengal Fox</td><td></td><td></td><td></td><td></td></tr><tr><td>Bird (Shikra)</td><td></td><td></td><td></td><td></td></tr><tr><td>Squirrel</td><td></td><td></td><td></td><td></td></tr><tr><td>Mouse</td><td></td><td></td><td></td><td></td></tr><tr><td>Mushroom</td><td></td><td></td><td></td><td></td></tr><tr><td>Tree</td><td>Yes</td><td></td><td></td><td></td></tr></tbody></table>"
