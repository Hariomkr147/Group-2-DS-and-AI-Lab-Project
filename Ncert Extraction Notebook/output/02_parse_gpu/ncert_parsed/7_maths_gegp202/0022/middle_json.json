              ],
              "image_path": "images/page_21_table_5.jpg",
              "content": "<table><tbody><tr><td>- 9</td><td>- 6</td><td>- 3</td><td>3</td><td>3</td><td>6</td><td>9</td></tr><tr><td>- 6</td><td>- 4</td><td>- 2</td><td>2</td><td>2</td><td>4</td><td>6</td></tr><tr><td>- 3</td><td>- 2</td><td>- 1</td><td>1</td><td>1</td><td>2</td><td>3</td></tr><tr><td>- 3</td><td>- 2</td><td>- 1</td><td>×</td><td>1</td><td>2</td><td>3</td></tr><tr><td>3</td><td>2</td><td>1</td><td>1</td><td>- 1</td><td>- 2</td><td>- 3</td></tr><tr><td>6</td><td>4</td><td>2</td><td>2</td><td>- 2</td><td>- 4</td><td>- 6</td></tr><tr><td>9</td><td>6</td><td>3</td><td>3</td><td>- 3</td><td>- 6</td><td>- 9</td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.2,
            0.424,
            0.789,
            0.442
          ],
          "content": [
            {
              "type": "text",
              "content": "is negative when one of them is positive and the other is negative."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.176,
            0.443,
            0.821,
            0.462
          ],
          "content": [
            {
              "type": "text",
              "content": "• Integer multiplication is commutative, i.e., for any two integers a and b,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.442,
            0.463,
            0.556,
            0.479
          ],
          "image_path": "images/page_21_equation_8.jpg",
          "content": "a \\times b = b \\times a."
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.176,
            0.481,
            0.821,
            0.518
          ],
          "content": [
            {
              "type": "text",
              "content": "Integer multiplication is associative, i.e., for any three integers, a, b, and c,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.399,
            0.519,
            0.6,
            0.537
          ],
          "image_path": "images/page_21_equation_10.jpg",
          "content": "\\overline{a} \\times (b \\times c) = (a \\times b) \\times c."
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.176,
            0.538,
            0.821,
            0.576
          ],
          "content": [
            {
              "type": "text",
              "content": "Integer multiplication is distributive over addition, i.e., for any three integers, a, b, and c,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.379,
            0.577,
            0.619,
            0.595
          ],
          "image_path": "images/page_21_equation_12.jpg",
          "content": "a \\times (b + c) = (a \\times b) + (a \\times c)."
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.313,
            0.643,
            0.397,
            0.717
          ],
          "content": [
