            0.432,
            0.066
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Prakash | Grade 7 | Part-II"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.15,
            0.089,
            0.847,
            0.185
          ],
          "content": [
            {
              "type": "text",
              "content": "In addition to the number line, we used the token model to understand integers. We used this model to perform addition and subtraction in Grade 6. Let us do a quick recall. We used green ( ) token to represent positive 1 and red ( ) token to represent negative 1, that is –1. Together they make zero, as they cancel each other out."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.113,
            0.194,
            0.317,
            0.215
          ],
          "content": [
            {
              "type": "text",
              "content": "Find (+7) – (+18)."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.151,
            0.22,
            0.846,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "To subtract 18 from 7, i.e., (+7) – (+18), we need to remove 18 positives from 7 positives."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.368,
            0.268,
            0.628,
            0.3
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.368,
                0.268,
                0.628,
                0.3
              ],
              "image_path": "images/page_4_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.175,
            0.315,
            0.8,
            0.353
          ],
          "content": [
            {
              "type": "text",
              "content": "But there are not enough tokens to remove 18 positives! We put in enough zero pairs so that we can remove 18 positives."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.113,
            0.361,
            0.274,
            0.384
          ],
          "content": [
            {
              "type": "text",
              "content": "How many?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.388,
            0.845,
            0.426
          ],
          "content": [
            {
              "type": "text",
              "content": "We have 7 positives and we need 11 more. So we need to put in 11 zero pairs:"
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.177,
            0.441,
            0.842,
            0.474
          ],
          "content": [
            {
              "type": "image_body",
              "index": 10,
              "bbox": [
                0.177,
                0.441,
                0.842,
                0.474
              ],
              "image_path": "images/page_4_image_10.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 11,
          "bbox": [
            0.434,
            0.476,
            0.842,
            0.509
          ],
          "content": [
            {
              "type": "image_body",
              "index": 11,
              "bbox": [
                0.434,
                0.476,
                0.842,
                0.509
              ],
              "image_path": "images/page_4_image_11.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.152,
            0.525,
            0.478,
            0.543
          ],
          "content": [
            {
              "type": "text",
              "content": "We can now remove 18 positives."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.154,
            0.558,
            0.841,
            0.626
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
              "bbox": [
                0.154,
                0.558,
                0.841,
                0.626
              ],
              "image_path": "images/page_4_image_13.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.151,
            0.642,
            0.639,
            0.661
          ],
          "content": [
            {
              "type": "text",
              "content": "What is left? There are 11 negatives, meaning –11."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.422,
            0.673,
            0.576,
            0.691
          ],
          "content": [
            {
              "type": "text",
              "content": "So, 7 – 18 = –11."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.152,
            0.701,
            0.846,
            0.738
          ],
          "content": [
            {
              "type": "text",
              "content": "We had also seen that subtracting a number is the same as adding its additive inverse."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.121,
            0.749,
            0.632,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "Using tokens, argue out the following statements."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.151,
            0.78,
            0.649,
            0.799
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) 7 – 18 = 7 + (– 18) (additive inverse of 18 is – 18)"
            }
          ]
        },
        {
          "type": "image",
          "index": 19,
          "bbox": [
            0.818,
            0.74,
            0.904,
            0.79
          ],
          "content": [
            {
              "type": "image_body",
              "index": 19,
              "bbox": [
                0.818,
                0.74,
                0.904,
                0.79
              ],
              "image_path": "images/page_4_image_19.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.152,
            0.805,
            0.649,
            0.823
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) 4 – (– 12) = 4 + 12 (additive inverse of – 12 is 12)"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.151,
            0.843,
            0.827,
            0.877
          ],
          "content": [
            {
              "type": "text",
              "content": "Note to the Teacher:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Tokens of different shapes may be used for positive and negative numbers for visually challanged students."
            }
          ]
        },
