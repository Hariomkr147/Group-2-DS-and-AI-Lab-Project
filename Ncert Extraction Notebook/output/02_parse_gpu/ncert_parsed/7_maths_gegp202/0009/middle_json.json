          ],
          "content": [
            {
              "type": "text",
              "content": "Since removing 2 positive tokens is the same as adding 2 negative tokens, "
            },
            {
              "type": "equation_inline",
              "content": "- 4 \\times 2"
            },
            {
              "type": "text",
              "content": " can also be obtained by adding 2 negative tokens to the empty bag 4 times."
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.686,
            0.087,
