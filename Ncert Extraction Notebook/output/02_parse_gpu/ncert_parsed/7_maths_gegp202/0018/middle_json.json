            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.158,
            0.448,
            0.572,
            0.467
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, for any integers a, b, and c, we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.366,
            0.478,
            0.632,
            0.496
          ],
          "image_path": "images/page_17_equation_11.jpg",
          "content": "a \\times (b + c) = (a \\times b) + (a \\times c)."
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.153,
            0.517,
            0.323,
            0.535
          ],
          "content": [
            {
              "type": "text",
              "content": "Pick the Pattern"
