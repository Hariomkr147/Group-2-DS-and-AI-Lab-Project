              ],
              "image_path": "images/page_11_table_14.jpg",
              "content": "<table><tbody><tr><td>Body parts</td><td>Complete rotation</td><td>Partial rotation</td><td>Bending</td><td>Turning, side-raising, up-down or any other movement</td></tr><tr><td>Elbow</td><td>No</td><td>No</td><td>Yes</td><td></td></tr><tr><td>Shoulder</td><td></td><td></td><td></td><td></td></tr><tr><td>Knee</td><td></td><td></td><td></td><td></td></tr><tr><td>Neck</td><td></td><td></td><td></td><td></td></tr><tr><td>Fingers</td><td></td><td></td><td></td><td></td></tr><tr><td>Toes</td><td></td><td></td><td></td><td></td></tr><tr><td>Wrist</td><td></td><td></td><td></td><td></td></tr></tbody></table>"
