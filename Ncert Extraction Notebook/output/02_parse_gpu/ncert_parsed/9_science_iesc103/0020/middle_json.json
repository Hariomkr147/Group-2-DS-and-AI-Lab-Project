          ],
          "content": [
            {
              "type": "text",
              "content": "y Reflect on any of the physical practices you are"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.121,
            0.384,
            0.773,
            0.421
          ],
          "content": [
            {
              "type": "text",
              "content": "familiar with, such as yoga, kabaddi, etc. How would it support bone and muscle health?"
            }
          ],
          "continues_prev": true
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.78,
