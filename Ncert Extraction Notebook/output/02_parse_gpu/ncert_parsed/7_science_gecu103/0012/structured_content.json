          ],
          "level": 2,
          "content": "D eeper <sup>ive</sup>"
        },
        {
          "type": "text",
          "bbox": [
            0.353,
            0.567,
            0.863,
            0.69
          ],
          "content": "International organisations, such as the International Electrotechnical Commission (IEC), American National Standards Institute (ANSI), and the Institute of Electrical and Electronics Engineers (IEEE) create standard symbols for electrical and electronic parts. Using the same symbols across the world helps people from different countries and industries understand each other easily."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.27,
            0.711,
            0.838,
            0.736
          ],
          "level": 2,
          "content": "3.4 Electrical Conductors and Insulators"
        },
        {
          "type": "image",
          "bbox": [
            0.044,
            0.767,
