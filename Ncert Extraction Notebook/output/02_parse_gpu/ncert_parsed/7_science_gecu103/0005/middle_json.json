                0.226
              ],
              "content": [
                {
                  "type": "text",
                  "content": "LED lamp"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.308,
            0.301,
            0.56,
            0.319
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 3.5: An LED lamp for torch"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.137,
            0.332,
            0.41,
            0.353
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 3.5: Let us observe"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.128,
            0.368,
            0.575,
            0.407
          ],
          "content": [
            {
              "type": "text",
              "content": "Take an LED of any colour (Fig. 3.6) and observe. Do you see any filament inside it?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.127,
            0.411,
            0.576,
            0.467
          ],
          "content": [
            {
              "type": "text",
              "content": "Notice",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the length of two wires attached to the LED. Do you find one of those longer than the other?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.114,
            0.471,
            0.576,
            0.601
          ],
          "content": [
            {
              "type": "text",
              "content": "Unlike incandescent lamps, LEDs do not have filaments (Fig. 3.6). They also have two terminals, but one is positive (attached to a longer wire) and the other is negative (the shorter wire). A torch may use one or more LEDs, sometimes of different shapes, in its lamp."
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.585,
            0.341,
            0.905,
            0.541
          ],
          "content": [
            {
              "type": "image_body",
              "index": 10,
              "bbox": [
                0.585,
                0.341,
                0.905,
                0.541
              ],
              "image_path": "images/page_4_image_10.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 11,
              "bbox": [
                0.609,
                0.545,
                0.876,
                0.565
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 3.6: LEDs of different colours"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.114,
            0.602,
            0.743,
            0.661
          ],
          "content": [
            {
              "type": "text",
              "content": "After having learnt about the electric cell, battery, and electric lamps, we are now ready to make the torch lamp glow using an electric cell or battery."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.114,
            0.671,
            0.742,
            0.717
          ],
          "content": [
            {
              "type": "text",
              "content": "3.2.4 Making an electric lamp glow using an electric cell or battery"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.134,
            0.731,
            0.424,
            0.752
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 3.6: Let us construct",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.127,
            0.767,
            0.743,
            0.806
          ],
          "content": [
            {
              "type": "text",
              "content": "Take an electric cell, an incandescent lamp used in a torch, a cell holder, a lamp holder, and four lengths of electric wire."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.127,
            0.809,
            0.744,
            0.847
          ],
          "content": [
            {
              "type": "text",
              "content": "Remove about 1 cm of the plastic covering from both ends of each wire to expose the metal."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.127,
            0.852,
            0.743,
            0.891
          ],
          "content": [
            {
              "type": "text",
              "content": "Attach two wires to the two ends of the cell holder as shown in Fig. 3.7a."
            }
          ]
        },
        {
          "type": "aside_text",
          "index": 18,
          "bbox": [
