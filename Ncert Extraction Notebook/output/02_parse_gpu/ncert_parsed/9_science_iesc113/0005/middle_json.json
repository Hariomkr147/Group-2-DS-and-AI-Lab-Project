              ],
              "image_path": "images/page_4_table_13.jpg",
              "content": "<table><tbody><tr><td>S. No.</td><td>Materials</td><td>Albedo</td></tr><tr><td>1.</td><td>Snow</td><td>0.80 - 0.90</td></tr><tr><td>2.</td><td>Ice</td><td>0.50 - 0.70</td></tr><tr><td>3.</td><td>Crushed rock</td><td>0.25 - 0.30</td></tr><tr><td>4.</td><td>Light coloured soil</td><td></td></tr><tr><td>5.</td><td>Black soil</td><td></td></tr><tr><td>6.</td><td>Ocean water</td><td></td></tr></tbody></table>"
            }
