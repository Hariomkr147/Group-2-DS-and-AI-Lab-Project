            0.442,
            0.838
          ],
          "content": [
            {
              "type": "text",
              "content": "13.1.3 Role of the atmosphere"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.108,
            0.84,
            0.775,
            0.91
          ],
          "content": [
            {
              "type": "text",
              "content": "The air surrounding the Earth is called atmosphere. It is held in place by the force of Earth’s gravity. It consists mainly of nitrogen (78%) and oxygen (21%) along with small amounts of argon, carbon dioxide, water vapour, and other gases."
            }
          ]
        }
