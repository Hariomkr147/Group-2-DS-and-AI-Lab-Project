              "bbox": [
                0.098,
                0.281,
                0.154,
                0.323
              ],
              "image_path": "images/page_3_image_3.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.159,
            0.293,
            0.458,
            0.313
          ],
          "content": [
            {
              "type": "text",
              "content": "Bridging Science and Society"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.13,
            0.322,
            0.708,
            0.448
          ],
          "content": [
            {
              "type": "text",
              "content": "Anna Mani",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ", India’s pioneering atmospheric scientist, mapped solar insolation across India in the 1950s. Along with S. Rangarajan, she later published "
            },
            {
              "type": "text",
              "content": "Solar Radiation Over India",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " in 1982, creating the country’s first "
            },
            {
              "type": "text",
              "content": "insolation atlas",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". Her pioneering measurements showed India’s vast solar energy potential. Today, this is being realised through the large-scale deployment of solar power across the country. India is laying the foundation for a resilient, sustainable and solar-powered energy future that sets global benchmarks."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.782,
            0.313,
            0.888,
            0.415
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.782,
                0.313,
                0.888,
                0.415
              ],
              "image_path": "images/page_3_image_6.jpg",
              "content": ""
            },
            {
              "type": "image_footnote",
              "index": 7,
              "bbox": [
                0.741,
                0.42,
                0.924,
                0.461
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 13.3: Solar Radiation Over India by Anna Mani and S. Rangarajan"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.108,
            0.482,
            0.774,
            0.518
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 13.1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " How much solar energy will be received by a 1 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { m } ^ { 2 }"
            },
            {
              "type": "text",
              "content": " area in one hour, if the insolation on the surface of the Earth were 1 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { k W m ^ { - 2 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.109,
            0.522,
            0.43,
            0.539
          ],
          "content": [
            {
              "type": "text",
              "content": "Answer:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " E = Intensity × area × time"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.193,
            0.542,
            0.511,
            0.56
          ],
          "image_path": "images/page_3_equation_10.jpg",
          "content": "\\mathrm{E}=1 \\times 1000 \\mathrm{~J} \\mathrm{~S}^{-1} \\mathrm{~m}^{-2} \\times 1 \\mathrm{~m}^{2} \\times 3600 \\mathrm{~s}"
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.193,
            0.563,
            0.423,
            0.581
          ],
          "image_path": "images/page_3_equation_11.jpg",
          "content": "\\mathrm{E}=3600000\\mathrm{J}=3.6 \\times 10^{6}\\mathrm{J}"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.108,
            0.584,
            0.775,
            0.638
          ],
          "content": [
            {
              "type": "text",
              "content": "(This amount of energy is approximately equal to the energy needed to melt 5 kg of ice and heat the water obtained to "
            },
            {
              "type": "equation_inline",
              "content": "1 0 0   ^ { \\circ } \\mathsf { C } ,"
            },
            {
              "type": "text",
              "content": " It is also equal to one unit of electricity used in a household, as shown on an electricity bill)."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.1,
            0.651,
            0.16,
            0.697
          ],
          "content": [
