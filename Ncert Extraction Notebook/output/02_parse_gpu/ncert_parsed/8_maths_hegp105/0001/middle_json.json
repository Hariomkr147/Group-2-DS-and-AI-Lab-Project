          ],
          "content": [
            {
              "type": "text",
              "content": "？ Take any 4 consecutive numbers. For example, 3, 4, 5, and 6. Place ‘+’ and ‘–’ signs in between the numbers. How many different possibilities exist? Write all of them."
            }
          ]
