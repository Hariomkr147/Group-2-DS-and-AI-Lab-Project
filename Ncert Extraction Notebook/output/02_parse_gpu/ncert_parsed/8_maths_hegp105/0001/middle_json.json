            0.511,
            0.387
          ],
          "content": [
            {
              "type": "text",
              "content": "Sum of Consecutive Numbers"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.149,
            0.397,
            0.848,
            0.436
          ],
          "content": [
            {
              "type": "text",
              "content": "Anshu is exploring sums of consecutive numbers. He has written the following—"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.42,
            0.444,
            0.607,
            0.548
          ],
          "image_path": "images/page_0_equation_8.jpg",
          "content": "\\begin{array}{l}7 = 3 + 4 \\\\10 = 1 + 2 + 3 + 4 \\\\12 = 3 + 4 + 5 \\\\15 = 7 + 8 \\\\\\underbrace{= 4 + 5 + 6}_{= 1 + 2 + 3 + 4 + 5}\\end{array}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.563,
            0.39,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, he is wondering—"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.173,
            0.587,
            0.847,
            0.624
          ],
          "content": [
            {
              "type": "text",
              "content": "• “Can I write every natural number as a sum of consecutive numbers "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { \\dot { \\theta } } _ { \\bullet } ^ { \\mathbf { \\dot { \\theta } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.174,
            0.629,
            0.847,
            0.667
          ],
          "content": [
            {
              "type": "text",
              "content": "more than one way?”"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.174,
            0.672,
            0.849,
            0.728
          ],
          "content": [
            {
              "type": "text",
              "content": "“Ohh, I know all odd numbers can be written as a sum of two consecutive numbers. Can we write all even numbers as a sum of consecutive numbers?”"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.174,
            0.733,
            0.846,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "• “Can I write 0 as a sum of consecutive numbers? Maybe I should use negative numbers.”"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.112,
            0.781,
            0.8,
            0.82
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Explore these questions and any others that may occur to you. Discuss them with the class."
            }
          ]
        },
        {
