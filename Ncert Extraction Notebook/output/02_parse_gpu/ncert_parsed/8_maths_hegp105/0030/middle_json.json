          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.167,
            0.42,
            0.845,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "1. The digital root of an 8-digit number is 5. What will be the digital root of 10 more than that number?"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.152,
            0.465,
            0.427,
            0.484
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Digital root is 5 + 1 = 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.202,
            0.485,
            0.502,
            0.504
          ],
          "content": [
            {
              "type": "text",
              "content": "One such number is 40000001"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.202,
            0.509,
            0.433,
            0.528
          ],
          "content": [
            {
              "type": "text",
              "content": "Try for more numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.167,
            0.538,
            0.848,
            0.595
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Write any number. Generate a sequence of numbers by repeatedly adding 11. What would be the digital roots of this sequence of numbers? Share your observations."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.152,
            0.602,
            0.424,
            0.62
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let the number be 10."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.201,
            0.621,
            0.846,
            0.66
          ],
          "content": [
            {
              "type": "text",
              "content": "The sequence of numbers obtained by repeatedly adding 11 are 10, 21, 32, 43, 54, … ."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.203,
            0.661,
            0.57,
            0.681
          ],
          "content": [
            {
              "type": "text",
              "content": "The digital roots of this sequence are"
            }
          ]
        },
