        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.151,
            0.86,
            0.779,
            0.898
          ],
          "content": [
            {
              "type": "text",
              "content": "It is not possible because "
            },
            {
              "type": "equation_inline",
              "content": "1 3 \\times 8 = 1 0 4 ."
            },
            {
              "type": "text",
              "content": " . For all 2-digit numbers greater than 12, the product with 8 is a 3-digit number."
            }
          ]
