          ],
          "content": [
            {
              "type": "text",
              "content": "Eight such expressions are possible. You can use the diagram below to systematically list all the possibilities."
            }
          ]
        },
        {
          "type": "image",
          "index": 3,
          "bbox": [
            0.23,
