            0.109,
            0.366,
            0.85,
            0.408
          ],
          "content": [
            {
              "type": "text",
              "content": "Evaluate each expression and write the result next to it. Do you notice anything interesting?"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.11,
            0.413,
            0.808,
            0.473
          ],
          "content": [
            {
              "type": "text",
              "content": "? Now, take four other consecutive numbers. Place the ‘+’ and ‘–’ signs as you have done before. Find out the results of each expression. What do you observe?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.11,
            0.479,
            0.808,
            0.52
          ],
          "content": [
            {
              "type": "text",
              "content": "? Repeat this for one more set of 4 consecutive numbers. Share your findings."
            }
          ]
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
