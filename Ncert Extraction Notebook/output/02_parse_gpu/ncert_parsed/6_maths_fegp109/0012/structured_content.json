          "content": "9. Draw the following."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.432,
            0.731,
            0.452
          ],
          "content": "a. A triangle with exactly one line of symmetry."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.455,
            0.753,
            0.475
          ],
          "content": "b. A triangle with exactly three lines of symmetry."
