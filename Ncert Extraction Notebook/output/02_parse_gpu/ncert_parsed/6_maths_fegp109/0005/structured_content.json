          "image_source": "images/page_4_image_4.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.387,
            0.282,
            0.586,
            0.435
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_4_image_5.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.615,
            0.278,
            0.815,
            0.43
          ],
          "content": "",
