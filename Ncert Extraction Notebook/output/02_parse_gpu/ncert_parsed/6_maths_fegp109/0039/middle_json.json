              "type": "text",
              "content": " b. "
            },
            {
              "type": "equation_inline",
              "content": "1 7 ^ { \\circ } ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.116,
            0.611,
            0.493,
            0.656
          ],
          "content": [
            {
