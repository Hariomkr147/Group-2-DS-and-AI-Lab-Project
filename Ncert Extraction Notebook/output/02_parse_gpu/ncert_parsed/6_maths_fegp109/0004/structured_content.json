            0.475
          ],
          "content": "Fold 4"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.553,
            0.829,
            0.575
          ],
          "content": "Here are the different folds giving different lines of symmetry."
        },
        {
          "type": "text",
          "bbox": [
            0.191,
            0.576,
            0.588,
            0.598
          ],
          "content": "• Fold the paper into half vertically."
        },
        {
          "type": "text",
          "bbox": [
            0.191,
            0.599,
            0.885,
            0.643
          ],
          "content": "Fold it again into half horizontally (i.e., you have folded it twice). Now open out the folds."
