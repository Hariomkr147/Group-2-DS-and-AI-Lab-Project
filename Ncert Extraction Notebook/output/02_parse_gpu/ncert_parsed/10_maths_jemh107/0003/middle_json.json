            0.16
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, QT = 2 units and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{PT} = \\mathrm{RS} = 2"
            },
            {
              "type": "text",
              "content": " units."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.168,
            0.562,
            0.209
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, using the Pythagoras theorem, we have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.255,
            0.216,
            0.437,
            0.264
          ],
          "image_path": "images/page_2_equation_4.jpg",
          "content": "\\begin{aligned} PQ ^{2} = &  PT ^{2} +  OT ^{2} \\\\= & 2^{2} + 2^{2} = 8.\\end{aligned}"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.097,
            0.274,
            0.135,
            0.292
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.262,
            0.272,
            0.433,
            0.295
          ],
          "image_path": "images/page_2_equation_6.jpg",
          "content": "PQ = \\sqrt[r]{2}   units"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.095,
            0.302,
            0.562,
            0.344
          ],
          "content": [
            {
              "type": "text",
              "content": "How will we find the distance between two points in two different quadrants?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.351,
            0.564,
            0.459
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider the points P(6, 4) and Q(–5, –3) (see Fig. 7.4). Draw QS perpendicular to the x-axis. Also draw a perpendicular PT from the point P on QS (extended) to meet y-axis at the point R."
            }
          ]
        },
        {
          "type": "chart",
          "index": 9,
          "bbox": [
            0.572,
            0.146,
            0.901,
            0.391
          ],
          "content": [
