            0.099,
            0.104,
            0.295,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "COORDINATE GEOMETRY"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.863,
            0.104,
            0.899,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "103"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.096,
            0.138,
            0.898,
            0.184
          ],
          "content": [
            {
              "type": "text",
              "content": "Also, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{PQ}^{2}+\\mathrm{PR}^{2}=\\mathrm{QR}^{2}"
            },
            {
              "type": "text",
              "content": " , by the converse of Pythagoras theorem, we have "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { P } = 9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " Therefore, PQR is a right triangle."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.197,
            0.901,
            0.235
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Show that the points (1, 7), (4, 2), (–1, –1) and "
            },
            {
              "type": "equation_inline",
              "content": "( - 4 , 4 )"
            },
            {
              "type": "text",
              "content": " are the vertices of a square."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.095,
            0.241,
            0.902,
            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let A(1, 7), B(4, 2), C(–1, –1) and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { D } ( - 4 , 4 )"
            },
            {
              "type": "text",
              "content": " be the given points. One way of showing that ABCD is a square is to use the property that all its sides should be equal and both its digonals should also be equal. Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.147,
            0.302,
            0.578,
            0.328
          ],
          "image_path": "images/page_4_equation_5.jpg",
          "content": "\\mathrm{AB} = \\sqrt{(1 - 4)^{2} + (7 - 2)^{2}} = \\sqrt{9 + 25} = \\sqrt{34}"
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.146,
            0.335,
            0.574,
            0.362
          ],
          "image_path": "images/page_4_equation_6.jpg",
          "content": "\\mathrm{BC} = \\sqrt{(4 + 1)^2 + (2 + 1)^2} = \\sqrt{25 + 9} = \\sqrt{34}"
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.147,
            0.368,
            0.599,
            0.394
          ],
          "image_path": "images/page_4_equation_7.jpg",
          "content": "CD =\\sqrt{\\left(-1+4\\right)^{2}+\\left(-1-4\\right)^{2}}=\\sqrt{9+25}=\\sqrt{34}"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.147,
            0.401,
            0.592,
            0.427
          ],
          "image_path": "images/page_4_equation_8.jpg",
          "content": "\\mathrm{DA}=\\sqrt{(1+4)^{2}+(7-4)^{2}}=\\sqrt{25+9}=\\sqrt{34}"
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.147,
            0.434,
            0.571,
            0.461
          ],
          "image_path": "images/page_4_equation_9.jpg",
          "content": "\\mathrm{AC} = \\sqrt{(1 + 1)^{2} + (7 + 1)^{2}} = \\sqrt{4 + 64} = \\sqrt{68}"
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.148,
            0.467,
            0.586,
            0.494
          ],
          "image_path": "images/page_4_equation_10.jpg",
          "content": "\\mathrm{BD} = \\sqrt{(4 + 4)^2 + (2 - 4)^2} = \\sqrt{64 + 4} = \\sqrt{68}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.095,
            0.503,
            0.902,
            0.561
          ],
          "content": [
            {
              "type": "text",
              "content": "Since, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AB} = \\mathrm{BC} = \\mathrm{CD} = \\mathrm{DA}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "AC  \\equiv  BD"
            },
            {
              "type": "text",
              "content": " , all the four sides of the quadrilateral ABCD are equal and its diagonals AC and BD are also equal. Thereore, ABCD is a square."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.095,
            0.567,
            0.425,
            0.741
          ],
          "content": [
            {
              "type": "text",
              "content": "Alternative Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " We find the four sides and one diagonal, say, AC as above. Here "
            },
            {
              "type": "equation_inline",
              "content": "AD^{2} + DC^{2} ="
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "34+34=68=AC^{2}"
            },
            {
              "type": "text",
              "content": " . Therefore, by the converse of Pythagoras theorem, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{D} = 90^{\\circ}"
            },
            {
              "type": "text",
              "content": " . A quadrilateral with all four sides equal and one angle "
            },
            {
              "type": "equation_inline",
              "content": "9 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " is a square. So, ABCD is a square."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.095,
            0.753,
            0.425,
            0.908
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 3 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Fig. 7.6 shows the arrangement of desks in a classroom. Ashima, Bharti and Camella are seated at A(3, 1), B(6, 4) and C(8, 6) respectively. Do you think they are seated in a line? Give reasons for your answer."
            }
          ]
        },
