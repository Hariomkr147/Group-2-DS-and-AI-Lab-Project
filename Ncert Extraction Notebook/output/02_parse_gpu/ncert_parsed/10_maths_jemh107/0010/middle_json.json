          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.095,
            0.139,
            0.899,
            0.178
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 6 : Find the coordinates of the point which divides the line segment joining the points (4, – 3) and (8, 5) in the ratio 3 : 1 internally."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.184,
            0.848,
            0.203
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : Let "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { P } ( x , y )"
            },
            {
              "type": "text",
              "content": " be the required point. Using the section formula, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.304,
            0.216,
            0.719,
            0.257
          ],
          "image_path": "images/page_9_equation_4.jpg",
          "content": "x = \\frac{3(8) + 1(4)}{3 + 1} = 7 , \\quad y = \\frac{3(5) + 1(-3)}{3 + 1} = 3"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.097,
            0.272,
            0.462,
            0.291
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, (7, 3) is the required point"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.304,
            0.898,
            0.343
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 7 : In what ratio does the point "
            },
            {
              "type": "equation_inline",
              "content": "( - 4 , 6 )"
            },
            {
              "type": "text",
              "content": " divide the line segment joining the points "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A } ( - 6 , 1 0 )"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{B}(3,-8)?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.095,
            0.348,
            0.899,
            0.387
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : Let (− 4, 6) divide AB internally in the ratio "
            },
            {
              "type": "equation_inline",
              "content": "m _ { _ 1 } : m _ { _ 2 } ."
            },
            {
              "type": "text",
              "content": " Using the section formula, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.312,
            0.396,
            0.897,
            0.443
          ],
          "image_path": "images/page_9_equation_8.jpg",
          "content": "( - 4 , 6 ) = \\left( \\frac { 3 m _ { 1 } - 6 m _ { 2 } } { m _ { 1 } + m _ { 2 } } , \\frac { - 8 m _ { 1 } + 1 0 m _ { 2 } } { m _ { 1 } + m _ { 2 } } \\right)\\tag{1}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.097,
            0.455,
            0.566,
            0.473
          ],
          "content": [
            {
              "type": "text",
              "content": "Recall that if "
            },
            {
              "type": "equation_inline",
              "content": "( x ,   y ) = ( a ,   b )"
            },
            {
              "type": "text",
              "content": " then "
            },
            {
              "type": "equation_inline",
              "content": "x = a"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\bar{y} \\equiv b"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.097,
            0.501,
            0.135,
            0.518
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.352,
            0.486,
            0.75,
            0.533
          ],
          "image_path": "images/page_9_equation_11.jpg",
          "content": "-4 = \\frac{3m_{1} - 6m_{2}}{m_{1} + m_{2}} \\quad  and  \\quad 6 = \\frac{- 8m_{1} + 10m_{2}}{m_{1} + m_{2}}"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.097,
            0.564,
            0.155,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.565,
            0.564,
            0.651,
            0.584
          ],
          "content": [
            {
              "type": "text",
              "content": "gives us"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.097,
            0.632,
            0.139,
            0.648
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.268,
            0.55,
            0.521,
            0.677
          ],
          "image_path": "images/page_9_equation_15.jpg",
          "content": "\\begin{aligned}4 &= \\frac{3m_{1} - 6m_{2}}{m_{1} + m_{2}} \\\\1 - 4m_{1} - 4m_{2} &= 3m_{1} - 6m_{2} \\\\7m_{1} &= 2m_{2} \\\\m_{1} \\div m_{2} &= 2 \\div 7\\end{aligned}"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.098,
            0.656,
            0.139,
            0.674
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.098,
            0.681,
            0.689,
            0.699
          ],
          "content": [
            {
              "type": "text",
              "content": "You should verify that the ratio satisfies the y-coordinate also."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.097,
            0.747,
            0.155,
            0.764
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.232,
            0.714,
            0.829,
            0.898
          ],
          "image_path": "images/page_9_equation_19.jpg",
          "content": "\\begin{aligned} \\frac{-8m_{1}+10m_{2}}{-m_{1}+m_{2}}&=\\frac{-8\\cfrac{m_{1}}{m_{2}}+10}{\\cfrac{m_{1}}{m_{2}}+1}&(Dividing throughout by  m_{2})\\\\ &\\\\&=\\frac{-8\\times\\cfrac{2}{7}+10}{\\cfrac{2}{7}+1}=6\\\\ \\end{aligned}"
        },
        {
          "type": "footer",
          "index": 20,
