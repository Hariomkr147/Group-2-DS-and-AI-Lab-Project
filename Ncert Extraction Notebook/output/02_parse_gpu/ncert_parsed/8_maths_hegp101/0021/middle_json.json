            0.152,
            0.753,
            0.593,
            0.774
          ],
          "content": [
            {
              "type": "text",
              "content": "3. State true or false. Explain your reasoning."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.203,
            0.777,
            0.611,
            0.798
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) The cube of any odd number is even."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.198,
            0.801,
            0.652,
            0.822
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) There is no perfect cube that ends with 8."
            }
