            0.151,
            0.643,
            0.781,
            0.689
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Find the cube roots of 27000 and 10648. "
            },
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) Cube root of 27000 = 30 (ii) Cube root of 10648 = 22"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.151,
            0.698,
            0.826,
            0.744
          ],
          "content": [
            {
              "type": "text",
              "content": "2. What number will you multiply by 1323 to make it a cube number? "
            },
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
