            0.205
          ],
          "image_path": "images/page_14_equation_5.jpg",
          "content": "6 = 2 \\times 3"
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.451,
            0.184,
            0.814,
            0.205
          ],
          "image_path": "images/page_14_equation_6.jpg",
          "content": "6^{3}=216=2\\times 2\\times 2\\times 3\\times 3\\times 3=2^{3}\\times 3^{3}"
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.24,
            0.226,
            0.338,
            0.247
          ],
          "image_path": "images/page_14_equation_7.jpg",
          "content": "1 5 = 3 \\times 5"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.44,
            0.225,
            0.825,
            0.247
          ],
          "image_path": "images/page_14_equation_8.jpg",
          "content": "1 5 ^ { 3 } = 3 3 7 5 = 3 \\times 3 \\times 3 \\times 5 \\times 5 \\times 5 = 3 ^ { 3 } \\times 5 ^ { 3 }"
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.223,
            0.268,
            0.353,
            0.289
          ],
          "image_path": "images/page_14_equation_9.jpg",
          "content": "1 2 = 2 \\times 2 \\times 3"
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.431,
            0.259,
