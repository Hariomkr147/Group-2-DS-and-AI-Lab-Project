            0.063
          ],
          "content": [
            {
              "type": "text",
              "content": "A Square and A Cube"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.151,
            0.087,
            0.805,
            0.137
          ],
          "content": [
            {
              "type": "text",
              "content": "Which of the following numbers have the digit 6 in the units place? (i) "
            },
            {
              "type": "equation_inline",
              "content": "3 8 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "3 4 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "4 6 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "5 6 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "7 4 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (vi) "
            },
            {
              "type": "equation_inline",
              "content": "8 2 ^ { 2 }"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.111,
            0.153,
            0.846,
            0.191
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Find more such patterns by observing the numbers and their squares from the table you filled earlier."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.175,
            0.196,
            0.673,
            0.216
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider the following numbers and their squares."
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.2,
            0.222,
            0.801,
            0.391
          ],
          "content": [
            {
              "type": "image_body",
              "index": 4,
              "bbox": [
                0.2,
                0.222,
                0.801,
                0.391
              ],
              "image_path": "images/page_4_image_4.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.111,
            0.409,
            0.846,
            0.448
          ],
          "content": [
            {
              "type": "text",
              "content": "？ If a number contains 3 zeros at the end, how many zeros will its square have at the end?"
            }
          ]
        },
        {
          "type": "footer",
          "index": 6,
          "bbox": [
            0.449,
            0.971,
            0.551,
            0.984
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.111,
            0.456,
            0.848,
            0.532
          ],
          "content": [
            {
              "type": "text",
              "content": "2 What do you notice about the number of zeros at the end of a number and the number of zeros at the end of its square? Will this always happen? Can we say that squares can only have an even number of zeros at the end?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.548,
            0.765,
            0.57
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What can you say about the parity of a number and its square?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.151,
            0.589,
            0.578,
            0.611
          ],
          "content": [
            {
              "type": "text",
              "content": "Perfect Squares and Odd Numbers"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.149,
            0.621,
            0.846,
            0.659
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us explore the differences between consecutive squares. What do you notice?"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.263,
            0.663,
            0.735,
            0.682
          ],
          "image_path": "images/page_4_equation_11.jpg",
          "content": "4-1=3 \\quad 9-4=5 \\quad 16-9=7 \\quad 25-16=9"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.15,
            0.687,
            0.755,
            0.706
          ],
          "content": [
            {
              "type": "text",
              "content": "See if this pattern continues for the next few square numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.151,
            0.707,
            0.848,
            0.744
          ],
          "content": [
            {
              "type": "text",
              "content": "From this we observe that adding consecutive odd numbers starting from 1 gives consecutive square numbers, as shown below."
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.23,
            0.784,
            0.317,
            0.801
          ],
          "image_path": "images/page_4_equation_14.jpg",
          "content": "1 \\div 3 = 4"
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.23,
            0.807,
            0.35,
            0.825
          ],
          "image_path": "images/page_4_equation_15.jpg",
          "content": "1+3+5=9"
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.231,
            0.831,
            0.395,
            0.849
          ],
          "image_path": "images/page_4_equation_16.jpg",
          "content": "1+3+5+7=16"
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.23,
            0.855,
            0.427,
            0.873
          ],
          "image_path": "images/page_4_equation_17.jpg",
          "content": "1+3+5+7+9=25"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.23,
            0.879,
            0.475,
            0.898
          ],
          "image_path": "images/page_4_equation_18.jpg",
