            0.232,
            0.516
          ],
          "image_path": "images/page_9_equation_28.jpg",
          "content": "y = 7"
        },
        {
          "type": "equation",
          "index": 29,
          "bbox": [
            0.514,
            0.496,
            0.569,
            0.516
          ],
          "image_path": "images/page_9_equation_29.jpg",
          "content": "y = 7"
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.111,
            0.54,
            0.493,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "What happens in cases like "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { u } { 1 5 } = 6 ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.175,
            0.576,
            0.715,
            0.598
          ],
          "content": [
            {
              "type": "text",
              "content": "Multiplying both sides by 15 leaves only u in the LHS —"
            }
          ]
        },
        {
          "type": "equation",
          "index": 32,
          "bbox": [
            0.446,
            0.597,
            0.549,
            0.615
          ],
          "image_path": "images/page_9_equation_32.jpg",
          "content": "u = 6 \\times 15"
        },
        {
          "type": "equation",
          "index": 33,
          "bbox": [
            0.463,
            0.62,
            0.534,
            0.639
          ],
          "image_path": "images/page_9_equation_33.jpg",
          "content": "w = 90."
        },
        {
          "type": "text",
          "index": 34,
          "bbox": [
            0.151,
            0.644,
            0.628,
            0.664
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, we can make the following observations —"
            }
          ]
        },
        {
          "type": "text",
          "index": 35,
          "bbox": [
            0.151,
            0.669,
            0.847,
            0.746
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) When a term that is added or subtracted on one side of an equation is removed from that side, its additive inverse should appear as a term on the other side for the equality to hold. For example, "
            },
            {
              "type": "equation_inline",
              "content": "2 y + 7"
            },
            {
              "type": "text",
              "content": " = 21 becomes "
            },
            {
              "type": "equation_inline",
              "content": "2 y = 2 1 - 7"
            }
          ]
        },
        {
          "type": "text",
          "index": 36,
          "bbox": [
            0.151,
            0.751,
            0.848,
            0.83
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) If one side of an equation is the product of two or more numbers or expressions, and we remove one of the factors, then the other side should be divided by this factor for the equality to hold. For example, "
            },
            {
              "type": "equation_inline",
              "content": "2 y = 1 4"
            },
            {
              "type": "text",
              "content": " becomes "
            },
            {
              "type": "equation_inline",
              "content": "y = 1 4 \\div 2"
            }
          ]
        },
        {
          "type": "text",
          "index": 37,
          "bbox": [
            0.151,
            0.833,
            0.848,
            0.892
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) If one side of an equation is the quotient of two numbers or expressions, and we remove the divisor, then the other side should be multiplied by this divisor for the equality to hold. For example,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 38,
          "bbox": [
            0.195,
            0.895,
            0.446,
            0.928
          ],
          "image_path": "images/page_9_equation_38.jpg",
          "content": "\\frac{u}{15}=6  becomes   u=6 \\times 15."
        },
        {
