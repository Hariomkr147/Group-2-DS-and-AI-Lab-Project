          "bbox": [
            0.174,
            0.38,
            0.325,
            0.4
          ],
          "image_path": "images/page_9_equation_16.jpg",
          "content": "6y + 7 = 4y + 21"
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.511,
            0.38,
            0.66,
            0.4
          ],
          "image_path": "images/page_9_equation_17.jpg",
          "content": "6y + 7 = 4y + 21"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.174,
