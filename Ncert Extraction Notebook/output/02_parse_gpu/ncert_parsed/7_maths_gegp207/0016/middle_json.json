          ],
          "content": [
            {
              "type": "text",
              "content": "？ "
            },
            {
              "type": "text",
              "content": "Example 12:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Ramesh and Suresh have 60 marbles between them. Ramesh has 30 more marbles than Suresh. How many marbles does each boy have?"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.151,
            0.151,
            0.546,
            0.265
          ],
          "content": [
            {
              "type": "text",
              "content": "In this problem, we have two unknowns. If we denote the number of marbles with Ramesh as x and the number of marbles with Suresh as y, then what are the different equations that we have?"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.164,
            0.271,
            0.525,
            0.29
          ],
          "content": [
            {
              "type": "text",
              "content": "1. The total number of marbles is 60."
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.297,
            0.292,
            0.397,
            0.31
          ],
          "image_path": "images/page_15_equation_4.jpg",
          "content": "x + y = 60."
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.563,
            0.138,
            0.935,
            0.312
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.563,
                0.138,
                0.935,
                0.312
              ],
              "image_path": "images/page_15_image_5.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.164,
            0.32,
            0.604,
            0.34
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Ramesh has 30 marbles more than Suresh."
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.448,
            0.341,
            0.548,
            0.359
          ],
          "image_path": "images/page_15_equation_7.jpg",
          "content": "x = y + 3 0 ."
        },
        {
          "type": "image",
