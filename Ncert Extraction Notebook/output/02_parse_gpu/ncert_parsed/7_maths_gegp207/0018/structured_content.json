            0.765,
            0.59,
            0.84
          ],
          "content": "\\begin{cases}15w - 4w = 26 \\\\15w = 26 + 4w \\\\15w = 30 \\\\w = 2\\end{cases}",
          "image_source": "images/page_17_equation_20.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.625,
