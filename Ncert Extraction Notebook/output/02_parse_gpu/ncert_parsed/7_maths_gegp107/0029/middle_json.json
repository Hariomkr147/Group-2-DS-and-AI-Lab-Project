            0.539
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A triangle does not exist"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.132,
            0.562,
            0.883,
            0.62
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Will this always happen? That is, for any set of lengths, will there be at least two comparisons where the direct length is less than the sum of the other two? Explore for different sets of lengths.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.117,
            0.622,
            0.488,
            0.64
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Some sets are 7, 10, 15; 12, 14, 18"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.116,
            0.675,
