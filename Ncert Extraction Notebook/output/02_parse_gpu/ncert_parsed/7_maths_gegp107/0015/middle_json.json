              "bbox": [
                0.229,
                0.537,
                0.27,
                0.551
              ],
              "content": [
                {
                  "type": "text",
                  "content": "4 cm"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.373,
            0.414,
