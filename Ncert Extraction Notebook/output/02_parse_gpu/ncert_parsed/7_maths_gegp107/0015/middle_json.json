        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.111,
            0.571,
            0.789,
            0.594
          ],
          "content": [
            {
              "type": "text",
              "content": "Construct a triangle ABC with AB = 5 cm, AC = 4 cm and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle A = 45^{\\circ}"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.174,
            0.602,
            0.814,
            0.623
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us take one of the given sides, AB, as the base of the triangle."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.351,
            0.626,
            0.644,
            0.787
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
              "bbox": [
                0.351,
                0.626,
                0.644,
                0.787
              ],
              "image_path": "images/page_14_image_13.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.15,
            0.798,
            0.574,
            0.817
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Construct a side AB of length 5 cm."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.15,
            0.816,
            0.578,
            0.853
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Construct "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{A} = 45^{\\circ}"
            },
            {
              "type": "text",
              "content": " by drawing the other arm of the angle."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.15,
            0.853,
            0.579,
            0.89
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Mark the point C on the other arm such that AC = 4 cm."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.15,
            0.89,
            0.577,
            0.911
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Join BC to get the required triangle."
            }
          ]
        },
