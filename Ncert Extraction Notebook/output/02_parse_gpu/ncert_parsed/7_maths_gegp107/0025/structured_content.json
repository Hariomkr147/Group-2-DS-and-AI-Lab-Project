              ],
              "content": "Equilateral Triangle Equilateral Triangle"
            }
          ],
          "image_source": "images/page_24_image_6.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.373,
            0.297,
            0.552,
            0.455
          ],
          "content": "",
