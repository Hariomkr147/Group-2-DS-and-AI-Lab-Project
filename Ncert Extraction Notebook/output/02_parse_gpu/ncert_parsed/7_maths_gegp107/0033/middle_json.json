        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.2,
            0.634,
            0.489,
            0.65
          ],
          "image_path": "images/page_32_equation_11.jpg",
          "content": "\\angle XAB + \\angle BAC + \\angle YAC = 180^{\\circ}"
        },
