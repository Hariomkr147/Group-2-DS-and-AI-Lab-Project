              ]
            },
            {
              "type": "text",
              "content": "Consider "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A B C } ,"
            },
            {
              "type": "text",
              "content": " , Draw line XY parallel to line BC so AB and AC become transversals."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.2,
            0.576,
            0.86,
            0.594
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore "
            },
            {
              "type": "equation_inline",
              "content": "\\angle XAB = \\angle B = 36^{\\circ}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle YAC = \\angle C = 72^{\\circ}"
            },
            {
              "type": "text",
              "content": " (Alternate Angles)"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
