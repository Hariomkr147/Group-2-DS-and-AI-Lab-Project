          "level": 2,
          "content": "(b) 3, 4, 6"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.115,
            0.6,
            0.159
          ],
          "content": "**Ans:** Since 3 < 4 + 6, 4 < 6 + 3 and 6 < 3 + 4. These are the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.167,
            0.267,
            0.186
          ],
          "level": 2,
          "content": "(c) 2, 4, 8"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.196,
            0.666,
            0.24
          ],
          "content": "**Ans:** 8 > 2 + 4. So, these are not the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.248,
            0.267,
            0.267
          ],
          "level": 2,
          "content": "(d) 5, 5, 8"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.276,
            0.6,
            0.32
          ],
          "content": "**Ans:** Since 5 < 5 + 8, 8 < 5 + 5. These are the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.328,
            0.3,
            0.347
          ],
          "level": 2,
          "content": "(e) 10, 20, 25"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.356,
            0.683,
            0.401
          ],
          "content": "**Ans:** Since 10 < 20 + 25, 20 < 25 + 10 and 25 < 10 + 20. These are the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.408,
            0.301,
            0.428
          ],
          "level": 2,
          "content": "(f) 10, 20, 35"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.437,
            0.666,
            0.482
          ],
          "content": "**Ans:** 35 > 10 + 20. So, these are not the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.489,
            0.301,
            0.509
          ],
          "level": 2,
          "content": "(g) 24, 26, 28"
        },
        {
          "type": "text",
          "bbox": [
            0.164,
            0.517,
            0.683,
            0.562
          ],
          "content": "**Ans:** Since 24 < 26 + 28, 26 < 28 + 24 and 28 < 24 + 26. These are the side lengths of a triangle."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.117,
            0.588,
            0.252,
            0.608
          ],
          "level": 2,
          "content": "Page No. 159"
