          ],
          "content": [
            {
              "type": "text",
              "content": "Altitudes Using Paper Folding"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.572,
            0.849,
            0.649
          ],
          "content": [
            {
              "type": "text",
              "content": "Cut out a paper triangle. Fix one of the sides as the base. Fold it in such a way that the resulting crease is an altitude from the top vertex to the base. Justify why the crease formed should be perpendicular to the base."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.151,
            0.678,
            0.673,
            0.701
          ],
          "content": [
            {
              "type": "text",
              "content": "Construction of the Altitudes of a Triangle"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.149,
            0.709,
            0.847,
            0.748
          ],
          "content": [
            {
              "type": "text",
              "content": "Construct an arbitrary triangle. Label the vertices A, B, C taking BC to be the base."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.11,
            0.756,
            0.508,
            0.78
          ],
          "content": [
            {
              "type": "text",
              "content": "Construct the altitude from A to BC,"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.149,
            0.788,
            0.847,
            0.827
          ],
          "content": [
            {
              "type": "text",
              "content": "Constructing the altitude using just a ruler is not accurate. To get a more precise angle of 90°, we use a set square along with a ruler."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
