            0.175,
            0.317,
            0.743,
            0.337
          ],
          "content": [
            {
              "type": "text",
              "content": "What would the altitude from A to BC be in this triangle?"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.164,
            0.349,
