            0.834,
            0.525
          ],
          "content": [
            {
              "type": "text",
              "content": "We extend BC and then drop the perpendicular from A to this line."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
