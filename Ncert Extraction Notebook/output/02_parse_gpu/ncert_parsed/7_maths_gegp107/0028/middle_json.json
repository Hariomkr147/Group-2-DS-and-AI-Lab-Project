            {
              "type": "equation_inline",
              "content": "\\mathrm{AC_{1}B, AC_{2}B, \\cdots}"
            },
            {
              "type": "text",
              "content": " are isosceles triangle. Similarly for points "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{D}_{1}, \\mathrm{D}_{2}, \\mathrm{D}_{3} \\ldots \\Delta \\mathrm{ADB},"
            },
            {
              "type": "text",
              "content": " "
            },
            {
