              "content": "\\Delta \\mathrm{AD}_{1}\\mathrm{B},\\Delta \\mathrm{AD}_{2}\\mathrm{B},\\ldots"
            },
            {
              "type": "text",
              "content": " are isosceles triangles."
            }
          ]
