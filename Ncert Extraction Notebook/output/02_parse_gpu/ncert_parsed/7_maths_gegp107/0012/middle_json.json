        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.113,
            0.68,
            0.846,
            0.721
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us study each of these cases by finding the relation between the radii (the smaller two lengths) and AB (longest length)."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.151,
            0.741,
            0.595,
            0.761
          ],
          "content": [
            {
              "type": "text",
              "content": "Case 1: Circles touch each other at a point",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.151,
            0.765,
            0.391,
            0.785
          ],
          "content": [
            {
              "type": "text",
              "content": "For this case to happen,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.37,
            0.792,
            0.628,
            0.81
          ],
          "image_path": "images/page_11_equation_17.jpg",
          "content": "sum of the two radii  =  AB"
        },
