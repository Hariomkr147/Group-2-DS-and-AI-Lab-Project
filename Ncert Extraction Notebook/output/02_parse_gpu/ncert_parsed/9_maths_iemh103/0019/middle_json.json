          ],
          "content": [
            {
              "type": "text",
              "content": "The World of Numbers"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.856,
            0.068,
            0.883,
            0.085
          ],
          "content": [
            {
              "type": "text",
              "content": "59"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.149,
            0.11,
            0.603,
            0.144
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert 0.35 into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { p } { q }"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.15,
            0.144,
            0.477,
            0.179
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that "
            },
            {
              "type": "equation_inline",
              "content": "0.35 = \\frac{35}{100} = \\frac{7}{20}."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.114,
            0.182,
            0.885,
            0.237
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, let us understand how to convert non-terminating repeating decimals into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { p } { q }"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.15,
            0.247,
            0.522,
            0.267
          ],
          "content": [
            {
              "type": "text",
              "content": "Case 2: Pure repeating decimals"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.113,
            0.267,
            0.886,
            0.308
          ],
          "content": [
            {
              "type": "text",
              "content": "A pure repeating decimal is one in which a digit or a sequence of digits begins repeating immediately after the decimal point."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.149,
            0.31,
            0.59,
            0.343
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert "
            },
            {
              "type": "equation_inline",
              "content": "0 . \\overline { { 6 } }"
            },
            {
              "type": "text",
              "content": " into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { p } { q }"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.15,
            0.343,
            0.349,
            0.364
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let "
            },
            {
              "type": "equation_inline",
              "content": "x = 0 . \\overline { { 6 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.369,
            0.885,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Since one-digit repeats, multiply both sides by "
            },
            {
              "type": "equation_inline",
              "content": "10^{1} = 10"
            },
            {
              "type": "text",
              "content": " , we get "
            },
            {
              "type": "equation_inline",
              "content": "1 0 x = 6 . \\overline { { 6 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.149,
            0.424,
            0.709,
            0.446
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Subtract the first equation from the second:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.152,
            0.45,
            0.381,
            0.471
          ],
          "image_path": "images/page_18_equation_11.jpg",
          "content": "10x - x = 6.\\overline{6} - 0.\\overline{6} = 6."
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.149,
            0.485,
            0.595,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Solve for "
            },
            {
              "type": "equation_inline",
              "content": "x : 9x = 6"
            },
            {
              "type": "text",
              "content": " Thus, "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{6}{9}=\\frac{2}{3}"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.15,
            0.546,
            0.735,
            0.58
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 6:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert 0.45 into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{p}{q}."
            },
            {
              "type": "text",
              "content": " Let "
            },
            {
              "type": "equation_inline",
              "content": "x = 0 . { \\overline { { 4 5 } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.113,
            0.585,
            0.883,
            0.627
          ],
          "content": [
            {
              "type": "text",
              "content": "Since two digits repeat, multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 2 } = 1 0 0"
            },
            {
              "type": "text",
              "content": " . We get "
            },
            {
              "type": "equation_inline",
              "content": "100x = 45.\\overline{45}"
            },
            {
              "type": "text",
              "content": " Subtracting the two equations, we get "
            },
            {
              "type": "equation_inline",
              "content": "9 9 x = 4 5"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.15,
            0.639,
            0.317,
            0.673
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "x = { \\frac { 4 5 } { 9 9 } } = { \\frac { 5 } { 1 1 } } ."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 16,
          "bbox": [
            0.151,
            0.699,
            0.559,
            0.72
          ],
          "content": [
            {
              "type": "text",
              "content": "Case 3: General repeating decimals"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.113,
            0.724,
            0.884,
            0.765
          ],
          "content": [
            {
              "type": "text",
              "content": "A general repeating decimal has some non-repeating digits just after the decimal point, followed by a repeating block."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.149,
            0.771,
            0.601,
            0.803
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 7:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert 0.16 into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { p } { q }"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.15,
            0.804,
            0.367,
            0.826
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let "
            },
            {
              "type": "equation_inline",
              "content": "x = 0 . 1 { \\overline { { 6 } } } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.113,
            0.833,
            0.886,
            0.874
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " First, shift the decimal to place the repeating part immediately after the decimal point."
            }
          ]
        }
      ]
    }
  ],
