            0.509
          ],
          "content": [
            {
              "type": "text",
              "content": "Think and Reflect"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.128,
            0.522,
            0.586,
            0.554
          ],
          "content": [
            {
              "type": "text",
              "content": "Try and represent "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{8}{5}  and  -\\frac{7}{4}"
            },
            {
              "type": "text",
              "content": " on a number line."
