          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " On this perpendicular line we mark the point B such that "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A B } = 1"
            },
            {
              "type": "text",
              "content": " unit and join the origin to B. Clearly, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { O B } = { \\sqrt { 2 } }"
            },
            {
              "type": "text",
              "content": " units."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.156,
            0.886,
            0.225
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " With O as centre and OB as radius, with a compass we draw an arc which intersects the number line at P. Clearly, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { O P } = { \\sqrt { 2 } }"
            },
            {
              "type": "text",
              "content": " units. Hence, P represents the irrational number "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt { 2 }"
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
