            0.087
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Manjari | Grade 9 | Part I"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.113,
            0.107,
            0.885,
            0.147
          ],
          "content": [
            {
              "type": "text",
              "content": "Since one digit is non-repeating, we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 1 } = 1 0"
            },
            {
              "type": "text",
              "content": " and obtain "
            },
            {
              "type": "equation_inline",
              "content": "1 0 x = 1 . \\overline { { 6 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.155,
            0.884,
            0.198
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Now, to move one full repeating cycle (1 digit repeating), we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 1 } = 1 0"
            },
            {
              "type": "text",
              "content": " again and get 100x = 16.6."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.148,
            0.2,
            0.884,
            0.223
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Subtracting the first shifted equation from the second, we get,"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.225,
            0.714,
            0.265
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "100x - 10x = 16.\\overline{6} - 1.\\overline{6}"
            },
            {
              "type": "text",
              "content": " or 90x = 15. Thus, "
            },
            {
              "type": "equation_inline",
              "content": "X = \\frac{15}{90} = \\frac{1}{6}"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.149,
            0.268,
            0.615,
            0.301
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 8:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert 2.357 into the form "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { p } { q } } ,"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.149,
            0.302,
            0.378,
            0.324
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let x = 2.357."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.328,
            0.885,
            0.392
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, ‘35’ is non-repeating (2 digits), ‘7’ repeats (1 digit). Firstly, we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 2 } = 1 0 0"
            },
            {
              "type": "text",
              "content": " to move the non-repeating digits before the decimal and we obtain 100x = 235.7."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.395,
            0.884,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Now, we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 1 } = 1 0"
            },
            {
              "type": "text",
              "content": " to move the full repeating cycle and get 1000x = 2357.7."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.148,
            0.442,
            0.801,
            0.464
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Subtracting, we obtain "
            },
            {
              "type": "equation_inline",
              "content": "1000x-100x=2357.7-235.7"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.149,
            0.465,
            0.596,
            0.507
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence, 900x = 2122 and "
            },
            {
              "type": "equation_inline",
              "content": "x = \\frac{2122}{900} = \\frac{1061}{450}"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.149,
            0.511,
            0.627,
            0.543
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 9:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Convert 2.4537 into the form "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{p}{q}."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.149,
            0.545,
            0.39,
            0.567
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let "
            },
            {
              "type": "equation_inline",
              "content": "x = 2 . 4 5 { \\overline { { 3 7 } } } ."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.112,
            0.575,
            0.884,
            0.635
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here, "
            },
            {
              "type": "equation_inline",
              "content": "^{ \\circ }45^{\\circ}"
            },
            {
              "type": "text",
              "content": " is non-repeating (2 digits), ‘37’ repeats (2 digits). Firstly, we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 2 } = 1 0 0 ^ { \\bar { 1 } }"
            },
            {
              "type": "text",
              "content": " to move the non-repeating digits before the decimal and we obtain 100x = 245.37."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.113,
            0.641,
            0.885,
            0.685
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Now, we multiply by "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 2 }   =   1 0 0"
            },
            {
              "type": "text",
              "content": " to move the full repeating cycle and get 10000x = 24537.37."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.148,
            0.691,
            0.85,
            0.713
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 4:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Subtracting, we obtain "
            },
            {
              "type": "equation_inline",
              "content": "10000x-100x=24537.\\overline{37}-245.\\overline{37}"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.15,
            0.717,
            0.633,
            0.759
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence, 9900x = 24292 and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{24292}{9900}=\\frac{6073}{2475}"
            }
          ]
        },
