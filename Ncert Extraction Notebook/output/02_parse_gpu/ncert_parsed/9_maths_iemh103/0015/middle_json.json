            0.784,
            0.885,
            0.826
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, to construct a line segment of length "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt { 2 }"
            },
            {
              "type": "text",
              "content": " and mark its position on the number line, we may proceed as follows."
            }
