        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.766,
            0.047,
            0.862,
            0.063
          ],
          "content": [
            {
              "type": "text",
              "content": "Power Play"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.15,
            0.089,
            0.457,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, "
            },
            {
              "type": "equation_inline",
              "content": "10^{-3} = \\frac{1}{10^{3}}, 7^{-2} = \\frac{1}{7^{2}}"
            },
            {
              "type": "text",
              "content": " , etc."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.109,
            0.122,
            0.391,
            0.169
          ],
          "content": [
            {
              "type": "text",
              "content": "Can we write "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { 3 } = \\frac { 1 } { 1 0 ^ { ^ { - 3 } } }   ?"
            },
            {
              "type": "text",
              "content": " We can write,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.335,
            0.177,
            0.661,
            0.212
          ],
          "image_path": "images/page_10_equation_4.jpg",
          "content": "\\frac{1}{10^{-3}} = \\frac{1}{1/10^{3}} = 1 \\div \\frac{1}{10^{3}} = 1 \\times 10^{3} = 10^{3}."
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.213,
            0.448,
            0.245
          ],
          "content": [
            {
              "type": "text",
              "content": "Similarly, "
            },
            {
              "type": "equation_inline",
              "content": "\\nabla ^ { 2 } = { \\frac { 1 } { 7 ^ { -   2 } } }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "4 ^ { a } = { \\frac { 1 } { 4 ^ { - a } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.174,
            0.244,
            0.395,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "In a generalised form,"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.332,
            0.27,
            0.664,
            0.302
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "n ^ { -   a } = { \\frac { 1 } { n ^ { a } } }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { a } = { \\frac { 1 } { n ^ { - a } } }"
            },
            {
              "type": "text",
              "content": " , where "
            },
            {
              "type": "equation_inline",
              "content": "n \\neq 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.778,
            0.247,
            0.865,
            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "Math Talk"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.301,
            0.705,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider the following general forms we have identified."
            }
          ]
        },
        {
          "type": "table",
          "index": 10,
          "bbox": [
            0.154,
            0.326,
            0.792,
            0.354
          ],
          "content": [
            {
              "type": "table_body",
              "index": 10,
              "bbox": [
                0.154,
                0.326,
                0.792,
                0.354
              ],
              "image_path": "images/page_10_table_10.jpg",
              "content": "<table><tr><td><eq>n^{a} \\times n^{b} = n^{a + b}</eq></td><td><eq>( n ^ { a } ) ^ { b } = ( n ^ { b } ) ^ { a } = n ^ { a   \\times   b }</eq></td><td><eq>n^{a} \\div n^{b} = n^{a - b}</eq></td></tr></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.112,
            0.367,
            0.846,
            0.407
          ],
          "content": [
            {
              "type": "text",
              "content": "？ We had required a and b to be counting numbers. Can a and b be any integers? Will the generalised forms still hold true?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.111,
            0.421,
            0.743,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "Write equivalent forms of the following. (i) 2– 4 (ii) "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { - 5 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "( = 7 ) ^ { - 2 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "( - 5 ) ^ { -   3 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { - 1 0 0 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.111,
            0.494,
            0.758,
            0.559
          ],
          "content": [
            {
              "type": "text",
              "content": "? Simplify and write the answers in exponential form. (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { - 4 } \\times 2 ^ { 7 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "3^{2} \\times 3^{-5} \\times 3^{6}"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "p ^ { 3 } \\times p ^ { - 1 0 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 4 }   \\times \\left( - 4 \\right) ^ { - 2 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { p } \\times 8 ^ { q }"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.151,
            0.574,
            0.305,
            0.593
          ],
          "content": [
            {
              "type": "text",
              "content": "Power Lines"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
