            0.217
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What does the first part of each name denote?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.152,
            0.22,
            0.847,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The first part of each name denotes the number of times 1000s are multiplied to 1000."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.152,
            0.279,
            0.314,
            0.3
          ],
          "content": [
            {
              "type": "text",
              "content": "Page No. 44–45",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.114,
            0.319,
            0.294,
            0.343
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.152,
            0.35,
            0.765,
            0.371
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Find out the units digit in the value of "
            },
            {
              "type": "equation_inline",
              "content": "2^{224} \\div 4^{32} ?"
            },
            {
              "type": "text",
              "content": " [Hint: 4 = 2"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": "]"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.153,
            0.375,
            0.405,
            0.395
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " The units digit is "
            },
            {
              "type": "equation_inline",
              "content": "^ { \\circ } 6 ^ { \\prime }"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.152,
            0.405,
            0.847,
            0.444
          ],
          "content": [
            {
              "type": "text",
              "content": "2. There are 5 bottles in a container. Every day, a new container is brought in. How many bottles would be there after 40 days?"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.153,
            0.449,
            0.404,
            0.468
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "2 0 0 = 2 \\times 1 0 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " bottles."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.153,
            0.478,
            0.847,
            0.541
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Write the given number as the product of two or more powers in three different ways. The powers can be any integers. (i) "
            },
            {
              "type": "equation_inline",
              "content": "6 4 ^ { 3 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "1 9 2 ^ { 8 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "3 2 ^ { - 5 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.153,
            0.547,
            0.419,
            0.565
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Some of the ways are"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.193,
            0.564,
            0.453,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "2^{10} \\times 2^{8}, \\quad 4^{5} \\times 4^{4}, \\quad 8^{3} \\times 8^{3}"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.187,
            0.587,
            0.432,
            0.624
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "2^{48} \\times 3^{8}, \\left | 2^{40} \\times \\bar{2}^{8} \\times 3^{8} \\right."
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 4 0 } \\times 6 ^ { 8 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.18,
            0.629,
            0.501,
            0.651
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "2^{-10} \\times 2^{-15}, 2^{-5} \\times 2^{-20}, 4^{-12} \\times 2^{-1}"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.152,
            0.661,
            0.846,
            0.699
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Examine each statement below and find out if it is ‘Always True’, ‘Only Sometimes True’, or ‘Never True’. Explain your reasoning."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.192,
            0.699,
            0.63,
            0.717
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Cube numbers are also square numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.186,
            0.717,
            0.631,
            0.735
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Fourth powers are also square numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.179,
            0.735,
            0.847,
            0.771
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) The fifth power of a number is divisible by the cube of that number."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.181,
            0.772,
            0.744,
            0.79
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) The product of two cube numbers is a cube number."
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.158,
            0.79,
            0.833,
            0.831
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) "
            },
            {
              "type": "equation_inline",
              "content": "q ^ { 4 6 }"
            },
            {
              "type": "text",
              "content": " is both a 4th power and a 6th power (q is a prime number) "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.193,
            0.833,
            0.452,
            0.85
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Only Sometimes True."
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.239,
            0.85,
            0.773,
            0.889
          ],
          "content": [
            {
              "type": "text",
              "content": "“This is only true for numbers that have powers as "
            },
            {
              "type": "equation_inline",
              "content": "6 . ^ { \\flat }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { 6 }   = ( n ^ { 2 } ) ^ { 3 } = ( n ^ { 3 } ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 25,
          "bbox": [
            0.121,
            0.919,
            0.141,
            0.939
          ],
          "content": [
            {
              "type": "text",
              "content": "6"
            }
          ]
        }
      ]
    }
