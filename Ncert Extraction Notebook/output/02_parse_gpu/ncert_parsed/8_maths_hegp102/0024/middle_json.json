              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 11,
          "bbox": [
            0.101,
            0.539,
            0.185,
            0.594
          ],
          "content": [
            {
              "type": "image_body",
              "index": 11,
              "bbox": [
                0.101,
                0.539,
                0.185,
                0.594
              ],
              "image_path": "images/page_23_image_11.jpg",
