          "content": [
            {
              "type": "text",
              "content": "(ii) Always True. We can write "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { 4 }   = ( n ^ { 2 } ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.177,
            0.137,
            0.361,
            0.191
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Always True. "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{n^{5}}{n^{3}} = n^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.178,
            0.197,
            0.513,
            0.24
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) Always True. "
            },
            {
              "type": "equation_inline",
              "content": "(n_{1})^{3} \\times (n_{2})^{3} = (n_{1} \\times n_{2})^{3} = (n_{1}n_{2})^{3}"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.183,
            0.246,
            0.838,
            0.289
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) Never True. "
            },
            {
              "type": "equation_inline",
              "content": "q ^ { 4 6 } ."
            },
            {
              "type": "text",
              "content": " , here q is prime number and 46 is not divisible by 4 and 6."
            }
          ]
        },
        {
          "type": "text",
