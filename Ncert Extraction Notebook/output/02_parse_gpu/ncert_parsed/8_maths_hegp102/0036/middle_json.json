              "type": "equation_inline",
              "content": "5 ^ { 7 } \\div 5 ^ { 4 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "9 ^ { -   7 } \\div 9 ^ { 4 }"
            },
            {
              "type": "text",
              "content": " (iv) "
