          ],
          "content": [
            {
              "type": "text",
              "content": "3. Write the numerical value of each of the following: (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 \\times 1 0 ^ { 3 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "7 ^ { 2 } \\times 2 ^ { 3 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "3 \\times 4 ^ { 4 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "( - 3 ) ^ { 2 } \\times ( - 5 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 2 } \\times 1 0 ^ { 4 }"
            },
            {
              "type": "text",
              "content": " (vi) "
            },
            {
              "type": "equation_inline",
              "content": "( - 2 ) ^ { 5 } \\times ( - 1 0 ) ^ { 6 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.152,
            0.156,
            0.691,
            0.213
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) 2000 (ii) 392 (iii) 768 (iv) 225 (v) 90000 (vi) –32000000"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.153,
            0.233,
            0.276,
            0.253
          ],
          "content": [
            {
              "type": "text",
              "content": "Page No. 24"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.261,
            0.707,
            0.361
          ],
          "content": [
            {
              "type": "text",
              "content": "3"
            },
            {
              "type": "text",
              "content": "7",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " can also be written as "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 2 } \\times 3 ^ { 5 }"
            },
            {
              "type": "text",
              "content": " . Can you reason out why? Ans: "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 7 } = 3 \\times 3 \\times 3 \\times 3 \\times 3 \\times 3 \\times 3"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "= ( 3 \\times 3 ) \\times ( 3 \\times 3 \\times 3 \\times 3 \\times 3 )"
            },
            {
              "type": "text",
              "content": " = 3"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " × 3"
            },
            {
              "type": "text",
              "content": "5",
              "styles": [
                "superscript"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.112,
            0.371,
            0.606,
            0.41
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Use this observation to compute the following. (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 9 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "5 ^ { 7 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "4 ^ { 6 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.417,
            0.519,
            0.512
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) One of the ways is "
            },
            {
              "type": "equation_inline",
              "content": "2^{9}=2^{4}\\times 2^{5}=16\\times 32=512"
            },
            {
              "type": "text",
              "content": " (ii) One of the ways is "
            },
            {
              "type": "equation_inline",
              "content": "5^{7}=5^{3}\\times 5^{4}=125\\times 625=78125"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.112,
            0.52,
            0.845,
            0.578
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Write the following expressions as a power of a power in at least two different ways: (i) "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { 6 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "7 ^ { 1 5 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "9 ^ { 1 4 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "5 ^ { 8 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.582,
            0.445,
            0.729
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { 6 }   = ( 8 ^ { 2 } ) ^ { 3 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { 6 }   =   ( 2 ^ { 3 } ) ^ { 6 }   =   2 ^ { 1 8 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "7 ^ { 1 5 }   =   ( 7 ^ { 3 } ) ^ { 5 } \\; ; \\qquad 7 ^ { 1 5 }   =   \\overline { { ( 7 ^ { 5 } ) ^ { 3 } } }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "9 ^ { 1 4 }   = ( 9 ^ { 2 } ) ^ { 7 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "9^{14} = (3^2)^{14} = 3^{28}"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "5 ^ { 8 }   = ( 5 ^ { 2 } ) ^ { 4 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "5 ^ { 8 }   = ( 5 ^ { 4 } ) ^ { 2 }"
            }
          ]
        },
        {
