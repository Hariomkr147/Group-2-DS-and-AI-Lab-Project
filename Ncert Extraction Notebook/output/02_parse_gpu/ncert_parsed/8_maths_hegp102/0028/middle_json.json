          ],
          "content": [
            {
              "type": "text",
              "content": "y "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { 0 } = 1 \\; ( n \\neq 0 )"
            }
          ]
        },
        {
          "type": "text",
