          "bbox": [
            0.175,
            0.476,
            0.823,
            0.535
          ],
          "content": [
            {
              "type": "text",
              "content": "The scientific notation for the number 308100000 is "
            },
            {
              "type": "equation_inline",
              "content": "3 . 0 8 1 \\times 1 0 ^ { 8 } ."
            },
            {
              "type": "text",
              "content": " The standard form of the scientific notation of any number is "
            },
            {
              "type": "equation_inline",
              "content": "x \\times 1 0 ^ { y } ,"
            },
            {
              "type": "text",
              "content": " , where "
            },
            {
              "type": "equation_inline",
              "content": "x \\geq 1"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "x < 1 0"
            },
            {
              "type": "text",
              "content": " and y is an integer."
            }
          ]
        },
        {
          "type": "text",
