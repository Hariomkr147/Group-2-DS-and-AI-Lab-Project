            0.448
          ],
          "image_path": "images/page_27_equation_10.jpg",
          "content": "\\bullet \\; n^{a} \\div m^{a} = (n \\div m)^{a}(m \\neq 0)"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.239,
