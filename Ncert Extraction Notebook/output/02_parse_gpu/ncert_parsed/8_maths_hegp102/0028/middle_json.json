          ],
          "content": [
            {
              "type": "text",
              "content": "y "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { a } \\times n ^ { b } = n ^ { a + b }"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.238,
            0.354,
            0.427,
            0.375
          ],
          "image_path": "images/page_27_equation_7.jpg",
          "content": "\\bullet ( n ^ { a } ) ^ { b } = ( n ^ { b } ) ^ { a } = n ^ { a   \\times   b }"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.237,
            0.379,
            0.448,
            0.4
          ],
          "image_path": "images/page_27_equation_8.jpg",
          "content": "\\bullet \\; n^{a} \\div n^{b} = n^{a - b} \\; (n \\neq 0)"
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.238,
            0.404,
            0.424,
            0.424
          ],
          "image_path": "images/page_27_equation_9.jpg",
          "content": "\\bullet \\; n^{a} \\times m^{a} = (n \\times m)^{a}"
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.238,
            0.429,
