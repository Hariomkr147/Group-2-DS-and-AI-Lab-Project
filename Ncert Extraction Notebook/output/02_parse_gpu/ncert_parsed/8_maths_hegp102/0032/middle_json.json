          ],
          "content": [
            {
              "type": "text",
              "content": "Simplify "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 0 ^ { 4 } } { 5 ^ { 4 } }"
            },
            {
              "type": "text",
              "content": " and write it in exponential form. "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 4 }   = 1 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.152,
            0.161,
            0.276,
            0.181
          ],
          "content": [
            {
              "type": "text",
              "content": "Page No. 26",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.11,
            0.188,
            0.846,
            0.255
          ],
          "content": [
            {
              "type": "text",
              "content": "? Roxie has 7 dresses, 2 hats, and 3 pairs of shoes. How many different ways can Roxie dress up? "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "7 \\times 2 \\times 3"
            },
            {
              "type": "text",
              "content": " ways"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.152,
            0.276,
            0.275,
            0.295
          ],
          "content": [
            {
              "type": "text",
              "content": "Page No. 27",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.11,
            0.302,
            0.662,
            0.351
          ],
          "content": [
            {
              "type": "text",
              "content": "How many passwords are possible with such a lock? "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "2 6 \\times 2 6 \\times 2 6 \\times 2 6 \\times 2 6 \\times 2 6 = ( 2 6 ) ^ { 6 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.112,
            0.359,
            0.467,
            0.449
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What is "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 1 0 0 } \\div 2 ^ { 2 5 }"
            },
            {
              "type": "text",
              "content": " in powers of 2? "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 7 5 }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "Page No. 28",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.11,
            0.455,
            0.622,
            0.504
          ],
          "content": [
            {
              "type": "text",
              "content": "Why can’t n be 0? "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If "
            },
            {
              "type": "equation_inline",
              "content": "n = 0 _ { j }"
            },
            {
              "type": "text",
              "content": " , then we get "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 0 } { 0 }"
            },
            {
              "type": "text",
              "content": " which is not defined."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.152,
            0.523,
            0.275,
            0.543
          ],
          "content": [
            {
              "type": "text",
              "content": "Page No. 29",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.551,
            0.845,
            0.616
          ],
          "content": [
            {
              "type": "text",
              "content": "？ We had required a and b to be counting numbers. Can a and b be any integers? Will the generalised forms still hold true? "
            },
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Yes."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.112,
            0.623,
            0.74,
            0.688
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Write equivalent forms of the following. (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { - 4 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { - 5 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "( - 7 ) ^ { - 2 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "( - 5 ) ^ { -   3 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "1 0 ^ { - 1 0 0 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.692,
            0.73,
            0.776
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 ^ { 4 } }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 1 0 ^ { 5 } }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { ( - 7 ) ^ { 2 } }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1^{\\circ}}{(-5)^{3}}"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{(10)^{100}}"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.112,
            0.781,
            0.758,
            0.845
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Simplify and write the answers in exponential form. (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { - 4 } \\times 2 ^ { 7 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 2 } \\times 3 ^ { - 5 } \\times 3 ^ { 6 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "p ^ { 3 } \\times p ^ { - 1 0 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 4 }   \\times \\left( - 4 \\right) ^ { - 2 }"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { p } \\times 8 ^ { q }"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.152,
            0.85,
            0.718,
            0.906
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " (i) "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 3 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 3 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "p ^ { - 7 }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "1"
            },
            {
              "type": "text",
              "content": " (v) "
            },
            {
              "type": "equation_inline",
              "content": "8 ^ { p + q }"
            }
          ]
