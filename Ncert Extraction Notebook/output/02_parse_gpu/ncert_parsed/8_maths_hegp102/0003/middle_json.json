          ],
          "content": [
            {
              "type": "text",
              "content": "Power Play"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.149,
            0.087,
            0.848,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "It might be hard to digest the fact that after just 46 folds, the thickness is more than 7,00,000 km. This is the power of "
            },
            {
              "type": "text",
              "content": "multiplicative growth,",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " also called "
            },
            {
              "type": "text",
              "content": "exponential growth.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us analyse the growth. We have seen that the thickness doubles after every fold."
            }
          ]
        },
        {
          "type": "table",
          "index": 2,
          "bbox": [
            0.209,
            0.178,
            0.472,
            0.234
          ],
          "content": [
            {
