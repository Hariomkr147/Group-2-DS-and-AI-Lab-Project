          ],
          "content": [
            {
              "type": "text",
              "content": "From the diagram, the number of rooms is "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 4 } ."
            },
            {
              "type": "text",
              "content": " This can be computed by repeatedly multiplying 3 by itself,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
