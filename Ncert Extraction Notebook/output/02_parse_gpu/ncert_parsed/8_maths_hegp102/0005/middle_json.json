          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.11,
            0.431,
            0.557,
            0.453
          ],
          "content": [
            {
              "type": "text",
              "content": "How many rooms were there altogether?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.151,
            0.456,
            0.713,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "The information given can be visualised as shown below."
