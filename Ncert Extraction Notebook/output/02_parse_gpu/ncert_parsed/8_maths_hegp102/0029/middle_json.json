          ],
          "content": [
            {
              "type": "text",
              "content": "IT's PUZZLE TIME!"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 1,
          "bbox": [
            0.24,
            0.084,
            0.757,
            0.19
          ],
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "bbox": [
                0.24,
                0.084,
                0.757,
                0.19
              ],
              "image_path": "images/page_28_image_1.jpg",
