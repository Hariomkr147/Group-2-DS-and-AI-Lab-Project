            0.063
          ],
          "content": [
            {
              "type": "text",
              "content": "Power Play"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.175,
            0.087,
            0.594,
            0.107
          ],
          "content": [
            {
              "type": "text",
              "content": "How many 5-digit passwords are possible?"
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.075,
            0.114,
            0.373,
            0.301
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.075,
                0.114,
                0.373,
                0.301
              ],
              "image_path": "images/page_8_image_2.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.384,
            0.107,
            0.707,
            0.143
          ],
          "content": [
            {
              "type": "text",
              "content": "Each digit has 10 choices, so a 5-digit lock will have:"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.383,
            0.143,
            0.709,
            0.272
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "10 \\times 10 \\times 10 \\times 10 \\times 10 = 10^{5}"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "^ { = 1 , 0 0 , 0 0 0 }"
            },
            {
              "type": "text",
              "content": " passwords. This is the same as writing numbers till 99,999 with all 5 digits, i.e., 00000, 00001, 00002, …00010, 00011, …, 00100, 00101, …, 00999, …, 30456, …, 99998, 99999."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.383,
            0.272,
            0.708,
            0.328
          ],
          "content": [
            {
              "type": "text",
              "content": "Estu says, “Next time, I will buy a lock that has 6 slots with the letters A to Z. I feel it is safer.”"
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.715,
            0.081,
            0.854,
            0.363
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.715,
                0.081,
                0.854,
                0.363
              ],
              "image_path": "images/page_8_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.11,
            0.329,
            0.664,
            0.354
          ],
          "content": [
            {
              "type": "text",
              "content": "How many passwords are possible with such a lock?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.367,
            0.821,
            0.406
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Think about how many combinations are possible in different contexts. Some examples are—"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.832,
            0.352,
            0.929,
            0.406
          ],
          "content": [
            {
              "type": "text",
              "content": "Try This"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.189,
            0.409,
            0.848,
            0.465
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Pincodes of places in India—The Pincode of Vidisha in Madhya Pradesh is 464001. The Pincode of Zemabawk in Mizoram is 796017."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.185,
            0.465,
            0.404,
            0.483
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Mobile numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.178,
            0.484,
            0.525,
            0.503
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Vehicle registration numbers."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.174,
            0.506,
            0.825,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "Try to find out how these numbers or codes are allotted/generated."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.151,
            0.55,
            0.549,
            0.574
          ],
          "content": [
            {
              "type": "text",
              "content": "2.3 The Other Side of Powers"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.15,
            0.583,
            0.791,
            0.605
          ],
          "content": [
            {
              "type": "text",
              "content": "Imagine a line of length 16 units. Erasing half of it would result in"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.298,
            0.606,
            0.698,
            0.631
          ],
          "image_path": "images/page_8_equation_16.jpg",
          "content": "2^{4} \\div 2 = \\frac{2 \\times 2 \\times 2 \\times 2}{2} = 2 \\times 2 \\times 2 = 2^{3} = 8   units."
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.175,
            0.634,
            0.603,
            0.654
          ],
          "content": [
            {
              "type": "text",
              "content": "Erasing half one more time would result in,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.256,
            0.657,
            0.741,
            0.682
          ],
          "image_path": "images/page_8_equation_18.jpg",
          "content": "(2^{4} \\div 2) \\div 2 = 2^{4} \\div 2^{2} = \\frac{2 \\times 2 \\times 2 \\times 2}{2 \\times 2} = 2 \\times 2 = 2^{2} = 4   units."
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.175,
            0.684,
            0.62,
            0.704
          ],
          "content": [
            {
              "type": "text",
              "content": "Halving 16 cm three times may be written as,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.329,
            0.706,
            0.668,
            0.734
          ],
          "image_path": "images/page_8_equation_20.jpg",
          "content": "2^{4} \\div 2^{3} = \\frac{2 \\times 2 \\times 2 \\times 2}{2 \\times 2 \\times 2} = 2 = 2^{1} = 2   units."
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.175,
            0.735,
            0.431,
            0.754
          ],
          "content": [
            {
              "type": "text",
              "content": "From this we can see that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.418,
            0.757,
            0.579,
            0.776
          ],
          "image_path": "images/page_8_equation_22.jpg",
          "content": "2^{4} \\div 2^{3} = 2^{4 - 3} = 2^{1}."
        },
        {
          "type": "paragraph_title",
          "index": 23,
          "bbox": [
            0.114,
            0.787,
            0.468,
            0.809
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What is "
            },
            {
              "type": "equation_inline",
              "content": "2 ^ { 1 0 0 } \\div 2 ^ { 2 5 }"
            },
            {
              "type": "text",
              "content": " in powers of 2?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.175,
            0.813,
            0.395,
            0.832
          ],
          "content": [
            {
              "type": "text",
              "content": "In a generalised form,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.432,
            0.836,
            0.565,
            0.854
          ],
          "image_path": "images/page_8_equation_25.jpg",
          "content": "n ^ { a } \\div n ^ { b } = n ^ { a   -   b } ,"
        },
        {
          "type": "footer",
          "index": 26,
          "bbox": [
            0.448,
            0.97,
            0.55,
            0.985
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.174,
            0.86,
            0.718,
            0.881
          ],
          "content": [
            {
              "type": "text",
              "content": "where "
            },
            {
              "type": "equation_inline",
              "content": "n \\neq 0"
            },
            {
              "type": "text",
              "content": " and a and b are counting numbers and "
            },
            {
              "type": "equation_inline",
              "content": "a \\geq b"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 28,
          "bbox": [
            0.878,
            0.915,
            0.911,
            0.936
          ],
          "content": [
            {
              "type": "text",
              "content": "2 7"
            }
          ]
        }
      ]
