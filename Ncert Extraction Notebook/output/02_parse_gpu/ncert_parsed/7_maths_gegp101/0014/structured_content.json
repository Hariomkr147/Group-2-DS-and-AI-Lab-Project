            0.207,
            0.326,
            0.387,
            0.345
          ],
          "content": "(a) $2 \\times 1 7 6 8 \\times 5 0$"
        },
        {
          "type": "text",
          "bbox": [
            0.206,
            0.352,
            0.534,
            0.386
          ],
          "content": "(b) $72 \\times 125 \\; [ \\mathrm{Hint} : 125 = \\frac{1000}{8} ]$"
        },
        {
          "type": "text",
          "bbox": [
            0.208,
            0.39,
            0.421,
            0.409
          ],
          "content": "(c) $1 2 5 \\times 4 0 \\times 8 \\times 2 5$"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.414,
            0.516,
            0.435
          ],
          "content": "2. Calculate these products quickly."
