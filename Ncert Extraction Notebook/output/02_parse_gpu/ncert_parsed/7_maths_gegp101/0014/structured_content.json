        {
          "type": "paragraph_title",
          "bbox": [
            0.111,
            0.275,
            0.293,
            0.299
          ],
          "level": 2,
          "content": "Figure it Out"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.302,
            0.628,
            0.322
          ],
          "content": "1. Find quick ways to calculate these products:"
