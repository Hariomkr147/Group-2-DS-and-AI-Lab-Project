        {
          "type": "text",
          "bbox": [
            0.186,
            0.573,
            0.865,
            0.644
          ],
          "content": "**Ans:** (3 × 100000) + (6 × 10000) + (7 × 1000) ) + (8 × 100) + (1 × 10) + (3 × 1) or, (36 × 10000) + (78 × 1000) + (13 × 1)"
        },
