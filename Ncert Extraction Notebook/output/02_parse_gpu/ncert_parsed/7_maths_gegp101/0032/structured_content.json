          ],
          "content": "\\begin{aligned}( c ) \\quad & 125 \\times 40 \\times 8 \\times 25 \\\\= & 125 \\times 8 \\times 40 \\times 25 \\\\= & 1000 \\times 1000\\end{aligned}",
          "image_source": "images/page_31_equation_10.jpg"
        },
        {
