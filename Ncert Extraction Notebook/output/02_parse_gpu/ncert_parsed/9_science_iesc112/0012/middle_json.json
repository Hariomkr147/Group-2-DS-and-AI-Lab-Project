                {
                  "type": "text",
                  "content": "Fig. 12.13: An angiosperm tree (Gulmohar)"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.11,
            0.239,
            0.395,
            0.257
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 12.8: Let us discuss"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.108,
            0.26,
            0.775,
            0.312
          ],
          "content": [
            {
              "type": "text",
              "content": "Collect different leaves from your surroundings, and observe their shape and venation. Group them as monocots or dicots. "
            },
            {
              "type": "text",
              "content": "Discuss",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " how their structures help them adapt in different conditions to survive."
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.107,
            0.315,
            0.158,
            0.354
          ],
