              ]
            },
            {
              "type": "text",
              "content": " Grouped animals by habitat — land, water and air 4th century BCE"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.814,
            0.445,
            0.948,
            0.504
          ],
          "content": [
            {
              "type": "text",
              "content": "Two Kingdom",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Divided life into Plantae, Animalia 1758"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.813,
            0.535,
            0.95,
            0.594
          ],
          "content": [
            {
              "type": "text",
              "content": "Three Kingdom",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Added Protista for microscopic life 1866"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.815,
            0.613,
            0.948,
            0.685
          ],
          "content": [
            {
              "type": "text",
              "content": "Four Kingdom",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Grouped life into Monera, Protista, Plantae, Animalia 1938"
            }
          ]
        },
        {
          "type": "text",
