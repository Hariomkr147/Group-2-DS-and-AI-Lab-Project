              "content": "Five Kingdom",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Grouped life into Monera, Protista, Fungi, Plantae, Animalia 1969"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 20,
          "bbox": [
            0.109,
            0.878,
            0.532,
            0.9
          ],
          "content": [
            {
              "type": "text",
              "content": "12.6 Five Kingdom Classification"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.108,
            0.902,
            0.775,
            0.937
          ],
          "content": [
            {
              "type": "text",
              "content": "In the five kingdom classification, all life forms are grouped based on certain common features."
            }
          ]
        }
