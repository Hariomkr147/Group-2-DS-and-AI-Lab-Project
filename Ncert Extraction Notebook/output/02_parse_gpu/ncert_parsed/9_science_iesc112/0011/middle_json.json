            0.502
          ],
          "content": [
            {
              "type": "text",
              "content": "Pause and Ponder"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.052,
            0.508,
            0.265,
            0.586
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Which plant features reduce their dependence on water but still require moist conditions?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.053,
            0.589,
            0.255,
            0.636
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Why do taller plants need specialised transport tissues?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.053,
            0.639,
            0.248,
            0.702
          ],
          "content": [
            {
              "type": "text",
              "content": "5. How do seeds and fruits affect, where and how plants can survive?"
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.07,
            0.721,
            0.272,
            0.902
          ],
          "content": [
            {
              "type": "image_body",
