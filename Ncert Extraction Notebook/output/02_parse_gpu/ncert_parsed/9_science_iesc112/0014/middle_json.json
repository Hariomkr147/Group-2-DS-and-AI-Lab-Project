          ],
          "content": [
            {
              "type": "text",
              "content": "Porifera (pore-bearers) — Multicellularity without tissues"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.761,
            0.104,
            0.821,
            0.138
          ],
          "content": [
            {
