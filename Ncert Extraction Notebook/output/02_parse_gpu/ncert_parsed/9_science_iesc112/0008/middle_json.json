                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.122,
            0.914,
            0.558,
            0.932
          ],
          "content": [
            {
              "type": "text",
              "content": "5. Keep the bottle aside undisturbed for a week."
            }
          ]
        },
        {
