                0.39,
                0.956,
                0.64
              ],
              "image_path": "images/page_23_image_11.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.112,
            0.648,
            0.775,
            0.684
          ],
          "content": [
            {
              "type": "text",
              "content": "y Study the diversity of farm animals used in different types of farming practices in various parts of the country."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.153,
            0.715,
            0.39,
            0.734
          ],
          "content": [
            {
              "type": "text",
              "content": "The Quest Continues…"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.142,
            0.741,
            0.742,
            0.775
          ],
          "content": [
            {
              "type": "text",
              "content": "What knowledge do you think scientists would come up with further and how would it affect the classification system?"
            }
          ]
        }
      ]
