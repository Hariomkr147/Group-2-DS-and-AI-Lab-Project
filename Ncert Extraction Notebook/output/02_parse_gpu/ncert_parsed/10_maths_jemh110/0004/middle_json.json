                0.778,
                0.377
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 10.5"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.098,
            0.414,
            0.202,
            0.433
          ],
          "content": [
            {
              "type": "text",
              "content": "Remarks"
