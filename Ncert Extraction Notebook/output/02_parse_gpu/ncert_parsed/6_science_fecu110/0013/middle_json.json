              "content": "<table><tr><td>Date</td><td>Observations</td><td>Sketches</td></tr><tr><td></td><td>Seeds are sown</td><td></td></tr><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></table>"
