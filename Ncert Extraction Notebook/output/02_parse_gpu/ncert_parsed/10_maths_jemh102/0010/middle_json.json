          ],
          "content": [
            {
              "type": "text",
              "content": "POLYNOMIALS"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 2,
          "bbox": [
            0.875,
            0.105,
            0.899,
            0.118
          ],
          "content": [
            {
              "type": "text",
              "content": "19"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.138,
            0.901,
            0.177
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the value of "
            },
            {
              "type": "equation_inline",
              "content": "p(x) = 2x^2 - 8x + 6"
            },
            {
              "type": "text",
              "content": " is zero when "
            },
            {
              "type": "equation_inline",
              "content": "x - 1 = 0   or   x - 3 = 0."
            },
            {
              "type": "text",
              "content": " , i.e., when "
            },
            {
              "type": "equation_inline",
              "content": "x = 1   or   x = 3.   So"
            },
            {
              "type": "text",
              "content": " , the zeroes of "
            },
            {
              "type": "equation_inline",
              "content": "2 x ^ { 2 } - 8 x + 6"
            },
            {
              "type": "text",
              "content": " are 1 and 3. Observe that :"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.265,
            0.191,
            0.885,
            0.233
          ],
          "content": [
            {
              "type": "text",
              "content": "Sum of its zeroes "
            },
            {
              "type": "equation_inline",
              "content": "1 + 3 = 4 = { \\frac { - ( - 8 ) } { 2 } } = { \\frac { - ( { \\mathrm { C o e f f i c i e n t ~ o f ~ } } x ) } { \\mathrm { C o e f f i c i e n t ~ o f ~ } x ^ { 2 } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.265,
            0.237,
            0.815,
            0.279
          ],
          "content": [
            {
              "type": "text",
              "content": "Product of its zeroes "
            },
            {
              "type": "equation_inline",
              "content": "s = 1 \\times 3 = 3 = \\frac{6}{2} = \\frac{ constant term }{ coefficient of   x^{2}}"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.292,
            0.901,
            0.33
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us take one more quadratic polynomial, say, "
            },
            {
              "type": "equation_inline",
              "content": "p ( x ) = 3 x ^ { 2 } + 5 x - 2"
            },
            {
              "type": "text",
              "content": " . By the method of splitting the middle term,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.345,
            0.335,
            0.86,
            0.379
          ],
          "image_path": "images/page_9_equation_7.jpg",
          "content": "\\begin{aligned}3x^{2} + 5x - 2 = & 3x^{2} + 6x - x - 2 = 3x(x + 2) - 1(x + 2) \\\\= & (3x - 1)(x + 2)\\end{aligned}"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.096,
            0.385,
            0.899,
            0.455
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence, the value of "
            },
            {
              "type": "equation_inline",
              "content": "3 x ^ { 2 } + 5 x - 2"
            },
            {
              "type": "text",
              "content": " is zero when either "
            },
            {
              "type": "equation_inline",
              "content": "3x - 1 = 0   or   x + 2 = 0"
            },
            {
              "type": "text",
              "content": " when "
            },
            {
              "type": "equation_inline",
              "content": "x = { \\frac { 1 } { 3 } } { \\mathrm { ~ o r ~ } } x = - 2"
            },
            {
              "type": "text",
              "content": " So, the zeroes of "
            },
            {
              "type": "equation_inline",
              "content": "3x^{2} + 5x = 2"
            },
            {
              "type": "text",
              "content": " are "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{3}  and  -2."
            },
            {
              "type": "text",
              "content": " Observe that :"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.265,
            0.467,
            0.85,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "Sum of its zeroes "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{3}+(-2)=\\frac{-5}{3}=\\frac{-(Coefficient of x)}{Coefficient of x^{2}}"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.265,
            0.521,
            0.835,
            0.565
          ],
          "image_path": "images/page_9_equation_10.jpg",
          "content": "\\mathrm{Product of its zeros}=\\frac{1}{3}\\times(-2)=\\frac{-2}{3}=\\frac{\\mathrm{Constant term}}{\\mathrm{Coefficient of}\\ x^{2}}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.095,
            0.576,
            0.899,
            0.616
          ],
          "content": [
            {
              "type": "text",
              "content": "In general, if "
            },
            {
              "type": "equation_inline",
              "content": "\\alpha ^ { * }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{aligned}\\left\\| \\begin{aligned} \\begin{aligned} \\end{aligned} \\end{aligned} \\right. \\end{aligned}"
            },
            {
              "type": "text",
              "content": " are the zeroes of the quadratic polynomial "
            },
            {
              "type": "equation_inline",
              "content": "p(x)=ax^{2}+bx+c,"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "a \\neq 0"
            },
            {
              "type": "text",
              "content": " , then you know that "
            },
            {
              "type": "equation_inline",
              "content": "\\bar { x } - \\alpha"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "x \\geq \\beta"
            },
            {
              "type": "text",
              "content": " are the factors of "
            },
            {
              "type": "equation_inline",
              "content": "p ( x )"
            },
            {
              "type": "text",
              "content": " . Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.339,
            0.621,
            0.868,
            0.691
          ],
          "image_path": "images/page_9_equation_12.jpg",
          "content": "\\begin{aligned} &ax^{2}+bx+\\overline{c}=k(x-\\alpha)\\ (x-\\beta),  where \\ k\\  is a constant  \\\\&\\begin{aligned}\\\\ &=k[x^{2}-(\\alpha+\\beta)x+\\alpha\\ \\beta] \\\\&=kx^{2}-k(\\alpha+\\beta)x+k\\ \\alpha\\ \\beta\\\\ &\\end{aligned}\\\\ \\end{aligned}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.147,
            0.697,
            0.902,
            0.716
          ],
          "content": [
            {
              "type": "text",
              "content": "Comparing the coefficients of "
            },
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } ."
            },
            {
              "type": "text",
              "content": " x and constant terms on both the sides, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.384,
            0.721,
            0.733,
            0.741
          ],
          "image_path": "images/page_9_equation_14.jpg",
          "content": "a = k,   b = - k(\\alpha + \\beta)   and   c = k\\alpha\\beta."
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.148,
            0.762,
            0.254,
            0.782
          ],
          "content": [
            {
              "type": "text",
              "content": "This gives"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.4,
            0.75,
            0.545,
            0.789
          ],
          "image_path": "images/page_9_equation_16.jpg",
          "content": "\\alpha + \\beta = \\frac { - b } { a } ,"
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.43,
            0.805,
            0.522,
            0.842
          ],
          "image_path": "images/page_9_equation_17.jpg",
          "content": "\\alpha \\beta = \\frac { c } { a }"
        },
        {
          "type": "page_footnote",
          "index": 18,
          "bbox": [
            0.096,
            0.862,
            0.901,
            0.899
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "^ { \\mathrm { ~ \\scriptsize ~  ~ } } \\alpha , \\beta"
            },
            {
              "type": "text",
              "content": " are Greek letters pronounced as alpha' and beta' respectively. We will use later one more letter "
            },
            {
              "type": "equation_inline",
              "content": "\\gamma ^ { \\prime }"
            },
            {
              "type": "text",
              "content": " pronounced as‘gamma'."
            }
          ]
        }
      ]
