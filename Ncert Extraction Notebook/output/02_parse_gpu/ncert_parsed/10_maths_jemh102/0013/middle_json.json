          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.341,
            0.147,
            0.525,
            0.188
          ],
          "image_path": "images/page_12_equation_3.jpg",
          "content": "\\alpha + \\beta + \\gamma = \\frac { - b } { a } ,"
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.299,
            0.19,
            0.514,
            0.228
          ],
          "image_path": "images/page_12_equation_4.jpg",
          "content": "\\alpha \\beta + \\beta \\gamma + \\gamma \\alpha = \\frac{c}{a},"
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.38,
            0.231,
            0.528,
            0.271
          ],
          "image_path": "images/page_12_equation_5.jpg",
          "content": "\\alpha \\beta \\gamma = \\frac { - d } { a } ."
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.095,
            0.274,
            0.372,
            0.294
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us consider an example."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.095,
            0.315,
            0.902,
            0.397
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5* : Verify that "
            },
            {
              "type": "equation_inline",
              "content": "3,   -1,   -\\frac{1}{3}"
            },
            {
              "type": "text",
              "content": " are the zeroes of the cubic polynomial "
            },
            {
              "type": "equation_inline",
              "content": "p(x)=3x^{3}-5x^{2}-11x-3"
            },
            {
              "type": "text",
              "content": " , and then verify the relationship between the zeroes and the coefficients."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.095,
            0.402,
            0.82,
            0.423
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : Comparing the given polynomial with "
            },
            {
              "type": "equation_inline",
              "content": "a x ^ { 3 } + b x ^ { 2 } + c x + d ,"
            },
            {
              "type": "text",
              "content": " we get"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.146,
            0.427,
            0.537,
            0.447
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "a=3,   b=-5,   c=-11,   d=-3."
            },
            {
              "type": "text",
              "content": " Further"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.145,
            0.451,
            0.732,
            0.473
          ],
          "image_path": "images/page_12_equation_10.jpg",
          "content": "p(3)=3\\times3^{3}-(5\\times3^{2})-(11\\times3)=3=81-45-33-3=0,"
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.145,
            0.476,
            0.798,
            0.498
          ],
          "image_path": "images/page_12_equation_11.jpg",
          "content": "p(-1)=3\\times(-1)^{3}-5\\times(-1)^{2}-11\\times(-1)-3=-3=5+11-3=0,"
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.152,
            0.505,
            0.65,
            0.607
          ],
          "image_path": "images/page_12_equation_12.jpg",
          "content": "\\begin{aligned}p\\left(-\\frac{1}{3}\\right) &= 3 \\times \\left(-\\frac{1}{3}\\right)^3 - 5 \\times \\left(-\\frac{1}{3}\\right)^2 - 11 \\times \\left(-\\frac{1}{3}\\right) - 3 \\\\&= -\\frac{1}{9} - \\frac{5}{9} + \\frac{11}{3} - 3 = -\\frac{2}{3} + \\frac{2}{3} = 0\\end{aligned}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.096,
            0.615,
            0.705,
            0.654
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "3,-1   and   -\\frac{1}{3}   are the zeros of   3x^3 - 5x^2 - 11x - 3."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.097,
            0.651,
            0.473,
            0.691
          ],
          "content": [
            {
              "type": "text",
              "content": "So, we take "
            },
            {
              "type": "equation_inline",
              "content": "\\alpha = 3, \\beta = -1   and   \\gamma = -\\frac{1}{3}."
            },
            {
              "type": "text",
              "content": " 1T"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.098,
            0.685,
            0.158,
            0.704
          ],
          "content": [
            {
              "type": "text",
              "content": "Now,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.15,
            0.705,
            0.695,
            0.749
          ],
          "image_path": "images/page_12_equation_16.jpg",
          "content": "\\alpha + \\beta + \\gamma = 3 + (-1) + \\left(-\\frac{1}{3}\\right) = 2 - \\frac{1}{3} = \\frac{5}{3} = \\frac{-(-5)}{3} = \\frac{-b}{a},"
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.15,
            0.755,
            0.891,
            0.801
          ],
          "image_path": "images/page_12_equation_17.jpg",
          "content": "\\alpha \\beta + \\beta \\gamma + \\gamma \\alpha = 3 \\times (-1) + (-1) \\times \\left(-\\frac{1}{3}\\right) + \\left(-\\frac{1}{3}\\right) \\times 3 = -3 + \\frac{1}{3} - 1 = -\\frac{11}{3} = \\frac{c}{a}"
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.151,
            0.812,
            0.568,
            0.856
          ],
          "image_path": "images/page_12_equation_18.jpg",
          "content": "\\alpha \\beta \\gamma = 3 \\times (-1) \\times \\left(-\\frac{1}{3}\\right) = 1 = \\frac{-(-3)}{3} = \\frac{-d}{a} \\cdot"
        },
        {
          "type": "page_footnote",
          "index": 19,
          "bbox": [
            0.098,
            0.875,
            0.467,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "*Not from the examination point of view."
            }
          ]
        }
      ]
    }
