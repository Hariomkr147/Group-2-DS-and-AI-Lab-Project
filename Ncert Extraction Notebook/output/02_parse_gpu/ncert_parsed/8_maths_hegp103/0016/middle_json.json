            0.149,
            0.218,
            0.848,
            0.274
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, we have a new number system where each landmark number is 5 times the previous one. Since 1 is the first landmark number, they are all powers of 5."
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.212,
            0.281,
            0.26,
            0.299
          ],
          "image_path": "images/page_15_equation_7.jpg",
          "content": "5 ^ { 0 }   = 1"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.313,
            0.282,
            0.361,
            0.299
          ],
          "image_path": "images/page_15_equation_8.jpg",
          "content": "5 ^ { 1 }   =   5"
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.413,
            0.282,
            0.469,
            0.299
          ],
          "image_path": "images/page_15_equation_9.jpg",
          "content": "5 ^ { 2 }   = 2 5"
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.512,
            0.282,
            0.579,
            0.299
          ],
          "image_path": "images/page_15_equation_10.jpg",
          "content": "5 ^ { 3 }   = 1 2 5"
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.621,
            0.282,
            0.687,
            0.299
          ],
          "image_path": "images/page_15_equation_11.jpg",
          "content": "5 ^ { 4 }   = 6 2 5"
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.73,
            0.282,
            0.805,
            0.299
          ],
          "image_path": "images/page_15_equation_12.jpg",
          "content": "5 ^ { 5 }   = 3 1 2 5"
        },
