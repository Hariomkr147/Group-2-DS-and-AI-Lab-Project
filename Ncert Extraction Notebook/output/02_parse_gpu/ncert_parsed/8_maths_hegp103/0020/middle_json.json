              ],
              "image_path": "images/page_19_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.108,
            0.262,
            0.8,
            0.303
          ],
          "content": [
            {
              "type": "text",
              "content": "What can we conclude about the product of a number and (10), in the Egyptian system?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.208,
            0.32,
            0.236,
            0.341
          ],
          "content": [
            {
              "type": "text",
              "content": "(i)"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.35,
            0.311,
            0.464,
            0.346
          ],
          "image_path": "images/page_19_equation_9.jpg",
          "content": "9 9 \\times \\cap"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.352,
            0.362,
            0.613,
            0.398
          ],
          "content": [
            {
              "type": "text",
              "content": "?9 is same as 9+9"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.352,
            0.427,
            0.693,
            0.463
          ],
          "image_path": "images/page_19_equation_11.jpg",
          "content": "\\infty , \\textcircled { 9 9 } \\times \\textcircled { 1 } = ( \\textcircled { 9 } + \\textcircled { 9 } ) \\times \\textcircled { 1 }"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.235,
            0.485,
            0.77,
            0.507
          ],
          "content": [
            {
              "type": "text",
              "content": "As these are numbers, the distributive law holds. So,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.311,
            0.521,
            0.688,
            0.663
          ],
          "image_path": "images/page_19_equation_13.jpg",
          "content": "( 9 + 9 ) \\times \\pi = 9 \\pi + 9 \\times \\pi"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.202,
            0.677,
            0.347,
            0.697
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "9 7 1 1 \\times 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.245,
            0.696,
            0.607,
            0.734
          ],
          "content": [
            {
              "type": "text",
              "content": "| is the same as "
            },
            {
              "type": "equation_inline",
              "content": "9 + n n + 1"
            },
            {
              "type": "text",
              "content": " . Thus, "
            },
            {
              "type": "equation_inline",
              "content": "9 n \\cap \\times n = ( 9 + n \\cap + 1 ) \\times n"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.243,
            0.733,
            0.848,
            0.808
          ],
          "content": [
            {
              "type": "text",
              "content": "Will the distributive property hold here? For the same reason that it holds for "
            },
            {
              "type": "equation_inline",
              "content": "( a   +   b )   \\times   n ,"
            },
            {
              "type": "text",
              "content": " it also holds when one of the numbers has more than 2 terms. For example, "
            },
            {
              "type": "equation_inline",
              "content": "(a + b + c) \\times n ="
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "a n + b n + c n . \\mathrm { S o } _ { 3 }"
            }
          ]
        },
