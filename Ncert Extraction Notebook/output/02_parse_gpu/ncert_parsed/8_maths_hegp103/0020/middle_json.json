          "bbox": [
            0.109,
            0.084,
            0.449,
            0.11
          ],
          "content": [
            {
              "type": "text",
              "content": "Find the following products—"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.148,
            0.121,
            0.772,
            0.16
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "\\cap \\times \\bigcap"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "9 \\times 8 ^ { b }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { \\pi ^ { b } } { \\Delta } \\times \\frac { \\pi ^ { b } } { \\Delta }"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "1 ^ { p } \\times \\sum g j"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.149,
            0.175,
            0.848,
            0.213
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, the product of any two landmark numbers is another landmark number!"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.108,
            0.215,
            0.801,
            0.257
          ],
          "content": [
            {
              "type": "text",
              "content": "Does this property hold true in the base-5 system that we created? Does this hold for any number system with a base?"
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.817,
            0.211,
            0.905,
            0.264
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.817,
