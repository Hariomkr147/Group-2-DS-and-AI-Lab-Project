              "image_path": "images/page_44_table_0.jpg",
              "content": "<table><tbody><tr><td>Number</td><td>Base-2 system (ur = 0, uk = 1)</td><td>Gumulgal System</td></tr><tr><td>4</td><td>(1) × 22 + (0) × 21 + (0) × 20 = uk ur ur</td><td>uk-uk</td></tr><tr><td>5</td><td>(1) × 22 + (0) × 21 + (1) × 20 = uk ur uk</td><td>uk-uk-ur</td></tr><tr><td>6</td><td>(1) × 22 + (1) × 21 + (0) × 20 = uk uk ur</td><td>uk-uk-uk</td></tr><tr><td>7</td><td>(1) × 22 + (1) × 21 + (1) × 20 = uk uk uk</td><td>uk-uk-uk-ur</td></tr><tr><td>8</td><td>(1) × 23 + (0) × 22 + (0) × 21 + (0) × 20= uk ur ur ur</td><td>uk-uk-uk-uk</td></tr></tbody></table>"
            }
