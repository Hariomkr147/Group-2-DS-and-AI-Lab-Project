          "content": [
            {
              "type": "text",
              "content": "A Story of Numbers"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.149,
            0.088,
            0.848,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "These symbols are used to denote other numbers as well. For example, consider the number 2367. Writing it as a sum of landmark numbers starting from 1000 such that we take as many 1000s as possible, 500s as possible, and so on, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.226,
            0.167,
            0.771,
            0.186
          ],
          "image_path": "images/page_11_equation_2.jpg",
          "content": "2367=1000+1000+100+100+100+50+10+5+1+1"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.15,
            0.191,
            0.653,
            0.211
          ],
          "content": [
            {
              "type": "text",
              "content": "So in Roman numerals, this number is MMCCCLXII."
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.113,
            0.22,
            0.147,
            0.245
          ],
          "content": [
            {
