            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.418,
            0.763,
            0.559,
            0.83
          ],
          "image_path": "images/page_11_equation_16.jpg",
          "content": "\\underbrace { \\overbrace { \\left( \\mathtt { C C X X X I I } \\right) } ^ { \\text { D } } } _ { \\text { C C C C X I I I } }"
        },
        {
          "type": "equation",
