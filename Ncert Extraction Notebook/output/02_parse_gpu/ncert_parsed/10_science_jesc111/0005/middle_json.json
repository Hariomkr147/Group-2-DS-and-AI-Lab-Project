          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Calculate the ratio of V to I for each pair of potential difference V and current I.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
