          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Repeat the above steps using three cells and then four cells in the circuit separately.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.125,
