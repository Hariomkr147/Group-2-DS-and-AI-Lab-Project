            0.167
          ],
          "image_path": "images/page_16_equation_4.jpg",
          "content": "I_{3} = 12\\  V  / 30\\ \\Omega = 0.4\\  A ."
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.13,
            0.169,
            0.407,
            0.186
          ],
          "content": [
            {
              "type": "text",
              "content": "The total current in the circuit,",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.243,
            0.19,
            0.448,
            0.239
          ],
          "image_path": "images/page_16_equation_6.jpg",
          "content": "\\begin{array} { l } { { I \\quad = \\quad I _ { _ { 1 } } + I _ { _ { 2 } } + I _ { _ { 3 } } } } \\\\ { { \\quad = \\quad \\left( 2 . 4 + 1 . 2 + 0 . 4 \\right) \\mathrm { A } } } \\\\ { { \\quad = \\quad 4 \\mathrm { ~ A } } } \\end{array}"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.13,
            0.241,
            0.547,
            0.26
          ],
          "content": [
            {
              "type": "text",
              "content": "The total resistance "
            },
            {
              "type": "equation_inline",
              "content": "R _ { p ^ { \\prime } }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "is given by [Eq. (11.18)]",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.133,
            0.265,
            0.303,
            0.302
          ],
          "image_path": "images/page_16_equation_8.jpg",
          "content": "\\left[ \\frac{1}{R_{p}} = \\frac{1}{5} + \\frac{1}{10} + \\frac{1}{30} = \\frac{1}{3} \\right."
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.131,
            0.308,
            0.27,
            0.328
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, "
            },
            {
              "type": "equation_inline",
              "content": "R _ { _ { p } } = 3 \\; \\Omega ."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.131,
            0.342,
            0.276,
            0.358
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 11.9"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.129,
            0.358,
            0.724,
            0.428
          ],
          "content": [
            {
              "type": "text",
              "content": "If in Fig. 11.12, "
            },
            {
              "type": "equation_inline",
              "content": "R_{1}=10\\Omega,R_{2}=40\\Omega,R_{3}=30\\Omega,R_{4}=20\\Omega,R_{5}=60\\Omega,"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "and a 12 V battery is connected to the arrangement. Calculate (a) the total resistance in the circuit, and (b) the total current flowing in the circuit.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.131,
            0.442,
            0.224,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.129,
            0.458,
            0.634,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "Suppose we replace the parallel resistors "
            },
            {
              "type": "equation_inline",
              "content": "R _ { I }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "R _ { z }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "by an equivalent resistor of resistance,",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "R ^ { \\prime }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "Similarly we replace",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the parallel resistors "
            },
            {
              "type": "equation_inline",
              "content": "R _ { _ 3 } , R _ { _ 4 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "R _ { \\bar { 5 } }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "by an equivalent single resistor of resistance",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\dot { R ^ { \\prime } } ,"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "Then using Eq. (11.18), we have",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "1 / R^{\\prime} = 1 / 10 + 1 / 40 = 5 / 40;"
            },
            {
              "type": "text",
              "content": " that is "
            },
            {
              "type": "equation_inline",
              "content": "R ^ { \\prime } = 8 \\; \\Omega"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "Similarly,",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "1/R'' \\quad = \\quad 1/30 \\pm 1/20 + 1/60 = 6/60;"
            },
            {
              "type": "text",
              "content": " that is, "
            },
            {
              "type": "equation_inline",
              "content": "R ^ { \\prime \\prime } \\equiv 1 0 \\; \\Omega ."
            },
            {
              "type": "text",
              "content": " Thus, the total resistance, "
            },
            {
              "type": "equation_inline",
              "content": "R = R' + R'' = 18 \\Omega."
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "To calculate the current, we use Ohm’s law, and get",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "I = V / R = 12\\  V  / 18\\ \\Omega = 0.67\\  A ."
            }
          ]
        },
        {
          "type": "image",
