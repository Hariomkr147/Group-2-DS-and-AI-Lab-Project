          ],
          "content": [
            {
              "type": "text",
              "content": "The current "
            },
            {
              "type": "equation_inline",
              "content": "I_{3}, \\mathrm{through} R_{3} = V/R_{3}"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.244,
