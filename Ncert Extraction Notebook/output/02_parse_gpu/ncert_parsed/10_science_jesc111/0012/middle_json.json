          ],
          "content": [
            {
              "type": "text",
              "content": "Figure 11.7 shows a combination of resistors in which three resistors are connected together between points X and Y. Here, the resistors are said to be connected in parallel.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 1,
          "bbox": [
            0.381,
