            0.087,
            0.295,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "Be a scientist"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 3,
          "bbox": [
            0.123,
            0.116,
            0.279,
            0.245
          ],
          "content": [
            {
