        {
          "type": "text",
          "bbox": [
            0.133,
            0.275,
            0.743,
            0.332
          ],
          "content": "Grade 8 students listed some common communicable diseases in Table 3.1 during a community campaign and a library search."
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.336,
            0.744,
            0.375
          ],
          "content": "Check the information listed by referring to books, trusted websites, or asking your science teacher. Add any missing details."
