            0.135,
            0.647,
            0.743,
            0.684
          ],
          "content": [
            {
              "type": "text",
              "content": "Ayurveda teaches us that true health is a balance of body, mind, and surroundings."
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.145,
            0.687,
