            0.561
          ],
          "content": [
            {
              "type": "text",
              "content": "3. "
            },
            {
              "type": "text",
              "content": "Analyse",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the data filled in Table 4.1 and choose which of the following is true for displacement:"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.155,
            0.565,
            0.347,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) It is never zero."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.147,
            0.581,
            0.739,
            0.599
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Its magnitude can be greater than the total distance travelled."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.143,
            0.598,
            0.762,
            0.615
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Its magnitude is less than or equal to the total distance travelled."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.144,
            0.615,
            0.763,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) Its magnitude is less than the total distance travelled in all cases."
            }
          ]
        },
        {
