            0.37,
            0.867,
            0.42
          ],
          "content": [
            {
              "type": "text",
              "content": "The intermediate points represent possible values for position of vehicle at intermediate times. They are correct if vehicle is moving with a constant speed."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
