              "content": "184"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.782,
            0.104,
            0.899,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "MATHEMATICS"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.096,
            0.139,
            0.901,
            0.178
          ],
          "content": [
            {
              "type": "text",
              "content": "Clearly, 2 is the number of wickets taken by the bowler in the maximum number (i.e., 3) of matches. So, the mode of this data is 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.095,
            0.184,
            0.902,
            0.262
          ],
          "content": [
            {
              "type": "text",
              "content": "In a grouped frequency distribution, it is not possible to determine the mode by looking at the frequencies. Here, we can only locate a class with the maximum frequency, called the "
            },
            {
              "type": "text",
              "content": "modal class",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ". The mode is a value inside the modal class, and is given by the formula:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.175,
            0.268,
            0.497,
            0.317
          ],
          "image_path": "images/page_13_equation_4.jpg",
          "content": "\\mathrm{Model} = l + \\left( \\frac{f_1 - f_0}{2f_1 - f_0 - f_2} \\right) \\times h"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.147,
            0.328,
            0.551,
            0.347
          ],
          "content": [
            {
              "type": "text",
              "content": "where l = lower limit of the modal class,"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.216,
            0.353,
            0.852,
            0.373
          ],
          "content": [
            {
              "type": "text",
              "content": "h = size of the class interval (assuming all class sizes to be equal),"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.211,
            0.378,
            0.548,
            0.399
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "f _ { 1 }"
            },
            {
              "type": "text",
              "content": " = frequency of the modal class,"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.212,
            0.404,
            0.738,
            0.425
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "f _ { 0 }"
            },
            {
              "type": "text",
              "content": " = frequency of the class preceding the modal class,"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.211,
            0.428,
            0.748,
            0.45
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "f _ { 2 }"
            },
            {
              "type": "text",
              "content": " = frequency of the class succeeding the modal class."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.147,
            0.454,
            0.858,
            0.474
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us consider the following examples to illustrate the use of this formula."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.095,
            0.486,
            0.902,
            0.544
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A survey conducted on 20 households in a locality by a group of students resulted in the following frequency table for the number of family members in a household:"
            }
          ]
        },
        {
          "type": "table",
          "index": 12,
          "bbox": [
            0.164,
            0.555,
            0.85,
            0.658
          ],
          "content": [
            {
              "type": "table_body",
              "index": 12,
              "bbox": [
                0.164,
                0.555,
                0.85,
                0.658
              ],
              "image_path": "images/page_13_table_12.jpg",
              "content": "<table><tbody><tr><td>Family size</td><td>1 - 3</td><td>3 - 5</td><td>5 - 7</td><td>7 - 9</td><td>9 - 11</td></tr><tr><td>Number of families</td><td>7</td><td>8</td><td>2</td><td>2</td><td>1</td></tr></tbody></table>"
            },
            {
              "type": "table_footnote",
              "index": 13,
              "bbox": [
                0.148,
                0.672,
                0.407,
                0.69
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Find the mode of this data."
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.096,
            0.697,
            0.899,
            0.737
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here the maximum class frequency is 8, and the class corresponding to this frequency is 3 – 5. So, the modal class is 3 – 5."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 15,
          "bbox": [
            0.098,
            0.745,
            0.153,
            0.762
          ],
          "content": [
            {
              "type": "text",
              "content": "Now"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.147,
            0.77,
            0.85,
            0.789
          ],
          "content": [
            {
              "type": "text",
              "content": "modal class = 3 – 5, lower limit (l ) of modal class = 3, class size "
            },
            {
              "type": "equation_inline",
              "content": "( h ) = 2"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.147,
            0.796,
            0.519,
            0.816
          ],
          "content": [
            {
              "type": "text",
              "content": "frequency "
            },
            {
              "type": "equation_inline",
              "content": "( f _ { 1 } )"
            },
            {
              "type": "text",
              "content": " of the modal class = 8,"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.148,
            0.823,
            0.672,
            0.843
          ],
          "content": [
            {
              "type": "text",
              "content": "frequency "
            },
            {
              "type": "equation_inline",
              "content": "( f _ { 0 } )"
            },
            {
              "type": "text",
              "content": " of class preceding the modal class = 7,"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.148,
            0.849,
            0.685,
            0.869
          ],
          "content": [
            {
              "type": "text",
              "content": "frequency "
            },
            {
              "type": "equation_inline",
              "content": "( f _ { 2 } )"
            },
            {
              "type": "text",
              "content": " of class succeeding the modal class = 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.097,
            0.875,
            0.578,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, let us substitute these values in the formula :"
            }
