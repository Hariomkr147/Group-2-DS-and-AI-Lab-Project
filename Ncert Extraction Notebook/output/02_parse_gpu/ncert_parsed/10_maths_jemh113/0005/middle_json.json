          ],
          "content": [
            {
              "type": "text",
              "content": "The third step is to find the product of "
            },
            {
              "type": "equation_inline",
              "content": "d _ { i }"
            },
            {
              "type": "text",
              "content": " with the corresponding "
            },
            {
              "type": "equation_inline",
              "content": "f _ { i ^ { \\flat } }"
            },
            {
              "type": "text",
              "content": " and take the sum of all the "
            },
            {
              "type": "equation_inline",
              "content": "f_{i}d_{i}^{\\prime} s ."
            },
            {
              "type": "text",
              "content": " . The calculations are shown in Table 13.4."
            }
          ]
        },
        {
          "type": "table",
