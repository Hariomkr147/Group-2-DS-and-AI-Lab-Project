          ],
          "content": "Let"
        },
        {
          "type": "equation",
          "bbox": [
            0.438,
            0.83,
            0.546,
            0.874
          ],
          "content": "\\overline { { u } } \\; = \\; \\frac { \\Sigma f _ { i } u _ { i } } { \\Sigma f _ { i } }",
          "image_source": "images/page_5_equation_15.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.096,
            0.881,
            0.609,
            0.902
          ],
          "content": "Here, again let us find the relation between $\\left[ \\overline { { u } } \\right]$ and $\\left[ { \\overline { { x } } } \\right]$ ."
