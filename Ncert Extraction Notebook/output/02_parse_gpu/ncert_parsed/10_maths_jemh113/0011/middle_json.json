              "bbox": [
                0.162,
                0.532,
                0.883,
                0.595
              ],
              "image_path": "images/page_10_table_10.jpg",
              "content": "<table><tbody><tr><td>Number of plants</td><td>0 - 2</td><td>2 - 4</td><td>4 - 6</td><td>6 - 8</td><td>8 - 10</td><td>10 - 12</td><td>12 - 14</td></tr><tr><td>Number of houses</td><td>1</td><td>2</td><td>1</td><td>5</td><td>6</td><td>2</td><td>3</td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.155,
            0.607,
            0.673,
            0.626
          ],
          "content": [
            {
              "type": "text",
              "content": "Which method did you use for finding the mean, and why?"
