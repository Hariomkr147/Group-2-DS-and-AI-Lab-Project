            0.633
          ],
          "content": "Using the formula :"
        },
        {
          "type": "equation",
          "bbox": [
            0.408,
            0.582,
            0.745,
            0.662
          ],
          "content": "\\mathrm{Media} = l + \\left(\\frac{\\frac{n}{2} - \\mathrm{cf}}{f}\\right)h, \\mathrm{we get}",
          "image_source": "images/page_25_equation_10.jpg"
        },
        {
          "type": "equation",
          "bbox": [
            0.445,
            0.684,
            0.778,
            0.729
          ],
          "content": "525 = 500 + \\left( \\frac{50 - 36 - x}{20} \\right) \\times 100",
          "image_source": "images/page_25_equation_11.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.096,
            0.741,
            0.635,
            0.762
          ],
          "content": "i.e., O 525 − 500 = (14 − x) × 5"
        },
        {
          "type": "text",
          "bbox": [
            0.097,
            0.769,
            0.594,
            0.79
          ],
          "content": "i.e., 25 = 70 – 5x"
