              "content": "<table><tbody><tr><td>Number of mangoes</td><td>50 - 52</td><td>53 - 55</td><td>56 - 58</td><td>59 - 61</td><td>62 - 64</td></tr><tr><td>Number of boxes</td><td>15</td><td>110</td><td>135</td><td>115</td><td>25</td></tr></tbody></table>"
