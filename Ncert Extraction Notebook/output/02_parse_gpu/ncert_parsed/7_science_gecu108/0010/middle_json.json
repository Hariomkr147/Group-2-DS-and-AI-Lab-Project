          "bbox": [
            0.267,
            0.39,
            0.773,
            0.41
          ],
          "content": [
            {
              "type": "text",
              "content": "Look up at the railway timetable on the internet."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.267,
            0.411,
            0.882,
            0.448
          ],
          "content": [
            {
              "type": "text",
              "content": "Identify",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " a train stopping at the railway station nearest to your place of stay."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.267,
            0.448,
            0.882,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "Find out the name of the next station where this train stops. Also, find the distance to that station as given in the timetable."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.267,
            0.486,
            0.883,
            0.542
          ],
          "content": [
            {
              "type": "text",
              "content": "Note the time at which the train departs from your station and arrives at the next station. Find the difference to calculate the time taken by the train to cover the distance till the next station."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.267,
            0.543,
            0.882,
            0.58
          ],
          "content": [
            {
              "type": "text",
              "content": "Calculate the speed of the train between the two stations and record it in Table 8.2."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.267,
            0.581,
            0.883,
            0.62
          ],
          "content": [
            {
              "type": "text",
              "content": "Repeat for 4–5 different types of trains (Passenger/ Express/ Superfast)."
