                0.26
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Drawing a magnetic field line with the help of a compass needle"
                }
              ]
            },
            {
              "type": "image_body",
              "index": 9,
              "bbox": [
                0.557,
