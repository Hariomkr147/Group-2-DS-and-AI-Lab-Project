          ],
          "image_path": "images/page_15_equation_2.jpg",
          "content": "\\mathrm{m}_{\\mathrm{m}}=\\frac{\\text { Specof light in air }}{\\text { Specof light in the medium }}=\\frac{c}{v}\\tag{9.7}"
        },
        {
          "type": "text",
