              ],
              "content": [
                {
                  "type": "text",
                  "content": "Figure 9.8 Formation of image by a convex mirror"
                }
              ]
            }
          ]
        },
        {
          "type": "table",
          "index": 10,
          "bbox": [
            0.102,
            0.59,
