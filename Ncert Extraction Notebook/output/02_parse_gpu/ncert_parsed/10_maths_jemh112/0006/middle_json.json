            {
              "type": "text",
              "content": "Fig. 12.9"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.101,
            0.324,
            0.865,
            0.445
          ],
          "content": [
            {
              "type": "text",
              "content": "the total surface area of the b "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{aligned}\\mathrm{grid-batch} &= \\mathrm{CSA}   of   \\mathrm{cylinder} + \\mathrm{CSA}   of   \\mathrm{h} \\\\&= 2\\pi r h + 2\\pi r^2 = 2\\pi r(h + r) \\\\&= 2 \\times \\frac{22}{7} \\times 30(145 + 30)   \\mathrm{cm}^2 \\\\&= 33000   \\mathrm{cm}^2 = 3.3   \\mathrm{m}^2\\end{aligned}"
            },
            {
              "type": "text",
              "content": " hemisphere"
