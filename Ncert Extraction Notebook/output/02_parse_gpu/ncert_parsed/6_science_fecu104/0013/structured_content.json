          "type": "text",
          "bbox": [
            0.324,
            0.294,
            0.608,
            0.338
          ],
          "content": "“Do not heat me or drop me or hammer me."
        },
        {
          "type": "text",
          "bbox": [
            0.324,
            0.341,
            0.61,
            0.384
          ],
          "content": "Do not keep me near mobile phones or remote controls.”"
