              ],
              "image_path": "images/page_10_table_1.jpg",
              "content": "<table><tbody><tr><td>S. no.</td><td>Material placed between the magnet Observations and the compass needle</td></tr><tr><td>1.</td><td>Wood</td></tr><tr><td>2.</td><td>Cardboard</td></tr><tr><td>3.</td><td>Plastic</td></tr><tr><td>4.</td><td>Glass</td></tr></tbody></table>"
