              ],
              "content": "Fig. 4.4: Iron filings sticking to a bar magnet"
            },
            {
              "bbox": [
                0.586,
                0.753,
                0.749,
                0.845
              ],
              "content": "If we repeat this activity with magnets of other shapes, do we get the same result?"
            }
          ],
