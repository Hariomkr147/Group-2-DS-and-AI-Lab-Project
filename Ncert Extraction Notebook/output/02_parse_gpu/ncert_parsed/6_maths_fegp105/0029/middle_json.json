          ],
          "content": [
            {
              "type": "text",
              "content": "Q.1. Find the prime factorisations of the following numbers: 64, 104, 105, 243, 320, 141, 1728, 729, 1024, 1331, 1000.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "code",
          "index": 5,
          "bbox": [
            0.114,
            0.213,
            0.539,
            0.506
          ],
          "content": [
            {
              "type": "code_body",
              "index": 5,
              "bbox": [
                0.114,
                0.213,
                0.539,
                0.506
              ],
              "content": "Ans. 64 = 2 × 2 × 2 × 2 × 2 × 2\n104 = 2 × 2 × 2 × 13\n105 = 3 × 5 × 7\n243 = 3 ×3 ×3 ×3 ×3\n320 = 2 × 2 × 2 × 2 × 2 × 2 × 5\n141 = 3 × 47\n1728 = 2 × 2 × 2 × 2 × 2 × 2 × 3 × 3 × 3\n729 = 3 ×3 ×3 × 3 ×3 ×3\n1024 = 2 × 2 × 2 × 2 × 2 ×2 × 2 × 2 × 2 × 2\n1331 = 11 × 11 × 11\n1000 = 2 × 2 × 2 × 5 × 5 × 5"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.115,
            0.514,
            0.881,
            0.549
          ],
          "content": [
            {
              "type": "text",
              "content": "Q.2. The prime factorisation of a number has one 2, two 3s, and one 11. What is the number?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "code",
          "index": 7,
          "bbox": [
            0.116,
            0.559,
            0.334,
            0.576
          ],
          "content": [
            {
              "type": "code_body",
              "index": 7,
              "bbox": [
                0.116,
                0.559,
                0.334,
                0.576
              ],
              "content": "Ans. 198 = 2 × 3 × 3 × 11"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.115,
