            0.166,
            0.882,
            0.187
          ],
          "content": [
            {
              "type": "text",
              "content": "The factors of 14 are: 1, 2, 7, 14. So, these jump sizes will land on 14."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
