          "content": [
            {
              "type": "text",
              "content": "9.2 How Much Solute Can a Fixed Amount of Solvent Dissolve?"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.269,
            0.355,
            0.672,
            0.379
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 9.1: Let us investigate"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 7,
          "bbox": [
            0.108,
            0.379,
            0.222,
            0.508
          ],
          "content": [
            {
              "type": "image_body",
              "index": 7,
              "bbox": [
                0.108,
                0.379,
