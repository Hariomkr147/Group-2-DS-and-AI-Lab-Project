          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 9.7: Let us measure"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.271,
            0.109,
            0.883,
            0.147
          ],
          "content": [
            {
              "type": "text",
              "content": "z Collect various objects from your surroundings, such as a stone, metal keys, and so on."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.272,
            0.148,
            0.883,
            0.204
          ],
          "content": [
            {
              "type": "text",
              "content": "z Fill a measuring cylinder with water up to any desired volume, say 50 mL (Fig. 9.19a) and record the initial volume taken in Table 9.2."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.272,
            0.205,
            0.883,
            0.244
          ],
          "content": [
            {
              "type": "text",
              "content": "Tie the object, say a stone, with a thread and slowly lower it into the measuring cylinder."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.273,
            0.246,
            0.503,
            0.265
          ],
          "content": [
            {
              "type": "text",
              "content": "z What do you notice?"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.272,
            0.266,
            0.883,
            0.304
          ],
          "content": [
            {
              "type": "text",
              "content": "z Record the final volume after the level rises, say 55 mL, as shown in Fig. 9.19b."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.272,
            0.305,
            0.883,
            0.362
          ],
          "content": [
            {
              "type": "text",
              "content": "z Subtract the initial volume from the final volume after the object is put into the measuring cylinder. This is the volume of the object."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.271,
            0.363,
            0.673,
            0.384
          ],
          "content": [
            {
              "type": "text",
              "content": "z Record your observations in Table 9.2."
            }
          ]
        },
        {
          "type": "image",
