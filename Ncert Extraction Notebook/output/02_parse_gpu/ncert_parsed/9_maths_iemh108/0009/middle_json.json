          ],
          "content": [
            {
              "type": "text",
              "content": "Exercise:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Verify that the following sequences are arithmetic progressions and write their "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { t h }"
            },
            {
              "type": "text",
              "content": " terms. What do you observe when you plot the ordered pairs emerging from them?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.112,
            0.729,
            0.532,
            0.75
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) 2, 5, 8, 11, … (ii) "
            },
            {
              "type": "equation_inline",
              "content": "- 5 , - 1 , 3 , 7 , \\ldots"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.111,
            0.754,
            0.885,
            0.795
          ],
          "content": [
            {
              "type": "text",
              "content": "Exercise:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Using the formula "
            },
            {
              "type": "equation_inline",
              "content": "t _ { n } = a + ( n - 1 ) \\times d ,"
            },
            {
              "type": "text",
              "content": " find the "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { t h }"
            },
            {
              "type": "text",
              "content": " term of the following arithmetic progressions."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.802,
            0.579,
            0.838
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{2}, \\frac{5}{2}, \\frac{9}{2}, \\frac{13}{2}, \\ldots"
            },
            {
              "type": "text",
              "content": " (ii) 1.5, 3.5, 5.5, 7.5, …"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.148,
            0.849,
            0.886,
            0.87
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that "
            },
            {
              "type": "equation_inline",
              "content": "t_{n}=a+(n-1)\\times d"
            },
            {
              "type": "text",
              "content": " is the explicit rule for finding the "
            },
            {
              "type": "equation_inline",
              "content": "n ^ { t h }"
            }
          ]
        }
