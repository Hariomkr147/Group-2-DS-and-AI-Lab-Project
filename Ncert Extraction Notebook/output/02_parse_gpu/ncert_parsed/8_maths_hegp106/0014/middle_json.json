            0.403
          ],
          "content": [
            {
              "type": "text",
              "content": "Sridharacharya (750 CE) gave an interesting method to quickly compute the squares of numbers using Identity 1C! Consider the following modified form of this identity —"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.394,
            0.405,
            0.605,
            0.425
          ],
          "image_path": "images/page_13_equation_5.jpg",
          "content": "a^{2}=(a+b)(a-b)+b^{2}"
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.112,
            0.441,
            0.403,
            0.464
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Why is this identity true?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.15,
            0.469,
            0.75,
            0.49
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, for example, "
            },
            {
              "type": "equation_inline",
              "content": "3 1 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " can be found by taking "
            },
            {
              "type": "equation_inline",
              "content": "a \\equiv 3 1"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "b = 1"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.43,
            0.492,
            0.678,
            0.573
          ],
          "image_path": "images/page_13_equation_8.jpg",
          "content": "\\begin{aligned}31^{2} &= (31 + 1)(31 - 1) + 1^{2} \\\\&= 32 \\times 30 + 1 \\\\&= 961.\\end{aligned}"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.171,
            0.576,
            0.621,
            0.598
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "1 9 7 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " can be found by taking "
            },
            {
              "type": "equation_inline",
              "content": "a = 1 9 7 ,"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "b = 3"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.412,
            0.6,
            0.692,
            0.681
          ],
          "image_path": "images/page_13_equation_10.jpg",
          "content": "\\begin{aligned}197^{2} &= (197 + 3) (197 - 3) + 3^{2} \\\\&= 200 \\times 194 + 9 \\\\&= 38809.\\end{aligned}"
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.112,
            0.697,
            0.293,
            0.72
          ],
          "content": [
            {
              "type": "text",
              "content": "Figure it Out"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.722,
            0.733,
            0.744
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Which is greater: "
            },
            {
              "type": "equation_inline",
              "content": "( a - b ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " or "
            },
            {
              "type": "equation_inline",
              "content": "( b - a ) ^ { 2 } ?"
            },
            {
              "type": "text",
              "content": " Justify your answer."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.15,
            0.752,
            0.625,
            0.773
          ],
          "content": [
            {
