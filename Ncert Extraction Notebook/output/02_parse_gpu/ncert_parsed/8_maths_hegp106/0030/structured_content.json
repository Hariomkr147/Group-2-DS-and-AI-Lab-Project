        {
          "type": "text",
          "bbox": [
            0.212,
            0.518,
            0.394,
            0.539
          ],
          "content": "(i) $( p - 1 )   ( p + 1 1 )$"
        },
        {
          "type": "text",
          "bbox": [
            0.205,
            0.542,
            0.426,
            0.562
          ],
          "content": "(ii) $(3a - 9b)(3a + 9b)$"
        },
        {
          "type": "text",
          "bbox": [
            0.2,
            0.567,
            0.419,
            0.587
          ],
          "content": "(iii) $- \\left( 2 y + 5 \\right) \\left( 3 y + 4 \\right)$"
