  "pages": [
    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "footer",
          "index": 0,
          "bbox": [
            0.448,
            0.97,
            0.551,
            0.985
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.585,
            0.046,
            0.862,
            0.064
          ],
          "content": [
            {
              "type": "text",
              "content": "We Distribute, Yet Things Multiply"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.15,
            0.09,
            0.685,
            0.116
          ],
          "content": [
            {
              "type": "text",
              "content": "Using exponent notation, we can write "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 3 } { 2 } } \\times ( a \\times a ) = { \\frac { 3 } { 2 } }   a ^ { 2 } ."
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.378,
            0.116,
            0.619,
            0.144
          ],
          "image_path": "images/page_5_equation_3.jpg",
          "content": "\\frac{3a}{2} \\times b = \\frac{3}{2} \\times (a \\times b) = \\frac{3}{2}ab."
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.393,
            0.147,
            0.606,
            0.177
          ],
          "image_path": "images/page_5_equation_4.jpg",
          "content": "\\frac{3a}{2} \\times \\frac{1}{5} = (\\frac{3}{2} \\times \\frac{1}{5}) a = \\frac{3}{10} a"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.174,
            0.178,
            0.276,
            0.197
          ],
          "content": [
            {
              "type": "text",
              "content": "So we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.349,
            0.198,
            0.648,
            0.228
          ],
          "image_path": "images/page_5_equation_6.jpg",
          "content": "\\frac{3a}{2}\\left(a-b+\\frac{1}{5}\\right)=\\frac{3}{2}a^{2}-\\frac{3}{2}ab+\\frac{3}{10}a."
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.109,
            0.238,
            0.633,
            0.263
          ],
          "content": [
            {
              "type": "text",
              "content": "Can any two terms be added to get a single term?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.174,
            0.27,
            0.763,
            0.297
          ],
          "content": [
            {
              "type": "text",
              "content": "For example, can "
            },
            {
              "type": "equation_inline",
              "content": "{ \\frac { 3 } { 2 } }   a ^ { 2 }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 3 } { 1 0 }"
            },
            {
              "type": "text",
              "content": " a be added to get a single term?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.149,
            0.298,
            0.849,
            0.355
          ],
          "content": [
            {
              "type": "text",
              "content": "We see that no two terms have exactly the same letter-numbers, a further simplification of the expression is not possible."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.15,
            0.353,
            0.824,
            0.373
          ],
          "content": [
            {
              "type": "text",
              "content": "Recall that we call terms having the same letter-numbers "
            },
            {
              "type": "text",
              "content": "like terms.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.112,
            0.383,
            0.483,
            0.405
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Example 2: Expand "
            },
            {
              "type": "equation_inline",
              "content": "\\left(a+b\\right)\\left(a+b\\right)"
            }
          ],
          "level": 2
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.174,
            0.418,
            0.82,
            0.469
          ],
          "image_path": "images/page_5_equation_12.jpg",
          "content": "We have (a+b)(a+b)=(a+b) a+(a+b) b=a \\times a+b \\times a+a b+b \\times b"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.15,
            0.474,
            0.848,
            0.512
          ],
          "content": [
            {
              "type": "text",
              "content": "Since "
            },
            {
              "type": "equation_inline",
              "content": "b a = a b ,"
            },
            {
              "type": "text",
              "content": " , we have two terms having the same letter-numbers ab (or, that are like terms), and so can be added —"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.386,
            0.516,
            0.611,
            0.535
          ],
          "image_path": "images/page_5_equation_14.jpg",
          "content": "b \\overline{a} \\pm \\overline{ab} = ab + ab \\pm 2ab"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.174,
            0.541,
            0.276,
            0.56
          ],
          "content": [
            {
              "type": "text",
              "content": "So we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.363,
            0.564,
            0.634,
            0.583
          ],
          "image_path": "images/page_5_equation_16.jpg",
          "content": "(a+b)(a+b)=a^{2}+2ab+b^{2}."
        },
        {
          "type": "paragraph_title",
          "index": 17,
          "bbox": [
            0.112,
            0.599,
            0.553,
            0.621
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Example 3: Expand "
            },
            {
              "type": "equation_inline",
              "content": "(a + b)(a^{2} + 2ab + b^{2})"
            }
          ],
          "level": 2
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.151,
            0.624,
            0.832,
            0.662
          ],
          "image_path": "images/page_5_equation_18.jpg",
          "content": "\\begin{aligned}(a + b) \\; (a^2 + 2ab + b^2) &= (a + b)a^2 + (\\overline{a} + b) \\times 2ab + (a + b)b^2 \\\\&= (a \\times \\overline{a}^2) \\div ba^2 + (a \\times 2ab) \\div (b \\times 2ab) \\div ab^2 + (b \\times b^2)\\end{aligned}"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.174,
            0.662,
            0.577,
            0.681
          ],
          "content": [
            {
              "type": "text",
              "content": "The terms can be simplified as follows—"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.413,
            0.684,
            0.584,
            0.705
          ],
          "image_path": "images/page_5_equation_20.jpg",
          "content": "a \\times a^{2} = a^{3}   (\\mathrm{why?})"
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.455,
            0.714,
            0.544,
            0.734
          ],
          "image_path": "images/page_5_equation_21.jpg",
          "content": "b a ^ { 2 }   = a ^ { 2 } b"
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.361,
            0.745,
            0.636,
            0.764
          ],
          "image_path": "images/page_5_equation_22.jpg",
          "content": "a \\times 2ab = 2 \\times a \\times a \\times b = 2a^{2}b"
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.364,
            0.774,
            0.639,
            0.794
          ],
          "image_path": "images/page_5_equation_23.jpg",
          "content": "b \\times 2ab = 2 \\times a \\times b \\times b = 2ab^{2}"
        },
        {
          "type": "equation",
          "index": 24,
          "bbox": [
            0.449,
            0.803,
            0.549,
            0.823
          ],
          "image_path": "images/page_5_equation_24.jpg",
          "content": "b \\times b ^ { 2 }   = b ^ { 3 }"
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.226,
            0.833,
            0.77,
            0.853
          ],
          "image_path": "images/page_5_equation_25.jpg",
          "content": "\\mathrm{S}0,(a+b)(a^{2}+2ab+b^{2})=a^{3}+a^{2}b+2a^{2}b+2ab^{2}+ab^{2}+b^{3}."
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.151,
            0.859,
            0.848,
            0.897
          ],
          "content": [
            {
              "type": "text",
              "content": "We see that "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 } b"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "2 a ^ { 2 } b"
            },
            {
              "type": "text",
              "content": " have the same letter-numbers (or, are like terms) and so can be added—"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 27,
          "bbox": [
            0.873,
            0.915,
            0.919,
            0.936
          ],
          "content": [
            {
              "type": "text",
              "content": "141"
            }
          ]
        }
      ]
    }
  ],
