            0.367
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Describe a general rule to multiply a number (of any number of digits) by 11 and write the product in one line. C Evaluate (i) "
            },
            {
              "type": "equation_inline",
              "content": "9 4 \\times 1 1 _ { \\mathrm { i } }"
            },
            {
              "type": "text",
              "content": " , (ii) "
            },
            {
              "type": "equation_inline",
              "content": "4 9 5 \\times 1 1"
            },
            {
              "type": "text",
              "content": " , (iii) "
            },
            {
              "type": "equation_inline",
              "content": "3 2 7 9 \\times 1 1"
            },
            {
              "type": "text",
              "content": " , (iv) "
            },
            {
              "type": "equation_inline",
              "content": "4 7 9 1 2 5 6 \\times 1 1 1"
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.817,
            0.326,
            0.905,
            0.378
          ],
          "content": [
            {
              "type": "image_body",
