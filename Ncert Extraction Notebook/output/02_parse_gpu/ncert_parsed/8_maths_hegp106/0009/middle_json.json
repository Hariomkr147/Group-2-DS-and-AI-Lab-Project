            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.111,
            0.375,
            0.802,
            0.414
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Can we come up with a similar rule for multiplying a number by 101?"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.109,
            0.428,
            0.363,
            0.453
          ],
          "content": [
            {
              "type": "text",
              "content": "Multiply 3874 by 101."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.149,
            0.454,
            0.483,
            0.474
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us take a 4-digit number dcba."
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.261,
            0.475,
            0.735,
            0.496
          ],
          "image_path": "images/page_8_equation_8.jpg",
          "content": "d c b a \\times 1 0 1 = d c b a \\times ( 1 0 0 + 1 ) = d c b a \\times 1 0 0 + d c b a ."
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.175,
            0.501,
            0.315,
            0.52
          ],
          "content": [
            {
              "type": "text",
              "content": "This becomes"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.346,
            0.517,
            0.645,
            0.57
          ],
          "image_path": "images/page_8_equation_10.jpg",
          "content": "\\frac{d\\quad c\\quad b\\quad a\\quad o}{d\\quad c\\quad b}\\quad a\\quad a"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.109,
            0.576,
            0.565,
            0.602
          ],
          "content": [
            {
              "type": "text",
              "content": "Use this to multiply "
            },
            {
              "type": "equation_inline",
              "content": "3 8 7 4 \\times 1 0 1"
            },
            {
              "type": "text",
              "content": " in one line."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.11,
            0.615,
            0.848,
            0.656
          ],
          "content": [
            {
              "type": "text",
              "content": "？ What could be a general rule to multiply a number by 101 and write the product in one line? Extend this rule for multiplication by 1001, 10001, …"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.109,
            0.668,
            0.8,
            0.709
          ],
          "content": [
            {
              "type": "text",
              "content": "Use this to find (i) "
            },
            {
              "type": "equation_inline",
              "content": "8 9 \\times 1 0 1"
            },
            {
              "type": "text",
              "content": " , (ii) "
            },
            {
              "type": "equation_inline",
              "content": "9 4 9   \\times   1 0 1"
            },
            {
              "type": "text",
              "content": " , (iii) 265831 × 1001, (iv) 1111 × 1001, (v) 9734 × 99 and (vi) "
            },
            {
              "type": "equation_inline",
              "content": "2 3 4 7 8 \\times 9 9 9 ."
            }
          ]
        },
        {
          "type": "image",
          "index": 14,
