            0.145,
            0.825,
            0.202
          ],
          "content": [
            {
              "type": "text",
              "content": "We extended the distributive property to find the product of two expressions each of which has two terms. The general form for the same is "
            },
            {
              "type": "equation_inline",
              "content": "(a+b)\\times(c+d)=ac+ad+bc+bd."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.176,
            0.212,
            0.623,
            0.232
          ],
          "content": [
            {
              "type": "text",
              "content": "� We saw some special cases of this identity."
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.257,
            0.241,
            0.467,
            0.26
          ],
          "image_path": "images/page_21_equation_4.jpg",
          "content": "(a + b)^{2} = a^{2} + 2ab + b^{2}"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.237,
            0.265,
            0.471,
            0.285
          ],
          "content": [
            {
              "type": "text",
              "content": "y "
            },
            {
              "type": "equation_inline",
              "content": "(a - b)^{2} = a^{2} - 2ab + b^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.238,
            0.289,
            0.471,
            0.309
          ],
          "content": [
            {
              "type": "text",
              "content": "y "
            },
            {
              "type": "equation_inline",
              "content": "(a+b)(a-b)=a^{2}-b^{2}."
            }
          ]
        },
        {
          "type": "footer",
