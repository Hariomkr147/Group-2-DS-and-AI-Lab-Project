          "content": [
            {
              "type": "text",
              "content": "3. Find 3 examples where the product of two numbers remains unchanged when one of them is increased by 2 and the other is decreased by 4."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.152,
            0.838,
            0.444,
            0.856
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let numbers be a and b."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.202,
            0.858,
            0.43,
            0.876
          ],
          "content": [
            {
              "type": "text",
              "content": "Then "
            },
            {
              "type": "equation_inline",
              "content": "(a + 2)   (b - 4) = ab"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.203,
            0.878,
            0.333,
            0.895
          ],
          "content": [
            {
              "type": "text",
              "content": "So, b = 2a + 4"
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.202,
            0.897,
            0.793,
            0.917
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence 3 examples are "
            },
            {
              "type": "equation_inline",
              "content": "( a = 1 , b = 6 ) , ( a = 2 , b = 8 ) , ( a = 3 , b = 1 0 )"
            }
          ]
