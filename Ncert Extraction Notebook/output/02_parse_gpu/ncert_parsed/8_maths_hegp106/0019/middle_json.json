            0.621
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Compute these products using the suggested identity."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.214,
            0.624,
            0.56,
            0.644
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "4 6 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " using Identity 1A for "
            },
            {
              "type": "equation_inline",
              "content": "( a + b ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.208,
            0.649,
            0.673,
            0.668
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "3 9 7 \\times 4 0 3"
            },
            {
              "type": "text",
              "content": " using Identity 1C for "
            },
            {
              "type": "equation_inline",
              "content": "\\left( a + b \\right) \\left( a - b \\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.202,
            0.672,
            0.557,
            0.692
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "9 1 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " using Identity 1B for "
            },
            {
              "type": "equation_inline",
              "content": "( a - b ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.203,
            0.697,
            0.651,
            0.717
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) "
            },
            {
              "type": "equation_inline",
              "content": "4 3 \\times 4 5"
            },
            {
              "type": "text",
              "content": " using Identity 1C for "
            },
            {
              "type": "equation_inline",
              "content": "( a + b )   ( a - b )"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.15,
            0.721,
            0.846,
            0.758
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Use either a suitable identity or the distributive property to find each of the following products."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.214,
            0.763,
            0.389,
            0.784
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "(p - 1)(p + 11)"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.208,
            0.787,
            0.422,
            0.807
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "( 3 a - 9 b ) ( 3 a + 9 b )"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.202,
            0.812,
            0.41,
            0.832
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "-(2y+5)\\left ( 3y+4 \\right )"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.203,
            0.835,
            0.343,
            0.856
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) "
            },
            {
              "type": "equation_inline",
              "content": "( 6 x + 5 y ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.209,
            0.863,
            0.332,
            0.887
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) "
            },
            {
              "type": "equation_inline",
              "content": "( 2 X   -   { \\frac { 1 } { 2 } } ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
