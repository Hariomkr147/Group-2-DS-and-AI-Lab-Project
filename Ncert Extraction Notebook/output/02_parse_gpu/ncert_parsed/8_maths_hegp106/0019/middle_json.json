            0.126
          ],
          "content": [
            {
              "type": "text",
              "content": "The required area is 2 times the area of JKLM."
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.341,
            0.133,
            0.514,
            0.162
          ],
          "image_path": "images/page_18_equation_3.jpg",
          "content": "\\mathrm{JK} = \\frac{X - y}{2}, \\mathrm{KM} = x"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.151,
            0.169,
            0.383,
            0.198
          ],
          "content": [
            {
              "type": "text",
              "content": "Area "
            },
            {
              "type": "equation_inline",
              "content": "( \\mathrm { { J K M L } } ) = x \\left( { \\frac { x - y } { 2 } } \\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.151,
            0.202,
            0.48,
            0.274
          ],
          "content": [
            {
              "type": "text",
              "content": "Required area = 2 × Area of JKML = 2x (x – y) 2 = x (x – y)."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.722,
            0.078,
            0.901,
            0.239
          ],
          "content": [
            {
              "type": "image_body",
