                0.239
              ],
              "image_path": "images/page_18_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.109,
            0.281,
            0.847,
            0.323
          ],
          "content": [
            {
              "type": "text",
              "content": "? By expanding the expressions, verify that all three expressions are equivalent. If "
            },
            {
              "type": "equation_inline",
              "content": "x = 8  and  y = 3."
            },
            {
              "type": "text",
              "content": " , find the area of the shaded region."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.337,
            0.803,
            0.395
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Write an expression for the area of the dashed region in the figure below. Use more than one method to arrive at the answer. Substitute "
            },
            {
              "type": "equation_inline",
              "content": "p = 6,   r = 3.5,"
            },
            {
              "type": "text",
              "content": " , and "
            },
            {
              "type": "equation_inline",
              "content": "s = 9"
            },
            {
              "type": "text",
              "content": " , and calculate the area."
            }
          ]
        },
