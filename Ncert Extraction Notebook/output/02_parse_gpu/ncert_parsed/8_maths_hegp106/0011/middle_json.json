          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "( m + 3 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "( 6 + p ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
            0.112,
            0.146,
            0.318,
            0.169
          ],
          "content": [
            {
              "type": "text",
              "content": "？ Expand "
            },
            {
              "type": "equation_inline",
              "content": "( 6 x + 5 ) ^ { 2 }"
            }
          ],
          "level": 2
        },
        {
          "type": "table",
          "index": 4,
          "bbox": [
            0.145,
            0.179,
