          ],
          "content": [
            {
              "type": "table_body",
              "index": 4,
              "bbox": [
                0.145,
                0.179,
                0.865,
                0.319
              ],
              "image_path": "images/page_10_table_4.jpg",
              "content": "<table><tbody><tr><td>Using the Distributive Property</td><td>Using the Identity</td></tr><tr><td>(6x + 5)<sup>2</sup> = (6x + 5) (6x + 5) = (6x × 6x) + (5 × 6x) +(6x × 5) + 5 × 5 = (6x)2 + 2 (6x × 5) + 52 = 36x<sup>2</sup> + 60x + 25.</td><td>(6x + 5)2 = (6x)2 + 52 + 2 × (6x × 5) = 36x<sup>2</sup> + 25 + 60x.</td></tr></tbody></table>"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.101,
            0.346,
            0.187,
            0.403
          ],
          "content": [
            {
              "type": "image_body",
