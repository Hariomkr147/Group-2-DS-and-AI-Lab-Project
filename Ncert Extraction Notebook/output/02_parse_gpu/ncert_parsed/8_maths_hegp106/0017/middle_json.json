            0.528,
            0.267,
            0.568,
            0.279
          ],
          "content": [
            {
              "type": "text",
              "content": "4 × 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.518,
            0.28,
            0.603,
            0.294
          ],
          "content": [
            {
              "type": "text",
              "content": "= 4 × (4 + 2)"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.149,
            0.307,
            0.848,
            0.382
          ],
          "content": [
            {
              "type": "text",
              "content": "Does your method match any of these, or is it different? Each expression that we have identified appears different, but are they really different? Since they describe the same pattern, they should all be the same. Let us simplify each expression and find out."
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.167,
            0.397,
            0.319,
            0.455
          ],
          "image_path": "images/page_16_equation_20.jpg",
          "content": "\\begin{array} { c } { ( k + 1 ) ^ { 2 } - 1 } \\\\ { = k ^ { 2 } + 1 + 2 k - 1 } \\\\ { = k ^ { 2 } + 2 k } \\end{array}"
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.369,
            0.397,
            0.461,
            0.438
          ],
          "image_path": "images/page_16_equation_21.jpg",
          "content": "\\begin{array} { r } { k ^ { 2 } + 2 \\times k } \\\\ { = k ^ { 2 } + 2 k } \\end{array}"
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.519,
            0.396,
            0.655,
            0.456
          ],
          "image_path": "images/page_16_equation_22.jpg",
          "content": "\\begin{array} { c } { k \\times ( k + 1 ) + k } \\\\ { = k ^ { 2 } + k + k } \\\\ { \\supset \\ldots = k ^ { 2 } + 2 k } \\end{array}"
        },
        {
          "type": "equation",
          "index": 23,
          "bbox": [
            0.712,
            0.399,
            0.812,
            0.437
          ],
          "image_path": "images/page_16_equation_23.jpg",
          "content": "\\stackrel{k \\times (k + 2)}{= k^2 + 2k}"
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.149,
            0.49,
            0.847,
            0.548
          ],
          "content": [
            {
              "type": "text",
              "content": "When carried out correctly, all methods lead to the same answer; "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { k } ^ { 2 } + 2 k ."
            },
            {
              "type": "text",
              "content": " The expression "
            },
            {
              "type": "equation_inline",
              "content": "k^{2}  和  2\\bar{k}"
            },
            {
              "type": "text",
              "content": " gives the number of circles at Step k of this pattern."
            }
          ]
        },
        {
          "type": "image",
          "index": 25,
          "bbox": [
            0.114,
            0.601,
            0.201,
            0.656
          ],
          "content": [
            {
              "type": "image_body",
              "index": 25,
