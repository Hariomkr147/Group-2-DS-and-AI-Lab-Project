          ],
          "image_path": "images/page_16_equation_14.jpg",
          "content": "\\begin{array} { r l } {  { 1 \\times 3 } } \\\\ { = 1 \\times ( 1 + 2 ) } \\end{array}"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.376,
            0.28,
