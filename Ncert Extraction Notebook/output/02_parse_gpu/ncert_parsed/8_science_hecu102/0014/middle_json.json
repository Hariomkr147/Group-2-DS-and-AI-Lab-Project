              "type": "text",
              "content": "Chapter 2 — The Invisible Living World: Beyond Our Naked Eye"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 2,
          "bbox": [
            0.892,
            0.029,
            0.917,
            0.045
          ],
          "content": [
            {
