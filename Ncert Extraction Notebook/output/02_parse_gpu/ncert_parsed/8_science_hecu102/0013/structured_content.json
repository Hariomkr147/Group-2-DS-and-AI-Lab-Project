        },
        {
          "type": "text",
          "bbox": [
            0.077,
            0.832,
            0.238,
            0.849
          ],
          "content": "(b) Dough in bowl B"
        },
        {
          "type": "text",
          "bbox": [
            0.062,
            0.852,
            0.251,
            0.869
          ],
          "content": "Fig. 2.11: Change in the"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.27,
            0.691,
            0.63,
            0.715
          ],
          "level": 2,
          "content": "Activity 2.8: Let us perform"
        },
        {
          "type": "text",
          "bbox": [
            0.042,
            0.869,
            0.271,
            0.915
          ],
          "content": "volume of flour after addition of yeast, sugar, and warm water"
        },
        {
          "type": "text",
          "bbox": [
            0.273,
            0.732,
            0.538,
            0.751
          ],
          "content": "Take two bowls A and B."
        },
        {
          "type": "text",
          "bbox": [
            0.271,
            0.751,
            0.882,
            0.789
          ],
          "content": "In each, take 200 g of flour (atta or maida) and add a pinch of sugar."
        },
        {
          "type": "text",
          "bbox": [
            0.273,
            0.79,
            0.883,
            0.827
          ],
          "content": "z Now, in bowl A, add a small amount of yeast powder and mix it well with the flour."
        },
        {
          "type": "text",
          "bbox": [
            0.274,
            0.828,
            0.882,
            0.864
          ],
          "content": "z In bowl B, do not add any yeast, so that we can compare the results of the two bowls."
        },
        {
          "type": "text",
          "bbox": [
            0.274,
            0.865,
            0.882,
            0.904
          ],
          "content": "z Knead the flour of the two bowls with warm water to make soft dough (Fig. 2.11)."
