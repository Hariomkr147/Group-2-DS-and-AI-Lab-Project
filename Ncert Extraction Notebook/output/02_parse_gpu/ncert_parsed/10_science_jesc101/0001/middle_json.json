        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.146,
            0.627,
            0.396,
            0.689
          ],
          "content": [
            {
              "type": "text",
              "content": "CAUTION: This Activity needs the teacher’s assistance. It would be better if students wear suitable eyeglasses.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.125,
            0.689,
            0.396,
            0.733
          ],
          "content": [
            {
              "type": "text",
              "content": "Clean a magnesium ribbon about 3-4 cm long by rubbing it with sandpaper.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.124,
            0.734,
            0.396,
            0.855
          ],
          "content": [
            {
              "type": "text",
              "content": "Hold it with a pair of tongs. Burn it using a spirit lamp or burner and collect the ash so formed in a watch-glass as shown in Fig. 1.1. Burn the magnesium ribbon keeping it away as far as possible from your eyes.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.126,
            0.855,
            0.339,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "What do you observe?",
              "styles": [
                "bold"
              ]
            }
          ]
