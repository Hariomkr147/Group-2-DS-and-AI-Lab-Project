                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{NaOH}+\\mathrm{H}_{2}\\mathrm{SO}_{4}\\rightarrow\\mathrm{Na}_{2}\\mathrm{SO}_{4}+\\mathrm{H}_{2}\\mathrm{O}"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.174,
            0.502,
            0.504,
            0.523
          ],
          "content": [
            {
              "type": "text",
              "content": "(c)",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{NaCl+AgNO_{3}\\rightarrow AgCl+NaNO_{3}}"
