            0.179,
            0.639,
            0.2
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Hydrogen gas and iron chloride are produced.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.172,
            0.2,
