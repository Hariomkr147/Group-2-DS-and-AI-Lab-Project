        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.529,
            0.581,
            0.686,
            0.604
          ],
          "level": 2,
          "content": "Activity 1.9"
        },
        {
          "type": "text",
          "bbox": [
            0.513,
            0.615,
            0.875,
            0.645
          ],
          "content": "**Take three iron nails and clean them by rubbing with sand paper.**"
        },
        {
          "type": "text",
          "bbox": [
            0.514,
            0.645,
            0.876,
            0.689
          ],
          "content": "**Take two test tubes marked as (A) and (B). In each test tube, take about 10 mL copper sulphate solution.**"
        },
        {
          "type": "text",
          "bbox": [
            0.513,
            0.689,
            0.876,
            0.762
          ],
          "content": "**Tie two iron nails with a thread and immerse them carefully in the copper sulphate solution in test tube B for about 20 minutes [Fig. 1.8 (a)]. Keep one iron nail aside for comparison.**"
        },
        {
          "type": "text",
          "bbox": [
            0.514,
            0.762,
            0.875,
            0.791
          ],
          "content": "**After 20 minutes, take out the iron nails from the copper sulphate solution.**"
        },
        {
          "type": "text",
          "bbox": [
            0.514,
            0.791,
            0.876,
            0.834
          ],
          "content": "**Compare the intensity of the blue colour of copper sulphate solutions in test tubes (A) and (B) [Fig. 1.8 (b)].**"
        },
        {
          "type": "text",
          "bbox": [
            0.514,
            0.834,
            0.875,
            0.879
          ],
          "content": "**Also, compare the colour of the iron nails dipped in the copper sulphate solution with the one kept aside [Fig. 1.8 (b)].**"
        },
