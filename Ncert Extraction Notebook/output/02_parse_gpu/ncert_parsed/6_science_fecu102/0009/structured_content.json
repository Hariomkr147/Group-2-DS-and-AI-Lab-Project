            0.669
          ],
          "content": "",
          "captions": [],
          "footnotes": [
            {
              "bbox": [
                0.358,
                0.681,
                0.524,
                0.715
              ],
              "content": "(b) Banana leaf with parallel venation"
            }
          ],
          "image_source": "images/page_8_image_10.jpg"
        },
        {
          "type": "image",
          "bbox": [
            0.611,
            0.573,
            0.742,
            0.671
          ],
          "content": "",
          "captions": [],
