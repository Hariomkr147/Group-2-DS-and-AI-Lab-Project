            0.336,
            0.836,
            0.809,
            0.857
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) All the pins will fall almost at the same time"
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.337,
            0.857,
            0.843,
            0.877
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Pins I and II will fall earlier than pins III and IV"
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.338,
