            0.655,
            0.785,
            0.675
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Both A and B are good conductors of heat"
            }
          ]
        },
        {
          "type": "image",
          "index": 18,
          "bbox": [
            0.066,
            0.743,
