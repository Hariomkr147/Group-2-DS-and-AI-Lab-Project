              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 7.5(a): Initial set-up for demonstration"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 4,
          "bbox": [
            0.046,
            0.292,
            0.277,
            0.456
          ],
          "content": [
            {
              "type": "image_body",
