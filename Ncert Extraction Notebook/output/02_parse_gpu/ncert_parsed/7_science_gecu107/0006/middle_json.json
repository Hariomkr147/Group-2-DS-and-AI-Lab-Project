              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 7.6: Measurement of the temperature of soil and water"
                }
              ]
            },
            {
              "type": "image_body",
              "index": 18,
              "bbox": [
                0.032,
                0.923,
                0.273,
                0.985
              ],
              "image_path": "images/page_5_image_18.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.356,
            0.761,
            0.831,
            0.781
          ],
          "content": [
            {
              "type": "text",
              "content": "Take two identical bowls as shown in Fig. 7.6."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.357,
            0.782,
            0.883,
            0.82
          ],
          "content": [
            {
              "type": "text",
              "content": "Fill one bowl halfway with soil and the other bowl halfway with water."
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.357,
            0.822,
            0.883,
            0.897
          ],
          "content": [
            {
              "type": "text",
              "content": "Fix a laboratory thermometer in each bowl as shown in Fig. 7.6. Make sure that the bulbs of the thermometer are immersed in soil and water, and do not touch the bottoms or the sides of the bowls."
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.358,
            0.898,
            0.658,
            0.918
          ],
          "content": [
            {
              "type": "text",
              "content": "Place the set-up in sunlight."
            }
          ]
        },
