              "bbox": [
                0.095,
                0.649,
                0.399,
                0.667
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 7.1: Heat transfer in a metal strip"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.443,
            0.435,
            0.883,
            0.474
          ],
          "content": [
            {
              "type": "text",
              "content": "Take a strip of a metal, such as aluminium or iron, about 15 cm long."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.444,
            0.478,
            0.884,
            0.553
          ],
          "content": [
            {
              "type": "text",
              "content": "Attach four pins to the strip with the help of wax such that they are arranged at nearly equal distances (about 2 cm apart), as shown in Fig. 7.1."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.444,
            0.557,
            0.884,
            0.633
          ],
          "content": [
            {
              "type": "text",
              "content": "Secure the strip to a stand and label the pins as I, II, III, and IV, as shown in Fig. 7.1. (If a stand is not available, place the strip between two bricks for support.)"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.444,
            0.636,
            0.883,
            0.676
          ],
          "content": [
            {
              "type": "text",
              "content": "Heat the end of the strip that is away from the stand with a candle or a spirit lamp."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.267,
            0.68,
            0.882,
            0.719
          ],
          "content": [
            {
              "type": "text",
              "content": "What will happen to the pins? Will they remain attached to the strip or will they fall?"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.267,
            0.723,
            0.868,
            0.744
          ],
          "content": [
            {
              "type": "text",
              "content": "Predict",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the order in which the pins will fall from the strip."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.265,
            0.747,
            0.678,
            0.768
          ],
          "content": [
            {
              "type": "text",
              "content": "Record",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " your observations in Table 7.1."
            }
          ]
        },
