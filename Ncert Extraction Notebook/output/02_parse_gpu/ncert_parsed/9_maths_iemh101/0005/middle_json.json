        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.127,
            0.529,
            0.885,
            0.59
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) If "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { D _ { 1 } R _ { 1 } }"
            },
            {
              "type": "text",
              "content": " represents the door to Reiaan’s room, how far is the door from the left wall (the y-axis) of the room? How far is the door from the x-axis?"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.12,
            0.594,
            0.517,
            0.617
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) What are the coordinates of "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbb { D } _ { 1 } \\mathbb { ? }"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.114,
            0.618,
            0.885,
            0.681
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) If "
            },
