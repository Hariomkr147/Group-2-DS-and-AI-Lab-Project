          "content": [
            {
              "type": "text",
              "content": "We similarly find the distances DM and MA:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.353,
            0.477,
            0.649,
            0.502
          ],
          "image_path": "images/page_9_equation_5.jpg",
          "content": "DM  = \\sqrt{2^2 + 5^2} = \\sqrt{29}   units"
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.351,
            0.512,
            0.65,
            0.539
          ],
          "image_path": "images/page_9_equation_6.jpg",
          "content": "\\mathrm{MA} = \\sqrt{6^{2} + 2^{2}} = \\sqrt{40}   units."
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.145,
            0.552,
            0.886,
            0.575
          ],
          "content": [
            {
              "type": "text",
              "content": "In general, the distance between the points "
            },
            {
              "type": "equation_inline",
              "content": "( \\bar { x } _ { 1 } , y _ { 1 } )"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "( x _ { 2 } , y _ { 2 } )"
            },
            {
              "type": "text",
              "content": " is given by"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.375,
            0.579,
            0.621,
            0.608
          ],
          "image_path": "images/page_9_equation_8.jpg",
          "content": "\\sqrt{ \\left( x_{2} - x_{1} \\right)^{2} + \\left( y_{2} - y_{1} \\right)^{2} }"
        },
        {
          "type": "text",
          "index": 9,
