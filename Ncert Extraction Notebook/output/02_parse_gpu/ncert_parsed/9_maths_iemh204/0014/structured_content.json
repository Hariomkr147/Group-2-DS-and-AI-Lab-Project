            0.089
          ],
          "content": "Ganita Manjari | Grade 9 | Part II"
        },
        {
          "type": "image",
          "bbox": [
            0.14,
            0.124,
            0.462,
            0.28
          ],
          "content": "",
          "captions": [
            {
              "bbox": [
