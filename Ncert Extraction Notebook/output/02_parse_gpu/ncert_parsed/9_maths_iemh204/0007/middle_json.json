        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.115,
            0.736,
            0.881,
            0.794
          ],
          "content": [
            {
              "type": "text",
              "content": "Proof of (a):",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In the parallelogram ABCD, AC is a transversal for AB ‖DC and also for AD ‖BC. So we get "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta  ACD \\cong \\Delta  CAB"
            },
            {
              "type": "text",
              "content": " by the ASA test. Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AB} = \\mathrm{DC}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A D } = \\mathrm { B C }"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.115,
            0.794,
            0.882,
            0.872
          ],
          "content": [
            {
              "type": "text",
              "content": "Proof of (b):",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " BC ‖AD with AB a transversal. Therefore "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{A} + \\angle \\mathrm{B} = 180^{\\circ}"
            },
            {
              "type": "text",
              "content": " as they are interior angles on the same side of this transversal. By similar reasoning, any two adjacent angles add up to "
            },
            {
              "type": "equation_inline",
              "content": "1 8 0 ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " . By using algebra, "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{A} = \\angle \\mathrm{C}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{B} = \\angle \\mathrm{D}"
            }
          ]
        }
