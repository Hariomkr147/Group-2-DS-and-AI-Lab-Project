          ],
          "level": 2,
          "content": "Activity 8.5: Let us experiment (Demonstration activity)"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.137,
            0.623,
            0.271,
            0.644
          ],
          "level": 2,
          "content": "Safety firstS"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.655,
            0.732,
            0.708
          ],
          "content": "This activity may be demonstrated under the supervision of the teacher. It may be performed in a fume hood or a well-ventilated area. Do not inhale the gases."
        },
        {
          "type": "image",
          "bbox": [
            0.735,
