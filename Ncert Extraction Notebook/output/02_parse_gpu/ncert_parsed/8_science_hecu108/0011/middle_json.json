              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.582,
            0.192,
            0.883,
            0.285
          ],
          "content": [
            {
              "type": "text",
              "content": "Take half of Sample A in a china dish and gently heat it (Fig. 8.15a) with continuous stirring until a black mass is formed."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.583,
            0.287,
            0.882,
            0.324
          ],
          "content": [
            {
              "type": "text",
              "content": "Let the content of the china dish cool."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.583,
            0.327,
            0.883,
            0.383
          ],
          "content": [
            {
              "type": "text",
              "content": "Place this black mass in a mortar and grind it with the help of a pestle."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.583,
            0.384,
            0.883,
            0.441
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, put it on another watch glass and label it as Sample B (Fig. 8.15b)."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.272,
            0.441,
            0.884,
            0.499
          ],
          "content": [
            {
              "type": "text",
              "content": "z Now, you have two samples— Sample A and Sample B (Fig. 8.16a and 8.16b). "
            },
            {
              "type": "text",
              "content": "Compare",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " both the Samples A and B step by step and "
            },
            {
              "type": "text",
              "content": "record",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " your observations in Table 8.2."
            }
          ]
        },
