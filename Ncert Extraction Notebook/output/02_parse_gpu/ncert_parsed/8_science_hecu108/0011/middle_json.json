            0.702
          ],
          "content": [
            {
              "type": "text",
              "content": "Compare the appearance of Sample A and Sample B like colour and texture."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 27,
          "bbox": [
            0.256,
