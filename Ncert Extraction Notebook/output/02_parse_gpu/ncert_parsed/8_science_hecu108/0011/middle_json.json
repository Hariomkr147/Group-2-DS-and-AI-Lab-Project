          "bbox": [
            0.318,
            0.083,
            0.883,
            0.122
          ],
          "content": [
            {
              "type": "text",
              "content": "Mix them thoroughly in a watch glass. Label this mixture as Sample A (Fig. 8.14)."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.319,
            0.126,
            0.542,
            0.146
          ],
          "content": [
            {
              "type": "text",
              "content": "z Observe it carefully."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.318,
            0.149,
            0.882,
            0.189
          ],
          "content": [
            {
              "type": "text",
              "content": "z Is this a uniform or a non-uniform mixture? Can you still observe both iron and sulfur as separate substances?"
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
