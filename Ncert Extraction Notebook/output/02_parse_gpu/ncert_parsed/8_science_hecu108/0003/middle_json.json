            0.482,
            0.804,
            0.882,
            0.842
          ],
          "content": [
            {
              "type": "text",
              "content": "Add a small amount of calcium oxide (quick lime) slowly to it."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.483,
            0.843,
            0.728,
            0.861
          ],
          "content": [
            {
              "type": "text",
              "content": "z What do you observe?"
            }
          ]
        },
        {
