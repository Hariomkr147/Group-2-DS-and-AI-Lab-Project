          ],
          "level": 2,
          "content": "A step furtheA step further"
        },
        {
          "type": "text",
          "bbox": [
            0.257,
            0.12,
            0.875,
            0.175
          ],
          "content": "More than 45 different elements, like aluminium, copper, silicon, cobalt, lithium, gold, silver, etc., are used in manufacturing a mobile phone, including its screen, battery, and other components."
        },
        {
          "type": "image",
          "bbox": [
            0.054,
            0.192,
            0.328,
            0.302
          ],
          "content": "",
          "captions": [
            {
              "bbox": [
