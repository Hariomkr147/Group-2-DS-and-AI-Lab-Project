        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.387,
            0.464,
            0.78,
            0.52
          ],
          "content": [
            {
              "type": "text",
              "content": "These gases are not water vapour otherwise they would have condensed back to form "
            },
            {
              "type": "text",
              "content": "water. Let us try to identify these gases.",
              "styles": [
                "underline"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 17,
          "bbox": [
            0.392,
            0.53,
            0.485,
            0.611
          ],
          "content": [
            {
              "type": "image_body",
