          "content": [
            {
              "type": "text",
              "content": "Use of elements, compounds, and mixtures in Indian Art",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.13,
