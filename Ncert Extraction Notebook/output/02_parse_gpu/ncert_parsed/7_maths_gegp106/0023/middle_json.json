            0.927,
            0.447
          ],
          "content": [
            {
              "type": "text",
              "content": "The parity of the number of small squares in a grid (with m rows and n columns) is:"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.163,
            0.457,
            0.778,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Even, if at least one of the numbers (either m or n) is even."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.163,
            0.477,
            0.606,
            0.495
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Odd, if both numbers (m and n) are odd."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.163,
            0.496,
            0.623,
            0.515
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Even, if both numbers (m and n) are even."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.116,
            0.554,
