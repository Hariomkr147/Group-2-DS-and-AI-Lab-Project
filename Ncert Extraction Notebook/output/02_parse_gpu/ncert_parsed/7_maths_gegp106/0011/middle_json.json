            0.594
          ],
          "content": [
            {
              "type": "text",
              "content": "The First-ever 4 × 4 Magic Square"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.149,
            0.604,
            0.847,
            0.661
          ],
          "content": [
            {
              "type": "text",
              "content": "The first ever recorded 4 × 4 magic square is found in a 10th century inscription at the Pārśhvanath Jain temple in Khajuraho, India, and is known as the Chautīsā Yantra."
            }
          ]
        },
        {
