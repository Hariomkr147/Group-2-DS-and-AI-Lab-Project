          "bbox": [
            0.144,
            0.852,
            0.234,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "Do you know?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.271,
            0.82,
            0.778,
