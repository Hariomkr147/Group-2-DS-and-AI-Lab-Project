              "content": ""
            },
            {
              "type": "image_caption",
              "index": 12,
              "bbox": [
                0.232,
                0.588,
                0.525,
                0.607
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 7.2: Heads and tails of a coin"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.695,
            0.464,
            0.821,
            0.576
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
              "bbox": [
                0.695,
                0.464,
                0.821,
                0.576
              ],
              "image_path": "images/page_5_image_13.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 14,
              "bbox": [
                0.662,
                0.588,
                0.857,
                0.607
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 7.3: A 6-sided die"
                }
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.15,
            0.615,
            0.817,
            0.659
          ],
          "image_path": "images/page_5_equation_15.jpg",
          "content": "\\mathrm{Exprimental} \\mathrm{Probability} = \\frac{\\mathrm{Number of times the event occurred}}{\\mathrm{Total Number of trials}}"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.114,
            0.668,
            0.886,
            0.707
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Suppose you roll a die 50 times, and it lands on a 4 exactly 8 times."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.149,
            0.708,
            0.789,
            0.748
          ],
          "content": [
            {
              "type": "text",
              "content": "Experimental probability of rolling a 4 is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 8 } { 5 0 }   =   0 . 1 6"
            },
            {
              "type": "text",
              "content": " % 1 or 6 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.15,
            0.756,
            0.863,
            0.795
          ],
          "content": [
            {
              "type": "text",
              "content": "We also say that the "
            },
            {
              "type": "text",
              "content": "relative frequency",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " of rolling a 4 is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 8 } { 5 0 }   =   0 . 1 6"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.112,
            0.796,
            0.886,
            0.875
          ],
          "content": [
            {
              "type": "text",
              "content": "Relative frequency helps you understand probability based on actual data, rather than theoretical predictions. It is especially useful in statistics and data analysis when you are working with observed outcomes."
            }
          ]
        }
      ]
    }
