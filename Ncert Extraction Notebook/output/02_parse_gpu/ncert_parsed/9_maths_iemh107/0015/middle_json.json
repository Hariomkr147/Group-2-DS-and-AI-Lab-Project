          ],
          "content": [
            {
              "type": "text",
              "content": "Also, the theoretical probabilities of each outcome are mentioned on the branch representing that outcome."
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.15,
            0.159,
            0.852,
            0.209
          ],
          "image_path": "images/page_14_equation_3.jpg",
          "content": "\\mathrm{Thecritical probability}(\\mathrm{P}) = \\frac{\\text { Number of favorable outcomes }}{\\text { Number of possible outcomes }}"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.112,
            0.223,
            0.885,
            0.262
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us consider the event of getting Heads twice. This is represented by the outcome HH."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.149,
