            0.098,
            0.394,
            0.634,
            0.411
          ],
          "content": [
            {
              "type": "text",
              "content": "a cell is kept in salt or sugar solutions of different concentrations?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.104,
            0.421,
            0.492,
            0.47
          ],
          "content": [
            {
              "type": "text",
              "content": "Solute concentration of extracellular medium = Solute concentration of intracellular medium — Isotonic solution"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.104,
            0.494,
            0.492,
            0.544
          ],
          "content": [
            {
              "type": "text",
              "content": "Solute concentration of extracellular medium < Solute concentration of intracellular medium — Hypotonic solution"
            }
          ]
        },
        {
          "type": "image",
          "index": 10,
          "bbox": [
            0.096,
            0.392,
            0.874,
            0.656
          ],
