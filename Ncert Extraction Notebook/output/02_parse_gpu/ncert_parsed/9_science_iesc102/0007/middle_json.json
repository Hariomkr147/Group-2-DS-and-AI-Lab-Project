            0.41,
            0.709,
            0.428
          ],
          "content": [
            {
              "type": "text",
              "content": "You have learnt that most cells have three basic parts:"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.232,
            0.431,
            0.882,
            0.465
          ],
          "content": [
            {
              "type": "text",
              "content": "y a selectively permeable membrane called the plasma Chapter 9 membrane,"
            }
          ]
        },
        {
          "type": "text",
