                0.062,
                0.628,
                0.202,
                0.657
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 2.12: From cell to DNA"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.242,
            0.254,
            0.521,
            0.452
          ],
          "content": [
            {
