            0.528
          ],
          "content": [
            {
              "type": "text",
              "content": "Meet a Scientist"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 16,
          "bbox": [
            0.652,
            0.542,
            0.762,
