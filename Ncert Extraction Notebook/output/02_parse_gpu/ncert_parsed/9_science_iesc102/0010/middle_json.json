              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 2.13: Endoplasmic reticulum and Golgi apparatus — pathway for protein processing and secretion"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 15,
          "bbox": [
            0.652,
