            {
              "type": "equation_inline",
              "content": "( ^ { \\circ } \\mathbb { C } )"
            },
            {
              "type": "text",
              "content": " . The thermometers below are showing "
            },
            {
              "type": "equation_inline",
              "content": "4 0 ^ { \\circ } \\mathbb { C }"
            },
            {
              "type": "text",
