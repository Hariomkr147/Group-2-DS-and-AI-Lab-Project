          "bbox": [
            0.113,
            0.384,
            0.832,
            0.426
          ],
          "content": [
            {
              "type": "text",
              "content": "You must move 6 steps backward, i.e., you must move –6. Hence, we write 9 + (–6) = 3."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.144,
            0.437,
            0.833,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "(Remember again : "
            },
            {
              "type": "text",
              "content": "Starting Number + Movement = Target Number",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": ")"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.143,
            0.489,
            0.705,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "The corresponding subtraction statement is 3–9=–6."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.145,
