            0.181,
            0.692,
            0.202
          ],
          "content": [
            {
              "type": "text",
              "content": "The corresponding subtraction statement is 9 – 5 = 4."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.144,
            0.212,
            0.833,
            0.255
          ],
          "content": [
            {
              "type": "text",
              "content": "(Remember: "
            },
            {
              "type": "text",
              "content": "Target Number – Starting Number = Movement needed",
              "styles": [
                "bold"
              ]
            },
