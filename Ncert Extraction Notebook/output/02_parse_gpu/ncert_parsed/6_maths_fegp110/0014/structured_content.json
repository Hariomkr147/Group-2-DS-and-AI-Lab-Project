            0.164
          ],
          "content": "a. – 125 + (– 30) = \\_\\_\\_\\_\\_\\_"
        },
        {
          "type": "text",
          "bbox": [
            0.157,
            0.166,
            0.427,
            0.187
          ],
          "content": "b. +105 – (–55) = \\_"
        },
        {
          "type": "text",
          "bbox": [
            0.158,
            0.19,
            0.425,
            0.209
          ],
          "content": "c. +80 – (–150) ="
        },
        {
          "type": "text",
          "bbox": [
            0.158,
            0.212,
            0.425,
            0.233
          ],
          "content": "d. –99 – (–200) = \\_\\_"
        },
        {
          "type": "image",
          "bbox": [
            0.576,
            0.147,
            0.831,
            0.242
          ],
          "content": "",
          "captions": [],
