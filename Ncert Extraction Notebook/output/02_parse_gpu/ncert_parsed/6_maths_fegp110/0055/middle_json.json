          ],
          "content": [
            {
              "type": "text",
              "content": "Q.2 Give three numbers such that their sum is –8.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.117,
            0.471,
            0.456,
            0.488
          ],
          "content": [
            {
              "type": "text",
              "content": "Ans. One of the combinations is -5,7,-10."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.164,
            0.498,
            0.405,
            0.515
          ],
          "content": [
            {
              "type": "text",
              "content": "Think of other combinations."
            }
