            },
            {
              "type": "image_footnote",
              "index": 17,
              "bbox": [
                0.608,
                0.637,
                0.762,
                0.656
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(+ 5) – (+ 4) = + 1"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.113,
            0.64,
            0.514,
            0.685
          ],
          "content": [
            {
              "type": "text",
              "content": "This is easy to do. From 5 positives take away 4 positives to see the result."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.113,
            0.697,
            0.395,
            0.74
          ],
          "content": [
            {
              "type": "text",
              "content": "Example:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us subtract: (–7) – (–5)."
