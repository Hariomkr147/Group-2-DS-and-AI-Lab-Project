        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.112,
            0.504,
            0.834,
            0.569
          ],
          "content": [
            {
              "type": "text",
              "content": "We have seen how to perform addition of integers with positive tokens and negative tokens. We can also perform subtraction using tokens!"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.113,
            0.584,
            0.395,
            0.626
          ],
          "content": [
            {
              "type": "text",
              "content": "Example:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us subtract: (+5) – (+4)."
            }
          ]
        },
        {
          "type": "image",
          "index": 15,
          "bbox": [
            0.575,
            0.589,
            0.828,
            0.631
          ],
          "content": [
            {
              "type": "image_body",
