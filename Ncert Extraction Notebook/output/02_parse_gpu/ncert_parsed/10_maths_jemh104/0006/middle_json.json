  "pages": [
    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "header",
          "index": 0,
          "bbox": [
            0.099,
            0.104,
            0.287,
            0.121
          ],
          "content": [
            {
              "type": "text",
              "content": "QUADRATIC EQUATIONS"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.872,
            0.105,
            0.899,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "43"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.096,
            0.138,
            0.902,
            0.177
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that we have found the roots of "
            },
            {
              "type": "equation_inline",
              "content": "2x^{2} - 5x + 3 = 0"
            },
            {
              "type": "text",
              "content": " by factorising "
            },
            {
              "type": "equation_inline",
              "content": "2 x ^ { 2 } - 5 x + 3"
            },
            {
              "type": "text",
              "content": " into two linear factors and equating each factor to zero."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.096,
            0.196,
            0.759,
            0.216
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 4 : Find the roots of the quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "6x^{2}-x-2=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.096,
            0.222,
            0.297,
            0.239
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution : We have"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.29,
            0.247,
            0.654,
            0.317
          ],
          "image_path": "images/page_5_equation_5.jpg",
          "content": "\\begin{aligned}6x^{2}-x-2&=6x^{2}+3x-4x-2\\\\&=3x\\left(2x+1\\right)-2\\left(2x+1\\right)\\\\&=(3x-2)(2x+1)\\end{aligned}"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.096,
            0.322,
            0.846,
            0.367
          ],
          "content": [
            {
              "type": "text",
              "content": "The roots of "
            },
            {
              "type": "equation_inline",
              "content": "6x^{2}-x-2=0"
            },
            {
              "type": "text",
              "content": " are the values of x for which "
            },
            {
              "type": "equation_inline",
              "content": "(3x - 2)(2x + 1) = 0"
            },
            {
              "type": "text",
              "content": " Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "3x - 2 = 0"
            },
            {
              "type": "text",
              "content": " or "
            },
            {
              "type": "equation_inline",
              "content": "2 x + 1 = 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.096,
            0.394,
            0.139,
            0.412
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.348,
            0.378,
            0.567,
            0.422
          ],
          "image_path": "images/page_5_equation_8.jpg",
          "content": "x = { \\frac { \\stackrel { \\cdot } { 2 } } { 3 } } \\quad { \\mathrm { o r } } \\quad x = - { \\frac { 1 } { 2 } }"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.096,
            0.432,
            0.627,
            0.473
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the roots of "
            },
            {
              "type": "equation_inline",
              "content": "6x^{2}-x-2=0\\  are \\ \\frac{2}{3}\\  and \\ -\\frac{1}{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.148,
            0.483,
            0.845,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "We verify the roots, by checking that "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{2}{3}"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "-\\frac{1}{2}"
            },
            {
              "type": "text",
              "content": " satisfy "
            },
            {
              "type": "equation_inline",
              "content": "6x^{2}-x-2=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.096,
            0.535,
            0.798,
            0.555
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5 : Find the roots of the quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "3x^{2}-2\\sqrt{6}x+2=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.096,
            0.571,
            0.711,
            0.672
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{aligned}\\sqrt{3}x^{2}-2\\sqrt{6}x+2&=3x^{2}-\\sqrt{6}x-\\sqrt{6}x+2\\\\&=\\sqrt{3}x\\left(\\sqrt{3}x-\\sqrt{2}\\right)-\\sqrt{2}\\left(\\sqrt{3}x-\\sqrt{2}\\right)\\\\&=\\left(\\sqrt{3}x-\\sqrt{2}\\right)\\left(\\sqrt{3}x-\\sqrt{2}\\right)\\end{aligned}"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.097,
            0.687,
            0.65,
            0.706
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm { S o } ,"
            },
            {
              "type": "text",
              "content": " , the roots of the equation are the values of x for which"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.298,
            0.719,
            0.578,
            0.749
          ],
          "image_path": "images/page_5_equation_14.jpg",
          "content": "\\left( \\sqrt{3}   x - \\sqrt{2} \\right) \\left( \\sqrt{3}   x - \\sqrt{2} \\right) = 0"
        },
        {
          "type": "footer",
          "index": 15,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.097,
            0.759,
            0.415,
            0.804
          ],
          "content": [
            {
              "type": "text",
              "content": "Now, "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt{3}x - \\sqrt{2} = 0"
            },
            {
              "type": "text",
              "content": " for "
            },
            {
              "type": "equation_inline",
              "content": "x   =   { \\sqrt { \\frac { 2 } { 3 } } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.096,
            0.815,
            0.775,
            0.838
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm { S o } ,"
            },
            {
              "type": "text",
              "content": " this root is repeated twice, one for each repeated factor "
            },
            {
              "type": "equation_inline",
              "content": "{ \\sqrt { 3 } } x   -   { \\sqrt { 2 } }"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.096,
            0.852,
            0.652,
            0.898
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the roots of "
            },
            {
              "type": "equation_inline",
              "content": "3x^{2}-2\\sqrt{6}x+2=0"
            },
            {
              "type": "text",
              "content": " are "
            },
            {
              "type": "equation_inline",
              "content": "\\left[ \\sqrt{\\frac{2}{3}}   ,   \\sqrt{\\frac{2}{3}} \\right]"
            }
          ]
        }
      ]
    }
  ],
