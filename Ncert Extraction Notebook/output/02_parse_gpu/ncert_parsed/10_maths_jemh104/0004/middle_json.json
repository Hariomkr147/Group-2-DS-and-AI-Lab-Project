          ],
          "content": [
            {
              "type": "text",
              "content": "41"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.097,
            0.138,
            0.702,
            0.157
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Since "
            },
            {
              "type": "equation_inline",
              "content": "x(x + 1) + 8 = x^2 + x + 8 \\mathrm{and} (x + 2)(x - 2) = x^2 - 4"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.149,
            0.162,
            0.257,
            0.181
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.37,
            0.162,
            0.559,
            0.181
          ],
          "image_path": "images/page_3_equation_4.jpg",
          "content": "x^{2}+x+8=x^{2}-4"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.148,
            0.186,
            0.518,
            0.205
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., x + 12 = 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.148,
            0.21,
            0.512,
            0.228
          ],
          "content": [
            {
              "type": "text",
              "content": "It is not of the form "
            },
            {
              "type": "equation_inline",
              "content": "a x ^ { 2 } + b x + c = 0 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.147,
            0.234,
            0.695,
            0.253
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the given equation is not a quadratic equation."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 8,
          "bbox": [
            0.098,
            0.257,
            0.206,
            0.276
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Here,"
            }
          ],
          "level": 2
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.294,
            0.257,
            0.576,
            0.275
          ],
          "image_path": "images/page_3_equation_9.jpg",
          "content": "LHS =x\\left(2x+3\\right)=2x^{2}+3x"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.145,
            0.281,
            0.183,
            0.298
          ],
          "content": [
            {
              "type": "text",
              "content": "So,"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.362,
            0.281,
            0.741,
            0.299
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "x \\left( 2x + 3 \\right) = x^{2} + 1"
            },
            {
              "type": "text",
              "content": " can be rewritten as"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.378,
            0.304,
            0.55,
            0.322
          ],
          "image_path": "images/page_3_equation_12.jpg",
          "content": "2x^{2} + 3x = x^{2} + 1"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.144,
            0.328,
            0.509,
            0.346
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, we get "
            },
            {
              "type": "equation_inline",
              "content": "x^{2} + 3x - 1 = 0"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.145,
            0.352,
            0.471,
            0.37
          ],
          "content": [
            {
              "type": "text",
              "content": "It is of the form "
            },
            {
              "type": "equation_inline",
              "content": "a x ^ { 2 } + b x + c = 0 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.144,
            0.375,
            0.585,
            0.395
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the given equation is a quadratic equation."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 16,
          "bbox": [
            0.098,
            0.399,
            0.208,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) Here,"
            }
          ],
          "level": 2
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.313,
            0.399,
            0.669,
            0.417
          ],
          "image_path": "images/page_3_equation_17.jpg",
          "content": "\\mathrm{LHS} = (x + 2)^3 = x^3 + 6x^2 + 12x + 8"
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.147,
            0.423,
            0.749,
            0.442
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "(x + 2)^{3} = x^{3} - 4"
            },
            {
              "type": "text",
              "content": " can be rewritten as"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.292,
            0.446,
            0.565,
            0.465
          ],
          "image_path": "images/page_3_equation_19.jpg",
          "content": "x^{3}+6x^{2}+12x+8=x^{3}-4"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.148,
            0.471,
            0.191,
            0.488
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 21,
          "bbox": [
            0.326,
            0.469,
            0.726,
            0.488
          ],
          "image_path": "images/page_3_equation_21.jpg",
          "content": "6x^{2}+12x+12=0\\quad or \\quad x^{2}+2x+2=0"
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.147,
            0.494,
            0.475,
            0.513
          ],
          "content": [
            {
              "type": "text",
              "content": "It is of the form "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0."
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.147,
            0.518,
            0.59,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "So, the given equation is a quadratic equation."
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.095,
            0.542,
            0.899,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "equation, but it is not a quadratic equation."
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.095,
            0.585,
            0.901,
            0.662
          ],
          "content": [
            {
              "type": "text",
              "content": "In (iv) above, the given equation appears to be a cubic equation (an equation of degree 3) and not a quadratic equation. But it turns out to be a quadratic equation. As is quadratic or not."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 26,
          "bbox": [
            0.409,
            0.687,
            0.588,
            0.706
          ],
          "content": [
            {
              "type": "text",
              "content": "EXERCISE 4.1"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.123,
            0.717,
            0.627,
            0.735
          ],
          "content": [
            {
              "type": "text",
              "content": "1.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Check whether the following are quadratic equations :"
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.171,
            0.74,
            0.354,
            0.758
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "(x + 1)^{2} \\equiv 2(x - 3)"
            }
          ]
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.542,
            0.741,
            0.752,
            0.758
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}-2x=(-2)(3-x)"
            }
          ]
        },
        {
          "type": "footer",
          "index": 30,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.162,
            0.764,
            0.446,
            0.782
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "(x - 2)(x + 1) = (x - 1)(x + 3)"
            }
          ]
        },
        {
          "type": "text",
          "index": 32,
          "bbox": [
            0.536,
            0.765,
            0.775,
            0.782
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) "
            },
            {
              "type": "equation_inline",
              "content": "(x - 3)(2x + 1) = x(x + 5)"
            }
          ]
        },
        {
          "type": "text",
          "index": 33,
          "bbox": [
            0.164,
            0.788,
            0.455,
            0.805
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) "
            },
            {
              "type": "equation_inline",
              "content": "(2x - 1)(x - 3) = (x + 5)(x - 1)"
            }
          ]
        },
        {
          "type": "text",
          "index": 34,
          "bbox": [
            0.536,
            0.787,
            0.752,
            0.805
          ],
          "content": [
            {
              "type": "text",
              "content": "(vi) "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}+3x+1=(x-2)^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 35,
          "bbox": [
            0.156,
            0.811,
            0.375,
            0.828
          ],
          "content": [
            {
              "type": "text",
              "content": "(vii) "
            },
            {
              "type": "equation_inline",
              "content": "(x + 2)^{3} = 2x(x^{2} - 1)"
            }
          ]
        },
        {
          "type": "text",
          "index": 36,
          "bbox": [
            0.527,
            0.811,
            0.788,
            0.828
          ],
          "content": [
            {
              "type": "text",
              "content": "(viii) "
            },
            {
              "type": "equation_inline",
              "content": "x^{3}-4x^{2}-x+1=(x-2)^{3}"
            }
          ]
        },
        {
          "type": "text",
          "index": 37,
          "bbox": [
            0.124,
            0.834,
            0.768,
            0.852
          ],
          "content": [
            {
              "type": "text",
              "content": "2.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Represent the following situations in the form of quadratic equations :"
            }
          ]
        },
        {
          "type": "text",
          "index": 38,
          "bbox": [
            0.17,
            0.858,
            0.901,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) The area of a rectangular plot is "
            },
            {
              "type": "equation_inline",
              "content": "5 2 8 \\; \\mathrm { m } ^ { 2 } ."
            },
            {
              "type": "text",
              "content": " . The length of the plot (in metres) is one more than twice its breadth. We need to find the length and breadth of the plot."
            }
          ]
        }
