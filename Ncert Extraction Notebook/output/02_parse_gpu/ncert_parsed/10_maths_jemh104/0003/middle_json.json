          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the number of toys produced that day satisfies the quadratic equation"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.319,
            0.567,
            0.515,
            0.586
          ],
          "image_path": "images/page_2_equation_20.jpg",
          "content": "x^{2}-55x+750=0"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.147,
            0.593,
            0.791,
            0.612
          ],
          "content": [
            {
              "type": "text",
              "content": "which is the required representation of the problem mathematically."
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.096,
            0.625,
            0.742,
            0.644
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2 :",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Check whether the following are quadratic equations:"
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.239,
            0.65,
            0.474,
            0.668
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "(x - 2)^{2} \\pm \\underline{1} = 2x - 3"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.567,
            0.65,
            0.885,
            0.669
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "x(x + 1) + 8 = (x + 2)(x - 2)"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.231,
            0.682,
            0.453,
            0.702
          ],
          "image_path": "images/page_2_equation_25.jpg",
          "content": "x(2x + 3) = x^{2} + 1"
        },
        {
          "type": "equation",
          "index": 26,
          "bbox": [
            0.561,
            0.683,
            0.766,
            0.702
          ],
          "image_path": "images/page_2_equation_26.jpg",
          "content": "\\mathrm{(iv)} \\left(x + 2\\right)^{3} = x^{3} - 4"
        },
        {
          "type": "paragraph_title",
          "index": 27,
          "bbox": [
            0.097,
            0.715,
            0.205,
            0.733
          ],
          "content": [
            {
              "type": "text",
              "content": "Solution :"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.097,
            0.741,
            0.622,
            0.761
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{LHS} = (x - 2)^2 + 1 = x^2 - 4x + 4 + 1 = x^2 - 4x + 5"
            }
          ]
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.135,
            0.776,
            0.629,
            0.795
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "(x - 2)^{2} + 1 = 2x - 3"
            },
            {
              "type": "text",
              "content": " can be rewritten as"
            }
          ]
        },
        {
          "type": "equation",
          "index": 30,
          "bbox": [
            0.358,
            0.803,
            0.563,
            0.821
          ],
          "image_path": "images/page_2_equation_30.jpg",
          "content": "x^{2}-4x+5=2x-3"
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.148,
            0.83,
            0.191,
            0.847
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e.,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 32,
          "bbox": [
            0.36,
            0.828,
            0.517,
            0.846
          ],
          "image_path": "images/page_2_equation_32.jpg",
          "content": "x^{2}-6x+8=0"
        },
        {
          "type": "text",
          "index": 33,
          "bbox": [
            0.148,
            0.855,
            0.473,
            0.872
          ],
          "content": [
            {
              "type": "text",
              "content": "It is of the form "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            }
          ]
        },
        {
          "type": "footer",
          "index": 34,
          "bbox": [
            0.435,
            0.967,
            0.563,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        },
        {
          "type": "text",
          "index": 35,
          "bbox": [
            0.148,
            0.88,
            0.659,
            0.899
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the given equation is a quadratic equation."
            }
          ]
        }
      ]
