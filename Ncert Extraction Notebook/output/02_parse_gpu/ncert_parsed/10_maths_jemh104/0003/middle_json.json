            0.607,
            0.207
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, their product "
            },
            {
              "type": "equation_inline",
              "content": "= \\left( x - 5 \\right) \\left( 40 - x \\right)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "= 40x - x^{2} - 200 + 5x"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "= -x^{2} + 45x - 200"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.147,
            0.214,
            0.77,
            0.234
          ],
          "content": [
            {
              "type": "text",
              "content": "So, "
            },
            {
              "type": "equation_inline",
              "content": "-x^{2}+45x-200=124"
            },
            {
              "type": "text",
              "content": " (Given that product = 124)"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.148,
            0.239,
            0.433,
            0.258
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., "
            },
            {
              "type": "equation_inline",
              "content": "-x^{2}+45x-324=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.147,
            0.264,
            0.433,
            0.284
          ],
          "content": [
            {
              "type": "text",
              "content": "i.e., "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}-45x+324=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.147,
            0.291,
            0.868,
            0.309
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore, the number of marbles John had, satisfies the quadratic equation"
            }
          ]
        },
        {
          "type": "equation",
