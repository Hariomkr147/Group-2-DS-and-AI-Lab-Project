            {
              "type": "text",
              "content": "47"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.41,
            0.139,
            0.59,
            0.157
          ],
          "content": [
            {
              "type": "text",
              "content": "EXERCISE 4.3"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.125,
            0.168,
            0.899,
            0.203
          ],
          "content": [
            {
              "type": "text",
              "content": "1.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find the nature of the roots of the following quadratic equations. If the real roots exist, find them:"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.172,
            0.219,
            0.339,
            0.237
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "2x^{2}-3x+5=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.543,
            0.215,
            0.742,
            0.237
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "3x^{2}-4\\sqrt{3}x+4=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.162,
            0.243,
            0.338,
            0.259
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) "
            },
            {
              "type": "equation_inline",
              "content": "2x^{2}-6x+3=0"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.124,
            0.267,
            0.9,
            0.302
          ],
          "content": [
            {
              "type": "text",
              "content": "2.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Find the values of k for each of the following quadratic equations, so that they have two equal roots."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.172,
            0.309,
            0.341,
            0.326
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "2x^{2} + kx + 3 = 0"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.542,
            0.309,
            0.723,
            0.326
          ],
          "image_path": "images/page_9_equation_9.jpg",
          "content": "kx(x - 2) + 6 = 0"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.124,
            0.334,
            0.898,
            0.369
          ],
          "content": [
            {
              "type": "text",
              "content": "and the area is "
            },
            {
              "type": "equation_inline",
              "content": "8 0 0 \\: \\mathrm { m } ^ { 2 } ?"
            },
            {
              "type": "text",
              "content": " If so, find its length and breadth."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.124,
            0.375,
            0.899,
            0.431
          ],
          "content": [
            {
              "type": "text",
              "content": "4.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Is the following situation possible? If so, determine their present ages. The sum of the ages of two friends is 20 years. Four years ago, the product of their ages in years was 48."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.123,
            0.436,
            0.9,
            0.473
          ],
          "content": [
            {
              "type": "text",
              "content": "5.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Is it possible to design a rectangular park of perimeter 80 m and area 400 m"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": "? If so, find its length and breadth."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.098,
            0.491,
            0.252,
            0.511
          ],
          "content": [
            {
              "type": "text",
              "content": "4.5 Summary"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.097,
            0.516,
            0.574,
            0.534
          ],
          "content": [
            {
              "type": "text",
              "content": "In this chapter, you have studied the following points:"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.124,
            0.541,
            0.9,
            0.576
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " , where a, b, c are real numbers and "
            },
            {
              "type": "equation_inline",
              "content": "a   \\neq   0"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.124,
            0.583,
            0.902,
            0.637
          ],
          "content": [
            {
              "type": "text",
              "content": "2. A real number   is said to be a root of the quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " , if "
            },
            {
              "type": "equation_inline",
              "content": "a \\alpha ^ { 2 } + b \\alpha + c = 0"
            },
            {
              "type": "text",
              "content": " . The zeroes of the quadratic polynomial "
            },
            {
              "type": "equation_inline",
              "content": "a x ^ { 2 } + b x + c"
            },
            {
              "type": "text",
              "content": " and the roots of the quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " are the same."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.124,
            0.643,
            0.9,
            0.68
          ],
          "content": [
            {
              "type": "text",
              "content": "3.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " If we can factorise "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c,a \\ne 0"
            },
            {
              "type": "text",
              "content": " , into a product of two linear factors, then the roots of the quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " can be found by equating each factor to zero."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.124,
            0.685,
            0.899,
            0.759
          ],
          "content": [
            {
              "type": "text",
              "content": "4.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Quadratic formula: The roots of a quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " are given by "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{-b\\pm\\sqrt{b^{2}-4ac}}{2a}"
            },
            {
              "type": "text",
              "content": " , provided "
            },
            {
              "type": "equation_inline",
              "content": "b ^ { 2 }   -   4 a c   \\geq   0"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.125,
            0.766,
            0.515,
            0.784
          ],
          "content": [
            {
              "type": "text",
              "content": "5.",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A quadratic equation "
            },
            {
              "type": "equation_inline",
              "content": "ax^{2}+bx+c=0"
            },
            {
              "type": "text",
              "content": " has"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.17,
            0.791,
            0.53,
            0.807
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) two distinct real roots, if "
            },
            {
              "type": "equation_inline",
              "content": "b^{2}-4ac>0"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.166,
            0.814,
            0.708,
            0.831
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) two equal roots (i.e., coincident roots), if "
            },
            {
              "type": "equation_inline",
              "content": "b^{2}-4ac=0"
            },
            {
              "type": "text",
              "content": " , and"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.162,
            0.837,
            0.448,
            0.853
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) no real roots, if "
            },
            {
              "type": "equation_inline",
              "content": "b^{2}-4ac<0"
            }
          ]
        },
        {
          "type": "footer",
          "index": 23,
          "bbox": [
            0.436,
            0.967,
            0.562,
            0.982
          ],
          "content": [
            {
              "type": "text",
              "content": "Reprint 2026-27"
            }
          ]
        }
      ]
    }
