            0.124,
            0.332,
            0.448,
            0.361
          ],
          "content": [
            {
              "type": "text",
              "content": "Take some freshly prepared lime water in a test tube.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.124,
            0.362,
            0.431,
            0.376
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Blow air through this lime water.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.124,
            0.377,
            0.448,
            0.406
          ],
          "content": [
            {
              "type": "text",
              "content": "Note how long it takes for the lime water to turn milky.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.124,
            0.406,
            0.449,
            0.449
          ],
          "content": [
            {
              "type": "text",
              "content": "Use a syringe or pichkari to pass air through some fresh lime water taken in another test tube (Fig. 5.7).",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.124,
            0.449,
            0.448,
            0.478
          ],
          "content": [
            {
              "type": "text",
              "content": "Note how long it takes for this lime water to turn milky.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.124,
            0.478,
            0.45,
            0.522
          ],
          "content": [
            {
              "type": "text",
              "content": "What does this tell us about the amount of carbon dioxide in the air that we breathe out?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
