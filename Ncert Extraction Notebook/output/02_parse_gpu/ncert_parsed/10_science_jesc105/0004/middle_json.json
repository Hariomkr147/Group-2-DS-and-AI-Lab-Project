          "image_path": "images/page_3_equation_0.jpg",
          "content": "\\begin{aligned} &\\mathrm{6CO_{2}+12H_{2}O\\xrightarrow{Clforopallyll}C_{6}H_{12}O_{6}+6O_{2}+6H_{2}O}\\\\ &\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad \\end{aligned}"
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.275,
            0.125,
            0.901,
            0.16
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us now see what actually happens during the process of photosynthesis. The following events occur during this process –",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.079,
            0.198,
            0.457,
            0.49
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "bbox": [
                0.079,
                0.198,
                0.457,
                0.49
              ],
              "image_path": "images/page_3_image_2.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 3,
              "bbox": [
                0.074,
                0.5,
                0.246,
                0.53
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Figure 5.1 Cross-section of a leaf"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.519,
            0.174,
            0.899,
            0.206
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) Absorption of light energy by chlorophyll.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.515,
            0.206,
            0.899,
            0.253
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Conversion of light energy to chemical energy and splitting of water molecules into hydrogen and oxygen.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.51,
            0.253,
            0.899,
            0.284
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Reduction of carbon dioxide to carbohydrates.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.487,
            0.284,
            0.9,
            0.378
          ],
          "content": [
            {
              "type": "text",
              "content": "These steps need not take place one after the other immediately. For example, desert plants take up carbon dioxide at night and prepare an intermediate which is acted upon by the energy absorbed by the chlorophyll during the day.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.488,
            0.378,
            0.901,
            0.426
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us see how each of the components of the above reaction are necessary for photosynthesis.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.487,
            0.425,
            0.9,
            0.537
          ],
          "content": [
            {
              "type": "text",
              "content": "If you carefully observe a cross-section of a leaf under the microscope (shown in Fig. 5.1), you will notice that some cells contain green dots. These green dots are cell organelles called chloroplasts which contain chlorophyll. Let us do an activity which demonstrates that chlorophyll is essential for photosynthesis.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.32,
            0.557,
            0.471,
            0.58
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 5.1"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.288,
            0.591,
            0.885,
            0.622
          ],
          "content": [
            {
              "type": "text",
              "content": "Take a potted plant with variegated leaves – for example, money plant or crotons.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.078,
            0.615,
            0.159,
            0.814
          ],
          "content": [
            {
              "type": "image_body",
              "index": 12,
              "bbox": [
                0.078,
                0.615,
                0.159,
                0.814
              ],
              "image_path": "images/page_3_image_12.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 13,
              "bbox": [
                0.106,
                0.818,
                0.127,
                0.831
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(a)"
                }
              ]
            }
          ]
        },
        {
          "type": "image",
          "index": 14,
          "bbox": [
            0.198,
            0.624,
            0.282,
            0.817
          ],
          "content": [
            {
              "type": "image_body",
              "index": 14,
              "bbox": [
                0.198,
                0.624,
                0.282,
                0.817
              ],
              "image_path": "images/page_3_image_14.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 15,
              "bbox": [
                0.076,
                0.836,
                0.174,
                0.85
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Figure 5.2"
                }
              ]
            },
            {
              "type": "image_caption",
              "index": 17,
              "bbox": [
                0.22,
                0.818,
                0.24,
                0.831
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(b)"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.288,
            0.622,
            0.885,
            0.651
          ],
          "content": [
            {
              "type": "text",
              "content": "Keep the plant in a dark room for three days so that all the starch gets used up.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.076,
            0.85,
            0.265,
            0.879
          ],
          "content": [
            {
              "type": "text",
              "content": "Variegated leaf (a) before and (b) after starch test",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.289,
            0.651,
            0.744,
            0.667
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Now keep the plant in sunlight for about six hours.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.289,
            0.667,
            0.885,
            0.696
          ],
          "content": [
            {
              "type": "text",
              "content": "Pluck a leaf from the plant. Mark the green areas in it and trace them on a sheet of paper.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.289,
            0.697,
            0.703,
            0.712
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Dip the leaf in boiling water for a few minutes.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.288,
            0.712,
            0.758,
            0.727
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "After this, immerse it in a beaker containing alcohol.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.291,
            0.727,
            0.885,
            0.757
          ],
          "content": [
            {
              "type": "text",
              "content": "Carefully place the above beaker in a water-bath and heat till the alcohol begins to boil.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.289,
            0.757,
            0.885,
            0.786
          ],
          "content": [
            {
              "type": "text",
              "content": "What happens to the colour of the leaf? What is the colour of the solution?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.289,
            0.787,
            0.843,
            0.803
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Now dip the leaf in a dilute solution of iodine for a few minutes.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.289,
            0.803,
            0.734,
            0.817
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Take out the leaf and rinse off the iodine solution.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.289,
            0.818,
            0.886,
            0.849
          ],
          "content": [
            {
              "type": "text",
              "content": "Observe the colour of the leaf and compare this with the tracing of the leaf done in the beginning (Fig. 5.2).",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.288,
            0.849,
            0.886,
            0.878
          ],
          "content": [
            {
              "type": "text",
              "content": "What can you conclude about the presence of starch in various areas of the leaf?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
