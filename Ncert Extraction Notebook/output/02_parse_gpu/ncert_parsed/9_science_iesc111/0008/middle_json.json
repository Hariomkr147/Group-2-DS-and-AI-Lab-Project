            {
              "type": "text",
              "content": "4. "
            },
            {
              "type": "text",
              "content": "Analyse",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " the function of each part of the flower based on visible characters."
            }
          ]
        },
        {
