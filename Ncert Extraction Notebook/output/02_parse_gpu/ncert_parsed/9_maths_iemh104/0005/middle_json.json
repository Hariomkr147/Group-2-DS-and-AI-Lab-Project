            0.788,
            0.219
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Using the same identity, find the values of the following: (i) "
            },
            {
              "type": "equation_inline",
              "content": "( 6 4 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (ii) (105)"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " (iii) (205)"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.113,
            0.249,
            0.822,
            0.296
          ],
          "content": [
            {
              "type": "text",
              "content": "4.3 Factorisation of Algebraic Expressions Using Identities"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.112,
            0.307,
            0.886,
            0.349
          ],
          "content": [
            {
              "type": "text",
              "content": "The identity "
            },
            {
              "type": "equation_inline",
              "content": "(a + b)^{2} = a^{2} + 2ab + b^{2}"
            },
            {
              "type": "text",
              "content": " can also be used to find factors of some algebraic expressions."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.149,
            0.355,
            0.769,
            0.376
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Consider the algebraic expression "
            },
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } + 4 x + 4"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.15,
            0.384,
            0.334,
            0.403
          ],
          "content": [
            {
              "type": "text",
              "content": "We observe that"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.15,
            0.412,
            0.481,
            0.431
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } = ( x ) ^ { 2 } ,   4 = 2 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " and 4x = 2(2)(x)."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.44,
            0.882,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence, "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}+4x+4=x^{2}+2(x)(2)+2^{2}"
            },
            {
              "type": "text",
              "content": " can be compared with "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 }   +   2 ( a ) ( b )   +   b ^ { 2 } ,"
            },
            {
              "type": "text",
              "content": " where a = x and b = 2."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.113,
            0.488,
            0.884,
            0.528
          ],
          "content": [
            {
              "type": "text",
              "content": "We conclude that "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}+4x+4=(x+2)^{2}"
            },
            {
              "type": "text",
              "content": " . Therefore, we can say that "
            },
            {
              "type": "equation_inline",
              "content": "( x + 2 )"
            },
            {
              "type": "text",
              "content": " is a factor of "
            },
            {
              "type": "equation_inline",
              "content": "x^{2} + 4x \\pm 4."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.148,
            0.533,
            0.883,
            0.581
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 6:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us try to find factors of another algebraic expression: 36x"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " + 12x + 1."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.15,
            0.589,
            0.624,
            0.61
          ],
          "content": [
            {
              "type": "text",
              "content": "Writing this in the form "
            },
            {
              "type": "equation_inline",
              "content": "a^{2} \\pm 2ab + b^{2}"
            },
            {
              "type": "text",
              "content": " we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.151,
            0.617,
            0.53,
            0.638
          ],
          "image_path": "images/page_4_equation_13.jpg",
          "content": "36x^{2}+12x+1=(6x)^{2}+2(6x)(1)+1^{2}"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.15,
            0.646,
            0.785,
            0.666
          ],
          "content": [
            {
              "type": "text",
              "content": "where a = 6x and b = 1. Therefore, "
            },
            {
              "type": "equation_inline",
              "content": "36x^{2} + 12x + 1 = (6x + 1)^{2}."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.15,
            0.673,
            0.592,
            0.694
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus (6x + 1) is a factor of "
            },
            {
              "type": "equation_inline",
              "content": "36x^{2} + 12x + 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.112,
            0.701,
            0.884,
            0.741
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 7:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us try to factor "
            },
            {
              "type": "equation_inline",
              "content": "5 0 p ^ { 2 } \\pm 6 0 p q \\pm 1 8 q ^ { 2 }"
            },
            {
              "type": "text",
              "content": " . What will a and b be in this case?"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.112,
            0.751,
            0.886,
            0.81
          ],
          "content": [
            {
              "type": "text",
              "content": "Try to think of a term whose square is "
            },
            {
              "type": "equation_inline",
              "content": "5 0 p ^ { 2 }"
            },
            {
              "type": "text",
              "content": " . It is "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt { 5 0 } p"
            },
            {
              "type": "text",
              "content": " . But if we want to avoid using the square root symbol we may proceed as follows:"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.149,
            0.817,
            0.688,
            0.838
          ],
          "content": [
            {
              "type": "text",
              "content": "We observe that 2 is a common factor of the terms"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.151,
            0.844,
            0.324,
            0.865
          ],
          "content": [
            {
              "type": "text",
              "content": "50p"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": ", 60pq, 18q"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": "."
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.151,
            0.87,
            0.639,
            0.892
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus "
            },
            {
              "type": "equation_inline",
              "content": "5 0 p ^ { 2 } + 6 0 p q + 1 8 q ^ { 2 } = 2 ( 2 5 p ^ { 2 } + 3 0 p q + 9 q ^ { 2 } ) ."
            }
          ]
        }
      ]
    }
  ],
