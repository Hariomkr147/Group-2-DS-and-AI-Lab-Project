          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) "
            },
            {
              "type": "equation_inline",
              "content": "\\left( { \\frac { 3 } { 4 } } s   +   8 t \\right) ^ { 2 }"
            },
            {
              "type": "text",
