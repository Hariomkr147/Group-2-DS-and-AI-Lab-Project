        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.112,
            0.616,
            0.885,
            0.693
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 17:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Saira has arranged a square of side x units, 8 rectangular strips of sides x units and width 1 unit, and 15 squares of side 1 unit to form a bigger rectangle. Find the length and breadth of the rectangle in terms of x."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.149,
            0.696,
            0.727,
            0.716
          ],
          "content": [
            {
              "type": "text",
              "content": "Area covered by a square of side x units "
            },
            {
              "type": "equation_inline",
              "content": "= x ^ { 2 }"
            },
            {
              "type": "text",
              "content": " sq. units"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.149,
            0.718,
            0.852,
            0.739
          ],
          "content": [
            {
              "type": "text",
              "content": "Area covered by rectangle of sides x units and 1 unit = x sq. units"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.149,
            0.74,
            0.727,
            0.761
          ],
          "content": [
            {
              "type": "text",
              "content": "Total area covered by 8 such rectangles = 8x sq. units"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.15,
            0.763,
            0.712,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "Area covered by a square of side 1 unit = 1 sq. units"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.149,
            0.784,
            0.714,
            0.805
          ],
          "content": [
            {
              "type": "text",
              "content": "Total area covered by 15 such squares = 15 sq. units"
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.149,
            0.807,
            0.716,
            0.827
          ],
          "content": [
            {
              "type": "text",
              "content": "Total area covered by all the squares and rectangles"
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.15,
            0.829,
            0.397,
            0.849
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "x^{2} + 8x + 15"
            },
            {
              "type": "text",
              "content": " sq. units."
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.15,
            0.851,
            0.663,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "Area of Saira’s rectangl "
            },
            {
              "type": "equation_inline",
              "content": "e = x^{2} + 8x + 15"
            },
            {
              "type": "text",
              "content": " sq. units."
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.113,
            0.873,
            0.884,
            0.914
          ],
          "content": [
            {
              "type": "text",
              "content": "We can factor "
            },
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } + 8 x + 1 5"
            },
            {
              "type": "text",
              "content": " to obtain the dimensions of the rectangle prepared by Saira."
            }
          ]
        }
      ]
