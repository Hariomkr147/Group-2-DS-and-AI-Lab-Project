          ],
          "content": [
            {
              "type": "text",
              "content": "2. Factor using suitable identities:"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.181,
            0.14,
            0.379,
            0.163
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "1 6 y ^ { 2 } - 2 4 y + 9"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.661,
            0.141,
            0.695,
            0.161
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii)"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.168,
            0.133,
            0.878,
            0.219
          ],
          "image_path": "images/page_9_equation_5.jpg",
          "content": "\\frac { 9 } { 4 } \\boldsymbol { s } ^ { 2 } + 6 \\boldsymbol { s } \\boldsymbol { t } + 4 \\boldsymbol { t } ^ { 2 }\\tag{iii}"
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.232,
            0.186,
            0.701,
            0.23
          ],
          "image_path": "images/page_9_equation_6.jpg",
          "content": "\\frac{m^{2}}{9}+\\frac{mk}{3}+\\frac{k^{2}}{4}+3nk+2mn+9n^{2}\\tag{iv}"
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.723,
            0.186,
            0.836,
            0.234
          ],
          "image_path": "images/page_9_equation_7.jpg",
          "content": "{ \\frac { p ^ { 2 } } { 1 6 } }   -   2   +   { \\frac { 1 6 } { p ^ { 2 } } }"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.174,
            0.245,
            0.558,
            0.268
          ],
          "content": [
            {
              "type": "text",
              "content": "(v) "
            },
            {
              "type": "equation_inline",
              "content": "9a^{2}+4b^{2}+c^{2}-12ab+6ac-4bc"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.131,
            0.28,
            0.608,
            0.361
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Expand the following using the identity (a + b + c)"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " = a"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " + b"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " + c"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " + 2ab + 2bc + 2ca: (i) "
            },
            {
              "type": "equation_inline",
              "content": "( p + 3 q + 7 r ) ^ { 2 }"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.662,
            0.338,
            0.869,
            0.359
          ],
          "image_path": "images/page_9_equation_10.jpg",
          "content": "(3x - 2y \\pm 4z)^{2}\\tag{ii}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.132,
            0.369,
            0.376,
            0.39
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Is this an identity?"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.17,
            0.397,
            0.706,
            0.42
          ],
          "image_path": "images/page_9_equation_12.jpg",
          "content": "(a+b-c)^{2}+(a-b+c)^{2}+(a-b-c)^{2}=2a^{2}+2b^{2}+2c^{2}."
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.148,
            0.432,
            0.883,
            0.471
          ],
          "content": [
            {
              "type": "text",
              "content": "In Grade 8, you were introduced to yet another identity, "
            },
            {
              "type": "equation_inline",
              "content": "a^{2}-b^{2}=(a+b)(a-b)"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.15,
            0.476,
            0.848,
            0.497
          ],
          "content": [
            {
              "type": "text",
              "content": "This can be quite useful if it is rewritten as "
            },
            {
              "type": "equation_inline",
              "content": "a^{2} = (a + b)(a - b) + b^{2}."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.149,
            0.507,
            0.883,
            0.548
          ],
          "content": [
            {
              "type": "text",
              "content": "Look at the following figure. Justify the identity "
            },
            {
              "type": "equation_inline",
              "content": "a^{2} = (a + b)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "( a - b ) \\pm b ^ { 2 }"
            },
            {
              "type": "text",
              "content": " for yourself."
            }
          ]
        },
        {
          "type": "image",
          "index": 16,
          "bbox": [
            0.117,
            0.577,
            0.509,
            0.831
          ],
          "content": [
            {
              "type": "image_body",
              "index": 16,
              "bbox": [
                0.117,
                0.577,
                0.509,
                0.831
              ],
              "image_path": "images/page_9_image_16.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 17,
              "bbox": [
                0.28,
                0.843,
                0.349,
                0.861
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 4.5"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.523,
            0.623,
            0.875,
            0.721
          ],
          "content": [
            {
              "type": "text",
              "content": "In 750 CE, this identity was proposed by Śhrīdharāchārya as a method to quickly compute the squares of numbers. For example,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.56,
            0.728,
            0.826,
            0.808
          ],
          "image_path": "images/page_9_equation_19.jpg",
          "content": "\\begin{aligned} 55^{2} &= (55 + 5)(55 - 5) + 5^{2} \\\\&= 60 \\times 50 + 25 \\\\&= 3000 + 25 = 3025.\\\\ \\end{aligned}"
        }
      ]
    }
