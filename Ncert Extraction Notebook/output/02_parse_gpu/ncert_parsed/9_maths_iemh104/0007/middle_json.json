              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 4.3: A square of side a units"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.111,
            0.523,
            0.886,
            0.62
          ],
          "content": [
            {
              "type": "text",
              "content": "The area of the big square is "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 }"
            },
            {
              "type": "text",
              "content": " square units. The small square has an area of "
            },
            {
              "type": "equation_inline",
              "content": "( a   -   b ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " square units. The larger rectangle has area "
            },
            {
              "type": "equation_inline",
              "content": "a b"
            },
            {
              "type": "text",
              "content": " square units while the smaller rectangle has area b "
            },
            {
              "type": "equation_inline",
              "content": "( a - b )"
            },
            {
              "type": "text",
              "content": " square units. Thus, to obtain "
            },
            {
              "type": "equation_inline",
              "content": "( a - b ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " we can subtract the areas of the rectangles from the big square."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.624,
            0.726,
            0.67
          ],
          "content": [
            {
              "type": "text",
              "content": "We obtain "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{aligned}(a - b)^{2} &= a^{2} - ab - b(a - b) = a^{2} - ab - ba + b^{2} \\\\&= a^{2} - 2ab + b^{2}.\\end{aligned}"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.375,
            0.71,
            0.621,
            0.736
          ],
          "content": [
            {
              "type": "text",
              "content": "Exercise Set 4.2"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.133,
            0.763,
            0.375,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Factor completely:"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.182,
            0.789,
            0.411,
            0.81
          ],
          "content": [
            {
              "type": "text",
              "content": "(i) "
            },
            {
              "type": "equation_inline",
              "content": "9x^{2} + 24xy + 16y^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.175,
            0.824,
            0.401,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) "
            },
            {
              "type": "equation_inline",
              "content": "4 s ^ { 2 } + 2 0 s t + 2 5 t ^ { 2 }"
            }
          ]
        }
      ]
