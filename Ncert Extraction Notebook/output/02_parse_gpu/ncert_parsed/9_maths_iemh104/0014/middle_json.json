            },
            {
              "type": "equation_inline",
              "content": "10x^{2}-11x-6=(2x-\\frac{ 尨 }{ 尨 })(\\frac{ 尨 }{ 尨 }+2)"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.168,
            0.768,
            0.654,
            0.788
          ],
          "content": [
            {
              "type": "text",
              "content": "(iv) "
            },
            {
              "type": "equation_inline",
              "content": "6x^{2} + 7x + 2 = \\left( \\underline{\\hspace{2cm}} \\right)\\left( \\underline{\\hspace{2cm}} \\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.131,
            0.801,
            0.885,
            0.896
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Select and use the identity that will help you to find the following products without multiplying directly: (i) "
            },
            {
              "type": "equation_inline",
              "content": "( 4 1 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (ii) "
            },
            {
              "type": "equation_inline",
              "content": "( 2 7 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (iii) "
            },
            {
              "type": "equation_inline",
              "content": "( 2 3 \\times 1 7 )"
            },
            {
              "type": "text",
              "content": " (iv) "
            },
            {
              "type": "equation_inline",
              "content": "( 1 3 5 ) ^ { 2 }"
            }
          ]
        }
      ]
