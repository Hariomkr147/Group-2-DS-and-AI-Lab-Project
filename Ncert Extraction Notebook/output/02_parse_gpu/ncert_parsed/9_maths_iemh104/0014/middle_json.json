          ],
          "content": [
            {
              "type": "text",
              "content": "Exploring Algebraic Identities"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.855,
            0.069,
            0.883,
            0.084
          ],
          "content": [
            {
              "type": "text",
              "content": "81"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.149,
            0.108,
            0.815,
            0.128
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 10:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us begin with "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}+7x+12=x^{2}+(a+b)x+ab."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.133,
            0.886,
            0.211
          ],
          "content": [
            {
              "type": "text",
              "content": "Comparing the coefficients of the x-term and the constant terms on both sides of the equation, we get "
            },
            {
              "type": "equation_inline",
              "content": "a + b = 7"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "a b = 1 2"
            },
            {
              "type": "text",
              "content": " . Note that this is only possible when "
            },
            {
              "type": "equation_inline",
              "content": "a = 3"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "b = 4 ,"
            },
            {
              "type": "text",
              "content": " or a = 4 and "
            },
            {
              "type": "equation_inline",
              "content": "b = 3"
            },
            {
              "type": "text",
              "content": " . Thus, we choose one of these two possibilities and write the factors as"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.149,
            0.216,
            0.523,
            0.235
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\left( x + a \\right) \\left( x + b \\right)"
            },
            {
              "type": "text",
              "content": " , that is, "
            },
            {
              "type": "equation_inline",
              "content": "\\left(x+3\\right)\\left(x+4\\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.15,
            0.24,
            0.86,
            0.261
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 11:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Let us try to factor "
            },
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } + 1 1 x + 3 0"
            },
            {
              "type": "text",
              "content": " in a similar manner."
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.345,
            0.269,
            0.689,
            0.29
          ],
          "image_path": "images/page_13_equation_6.jpg",
          "content": "x^{2}+11x+30=x^{2}+(a+b)x+ab."
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.111,
            0.306,
            0.886,
            0.423
          ],
          "content": [
            {
              "type": "text",
              "content": "This leads to "
            },
            {
              "type": "equation_inline",
              "content": "a + b = 11"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "ab   =   30"
            },
            {
              "type": "text",
              "content": " . We need to choose values of a and b appropriately, so that "
            },
            {
              "type": "equation_inline",
              "content": "a + b = 11"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "a b = 3 0"
            },
            {
              "type": "text",
              "content": " are both satisfied. What if we choose "
            },
            {
              "type": "equation_inline",
              "content": "a = 2"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "b = 1 5 ?"
            },
            {
              "type": "text",
              "content": " Or "
            },
            {
              "type": "equation_inline",
              "content": "a = 3"
            },
            {
              "type": "text",
              "content": " and b = 10? Clearly these will not work as "
            },
            {
              "type": "equation_inline",
              "content": "a + b"
            },
            {
              "type": "text",
              "content": " is not equal to 11 even though "
            },
            {
              "type": "equation_inline",
              "content": "ab = 30.\\; \\mathrm{S0}"
            },
            {
              "type": "text",
              "content": " , we look at the factors of 30 and arrive at a = 5 and b = 6 or vice-versa. This way the x-term, 11x, can be split as "
            },
            {
              "type": "equation_inline",
              "content": "5 x + 6 x ,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.149,
            0.434,
            0.717,
            0.458
          ],
          "image_path": "images/page_13_equation_8.jpg",
          "content": "\\mathrm{Thus}, x^{2}+11x+30=x^{2}+(5+6)x+30=(x+5)(x+6)"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.111,
            0.469,
            0.886,
            0.567
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 12:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " In order to factor "
            },
            {
              "type": "equation_inline",
              "content": "X_{\\triangle}^{2} = 5X + 6,"
            },
            {
              "type": "text",
              "content": " we first note that the coefficient of x is negative. Once again comparing "
            },
            {
              "type": "equation_inline",
              "content": "x ^ { 2 } \\mathrm { ~ - ~ } 5 x \\mathrm { ~ + ~ } 6"
            },
            {
              "type": "text",
              "content": " with "
            },
            {
              "type": "equation_inline",
              "content": "x^{2}+(a+b)x+ab,"
            },
            {
              "type": "text",
              "content": " , we get "
            },
            {
              "type": "equation_inline",
              "content": "a \\pm b = -5"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "ab = 6"
            },
            {
              "type": "text",
              "content": " . Note that these two equations can be satisfied together only when "
            },
            {
              "type": "equation_inline",
              "content": "a = - 2"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "b = - 3"
            },
            {
              "type": "text",
              "content": " or vice-versa."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.375,
            0.594,
            0.622,
            0.622
          ],
          "content": [
            {
              "type": "text",
              "content": "Exercise Set 4.4"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
