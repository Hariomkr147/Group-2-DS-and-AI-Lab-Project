        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.113,
            0.712,
            0.662,
            0.736
          ],
          "content": [
            {
              "type": "text",
              "content": "4.5 Factorisation Using Algebra Tiles"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.113,
            0.746,
            0.68,
            0.767
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider a rectangle with sides "
            },
            {
              "type": "equation_inline",
              "content": "x + 3"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "x + 4"
            },
            {
              "type": "text",
              "content": " units."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.148,
            0.771,
            0.875,
            0.818
          ],
          "content": [
            {
              "type": "text",
              "content": "We know that the area of such a rectangle is "
            },
            {
              "type": "equation_inline",
              "content": "\\left(x+3\\right)\\left(x+4\\right)"
            },
            {
              "type": "text",
              "content": " sq. units. Using distributivity, we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.277,
            0.822,
            0.758,
            0.842
          ],
          "image_path": "images/page_10_equation_10.jpg",
          "content": "(x + 3)(x + 4) = x^{2} + 3x + 4x + 12 = x^{2} + 7x + 12."
        }
      ]
    }
  ],
