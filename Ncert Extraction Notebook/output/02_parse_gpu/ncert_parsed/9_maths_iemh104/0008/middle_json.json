          ],
          "content": [
            {
              "type": "text",
              "content": "("
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " 2 was taken out as a common factor in Example 7. Is it possible to do something similar in Exercises (v) and (vi) above?)"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.131,
            0.341,
            0.788,
            0.412
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Find the values of the following using the identity "
            },
            {
              "type": "equation_inline",
              "content": "(a - b)^{2} = a^{2} - 2ab + b^{2}."
            },
            {
              "type": "text",
              "content": " (i) "
            },
            {
              "type": "equation_inline",
              "content": "( 7 9 ) ^ { 2 }"
            },
            {
              "type": "text",
              "content": " (ii) (193)"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            },
            {
              "type": "text",
              "content": " (iii) (299)"
            },
            {
              "type": "text",
              "content": "2",
              "styles": [
                "superscript"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.114,
            0.44,
            0.402,
            0.462
          ],
          "content": [
            {
              "type": "text",
              "content": "4.4. More Identities"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.112,
            0.474,
            0.883,
            0.513
          ],
          "content": [
            {
              "type": "text",
              "content": "What will happen if we want to find the square of the sum of three numbers "
            },
            {
              "type": "equation_inline",
              "content": "a ,"
            },
            {
              "type": "text",
              "content": " b and "
            },
            {
              "type": "equation_inline",
              "content": "c ,"
            },
            {
              "type": "text",
              "content": " that is, "
            },
            {
              "type": "equation_inline",
              "content": "(a + b + c)^{2}?"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.149,
            0.522,
            0.418,
            0.542
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us replace "
            },
            {
              "type": "equation_inline",
              "content": "b + c"
            },
            {
              "type": "text",
              "content": " by d."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.15,
            0.549,
            0.587,
            0.569
          ],
          "content": [
            {
              "type": "text",
              "content": "We already know, "
            },
            {
              "type": "equation_inline",
              "content": "(a + d)^{2} = a^{2} + 2ad + d^{2}."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.113,
            0.579,
            0.635,
            0.618
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, replacing d by "
            },
            {
              "type": "equation_inline",
              "content": "( b \\quad + \\quad \\bar { c } )"
            },
            {
              "type": "text",
              "content": " , we get "
            },
            {
              "type": "equation_inline",
              "content": "a^{2}+2ad+d^{2}=a^{2}+2a(b+c)+(b+c)^{2}."
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.149,
            0.626,
            0.609,
            0.646
          ],
          "image_path": "images/page_7_equation_14.jpg",
          "content": "\\mathrm{So},(a+b+c)^{2}=a^{2}+2ab+2ac+b^{2}+2bc+c^{2}."
        },
        {
          "type": "image",
          "index": 15,
          "bbox": [
            0.658,
            0.521,
            0.88,
            0.675
          ],
          "content": [
            {
              "type": "image_body",
              "index": 15,
              "bbox": [
                0.658,
                0.521,
                0.88,
                0.675
              ],
              "image_path": "images/page_7_image_15.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.113,
            0.655,
            0.634,
            0.694
          ],
          "content": [
            {
              "type": "text",
              "content": "It may be more convenient to remember this as."
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.15,
            0.701,
            0.587,
            0.721
          ],
          "image_path": "images/page_7_equation_17.jpg",
          "content": "(a+b+c)^{2}=a^{2}+b^{2}+c^{2}+2ab+2bc+2ca."
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.113,
            0.729,
            0.634,
            0.79
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us interpret this geometrically by drawing a square of side "
            },
            {
              "type": "equation_inline",
              "content": "a + b + c"
            },
            {
              "type": "text",
              "content": " as shown in Fig. 4.4."
            }
          ]
        },
