              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.114,
            0.552,
            0.734,
            0.639
          ],
          "content": [
            {
              "type": "text",
              "content": "Caution",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": "— During a solar eclipse, one might be tempted to look at the Sun, thinking that it wouldn’t be strong enough to cause harm to our eyes. However, even during the eclipse, the Sun is intense enough to damage the eyes and cause blindness. Thus, directly viewing solar eclipse must be strictly avoided. Also, do not view it through sunglasses,"
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.75,
            0.475,
            0.936,
            0.608
          ],
