            0.844,
            0.613,
            0.873
          ],
          "content": [
            {
              "type": "text",
              "content": "Why does the colour of potassium permanganate not disappear when excess is added?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
