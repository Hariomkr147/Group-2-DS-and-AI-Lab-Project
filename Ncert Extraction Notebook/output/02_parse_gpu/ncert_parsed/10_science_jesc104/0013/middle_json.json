            0.787
          ],
          "content": [
            {
              "type": "text",
              "content": "Take about 3 mL of ethanol in a test tube and warm it gently in a water bath.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.101,
            0.787,
            0.613,
            0.816
          ],
          "content": [
            {
              "type": "text",
              "content": "Add a 5% solution of alkaline potassium permanganate drop by drop to this solution.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.101,
            0.815,
            0.612,
            0.844
          ],
          "content": [
            {
              "type": "text",
              "content": "Does the colour of potassium permanganate persist when it is added initially?",
              "styles": [
