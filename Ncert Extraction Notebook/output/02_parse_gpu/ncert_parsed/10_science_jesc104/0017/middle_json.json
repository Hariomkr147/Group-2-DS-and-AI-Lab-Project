            0.316,
            0.087,
            0.684,
            0.111
          ],
          "image_path": "images/page_16_equation_1.jpg",
          "content": "\\mathrm{CH_{3}COOC_{2}H_{5}}\\xrightarrow{\\mathrm{NaOH}}\\mathrm{C_{2}H_{5}OH}+\\mathrm{CH_{3}COONa}"
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.28,
            0.112,
            0.892,
            0.161
          ],
          "content": [
            {
              "type": "text",
              "content": "(ii) Reaction with a base: Like mineral acids, ethanoic acid reacts with a base such as sodium hydroxide to give a salt (sodium ethanoate or commonly called sodium acetate) and water:",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.314,
            0.165,
            0.67,
            0.183
          ],
          "image_path": "images/page_16_equation_3.jpg",
          "content": "\\mathrm{NaOH}+\\mathrm{CH_{3}COOH}\\rightarrow\\mathrm{CH_{3}COONa}+\\mathrm{H_{2}O}"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.307,
            0.184,
            0.892,
            0.218
          ],
          "content": [
            {
              "type": "text",
              "content": "How does ethanoic acid react with carbonates and hydrogencarbonates?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.307,
            0.221,
            0.639,
            0.238
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us perform an activity to find out.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.119,
            0.243,
            0.272,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 4.9"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.101,
            0.275,
            0.618,
            0.29
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Set up the apparatus as shown in Chapter 2, Activity 2.5.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.101,
            0.289,
            0.871,
            0.319
          ],
          "content": [
            {
              "type": "text",
              "content": "Take a spatula full of sodium carbonate in a test tube and add 2 mL of dilute ethanoic acid.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.101,
            0.318,
            0.316,
            0.333
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "What do you observe?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.101,
            0.333,
            0.824,
            0.349
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Pass the gas produced through freshly prepared lime-water. What do you observe?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.101,
            0.348,
            0.871,
            0.377
          ],
          "content": [
            {
              "type": "text",
              "content": "Can the gas produced by the reaction between ethanoic acid and sodium carbonate be identified by this test?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.1,
            0.376,
            0.82,
            0.393
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Repeat this Activity with sodium hydrogencarbonate instead of sodium carbonate.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.276,
            0.405,
            0.899,
            0.47
          ],
          "content": [
            {
              "type": "text",
              "content": "(iii) Reaction with carbonates and hydrogencarbonates: Ethanoic acid reacts with carbonates and hydrogencarbonates to give rise to a salt, carbon dioxide and water. The salt produced is commonly called sodium acetate.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.315,
            0.472,
            0.76,
            0.493
          ],
          "image_path": "images/page_16_equation_14.jpg",
          "content": "2CH_{3}COOH + Na_{2}CO_{3} \\rightarrow 2CH_{3}COONa + H_{2}O + CO_{2}"
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.315,
            0.495,
            0.744,
            0.516
          ],
          "image_path": "images/page_16_equation_15.jpg",
          "content": "\\mathrm{CH_{3}COOH + [NaHCO_{3} \\rightarrow CH_{3}COONa + H_{2}O + CO_{2}]}"
        },
        {
          "type": "paragraph_title",
          "index": 16,
          "bbox": [
            0.239,
            0.53,
            0.736,
            0.559
          ],
          "content": [
            {
              "type": "text",
              "content": "Q U E S T I O N S"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
