          ],
          "content": [
            {
              "type": "text",
              "content": "Activity 4.10"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.455,
            0.706,
            0.871,
            0.721
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "Take about 10 mL of water each in two test tubes.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.455,
            0.721,
            0.872,
            0.749
          ],
          "content": [
            {
              "type": "text",
              "content": "Add a drop of oil (cooking oil) to both the test tubes and label them as A and B.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.456,
            0.75,
            0.871,
            0.765
          ],
          "content": [
            {
              "type": "text",
              "content": "n "
            },
            {
              "type": "text",
              "content": "To test tube B, add a few drops of soap solution.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.456,
            0.765,
            0.872,
            0.793
          ],
          "content": [
            {
              "type": "text",
              "content": "Now shake both the test tubes vigourously for the same period of time.",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.455,
            0.794,
            0.873,
            0.837
          ],
          "content": [
            {
              "type": "text",
              "content": "Can you see the oil and water layers separately in both the test tubes immediately after you stop shaking them?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 30,
          "bbox": [
            0.455,
            0.837,
            0.873,
            0.882
          ],
          "content": [
            {
              "type": "text",
              "content": "Leave the test tubes undisturbed for some time and observe. Does the oil layer separate out? In which test tube does this happen first?",
              "styles": [
                "bold"
              ]
            }
          ]
        },
