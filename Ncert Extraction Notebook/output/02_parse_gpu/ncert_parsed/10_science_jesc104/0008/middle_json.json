            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { C _ { 6 } H _ { 1 2 } }"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "text",
              "content": "and the following structure –",
              "styles": [
                "bold"
              ]
            }
          ]
        },
