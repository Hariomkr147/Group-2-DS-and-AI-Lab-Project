            0.457,
            0.108
          ],
          "level": 2,
          "content": "Ever heard of ..."
        },
        {
          "type": "image",
          "bbox": [
            0.127,
            0.237,
            0.245,
            0.324
          ],
          "content": "",
          "captions": [],
