            0.764,
            0.818
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) Both M and N will stick to their surfaces."
            }
          ]
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.336,
            0.819,
            0.801,
            0.839
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) Both M and N will not stick to their surfaces."
