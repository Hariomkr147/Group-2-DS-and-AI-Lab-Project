            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "("
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Use the Baudhāyana–Pythagoras Theorem.)"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.117,
            0.784,
            0.557,
            0.802
          ],
          "content": [
            {
              "type": "text",
              "content": "What can we say about ∆ABC and ∆XYZ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.117,
            0.802,
            0.596,
            0.821
          ],
          "content": [
            {
              "type": "text",
              "content": "("
            },
            {
              "type": "text",
              "content": "Hint:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Use the SSS criterian for congruence.)"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.116,
            0.822,
            0.737,
            0.84
          ],
          "content": [
            {
              "type": "text",
              "content": "We conclude that ∆ABC had to be a right triangle after all."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.116,
            0.84,
            0.88,
            0.86
          ],
          "content": [
            {
              "type": "text",
              "content": "Hence the converse of the Baudhāyana–Pythagoras Theorem is also true!"
            }
          ]
        }
