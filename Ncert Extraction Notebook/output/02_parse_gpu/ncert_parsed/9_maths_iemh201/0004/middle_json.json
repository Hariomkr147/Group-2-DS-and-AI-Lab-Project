          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.116,
            0.744,
            0.559,
            0.764
          ],
          "content": [
            {
              "type": "text",
              "content": "What can we say about the length of XY?"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.117,
            0.765,
