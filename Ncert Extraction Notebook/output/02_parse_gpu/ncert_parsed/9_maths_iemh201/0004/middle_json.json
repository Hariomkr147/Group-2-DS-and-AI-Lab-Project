              "type": "text",
              "content": "Ganita Manjari | Grade 9 | Part II"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.116,
            0.111,
            0.881,
            0.148
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Here is a statement of the Baudhāyana–Pythagoras theorem."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.116,
            0.149,
            0.881,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "a , b , c"
            },
            {
              "type": "text",
              "content": " be the sidelengths of a triangle. If the triangle is right-angled, then "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 } + b ^ { 2 } = c ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.153,
            0.188,
            0.388,
            0.206
          ],
          "content": [
            {
              "type": "text",
              "content": "What is its converse?"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.116,
            0.207,
            0.881,
            0.245
          ],
          "content": [
            {
              "type": "text",
              "content": "To write the converse, we keep the first sentence of the Baudhāyana– Pythagoras theorem as it is, and make the necessary change in the second."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.116,
            0.244,
            0.881,
            0.283
          ],
          "content": [
            {
              "type": "text",
              "content": "Let a, b, c be the sidelengths of a triangle. If "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { 2 }   +   b ^ { 2 }   =   c ^ { 2 } ,"
            },
            {
              "type": "text",
              "content": " then the triangle is right-angled."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.153,
            0.284,
            0.389,
            0.3
          ],
          "content": [
            {
              "type": "text",
              "content": "Is this converse true?"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.152,
            0.3,
            0.878,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A B C }"
            },
            {
              "type": "text",
              "content": " be the triangle with sidelengths a, b, c such that "
            },
            {
              "type": "equation_inline",
              "content": "a^{2} + b^{2} = c^{2}"
            }
          ]
        },
        {
          "type": "image",
          "index": 9,
          "bbox": [
            0.369,
            0.327,
            0.633,
            0.505
          ],
          "content": [
            {
              "type": "image_body",
              "index": 9,
              "bbox": [
                0.369,
                0.327,
                0.633,
                0.505
              ],
              "image_path": "images/page_3_image_9.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.116,
            0.533,
            0.851,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "Construct another right triangle ∆XYZ whose perpendicular sides YZ and XZ have sidelengths a and b."
            }
          ]
        },
        {
          "type": "image",
          "index": 11,
          "bbox": [
            0.301,
