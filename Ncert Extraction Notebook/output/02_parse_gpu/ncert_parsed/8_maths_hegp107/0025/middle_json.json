          "content": [
            {
              "type": "text",
              "content": "(a) No. of grey bricks in a block of the pattern = 2 + 3 + 4 = 9 No. of coloured bricks in a block of the pattern = 3 + 2 + 1 = 6 Ratio of grey bricks to coloured bricks in a block of the pattern = 9 : 6 = 3 : 2"
            }
