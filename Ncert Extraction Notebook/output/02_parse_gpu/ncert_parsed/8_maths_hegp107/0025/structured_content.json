        {
          "type": "text",
          "bbox": [
            0.204,
            0.264,
            0.849,
            0.344
          ],
          "content": "(a) No. of grey bricks in a block of the pattern = 2 + 3 + 4 = 9 No. of coloured bricks in a block of the pattern = 3 + 2 + 1 = 6 Ratio of grey bricks to coloured bricks in a block of the pattern = 9 : 6 = 3 : 2"
        },
        {
          "type": "text",
          "bbox": [
            0.203,
            0.355,
            0.721,
            0.416
          ],
          "content": "(b) No. of grey bricks in one block of pattern = 16 No. of coloured bricks in one block of pattern = 12 Ratio is 16 : 12 = 4 : 3"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.425,
            0.848,
            0.482
          ],
