            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "Place concave and convex mirrors on a table with their reflecting surfaces facing upwards."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.134,
            0.164,
            0.604,
            0.24
          ],
          "content": [
            {
              "type": "text",
              "content": "z Now view them from the side, keeping your eye at their level, to "
            },
            {
              "type": "text",
              "content": "identify",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " whether the reflecting surface is curved inwards or outwards (Fig. 10.4)."
            }
          ]
        },
        {
