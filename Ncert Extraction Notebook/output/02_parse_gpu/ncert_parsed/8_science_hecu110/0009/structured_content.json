              "bbox": [
                0.191,
                0.082,
                0.396,
                0.135
              ],
              "content": "Are laws of reflection applicable to spherical mirrors also?"
            }
          ],
          "image_source": "images/page_8_image_0.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.421,
            0.082,
            0.883,
            0.16
          ],
          "content": "The laws of reflection are valid for all kinds of mirrors — plane and spherical. But if multiple parallel rays fall on the spherical mirrors, we observe something interesting."
        },
        {
          "type": "image",
          "bbox": [
            0.073,
            0.165,
            0.292,
