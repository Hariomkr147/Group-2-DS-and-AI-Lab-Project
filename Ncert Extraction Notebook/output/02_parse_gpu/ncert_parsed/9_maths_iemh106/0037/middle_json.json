            0.086
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Manjari | Grade 9 | Part I"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.37,
            0.11,
            0.629,
            0.132
          ],
          "content": [
            {
              "type": "text",
              "content": "Chapter Summary"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.152,
            0.152,
            0.883,
            0.207
          ],
          "content": [
            {
              "type": "text",
              "content": "π is the constant circumference to diameter ratio for all circles, and is approximately equal to "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 2 2 } { 7 }"
            },
            {
              "type": "text",
              "content": " or 3.14."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.151,
            0.212,
            0.884,
            0.252
          ],
          "content": [
            {
              "type": "text",
              "content": "The circumference of a circle is given by "
            },
            {
              "type": "equation_inline",
              "content": "\\mathsf { C } = 2 \\pi r _ { \\mathrm { i } }"
            },
            {
              "type": "text",
              "content": " , where r is the radius of the circle."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.151,
            0.256,
            0.883,
            0.301
          ],
          "content": [
            {
              "type": "text",
              "content": "• The arc length of a circle is given by "
            },
            {
              "type": "equation_inline",
              "content": "l = 2 \\pi r \\times \\frac { \\Theta ^ { \\circ } } { 3 6 0 ^ { \\circ } }"
            },
            {
              "type": "text",
              "content": " , where θ is the central angle."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.152,
            0.306,
            0.802,
            0.336
          ],
          "content": [
            {
              "type": "text",
              "content": "• The area of a triangle is given by "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A } = { \\frac { 1 } { 2 } }"
            },
            {
              "type": "text",
              "content": " base times height."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.152,
            0.341,
            0.883,
            0.362
          ],
          "content": [
            {
              "type": "text",
              "content": "• Heron’s formula for the area of a triangle in terms of its sides a, b, c:"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.232,
            0.367,
            0.798,
            0.405
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm{area} = \\sqrt{s(s - a)(s - b)(s - c)}"
            },
            {
              "type": "text",
              "content": " . where "
            },
            {
              "type": "equation_inline",
              "content": "s = s = \\frac{1}{2}(a + b + c)."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.406,
            0.599,
            0.427
          ],
          "content": [
            {
              "type": "text",
              "content": "• The area of a circle is given by "
            },
            {
              "type": "equation_inline",
              "content": "A = \\pi r^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.152,
            0.435,
            0.884,
            0.538
          ],
          "content": [
            {
              "type": "text",
              "content": "Estimates for π: Archimedes: "
            },
            {
              "type": "equation_inline",
              "content": "3 \\frac { 1 0 } { 7 1 } < \\pi < 3 \\frac { 1 } { 7 } ;"
            },
            {
              "type": "text",
              "content": " Chongzhi: "
            },
            {
              "type": "equation_inline",
              "content": "\\pi \\; \\approx \\; \\frac { 3 5 5 } { 1 1 3 } ;"
            },
            {
              "type": "text",
              "content": " Āryabhaṭa: "
            },
            {
              "type": "equation_inline",
              "content": "\\pi \\; \\approx \\; 3.1416;"
            },
            {
              "type": "text",
              "content": " Mādhava’s exact formula: "
            },
            {
              "type": "equation_inline",
              "content": "\\pi = 4 \\left( 1 - \\frac{1}{3} + \\frac{1}{5} - \\frac{1}{7} + \\cdots \\right)"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.153,
            0.539,
            0.467,
            0.559
          ],
          "content": [
            {
              "type": "text",
              "content": "• π is an irrational number."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.152,
            0.559,
            0.883,
            0.609
          ],
          "content": [
            {
              "type": "text",
              "content": "• The area of a sector of a circle is given by "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{area} = \\pi r^2 \\times \\frac{\\theta^\\circ}{360^\\circ}"
            },
            {
              "type": "text",
              "content": " where θ is the central angle."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.153,
            0.616,
            0.884,
            0.655
          ],
          "content": [
            {
              "type": "text",
              "content": "Brahmagupta’s formula for the area of a cyclic quadrilateral in terms of its sides "
            },
            {
              "type": "equation_inline",
              "content": "a,b,c,d;"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.194,
            0.657,
            0.833,
            0.694
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\mathrm{area} = \\sqrt{(s - a)(s - b)(s - c)(s - d)}"
            },
            {
              "type": "text",
              "content": " . where "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{2}(a + b + c + d)"
            }
          ]
        }
      ]
    }
  ],
