            0.087
          ],
          "content": [
            {
              "type": "text",
              "content": "Measuring Space: Perimeter and Area"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.844,
            0.068,
            0.883,
            0.085
          ],
          "content": [
            {
              "type": "text",
              "content": "141"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.112,
            0.108,
            0.887,
            0.149
          ],
          "content": [
            {
              "type": "text",
              "content": "a square with area ab sq. units. Here is a slightly simplified form of Baudhāyana’s construction (Fig. 6.30)."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.484,
            0.16,
            0.816,
            0.2
          ],
          "content": [
            {
              "type": "text",
              "content": "• Given: rectangle ABCD with "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AD} = a, \\mathrm{AB} = b   where   a > b."
            }
          ]
        },
        {
          "type": "chart",
          "index": 4,
          "bbox": [
            0.117,
            0.201,
            0.48,
            0.408
          ],
          "content": [
            {
              "type": "chart_body",
              "index": 4,
              "bbox": [
                0.117,
                0.201,
                0.48,
                0.408
              ],
              "image_path": "images/page_23_chart_4.jpg",
              "content": ""
            },
            {
              "type": "chart_caption",
              "index": 5,
              "bbox": [
                0.164,
                0.395,
                0.437,
                0.428
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.30: Rectangle ABCD with AD = a, AB = b"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.484,
            0.208,
            0.854,
            0.229
          ],
          "content": [
            {
              "type": "text",
              "content": "• Locate E on AD so that "
            },
            {
              "type": "equation_inline",
              "content": "AE = AB."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.485,
            0.238,
            0.822,
            0.259
          ],
          "content": [
            {
              "type": "text",
              "content": "• Locate the midpoint F of ED."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.485,
            0.267,
            0.882,
            0.308
          ],
          "content": [
            {
              "type": "text",
              "content": "• Draw square AFGH with side AF and vertex H on AB produced."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.486,
            0.316,
            0.883,
            0.356
          ],
          "content": [
            {
              "type": "text",
              "content": "• Draw arc AG with centre H. Let arc AG cut side BC at K."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.486,
            0.365,
            0.883,
            0.405
          ],
          "content": [
            {
              "type": "text",
              "content": "• Draw a line through K parallel to AH. Let it cut GH at P."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.485,
            0.413,
            0.883,
            0.475
          ],
          "content": [
            {
              "type": "text",
              "content": "• Draw square HPQS with HP as side. Then square HPQS has the same area as rectangle ABCD."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.112,
            0.488,
            0.886,
            0.558
          ],
          "content": [
            {
              "type": "text",
              "content": "Try to work out why this method works. You will find that it is a geometrical translation of the formula "
            },
            {
              "type": "equation_inline",
              "content": "\\left( \\frac{a + b}{2} \\right)^{2} - \\left( \\frac{a - b}{2} \\right)^{2} = ab"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.113,
            0.578,
            0.501,
            0.602
          ],
          "content": [
            {
              "type": "text",
              "content": "*Why does this method work?"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.111,
            0.607,
            0.883,
            0.676
          ],
          "content": [
            {
              "type": "text",
              "content": "Refer to Fig. 6.30. From "
            },
            {
              "type": "equation_inline",
              "content": "AE = b"
            },
            {
              "type": "text",
              "content": " we get "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{AF}=\\frac{\\mathrm{AE}+\\mathrm{AD}}{2}=\\frac{a+b}{2}"
            },
            {
              "type": "text",
              "content": " Hence, "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{HG} = \\frac{a + b}{2} = \\mathrm{HK}"
            },
            {
              "type": "text",
              "content": " as HK is a radius of the circle."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.148,
            0.683,
            0.661,
            0.724
          ],
          "content": [
            {
              "type": "text",
              "content": "Next, "
            },
            {
              "type": "equation_inline",
              "content": "BH = AH - AB = AF - AB = \\frac{a + b}{2} - b = \\frac{a - b}{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.113,
            0.729,
            0.885,
            0.77
          ],
          "content": [
            {
              "type": "text",
              "content": "Now consider the right-angled triangle HKP. Using the Baudhāyana– Pythagoras theorem we get"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.151,
            0.77,
            0.567,
            0.819
          ],
          "image_path": "images/page_23_equation_17.jpg",
          "content": "\\mathrm{HP}^{2}=\\mathrm{HK}^{2}-\\mathrm{BH}^{2}=\\left(\\frac{a+b}{2}\\right)^{2}-\\left(\\frac{a-b}{2}\\right)^{2}="
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.153,
            0.82,
            0.599,
            0.865
          ],
          "image_path": "images/page_23_equation_18.jpg",
          "content": "\\frac{a^{2}+2ab+b^{2}}{4}-\\frac{a^{2}-2ab+b^{2}}{4}=\\frac{ab}{2}+\\frac{ab}{2}=ab."
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.149,
            0.877,
            0.818,
            0.9
          ],
          "content": [
            {
              "type": "text",
              "content": "Therefore square HPQS has the same area as rectangle ABCD."
            }
          ]
        }
      ]
    }
  ],
