              "content": "136"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.184,
            0.068,
            0.489,
            0.087
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Manjari | Grade 9 | Part I"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.113,
            0.107,
            0.767,
            0.129
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 5:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " A triangle with sides 3 units, 4 units and 5 units."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.113,
            0.142,
            0.883,
            0.186
          ],
          "content": [
            {
              "type": "text",
              "content": "The semi-perimeter is "
            },
            {
              "type": "equation_inline",
              "content": "s = \\frac{1}{2}(3 + 4 + 5) = 6"
            },
            {
              "type": "text",
              "content": " units. Heron’s formula now yields,"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.139,
            0.195,
            0.856,
            0.218
          ],
          "content": [
            {
              "type": "text",
              "content": "area of triangle "
            },
            {
              "type": "equation_inline",
              "content": "\\sqrt{6 \\times (6 - 3) \\times (6 - 4) \\times (6 - 5)} = \\sqrt{6 \\times 3 \\times 2} = 6"
            },
            {
              "type": "text",
              "content": " sq. units."
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.123,
            0.233,
            0.303,
            0.406
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.123,
                0.233,
                0.303,
                0.406
              ],
              "image_path": "images/page_18_image_5.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 6,
              "bbox": [
                0.179,
                0.413,
                0.259,
                0.43
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.25"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.322,
            0.247,
            0.886,
            0.326
          ],
          "content": [
            {
              "type": "text",
              "content": "Let us check this against the ‘half base times height’ formula. See Fig. 6.25; note that "
            },
            {
              "type": "equation_inline",
              "content": "3 ^ { 2 }   +   4 ^ { 2 }   =   5 ^ { 2 }"
            },
            {
              "type": "text",
              "content": " . Therefore, by the converse of the Baudhāyana–Pythagoras hypotenuse theorem, ΔABC is right-angled at B. So,"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.434,
            0.331,
            0.773,
            0.352
          ],
          "content": [
            {
              "type": "text",
              "content": "base = 3 units, height = 4 units,"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.322,
            0.359,
            0.884,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "so the area is "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{2}( base  \\times  height ) = \\frac{1}{2}(3 \\times 4) = 6."
            },
            {
              "type": "text",
              "content": " sq. units, the same as earlier."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.15,
            0.44,
            0.563,
            0.458
          ],
          "content": [
            {
              "type": "text",
              "content": "We get the correct result in each case."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.112,
            0.46,
            0.885,
            0.536
          ],
          "content": [
            {
              "type": "text",
              "content": "You may wonder how Heron’s formula is proved. There are many proofs known; one of them uses the Baudhāyana–Pythagoras theorem and repeated use of the ‘difference-of-two-squares’ formula "
            },
            {
              "type": "equation_inline",
              "content": "a^{2}-b^{2}=(a-b)(a+b)"
            },
            {
              "type": "text",
              "content": " . We will study some of these proofs in Grade 10."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.112,
            0.536,
            0.884,
            0.575
          ],
          "content": [
            {
              "type": "text",
              "content": "There are two other such formulas for the area of a triangle. Both have a connection with circles. See Fig. 6.26."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.112,
            0.575,
            0.884,
            0.614
          ],
          "content": [
            {
              "type": "text",
              "content": "Given any triangle ABC, there is exactly one circle that passes through its three vertices. This is called the "
            },
            {
              "type": "text",
              "content": "circumcircle",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A B C }"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.112,
            0.613,
            0.883,
            0.653
          ],
          "content": [
            {
              "type": "text",
              "content": "There is also exactly one circle that fits tightly in the triangle, touching its three sides. This is called the "
            },
            {
              "type": "text",
              "content": "incircle",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " of ∆ABC."
            }
          ]
        },
        {
          "type": "image",
          "index": 15,
          "bbox": [
            0.153,
            0.666,
            0.421,
            0.857
          ],
          "content": [
            {
              "type": "image_body",
              "index": 15,
              "bbox": [
                0.153,
                0.666,
                0.421,
                0.857
              ],
              "image_path": "images/page_18_image_15.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 16,
              "bbox": [
                0.247,
                0.866,
                0.328,
                0.883
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.26"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.459,
            0.685,
            0.877,
            0.782
          ],
          "content": [
            {
              "type": "text",
              "content": "Let the sides of "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A B C }"
            },
            {
              "type": "text",
              "content": " be a, b, and c. Let the radius of the circumcircle be R. Let the radius of the incircle be r. Then we have the following two formulas for the area:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.559,
            0.784,
            0.77,
            0.825
          ],
          "image_path": "images/page_18_equation_18.jpg",
          "content": "\\mathrm{Area}   of   \\Delta \\mathrm{ABC} = \\frac{abc}{4R}"
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.525,
            0.839,
            0.804,
            0.88
          ],
          "image_path": "images/page_18_equation_19.jpg",
          "content": "\\mathrm{Area}   of   \\Delta \\mathrm{ABC} = \\frac{r(a + b + c)}{2}"
        }
      ]
    }
  ],
