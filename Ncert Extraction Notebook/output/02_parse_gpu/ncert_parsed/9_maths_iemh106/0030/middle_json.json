                0.376,
                0.251
              ],
              "image_path": "images/page_29_image_2.jpg",
              "content": ""
            },
            {
              "type": "image_caption",
              "index": 4,
              "bbox": [
                0.173,
                0.259,
                0.342,
                0.291
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.39: Area of a semi-circular disc"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.399,
            0.135,
            0.877,
            0.223
          ],
          "content": [
            {
              "type": "text",
              "content": "By symmetry, we see that the area of a semicircular disc is "
            },
            {
              "type": "equation_inline",
              "content": "\\left( { \\frac { 1 8 0 } { 3 6 0 } } \\right) ^ { \\mathrm { t h } } = { \\frac { 1 } { 2 } }"
            },
            {
              "type": "text",
              "content": " of the area of the circle, i.e., "
            },
            {
              "type": "equation_inline",
              "content": "\\frac { 1 } { 2 }   \\pi r ^ { 2 }"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.4,
            0.227,
            0.878,
            0.268
          ],
          "content": [
            {
              "type": "text",
              "content": "We could use the reflection symmetry of the circle to understand this result."
            }
          ]
        },
        {
          "type": "image",
          "index": 6,
          "bbox": [
            0.117,
            0.314,
            0.362,
            0.496
          ],
          "content": [
            {
              "type": "image_body",
              "index": 6,
              "bbox": [
                0.117,
                0.314,
                0.362,
                0.496
              ],
              "image_path": "images/page_29_image_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.368,
            0.343,
            0.876,
            0.435
          ],
          "content": [
            {
              "type": "text",
              "content": "By symmetry, we see that the area of a quarter circular disc is "
            },
            {
              "type": "equation_inline",
              "content": "\\left( { \\frac { 9 0 } { 3 6 0 } } \\right) ^ { \\mathrm { t h } } = { \\frac { 1 } { 4 } }"
            },
            {
              "type": "text",
              "content": " of the area of the circle, i.e., "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{1}{4} \\pi r^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.368,
            0.445,
            0.876,
            0.503
          ],
          "content": [
            {
              "type": "text",
              "content": "We could also use the quarter-turn symmetry of the circle to understand this result."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.122,
            0.498,
            0.359,
            0.531
          ],
          "content": [
            {
              "type": "text",
              "content": "Fig. 6.40: Area of a quarter circular disc"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.112,
            0.556,
            0.885,
            0.598
          ],
          "content": [
            {
              "type": "text",
              "content": "Examining the above, we immediately obtain the desired formula for a general sector:"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.112,
            0.606,
            0.885,
            0.648
          ],
          "content": [
            {
              "type": "text",
              "content": "Formula for the area of a sector of a disc",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " in terms of the angle it subtends at the centre of the circle"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.112,
            0.654,
            0.885,
            0.694
          ],
          "content": [
            {
              "type": "text",
              "content": "If the arc is "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { A B } ,"
            },
            {
              "type": "text",
              "content": " and it subtends an angle of "
            },
            {
              "type": "equation_inline",
              "content": "\\theta ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " at the centre O of the circle (see Fig. 6.38), then the area of the sector is"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.438,
            0.696,
            0.56,
            0.739
          ],
          "image_path": "images/page_29_equation_13.jpg",
          "content": "\\pi r ^ { 2 }   \\times   { \\frac { \\theta ^ { \\circ } } { 3 6 0 ^ { \\circ } } } ."
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.113,
            0.744,
            0.885,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "Note how we have used the rotational symmetry of a circle in deducing these formulas."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.111,
            0.782,
            0.886,
            0.843
          ],
          "content": [
            {
              "type": "text",
              "content": "Related to a sector, there is a part of the circular region called a segment. A "
            },
            {
              "type": "text",
              "content": "segment",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " of a circle is the region bounded by an arc of the circle and the chord joining the endpoints of the arc."
            }
          ]
        }
      ]
    }
  ],
