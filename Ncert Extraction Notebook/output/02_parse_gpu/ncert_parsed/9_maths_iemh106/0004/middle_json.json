              "content": "Measuring Space: Perimeter and Area"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.844,
            0.068,
            0.883,
            0.084
          ],
          "content": [
            {
              "type": "text",
