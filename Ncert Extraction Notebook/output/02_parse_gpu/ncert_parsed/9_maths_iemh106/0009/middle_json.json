            },
            {
              "type": "image_caption",
              "index": 6,
              "bbox": [
                0.168,
                0.408,
                0.399,
                0.443
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Fig. 6.10: Length of an arc of a circle"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.451,
            0.275,
            0.879,
            0.357
          ],
          "content": [
            {
              "type": "text",
              "content": "If the arc is AB, and it subtends an angle "
            },
            {
              "type": "equation_inline",
              "content": "\\theta ^ { \\circ }"
            },
            {
              "type": "text",
              "content": " at the centre O of the circle, the length of the arc is "
            },
            {
              "type": "equation_inline",
              "content": "2 \\pi r \\times \\frac { \\theta ^ { \\circ } } { 3 6 0 ^ { \\circ } }"
            }
          ]
        },
