              ],
              "image_path": "images/page_31_table_5.jpg",
              "content": "<table><tbody><tr><td></td><td>a</td><td>b</td></tr><tr><td>a</td><td>a<sup>2</sup></td><td>ab</td></tr><tr><td>b</td><td>ab</td><td>b<sup>2</sup></td></tr></tbody></table>"
            },
            {
