        },
        {
          "type": "text",
          "bbox": [
            0.153,
            0.51,
            0.849,
            0.55
          ],
          "content": "**Step 3:** \u0007Draw a sufficiently long arc from line l."
        },
        {
          "type": "image",
          "bbox": [
            0.311,
            0.565,
            0.672,
            0.737
          ],
          "content": "",
