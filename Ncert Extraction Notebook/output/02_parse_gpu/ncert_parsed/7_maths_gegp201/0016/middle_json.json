            0.608
          ],
          "content": [
            {
              "type": "text",
              "content": "Step 1:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " Draw the base QR of length 4 cm."
            }
          ]
        },
        {
          "type": "text",
