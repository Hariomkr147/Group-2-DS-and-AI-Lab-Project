              "type": "text",
              "content": "Step 3:",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " From R, cut an arc on line l of radius 5 cm."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
