            0.066
          ],
          "content": [
            {
              "type": "text",
              "content": "Ganita Prakash | Grade 7 | Part-II"
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.176,
            0.089,
            0.272,
            0.107
          ],
          "content": [
            {
              "type": "text",
              "content": "We have,"
            }
          ]
        },
        {
          "type": "equation",
          "index": 2,
          "bbox": [
            0.426,
            0.108,
            0.581,
            0.127
          ],
          "image_path": "images/page_17_equation_2.jpg",
          "content": "\\mathrm{AB} = \\mathrm{AC}   ( given )"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.316,
            0.127,
            0.707,
            0.145
          ],
          "content": [
            {
              "type": "text",
              "content": "∠ADB = ∠ADC = 90° (from construction)"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.227,
            0.146,
            0.793,
            0.165
          ],
          "content": [
            {
              "type": "text",
              "content": "AD is a common side of the two triangles "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A D B }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta \\mathrm { A D C }"
            }
          ]
        },
        {
          "type": "image",
          "index": 5,
          "bbox": [
            0.362,
            0.171,
            0.635,
            0.309
          ],
          "content": [
            {
              "type": "image_body",
              "index": 5,
              "bbox": [
                0.362,
                0.171,
                0.635,
                0.309
              ],
              "image_path": "images/page_17_image_5.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.153,
            0.316,
            0.847,
            0.373
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, the triangles satisfy the RHS condition. Hence, "
            },
            {
              "type": "equation_inline",
              "content": "\\Delta  ADB \\cong \\Delta  ADC"
            },
            {
              "type": "text",
              "content": " This shows that "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm{B} = \\angle \\mathrm{C},"
            },
            {
              "type": "text",
              "content": " as they are corresponding parts of congruent triangles."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.175,
            0.373,
            0.662,
            0.394
          ],
          "content": [
            {
              "type": "text",
              "content": "Thus, the angles opposite to equal sides are equal."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.402,
            0.546,
            0.425
          ],
          "content": [
            {
              "type": "text",
              "content": "Can you use this fact to find "
            },
            {
              "type": "equation_inline",
              "content": "\\angle \\mathrm { B }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\angle C ?"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.151,
            0.442,
            0.563,
            0.464
          ],
          "content": [
            {
              "type": "text",
              "content": "Angles in an Equilateral Triangle",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.151,
            0.468,
            0.845,
            0.489
          ],
          "content": [
            {
              "type": "text",
              "content": "Equilateral triangles are those in which all the sides have equal lengths."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.111,
            0.497,
            0.513,
            0.521
          ],
          "content": [
            {
              "type": "text",
              "content": "What can we say about their angles?"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.151,
            0.53,
            0.846,
            0.569
          ],
          "content": [
            {
              "type": "text",
              "content": "We can use the recently discovered fact that angles opposite to equal sides are equal."
            }
          ]
        },
        {
          "type": "image",
          "index": 13,
          "bbox": [
            0.39,
            0.569,
            0.607,
            0.709
          ],
          "content": [
            {
              "type": "image_body",
              "index": 13,
              "bbox": [
                0.39,
                0.569,
                0.607,
                0.709
              ],
              "image_path": "images/page_17_image_13.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.152,
            0.722,
            0.572,
            0.741
          ],
          "content": [
            {
              "type": "text",
              "content": "The sides AB and AC are equal. "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{SO} \\angle \\mathrm{B} = \\angle \\mathrm{C}."
            }
          ]
        },
        {
          "type": "image",
          "index": 15,
