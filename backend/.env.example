DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5432/tutor
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
# Generate each value with: python -c "import secrets; print(secrets.token_urlsafe(16))"
# Optional: CORS_ORIGINS=http://localhost:5173   APP_ENV=production   TOKEN_MINUTES=480   MESSAGES_PER_MINUTE=30
# LLM provider: gemini (default) | openai | anthropic | ollama. A request can override it with {"provider": "..."}.
LLM_PROVIDER=gemini
# gemini: uses Google ADC (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
# Optional: GOOGLE_CLOUD_LOCATION=global   GEMINI_MODEL=gemini-3-flash-preview
# openai (or any OpenAI-compatible API): OPENAI_API_KEY=   OPENAI_MODEL=gpt-4o-mini   OPENAI_BASE_URL=
# anthropic: ANTHROPIC_API_KEY=   ANTHROPIC_MODEL=claude-haiku-5-5
# ollama (local): OLLAMA_BASE_URL=http://localhost:11434/v1   OLLAMA_MODEL=llama3.1
# qwen_finetuned (our fine-tuned tutor), hosted in one of two ways:
#   Hugging Face Space: QWEN_URL=https://<owner>-<space>.hf.space   QWEN_API_KEY=<Read token of the Space owner>
#   Kaggle notebook (docs/milestone-3/model_hosting/hosting-qwen.ipynb): QWEN_URL and QWEN_API_KEY as it prints them
# Optional: QWEN_TIMEOUT=60
# Tutor replies: qwen_finetuned (default) writes hint and probe turns; templates are used if it is not set up or fails.
# Optional: SOCRATIC_PROVIDER=templates (model off) or another provider name
