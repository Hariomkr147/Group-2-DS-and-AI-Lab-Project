        {
          "name": "Ingest course pack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ]
            },
            "description": "Replaces a pack with the same id. Prerequisites must exist in the pack.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"ncert-science\",\n  \"title\": \"NCERT Science (sample)\",\n  \"subject\": \"Science\",\n  \"concepts\": [\n    {\n      \"id\": \"force\",\n      \"name\": \"Force\",\n      \"level\": 1,\n      \"prerequisites\": [],\n      \"materials\": [\n        {\n          \"source\": \"NCERT Science\",\n          \"page\": \"to fill\",\n          \"text\": \"A force is a push or a pull.\"\n        }\n      ],\n      \"questions\": [\n        {\n          \"id\": \"force-1\",\n          \"text\": \"Is pushing a door a force? (yes/no)\",\n          \"answer\": \"yes\",\n          \"hint\": \"A push is one kind of force.\",\n          \"difficulty\": 1\n        }\n      ]\n    },\n    {\n      \"id\": \"motion\",\n      \"name\": \"Motion\",\n      \"level\": 2,\n      \"prerequisites\": [\n        \"force\"\n      ],\n      \"materials\": [],\n      \"questions\": []\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
