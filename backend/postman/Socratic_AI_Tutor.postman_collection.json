    {
      "name": "Setup",
      "item": [
        {
          "name": "Start session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "Saves session_id into the collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"learner_id\": \"{{learner_id}}\",\n  \"course_id\": \"{{course_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('session_id', pm.response.json().session_id);"
                ]
              }
            }
          ]
        }
      ]
    },
